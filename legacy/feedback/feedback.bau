*(feedback
<table width=100% cellpadding=0 cellspacing=0>
  <tr>
    <td>
      <div id="centercolumn_record">
        <div class='navarea'>
          <font size="1">
            <span class='underlinedlink' align='right'>
            <a href='/'>Home</a>  >  
            </span>
            <span class='greylink' align='right'>Feedback response</span>
          </font>
	      </div>
	      <br>
        <table width='100%'  cellpadding=0 cellspacing=0>
            <tr valign='center' class='green_curve_background'>
              <td align='left'>
                <img src='/images/header_left.gif'></img>
              </td>
              <td width='97%' valign='center' class='green_curve_background'>
                Feedback response			
              </td>
              <td align='right'>
                <img src='/images/header_right.gif'></img>
              </td>
            </tr>
          </table>
          <br>	
          <div id='login_gray_background' style="width: 95%">
            <h2>Thanks you for your feedback!</h2><br>
            <p>Our team will review your feedback and reply to you in the next 
            few days.</p>
            <br>
            <p><a href="javascript: self.close(\)">Close Window</a></p>
          </div>	
          <br>
          <b>Your message:</b><br>
          <div id='login_green_background' style="width: 95%">
          <b>From:</b> $(name) ($(email)\) <br><br>
          <b>Subject:</b> $(subject) <br><br>
          <b>Message:</b> <pre>$(message)</pre> <br><br>
        </div>
        <br>
        <center>
          <div id='login_gray_background' style="width: 20%; font-size:200%;">
            <p><a href="javascript: self.close(\)">Close this window</a></p>
          </div>
        </center>
      </div>
    </td>
  </tr>
</table>
)
