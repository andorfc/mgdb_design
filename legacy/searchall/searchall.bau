$$SYNTAX-LEVEL 2
*(search
  <script src="/js/search_engine.js" type="text/javascript"></script>

  <table width='100%'  cellpadding=0 cellspacing=0>
    <tr valign='center' class='green_curve_background'>
      <td align='left'>
        <img src='/images/header_left.gif'></img>
      </td>
      <td width='97%' valign='center' class='green_curve_background'>
        MaizeGDB Data Search
      </td>
      <td align='right'>
        <img src='/images/header_right.gif'></img>
      </td>
    </tr>
  </table>

  <div id="searchall-results" style="margin-left:10px">
    <h3>Searching for '$(global_search_term)' ...</h3>
    <br><img src="/images/cornloading_60.gif">
  </div>
  
  <script language="javascript">
    // Start the search
    global_search_action('$(global_search_term)', '$(global_search_type)'\);
  </script>
)
