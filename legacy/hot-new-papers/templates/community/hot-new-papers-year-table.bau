*(hot-new-papers-year-table #include-js: js/hot_new_papers.js#
<div id='leftcolumn-hotnewpapers'>
  <table width=100% height='405px' id='hotnew-tab' cellpadding=0 cellspacing=0>
    <!--<tr id="codie"
      onmouseover='javascript:ChangeColor(this, true\);' 
      onmouseout='javascript:ChangeColor(this, false\);' 
      onclick='javascript: document.location.href = "/hot_new_papers?row=0&sort=0&codie=1";' 
      class='lite_green_background_1'>
      
		  <td style='border-top:1px solid #5B6E1F; border-bottom:1px solid #5B6E1F;font-size: 12px; padding-top:2px; padding-bottom:2px;padding-left:2px;'>
        CODIE Recommended Readings
		  </td>
		</tr> -->
	  @(inits #display: off#
			$(row-no #default:1#)
		)
	  @(hot-new-table-row
      <tr %(row-color 
          $row=$this->reflect(\)->upstream('hot-new-papers-year-table'\)->get('row-no'\);
          $row_val=$row->value(\);
          $idstr='id='.$row_val;
          $row->replace($row_val + 1\);
          return $idstr;)
        onmouseover='javascript:ChangeColor(this, true\);' onmouseout='javascript:ChangeColor(this, false\);' 
        onclick='DoNav(%(send-row return $this->reflect(\)->upstream('hot-new-papers-year-table'\)->get('row-no'\)->value(\)-1;),0\);javascript:ChangeColor(this, true\);' 
        class='lite_green_background_1'>
        
			  <td style='border-top:1px solid #5B6E1F; border-bottom:1px solid #5B6E1F;font-size: 12px; padding-top:2px; padding-bottom:2px;padding-left:2px;'>
			    $(hotnewyear)
			  </td>
			</tr>
		)
    <tr id=0
      onmouseover='javascript:ChangeColor(this, true\);' 
      onmouseout='javascript:ChangeColor(this, false\);' 
      onclick='DoNav(0\);' 
      class='lite_green_background_1'>
      
		  <td style='border-top:1px solid #5B6E1F; border-bottom:1px solid #5B6E1F;font-size: 12px; padding-top:2px; padding-bottom:2px;padding-left:2px;'>
        All Recommended Readings
		  </td>
		</tr>
		<tr>
		  <td style='border-top:1px solid #5B6E1F; border-bottom:1px solid #5B6E1F;font-size: 12px; padding-top:2px; padding-bottom:2px;padding-left:2px;'>
		    <a href="/data_center/reference">Search all papers</a>
		  </td>
		</tr>
  </table>		
</div>
)
