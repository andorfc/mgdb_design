$$SYNTAX-LEVEL 2
*(stock-sections
  @(top {display: off}
    <script language="javascript">
      recordAccess('stock', '$(escaped_name)'\);
    </script>

    <p class='data_center_title'>
      <table>
        <tr>
          <td valign='middle'>
           <span class='data_center_title'>$(name)</span>
          </td>
        </tr>
      </table>
    </p>
    <br>
    @(user-annotation {display: off}
      <p>
       <b>
          <a href="create_pheno_annotation.cgi?id=$(id)" target="new">Add your
            own annotation to this record!</a>
        </b>
     </p>
    )
    @(syn {display: off}
      <p>
       This Stock is also known by the following names: <br>
       <div class="small_tab">
         @(syn_sec
          <b>$(synonym)</b> $(authority)<br>
         )
       </div>
      </p>
    )
    @(references {display:off}
      <br>
      @(show_ref
      <p>
       @(print {display:off}
           <a name="show_ref"></a>
           <a onclick="javascript:toggle_references('hide'\);" href="#r" title="Hide these papers!">
             <img src="/images/collapse.png" border=0 alt="Hide these papers!">
           </a>
           <b>Related Papers:</b> (click the arrow to the left to hide these\)<br>
        )
       <div id="show_ref" name="show_ref" style="display: none">

            <a name="show_ref"></a>
            <a onclick="javascript:toggle_references('hide'\);" href="#r" title="Hide these papers!">
              <img src="/images/collapse.png" border=0 alt="Hide these papers!">
            </a>
            <b>Related Papers:</b> (click the arrow to the left to hide these\)<br>

          @(fill_ref
          &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(<i>$(cont_name)</i>\)
          <a href="/data_center/reference?id=$(ref_id)" title="$(ref_title)">$(ref_name)</a><br>
          )

       </div>
      )
      @(hide_ref
       <p>
        @(hide_print {display:off}
         <a onclick="javascript:toggle_references('show'\);" href="#r" title="Show related references">
           <img alt="Show related references" src="/images/expand.png" border=0>
         </a>
          This Stock has <b>$(match_count)</b> references that describe it.
          Click the arrow to the left to view these references.
        )
        <div id="hide_ref" name="hide_ref" style="display: $(display)">

         <a onclick="javascript:toggle_references('show'\);" href="#r" title="Show related references">
           <img alt="Show related references" src="/images/expand.png" border=0>
         </a>
          This Stock has <b>$(match_count)</b> references that describe it.
          Click the arrow to the left to view these references.

        </div>
       </p>
      )
    )
  )

  @(overview {display: off}
    <p>
     @(available {display: off}
       <br><b>Available From:</b>
        <a href="/person?id=$(avail_id)">$(name_first) $(name_last)</a>
     )
     @(available-no_link {display: off}
       <br><b>Available From:</b> $(name_first) $(name_last)
     )
     @(ordering {display: off}
       (<a href="/ordering/coop_order/$(stock_order)">Order this stock</a>\) <br>
     )
     @(coop {display: off}
       <br><b>Co-op ID:</b> $(coop_id)<br>
     )
     @(country  {display: off}
       <br><b>Country:</b> $(cntry)<br>
     )
     @(classification {display: off}
       <br><b>Classification:</b> $(class)<br>
     )
     @(developer {display: off}
       <br><b>Developer:</b>
        <a href="/person?id=$(dev_id)">$(dev_namefirst) $(dev_namelast)</a>
        <br>
     )
     @(linkage_group {display: off}
       <br><b>Focus Linkage Group:</b>
        <a href="lg?id=$(linkage_id)">$(linkage_name)</a><br>
     )
     @(market_class {display: off}
       <br><b>Market Class:</b> $(market_name)<br>
     )
     @(pedigree {display: off}
       <br><b>Pedigree:</b> $(ped)<br>
     )
     @(species {display: off}
       <br><b>Species:</b> $(species_name)<br>
     )
     @(state_province {display: off}
       <br><b>State/Province:</b> $(state)<br>
     )
     @(stype {display: off}
       <br><b>Type:</b>
        @(with_comments
        <acronym title="$(type_comment)">$(type_name)</acronym>
        (<a href="term?id=$(type_record)">?</a>\)
        )
        @(without_comments {bind: with_comments | display: off}
          $(type_name)
        )<br>
     )
     @(year {display: off}
       <br><b>Year:</b> $(yr)<br>
     )
     @(parents {display: off}
       <br><b>Parent(s\):</b><br>
        @(parent_sec
        &nbsp;<a href="stock?id=$(id)">$(name)</a> $(percent)<br>
        )
     )
     @(progeny {display: off}
       <br><b>Immediate Progeny:</b> (<a href="javascript:toggleItem('progeny-section'\)">show/hide</a>\)<br>
       <div id="progeny-section" style="display: none;">
         @(progeny_sec
           &nbsp;<a href="stock?id=$(id)">$(name)</a><br>
         )
       </div>
     )
     @(network {display: off}
      <br><b><a href="/breeders_toolbox?data=$(name)" target="_blank">Pedigree Network &mdash; click to go to the MaizeGDB Pedigree Viewer</a></b><br>
      <img src="/images/ajax-loader-small.gif" id="thumbnail_load" style="display: $(thumbnail_load_display)"/>
        <br>
        <a href="#!" onclick="open_sb_basic('/breeders_toolbox?data=$(name)&embed=1&layout=cose', 'Pedigree Viewer', 1200, 1250, 'iframe'\)">
            <img src="$(thumbnail_src)" id="thumbnail" style="display: $(thumbnail_display)"/>
        </a>
      <span id="thumbnail_error" style="color: crimson; font-weight: bold; display: none;">
            Our apologies, but we are unable to load the PedNet thumbnail for $(name) at this time.
      </span>
      @(thumbnail_ajax {display: off}
        <iframe src="/breeders_toolbox?data=$(name)&embed=1&layout=concentric" style="visibility: hidden; position: absolute; left: -5000px; width: 750px; height: 950px"></iframe> 
        <script language="javascript">
         $.ajax({
            url: '/tools/breeders_toolbox/img_data/img_data.php',
            data: {
                stock: '$(name)'
            },
            success: function (imgData\) { 
                \$("#thumbnail_load"\).hide(\);
                if (imgData.toLowerCase(\).includes("error"\)\) {
                    \$("#thumbnail_error"\).show(\);
                }
                else {
                    \$("#thumbnail"\).attr("src", imgData\);
                    \$("#thumbnail"\).show(\);
                }
            },
            error: function (jqXHR, textStatus, errorThrown\) {
            console.log(textStatus + " : " + errorThrown\);
                \$("#thumbnail_load"\).hide(\);
                \$("#thumbnail_error"\).show(\);
            }
        }\);
        </script>
      )
     )
     @(descriptions {display: off}
       <br><b>Description:</b> $(description)<br>
     )
     @(assembly {display: off}
      <br><b>Assembly:</b> 
      <a href="/genome/assembly/$(assembly_name)">$(assembly_name)</a>
      <br>
     )
     @(comment {display: off}
      <br><b>Comments:</b>
      <div class="small_tab">$(comments)</div>
      <br>
     )
     @(relation_sec {display: off}
       <br><b>Relation(s\):</b><br>
        @(relations
        &nbsp;$(relation) <a href="stock?id=$(related_id)">$(name)</a><br>
        )
     )
    
    @(stock_images {display: off}
      <br>
      <b>Stock images</b>
      *(lamba {load: ../templates/partials/image_table.bau})
    )
    
    @(stock_unavailable {display: off}
      <br>
      <span style="color:green">
        <b>This stock is not currently available at the Maize Cooperation Stock Center.</b>
      </span>
    )

    @(stock_unavailable-uniformMu {display: off}
      <br>
      <span style="color:green">
       <b>This <a href="https://maizegdb.org/uniformmu"><b>UniformMu</b></a> stock is 
       back-ordered. Replenishment is underway. Replenishment is underway. No need to 
       email, check here for updates.</b>
      </span>
    )

    @(stock_discontinued {display: off}
      <br>
      <b class="error">This stock has been discontinued.</b>
    )
    </p>
  )
  
  @(annotations {display: off}
    @(curation {display: off}
    <!-- Unused -->
      <table cellpadding=0 cellspacing=0 width="90%">
        <tr>
          <td><img src="/images/lite_green_lt.gif"></td>
          <td class=lite_green_background width="100%"></td>
          <td><img src="/images/lite_green_rt.gif"></td>
        </tr>
        <tr>
          <td class=lite_green_background></td>
          <td class=lite_green_background style="padding:2px">
            <p>
              <b>Add annotation to this record</b>
              <form action="javascript:popUpAnnotation('curationform', '/curation/FreeText/edit'\);" method="post"
                    id="curationform">
                <input type="hidden" id="table_name" value="phenotype">
                <input type="hidden" id="mgdb_id" value="$(id)">
                <input type="hidden" id="rec_name" value="$(rec_name)">
                <input type="hidden" id="auto_num" name="auto_num" value="">
                &nbsp;<a onclick="curationform.submit(\)"
                   href="#" >Add free text annotation</a>
              </form>
            </p>
          </td>
          <td class=lite_green_background></td>
        </tr>
        <tr>
          <td><img src="/images/lite_green_lb.gif"></td>
          <td class=lite_green_background width="100%"></td>
          <td><img src="/images/lite_green_rb.gif"></td>
        </tr>
      </table>
      <br>
    )

    @(no-user {display: off}
      <p><b>No user annotations</b></p>
      <br>
    )
    @(annotation-user {display: off}
      <p><b>User Annotations:</b></p>
      @(annotation-user-list
        <form name="ft_edit_$(auto_num)" id="ft_edit_$(auto_num)" method="post"
              target="annotation">
          <input type="hidden" name="auto_num" id="auto_num" value="$(auto_num)">
          <input type="hidden" name="mgdb_id" id="mgdb_id" value="$(mgdb_id)">
          <input type="hidden" name="table_name" id="table_name" value="phenotype">
          From:
          <b><a href="/person/$(person_id)">$(first_name) $(last_name)</a></b>
          (<i>$(mod_date)</i>\)
          <br>
          <span style="margin-left: 10px;">$(memo)</span>
        </form>
      )
      <br>
    )
    @(annotation-user-curator {display: off}
      <p><b>User Annotations: (curator's view\)</b></p>
      @(annotation-user-list-ex
        <form name="ft_edit_$(auto_num)" id="ft_edit_$(auto_num)" method="post"
              target="annotation">
          <input type="hidden" name="auto_num" id="auto_num" value="$(auto_num)">
          <input type="hidden" name="mgdb_id" id="mgdb_id" value="$(mgdb_id)">
          <input type="hidden" name="table_name" id="table_name" value="phenotype">
          From:
          <b><a href="/person/$(person_id)">$(first_name) $(last_name)</a></b>
          (<i>$(mod_date)</i>\)
          <br>
          <span style="margin-left: 10px;">$(memo)</span>
          <br>
          <i><a href="#"
                onclick="popUpAnnotation('ft_edit_$(auto_num)', '/curation/FreeText/edit'\);">Edit this annotation</a>
          </i>
        </form>
      )
      <br>
    )
  )

  @(related_records {display: off}
    @(genotypic_variations {display: off}
     <br>
     <p>
        <b>Genotypic Variations: </b>
       <table width="100%">
        @(gvar_sec
          <tr>
            <td>&nbsp;<a href="/data_center/variation?id=$(id_1)">$(name_1)</a></td>
            <td>&nbsp;<a href="/data_center/variation?id=$(id_2)">$(name_2)</a></td>
            <td>&nbsp;<a href="/data_center/variation?id=$(id_3)">$(name_3)</a></td>
            <td>&nbsp;<a href="/data_center/variation?id=$(id_4)">$(name_4)</a></td>
          </tr>
        )
        </table>
        @(geno_images {display: off}
        <br><b>Genotypic Variations Images</b>
        <table width="100%">
         <tr>
           <!-- default tab displayed -->
             <td id="first_tab" name="first_tab" onclick="toggle_tab('first_tab'\); toggle_images('gen_images', $(vi_id), '$(first_name)', '$(first_name)'\);" class="stock_tab_focus">
            $(first_name)
          </td><!--refresh_imgtbl($(img_id), '$(name)'\);  refresh_imgtbl($(vi_id), '$(name)'\);'border-right: 3px green dashed; border-left: 3px green dashed; border-bottom: 3px green dashed;-->
          @(geno_images_sec
            <td id='$(name)' name='$(name)' onclick=" toggle_images('gen_images', $(img_id), '$(name)', '$(first_name)'\); toggle_tab('$(name)'\); " class="stock_tab_unfocus">
                 <b>$(name)</b>
              </td>
           )
            </tr>
            </table>
            <div id="gen_images">
            <iframe id="carousel" name="carousel" marginheight='0' marginwidth='0' width='100%' height='115' frameborder='0' scrolling='no' src="../../tools/car/examples/stocks_carousel.php?id=$(vi_id)&name=$(first_name)">

           </iframe>
             <table cellpadding='15' cellspacing='0' width='100%'>
               <tr style='background-color: #D3DEBC;' valign='top'>
                <td width='10%' valign='top'><b>Image</b></td>
                <td width='10%' valign='top'><b>Variation</b></td>
                <td valign='top' width='10%'><b>Type</b></td>
                <td><b>Caption</b></td>
              </tr>
             @(geno_img_tbl
               <tbody id="tbl$(name)" name="tbl$(name)" style="$(display)">
                $(table_row)
              </tbody>
              )
                </table>
           </div>
           <br>
          )
     </p>
    )


    @(karyotypic_variations {display: off}
     <br>
     <p>
       <b>Karyotpic Variations:</b><br>
        @(kvar_sec
        &nbsp;<a href="/data_center/kv?id=$(id)">$(name)</a><br>
        )
    )

    @(phenotypes {display: off}
     <br>
     <p>
       <b>Phenotypes:</b><br>
        @(pheno_sec
        &nbsp;<a href="/data_center/phenotype?id=$(id)">$(name)</a>
         $(attrib)<br>
        )
    )
     @(trait_vals_sec {display: off}
    <p id="trait_vals">
       <div id="datacenter_lite_green_background">
        <a href="#!" onclick="javascript:trait_val_search('$(name)', 'trait_val_results'\)">
         <img id="trait_val_icon" src="/images/expand.jpg"/> Browse trait values for $(name)
        </a>
        <div id="trait_val_results"></div>
        </div>
      </p>
    )
    @(no_related {display: off}
     <br>
     <b>&nbsp;&nbsp;No related records found for this stock.</b>
    )
  )


  @(grin {display: off}
      @(grin_results
     $(grin_item)<br>
    )

    @(no_grin {display: off}
     <br>
     <b>No GRIN Information found for this record.</b>
    )
  )
   
  @(offsite {display: off}
    <p>
    @(offsite_sec
     <br>
     <a href="/person?id=$(db_person)">$(person_name)</a>:
     <b><a href=" $(url_prefix)$(key_urlencode)">$(key_display)</a></b>
     <br>
    )
    @(no_offsite {bind: offsite_sec | display: off}
     <br>
     <b> No offsite data available for this record. </b>
    )
    </p>
  )

  <!--@(image {display: off}
    <p>
      @(image_loop
         <a href="http://images.maizegdb.org/db_images/Phenotype/$(url)">
         <img border=0 src="http://images.maizegdb.org/db_images/Phenotype/$(url)">
       </a>
        <br> $(caption)
      )
    </p>
  )-->

)
