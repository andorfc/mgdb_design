$$SYNTAX-LEVEL 2
*(gene-adv-results-page
  <table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <th style="text-align: left; width: 10%">Locus Name</th>
    <th style="text-align: left; width: 30%">Full Name</th>
    <th style="text-align: left; width: 30%">Gene Model</th>
    <th style="text-align: left; width: 5%">Line</th>
    <th style="text-align: left; width: 10%">Type</th>
    <th style="text-align: left; width: 10%">Chr</th>
    <th style="text-align: left; width: 10%">Version</th>
  </tr>
  @(adv_gene-row 
  <tr style="background-color: $(bgcolor); height:25px;">
    <td style="text-align: left; width: 10%">
      <a href="$(path)/$(locus_id)">$(locus_name)</a>&nbsp;
    </td>
    <td style="text-align: left; width: 30%">$(locus_full_name)&nbsp;</td>
    <td style="text-align: left; width: 20%">
      <a href="$(path)/$(gene_name)">$(gene_name)</a>&nbsp;
    </td>
    <td style="text-align: left">$(line)&nbsp;</td>
    <td style="text-align: left; width: 10%">$(model_type)&nbsp;</td>
    <td style="text-align: left; width: 10%">$(chr)&nbsp;</td>
    <td style="text-align: left; width: 10%">$(version)&nbsp;</td>
  </tr>
  )
  </table>
  
  @(load-next-page_adv {display: off}
    <script language="javascript">
      geneAdvSearch('gene_adv_results_list$(nextpage)', $(nextpage)\);
    </script>
  )
)
