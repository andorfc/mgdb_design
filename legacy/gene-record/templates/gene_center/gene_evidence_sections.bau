$$SYNTAX-LEVEL 2
*(gene-evidence-sections

  @(evidence {display: off}
    <div id="evidence-contents" name="evidence-contents">
      <table width="95%">
        <tr height='10px'>
         <td width="30%" id="evi-tab_v3" name="evi-tab_v3"
              class="toggle_tab evi_tab genome_tab_focus" align="center"
              onclick="toggle_genome_tabs('evi-tab_v3', 'evi-div_v3', 'evi'\)">
            &nbsp;&nbsp;&nbsp;B73 RefGen_v3&nbsp;&nbsp;&nbsp;
            <br>
          </td>
          <td width="30%" id="evi-tab_v2" name="evi-tab_v2"
              class='toggle_tab evi_tab genome_tab_unfocus' align="center"
              onclick="toggle_genome_tabs('evi-tab_v2', 'evi-div_v2', 'evi'\)">
            &nbsp;&nbsp;&nbsp;B73 RefGen_v2&nbsp;&nbsp;&nbsp;
            <br>
          </td>
          <td width="30%" id="evi-tab_v1" name="evi-tab_v1"
              class='toggle_tab evi_tab genome_tab_unfocus' align="center"
              onclick="toggle_genome_tabs('evi-tab_v1', 'evi-div_v1', 'evi'\)">
            &nbsp;&nbsp;&nbsp;B73 RefGen_v1&nbsp;&nbsp;&nbsp;
            <br>
          </td>
          <td style="align: right; width: 10%;">
            &nbsp;&nbsp;&nbsp;
          </td>
        </tr>
      </table>
    
      <div id="evi-div_v3" name="evi-div_v3" width="95%" class="genome_box toggle_div evi_div"
           style="display:$(display-v3)">
        <div id="evi-content_v3" name="evi-content_v3"
             style="position:relative; left:20px;top:5px; width:95%;">
          $(contents-v3)
        </div>
      </div>
      
      <div id="evi-div_v2" name="evi-div_v2" width="95%" class="genome_box toggle_div evi_div"
           style="display:$(display-v2)">
        <div id="evi-content_v2" name="evi-content_v2"
             style="position:relative; left:20px;top:5px; width:95%;">
          $(contents-v2)
        </div>
      </div>
      
      <div id="evi-div_v1" name="evi-div_v1" width="95%" class="genome_box toggle_div evi_div"
           style="display:$(display-v1)">
        <div id="evi-content_v1" name="evi-content_v1"
             style="position:relative; left:20px;top:5px; width:95%;">
          $(contents-v1)
        </div>
      </div>
    </div>    
  )
)
