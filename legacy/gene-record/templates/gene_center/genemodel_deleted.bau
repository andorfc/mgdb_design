*(body
  <script type="text/javascript"> 
    var count = -1;
    function goBack(\) { 
      window.history.go(count\);
      event.preventDefault(\);
      return false;
      
    } 
    function adjust_hist(\) {
      count = -2;
    }
  </script>
  
  <table cellpadding=0 cellspacing=0>
    <tr>
      <td>
        <div id="centercolumn_record">
          <div align="right"> 
            <a href="#">Home</a> > <a href="#">Gene Center</a> > <a href="/gene_center/gene/$(page_url)">$(page)</a>
          </div>
          <br>
          <table width='100%'  cellpadding=0 cellspacing=0>
            <tr valign='center' class='green_curve_background'>
              <td align='left'>
                 <img src='/images/header_left.gif'>
              </td>
              <td width='97%' valign='center' class='green_curve_background'>
                 $(page) Record
              </td>
              <td align='right'>
                 <img src='/images/header_right.gif'>
              </td>
            </tr>
          </table>
        </div>
      
        <div id="centercolumn_record">
          <p>Gene model record not found for $(id1).</p><br>
          The gene model $(id1) has been deleted from the current gene model
          set ($(cur_gm_set)\).
          $(merged)
          <br><br>
          <a onclick="javascript:goBack(\);" href="#">Go back to the previous 
          page</a>.<br><br>
          <p><a href="/index.php">Return to the homepage</a>.</p> 
        </div>
        
      </td>
    </tr>
  </table>
)
