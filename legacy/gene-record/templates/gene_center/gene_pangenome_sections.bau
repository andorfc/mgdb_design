$$SYNTAX-LEVEL 2
*(pangenome-sections

  @(overview_pangenome {display: off}
    <p>
      There are multiple ways to define and generate a <b>pan-genome</b>. 
      Here we use "pan-genome" to mean to an analysis of multiple genome 
      annotations to group gene models by sequence similarity and 
      syntenic position, to identify core gene models (present in all annotations\) 
      and to identify orphan gene models (present in only one\).
      <br><br>
      A <b>pan-gene</b> is the set of gene models from multiple genomes that appear
      to represent the same gene.
      <br><br>
      <b>You can also explore the pan-gene set in the 
      <a href="/pan_gene_center/pan_gene/$(gene_model)">pan-gene data center.</a></b>
      <br><br>
      <table>
        <tr>
          <td align="left" align="center" width="70%">
            To explore <b>structural variation</b> across the NAM founders, within and 
            near $(gene_model) try 
            <a href="https://bridgecereal.scinet.usda.gov/Maize" target="_blank">BRIDGEcereal</a>.<br>
            Type '$(gene_model)' into the box at the upper left, click 'Check gene id' to see 
            if the gene model is in the database, scroll down to select the flanking region
            and other parameters, then scroll to the bottom and click 'Submit'. 
          </td>
          <td width="30%">
            <a href="https://bridgecereal.scinet.usda.gov/Maize" target="_blank">
              <img src="/images/BRIDGEcereal_logo.png">
            </a>
          </td>
        </tr>
      </table>
    </p>
    <br>
    
    @(not_in_pangenome_analysis {display: off}
      <p>
        <b>No pan-gene information.</b> This annotation was not included in the 
        pan-genome analysis
      </p>
    )
    @(not_placed_into_pan_gene {display: off}
      <p>
        <b>No pan-gene information.</b> This gene model was not placed in a pan-gene set.
      </p>
    )
    @(pangenome_analysis_infomation {display: off}
      <p>
        <b>Analysis description:</b> $(analysis-description)
        <br>
        <a href="https://download.maizegdb.org/Pan-genes/">Download full pan-gene analyses</a>
      </p>
      <br>
      <b>Datasets associated with one or more members of this pan-gene set</b><br>
      <p>
        $(pangenome_source)
      </p>
      <br>
    )
    
   @(no_pangenome_data {display: off}
      <div style="margin-left:20px">
        There is no functional or insertion data for any gene model
        associated with $(gene_model) in this pan-genome.
      </div>
    )
    @(b73-associated-gene-models {display: off}
      <br>
      <b>Datasets associated with related gene models in other B73 genome assembly versions</b><br>
      <p>
        $(pan-b73-source)
      </p>
    
      @(pan_b73_expression {display: off}
        <div style="margin-left:20px">
          <b>Expression data</b> is associated with one or more related B73 genes:
          <div style="margin-left:30px">
            @(pan_b73_expression_gene_list
              <a href="/gene_center/gene/$(gene_model)#expression" target="_blank">$(b73_gene_model)</a> 
            )
          </div>
        </div>
        <br>
      )
    
      @(pan_b73_proteomic {display: off}
        <div style="margin-left:20px">
          <b>Proteomic data</b> is associated with one or more related B73 genes
          @(pan_b73_proteomic_gene_list
            <a href="/gene_center/gene/$(gene_model)#proteomics" target="_blank">$(b73_gene_model)</a> 
          )
        </div>
        <br>
      )
    
      @(pan_b73_insertions {display: off}
        <div style="margin-left:20px">
          <b>Insertion data</b> exists for one or more related B73 genes:
          <div style="margin-left:30px">
            @(pan_b73_insertion_gene_list
              <a href="/gene_center/gene/$(gene_model)#insertions" target="_blank">$(b73_gene_model)</a> 
            )
          </div>
        </div>
        <br>
      )
    
      @(pan_b73_hand_curated_genes {display: off}
        <div style="margin-left:20px">
          One or more related gene models has been <b>hand-corrected</b>:
          <div style="margin-left:30px">
            @(pan_b73_hand_curated_gene_list
              <a href="/gene_center/gene/$(gene_model)" target="_blank">$(b73_gene_model)</a> 
            )
          </div>
        </div>
        <br>
      )
    
      @(b73-pangenome-image {display: off}
        <b>Pangenome view:</b><br>
        This image shows genomic sequence at the B73 gene model location across multiple 
        assemblies. The image was generated by the 
        <a href="https://github.com/ComparativeGenomicsToolkit/cactus/blob/master/doc/pangenome.md">cactus-Minigraph 
        pangenome pipeline</a> by MaizeGDB in 2026. Where present, the merged CDSs (dark yellow\) 
        and UTRs (aqua\) in the subgraph space are also shown. 
        <br>
        <img src="$(pangenome-url)" width="725px">
      )
      
      @(no_pan_b73_data {display: off}
        <div style="margin-left:20px">
          There no expression, proteomic, or insertion data was found for any B73 gene model
          associated with $(gene_model).
        </div>
        <br>
      )
    )
  )
  
  @(no-pan-gene {display: off}
    <br>
    <b>No pan-gene set was found for this gene model</b>
  )
  
  @(singleton {display: off}
    <br>
    <b>This gene model is a singleton, that is, it is the only member of its pan-gene set.</b>
  )
  
  @(pan-gene {display: off}
    <br>
    This pan-gene set contains <b>$(pan-gene-size)</b> members
    <br><br>
    <b>View this pan-gene in the  
    <a href="/pan_gene_center/pan_gene/$(gene_model)">pan-gene data center.</a></b>
    <br><br>
    @(pan-gene-members {display: off}
      <b>$(relationship_type)</b>
      <br>
      <table width="100%">
        <tr align="left" style="background-color:#d9edee">
          <th width="2%" valign="top"></th>
          <th width="16%" valign="top">gene model&nbsp;</th>
          <th width="10%" valign="top">set&nbsp;</th>
          <th width="4%" valign="top">chr&nbsp;</th>
          <th width="32%" valign="top">assembly&nbsp;</th>
        </tr>
        @(pan-gene-member_list
          <tr align="left">
            <td></td>
            <td width="14em" valign="top">
<!--  keep this!      <a href="/gene_center/gene/$(pan_gene_member)">$(pan_gene_member_display)</a>&nbsp; -->
              $(pan_gene_member_display)
            </td>
            <td width="10em" valign="top">$(pan_gene_member_annotation)&nbsp;</td>
            <td width="10em" valign="top">$(chr)&nbsp;</td>
            <td width="24em" valign="top">
              <a href="/genome/genome_assembly/$(related_assembly)">$(pan_gene_member_assembly)</a>&nbsp;
            </td>
          </tr>
        )
      </table>
      <br>
      <p>
        NOTE: <i>chr = 'n/a'</i> means the gene model information is not in the MaizeGDB database, so the 
        chromosome name cannot be found.
      </p>
    )
    
    @(pan-gene-member {display: off}
      <!-- only one related gene model -->
      <br>
      $(pan_gene_member) in gene model set $(pan_gene_member_annotation)
      for assembly <a href="/genome/genome_assembly/$(related_assembly)">$(pan_gene_member_assembly)</a>. 
      Calculated by $(pan_gene_attribution).
      <br>
    )
    
  )
  
  @(browsers_pangenome {display: off}
    @(pan-browsers {display: off}
        @(browser-list
            <iframe style="width: 100%" src="$(browser_link)"></iframe>
            <br><br>
        )
    )
    @(no-pan-browsers {display: off}
     <br>
     <b>No pan-gene set was found for this gene model</b>
    )
  )
  
  @(orthologs_pangenome {display: off}
    @(orthologs {display: off}
      <br>
      <table width="100%">
        <tr align="left">
          <th width="2%" valign="top"></th>
          <th width="17%" valign="top">gene model&nbsp;</th>
          <th width="35%" valign="top">assembly&nbsp;</th>
          <th width="22%" valign="top">source&nbsp;</th>
          <th width="5%" valign="top">species&nbsp;</th>
          <th width="15%" valign="top">ortholog&nbsp;</th>
        </tr>
        @(ortholog_list
          <tr align="left">
            <td></td>
            <td valign="top">
              <a href="/gene_center/gene/$(ortholog_gm)">$(ortholog_gm)</a>
            </td>
            <td valign="top">
              <a href="/genome/genome_assembly/$(ortholog_assembly)">$(ortholog_assembly)</a>
            </td>
            <td valign="top">
              <span class=\"tooltip\">
                $(ortholog_source_short)
                <span class=\"tooltiptext tooltip-right\">$(ortholog_source)</span>
             </span>
            </td>
            <td valign="top">$(ortholog_species)&nbsp;</td>
            <td valign="top">
              <a href="$(ortholog_link)$(ortholog_identifier)">$(ortholog_identifier)</a>
            </td>
          </tr>
        )
      </table>
    )
    
    @(no-pangenome_orthologs {display: off}
      There are no orthlogs for related gene models in this pan-genome.
    )
  )
)
