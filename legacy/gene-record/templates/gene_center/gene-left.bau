<!-- SIMPLE SEARCH -->
    <a name='simple'></a>
    <div id="search_lite_green_background" name="simple_gene_search">
      <p>
        <b>Simple Search</b>: This search form allows you to find gene loci and
        gene models given basic information (locus name, Gene Model ID, Transcript ID, 
        Translation ID, Gene symbol, Gene name\), including partial names.
        <br>
        
        *(simple-search-instructions {load: templates/data_center/simple_search_instructions.bau})
        
      </p>
      <br>
      <form name='n1' method="get" action="/gene_center/gene" class="tiny">
        <input type="hidden" name="dataname" id="dataname" value="gene">
        <input type="text" name="term" id="term" size="20" class="quick_search"
               value=$(gene_term)>
        <span name="button" value="" class="button" 
              onClick="getSearchData('gene', 'simple_results', document.getElementById\('term'\).value\);">Submit</span>
        (see a sample 
        <a href="#" 
           onClick="document.getElementById\('term'\).value='Zm00001eb067740'">gene model query</a>
        or
        <a href="#" 
           onClick="document.getElementById\('term'\).value='lg1'">locus query</a>\)
        @(limits
          <br>
          *(adjust_limits {load: templates/data_center/set_search_limit.bau})
        )
      </form>
      <br>
      <p>
        <b>More Examples:</b>  
        <a href="#" onClick="document.getElementById\('term'\).value='lg1'">lg1</a>,
        <a href="#" onClick="document.getElementById\('term'\).value='liguleless1'">liguleless1</a>,
        <a href="#" onClick="document.getElementById\('term'\).value='Zm00001eb067740'">Zm00001eb067740</a>,
        <a href="#" onClick="document.getElementById\('term'\).value='GRMZM2G036297'">GRMZM2G036297</a>,
        <a href="#" onClick="document.getElementById\('term'\).value='DAA35605'">DAA35605</a>,
        <a href="#" onClick="document.getElementById\('term'\).value='Zm00001d002005_T001'">Zm00001d002005_T001</a>
        <br>
        <b>Wildcards:</b> Compare 
        <a href="#" onClick="document.getElementById\('term'\).value='^lg1'">"starts with lg1"</a>
        to 
        <a href="#" onClick="document.getElementById\('term'\).value='lg1$'">"ends with lg1"</a>
      </p>
      <br>
      <a href="#nomenclature">Why are gene model names so long?</a>
      <br>
      
      <div id='simple_results'></div>
      
    </div><!-- SIMPLE SEARCH -->
    <br>
    
<!-- ADVANCED SEARCH -->
    <a name='advanced'></a>
    <div id="datacenter_gray_background" name="adv_gene_search">
      <table summary="A table within which you can set up your search criteria." 
             border="0" cellpadding="6" cellspacing="4" width="100%">
        <tr>
          <td class="small" valign="TOP" width="100%">
            <p style="margin-bottom: 8px;">
              <span style="font-family: Verdana,Arial,sans-serif; font-size: 120%; font-weight: bold; margin-bottom: 6px;">
                Advanced Search
              </span>
            </p>
            <p>
              Check the boxes next to the fields you want to search; if you 
              just want to find records that have <i>any</i> value for that 
              attribute, check the box and leave the criteria alone.
            </p>
            <br>
            Show only genes:
            <form method="post" 
                  action="javascript:geneAdvSearch('adv_results'\);" 
                  style="margin-bottom:0px;margin-top:0px;padding-bottom:0px;line-height:210%">
                  
              <!-- gene model version -->
              <input name="check" value="true" type="hidden">
              <input id="box_version" name="box_version" value="true" type="checkbox"> 
              <label for="box_version"> </label> from 
              <label for="version">this <b>annotation</b></label>: 
              <select class="small" name="version" id="version"
                      onchange="document.getElementById('box_version'\).checked = true;">
                <option value="all">All annotations</option>
                $(annotation-list)
              </select>
              <br>
              
              <!-- gene model type -->
              <input id="box_type" name="box_type" value="true" type="checkbox"> 
              <label for="box_type"> </label> of 
              <label for="type">this <b>type</b></label>: 
              <select class="small" name="type" id="type"
                      onchange="document.getElementById('box_type'\).checked = true;">
                <option value="all">All types</option>
                $(gm_type_options)
              </select>
              <br>
              
              <!-- Chromosome -->
              <input id="box_chr" name="box_chr" value="true" type="checkbox"> 
              <label for="box_chr"> </label> on 
              <label for="chromosome">this <b>chromosome</b></label>: 
              <select class="small" name="chromosome" id="chromosome"
                      onchange="document.getElementById('box_chr'\).checked = true;">
                <option value="all">All chromosomes</option>
                <option value="Chr1">chromosome 1</option>
                <option value="Chr2">chromosome 2</option>
                <option value="Chr3">chromosome 3</option>
                <option value="Chr4">chromosome 4</option>
                <option value="Chr5">chromosome 5</option>
                <option value="Chr6">chromosome 6</option>
                <option value="Chr7">chromosome 7</option>
                <option value="Chr8">chromosome 8</option>
                <option value="Chr9">chromosome 9</option>
                <option value="Chr10">chromosome 10</option>
                <option value="Unplaced">Unplaced</option>
                <option value="ChrMt">Mitochondrial</option>
                <option value="ChrPt">Plastid</option>
              </select>
              <br>
              
              <!-- Chromosome position -->
              <input id="box_range" name="box_range" value="true" type="checkbox"> 
              <label for="box_range"> </label> between 
              <input type="text" name="range_start" id="range_start" size=8
                     onchange="document.getElementById('box_range'\).checked = true;">
              <label for="range-end">and</label> 
              <input type="text" name="range_end" id="range_end" size=8
                     onchange="document.getElementById('box_range'\).checked = true;">
              <br>

              <!-- With a gene locus -->
              <input id="box_locus_assoc" name="box_locus_assoc" value="true" type="checkbox"> 
              <label for="box_locus_assoc"> associated with a <b>gene locus</b></label>
              <br>
              
              <!-- Gene products -->
              <input id="box_gp" name="box_gp" value="true" type="checkbox"> 
              <label for="box_gp"> </label> that produce 
              <label for="gene_product">this <b>gene product</b></label>: 
              <select class="small" name="gene_product" id="gene_product"
                      onchange="document.getElementById('box_gp'\).checked = true;">
                <option value="all">Any gene product</option>
                $(gene_product-list)
              </select>
              <br>

              <!-- Phenotypes -->         
              <input id="box_pheno" name="box_pheno" value="true" type="checkbox"> 
              <label for="box_pheno"> </label> that <label for="pheno">have this <b>phenotype</b></label>: 
              <select class="small" name="pheno" id="pheno"
                     onchange="document.getElementById('box_pheno'\).checked = true">
                <option value="0">Any phenotype</option>
                $(gene_phenotype-list)
              </select>
              <br>

              <!-- Traits -->         
              <input id="box_trait" name="box_trait" value="true" type="checkbox"> 
              <label for="box_trait"> </label> 
              that <label for="trait">are associated with this <b>trait</b></label>: 
              <select class="small" name="trait" id="trait"
                     onchange="document.getElementById('box_trait'\).checked = true">
                <option value="0">Any trait</option>
                $(gene_trait-list)
              </select>
              <br>
              
              <!-- In tandem array -->
              <input id="box_tandem" name="box_tandem" value="true" type="checkbox"> 
              <label for="box_tandem"> </label> 
              that belong to a tandem array
              <br>

              <!-- Associated with protein -->
              <input id="box_protein" name="box_protein" value="true" type="checkbox"> 
              <label for="box_protein">that is associated with this protein or enzyme 
              (UniProt, PFam, EC\)</label> 
              <input type="text" name="protein" id="protein" size=12
                     onchange="document.getElementById('box_protein'\).checked = true;">
              <br>

              <input class="button" value="Submit" type="button" 
                      onclick="javascript:geneAdvSearch('adv_results'\);">
                      &nbsp;
              <input class="button" value="Clear" type="button" 
                     onclick="javascript:this.form.reset(\);">
              
              @(adv_limits
                *(adv_adjust_limits {load: templates/data_center/set_adv_search_limit.bau})
              )
            </form>
          </td>
        </tr>
      </table>
      
      <div id="adv_results"></div>
    </div><!-- ADVANCED SEARCH -->
    <br>

<!-- BLAST SEARCH -->
    <a name='blast'></a>
    <div id="search_lite_green_background" name="blast">
      <p style="margin-bottom: 8px;">
        <span style="font-family: Verdana, Arial, sans-serif; font-size: 120%; font-weight: bold; margin-bottom: 6px;">
          Search for Gene Models by Sequence
        </span>
      </p>
      <script language="javascript">
        function submit_gm_blast(frm\) {
          var el = document.getElementById('targets[]'\);
          var tgt = el.selectedIndex;
          if (tgt == 0\) {
            alert("You have not selected a target."\);
            return;
          }
          
          el = document.getElementById('sequence'\);
          var seq = el.value;
          if (seq == ''\) {
            alert("You have not entered any sequence."\);
            return;
          }
          
          frm.submit(\);
        }
      </script>
      <form id="blast_form" action="/search/gene/gene_seq_search.php" 
            method="POST">
        Enter up to 5 sequences, Genbank IDs or gene model names 
        (Zmdddddadddddd, ZEAMMB73_xxxx or GRMZMxxxxxx\):
        <a href="#blast"
           onclick="document.getElementById('sequence'\).value='Zm00001d002005'">Sample</a>
        <br>
        <table>
          <tr>
            <td style="white-space:nowrap">
              <input type="radio" name="seq_type" id="seq_type" 
                     class="seq_type" value="nucleotide" checked>
              Nucleotide
            </td>
          </tr>
          <tr>
            <td style="white-space:nowrap">
              <input type="radio" name="seq_type" id="seq_type" 
                     class="seq_type" value="aminoacid"}>
              Amino acid
            </td>
            <td>
            </td>
          </tr>
        </table>
        <select name="targets[]" id="targets[]">
          <option class='target_option' value=''>Select a target dataset</option>
          $(blast-target-options)
        </select>
        <br>
        <textarea name="sequence" id="sequence" rows=8 cols=80></textarea>
        <br>
        <input type="hidden" name="a" id="a" value="START_BLAST">
        <input type="hidden" name="max_evalue" id="max_evalue" value="1e-7">
        <input type="hidden" name="max_hits" id="max_hits" value=100>
        <br>
        <input class="button" value="Submit" type="button" 
               onclick="submit_gm_blast(document.getElementById('blast_form'\)\);">
      </form>
    </div><!-- BLAST SEARCH -->
    <br>

<!-- TRANSLATE -->
    <a name='translate'></a>
    <div id="datacenter_gray_background" name="translate">
      <p style="margin-bottom: 8px;">
        <span style="font-family:Verdana,Arial,sans-serif;font-size:120%;font-weight:bold;margin-bottom:6px;">
          Translate Gene Model IDs - download
        </span>
      </p>
      <form name="translate_form" id="translate_form" method="post" target="_blank"
            action="/search/gene/gene_translate.php" class="tiny">
        <table>
          <tr>
            <td>
              &nbsp;&nbsp;&nbsp;Enter list - 8,000 gene model limit:
              (<a href="javascript:gm_populate_mixed_example('gm_list'\);">Example list</a>\)
              <br>
              &nbsp;&nbsp;&nbsp;
              <textarea rows="10" cols="35" name="gm_list" id="gm_list">Enter gene model list here.</textarea>
            </td>
            <td width=10></td>
            <td>
              Translate to:<br>
              <select name="trans_to" id="trans_to">
                <option value="all">All gene sets</option>
                <option value="B73">All B73 gene sets</option>
                <option value="NAM">All NAM founders</option>
                <option value="genbank_gene">GenBank Gene accessions (Entrez\)</option>
                <option value="genbank_id">GenBank protein accessions (ZEAMMB*\)</option>
                $(assembly-list)
              </select>
              <br><br>
              <input class="button" value="Submit" type="button" 
                      onclick="document.getElementById('translate_form'\).submit(\);">
                      &nbsp;
            </td>
          </tr>
        </table>
      </form> 
      <br>
      Alternatively, <a href="https://download.maizegdb.org/Pan-genes/Pan-Zea">download 
      the full gene model associations table between the B73 assemblies and all other 
      assemblies in our database.</a>
    </div><!-- TRANSLATE -->
    <br>
    
<!-- SEARCH BY REGION -->
    <a name='region'></a>
    <div id="search_lite_green_background" name="blast">
      <p style="margin-bottom: 8px;">
        <span style="font-family:Verdana,Arial,sans-serif;font-size:120%;font-weight:bold;margin-bottom:6px;">
          Download By Region
        </span>
      </p>
      <br>
      <form name='region_form' id="region_form" method="get" target="_blank" 
            action="/search/gene/gene_chr_position.php" class="tiny">
        <table>
          <tr>
            <td colspan=3>
              <input type="radio" name="region" id="assembly_coords"
                     onclick="setRegion(\)">
              <label for="assembly_coords">assembly coordinates</label>
            </td>
          </tr>
          <tr>
            <td width=20> </td>
            <td colspan=2 class="assembly_coords_els">
              <table>
                <tr height="40">
                  <td>
                    Annotation: <br>
                    <select class="small" name="gm_version" id="gm_version">
                      $(annotation-list)
                    </select>
                  </td>
                  <td>
                    Chromosome: <br>
                    <select name="chr" id="chr" class="assembly_coords_els">
                      <option value="chr1">Chromosome 1</option>
                      <option value="chr2">Chromosome 2</option>
                      <option value="chr3">Chromosome 3</option>
                      <option value="chr4">Chromosome 4</option>
                      <option value="chr5">Chromosome 5</option>
                      <option value="chr6">Chromosome 6</option>
                      <option value="chr7">Chromosome 7</option>
                      <option value="chr8">Chromosome 8</option>
                      <option value="chr9">Chromosome 9</option>
                      <option value="chr10">Chromosome 10</option>
                      <option value="UNKNOWN">Unmapped</option>
                      <option value="chrMt">Mitochondria</option>
                      <option value="chrPt">Chloroplast</option>
                      <option value="chrAll">All</option>
                    </select>
                  </td>
                </tr>
                <tr height="40">
                  <td>
                    Model type: <br>
                    <select name="model_type" id="model_type" class="assembly_coords_els">
                      <option value="any">any</option>
                      <option value="protein_coding">Protein Coding</option>
                      <option value="miRNA">miRNA</option>
                      <option value="transposable_element">Transposable Element</option>
                      <option value="low_confidence">Low Confidence</option>
                    </select>
                  </td>
                  <td>
                    Data type: <br>
                    <select name="data_type" id="data_type" class="assembly_coords_els">
                      <option value="all">All Genes/Gene Models</option>
                      <option value="canonical">Canonical Transcripts</option>
                      <option value="genes">Only Gene Models Linked to Genes</option>
                    </select>
                  </td>
                </tr>
                <tr height="40">
                  <td>
                    Start position: <br>
                    <input type="text" name="start_pos" id="start_pos" size=10 class="assembly_coords_els">
                  </td>
                  <td>
                    End position: <br>
                    <input type="text" name="end_pos" id="end_pos" size=10 class="assembly_coords_els">
                  </td>
                </tr>
                <tr>
                  <td colspan=2>(enter positions w/o commas or spaces, or leave both empty for entire chromosome\)</td>
                </tr>
              </table>
            </td>
          </tr>
          
          <tr height=3></tr>
          
          <tr>
            <td colspan=3>
              <input type="radio" name="region" id="marker_pos"
                     onclick="setRegion(\)">
              <label for="marker_pos">marker</label>
            </td>
          </tr>
          <tr>
            <td width=20> </td>
            <td valign="top" class="marker_pos_els">
              <label for="start_marker">Start:</label>
              <input type="text" size=10 name="start_marker" class="marker_pos_els">
              &nbsp;&nbsp;
              <label for="end_marker">End:</label>
              <input type="text" size=10 name="end_marker" class="marker_pos_els">
              <label for="assembly">Assembly:</label>
              <select name="assembly" id="assembly" class="marker_pos_els">
                $(annotation-list)
              </select>
            </td>
            <td width=350 class="marker_pos_els">
              Enter two markers to get gene models within the span. Both must 
              be on the same chromosome. Only applicable for assemblies with 
              aligned markers.
            </td>
          </tr>
          <!-- GM Positions -->
          <tr height=3></tr>
          
          <tr>
            <td colspan=3>
              <input type="radio" name="region" id="gm_pos"
                     onclick="setRegion(\)">
              <label for="gm_pos">Assembly Annotation Positions</label>
            </td>
          </tr>
          <tr>
            <td width=20> </td>
            <td valign="top" class="gm_pos_els">
              <label for="gm_pos_list">
                Enter List - 8,000 gene model limit 
                (<a href="javascript:gm_populate_mixed_example('gm_pos_list'\);">Example list</a>\)
              </label>
              <textarea rows="10" cols="35" name="gm_pos_list" id="gm_pos_list" class="gm_pos_els"></textarea>
             
            </td>
            <td width=350 class="gm_pos_els">
               Enter a list of gene models, transcripts, and/or proteins to retrieve 
               their physical coordinates. 
            </td>
          </tr>
          
          <tr height=5></tr>
        
          <tr>
            <td width=20> </td>
            <td colspan=2>
              <span name="button" value="" class="button" 
                    onClick="chrPosSearch(\)">Submit</span>
            </td>
          </tr>

        </table>
      </form>
    </div><!-- SEARCH BY REGION -->
    
    <script language="javascript">
      setRegion('assembly'\);
    </script>
    
    <br>
  
<!-- SEARCH BY MARKERS OR POSITIONS -->
    <a name='markerpositions'></a>
    <div id="datacenter_lite_blue_background" name="blast">
      <span style="font-family:Verdana,Arial,sans-serif;font-size:120%;font-weight:bold;margin-bottom:6px;">
        Find gene models by position 
      </span>
      <form name='bulk_position_form' id="bulk_position_form" method="POST" target="_blank" 
            action="/search/gene/gene_bulk_position.php" class="tiny">
        Enter one or more lines in comma-separated format with the columns:<br>
        <i>[chromosome]:[start]..[end]</i> Limit the number of positions to 100 or fewer.
        (<a href="#!" onclick="gm_populate_bulk_positions('bulk_positions'\)">Example</a>\)<br>
        <textarea name="bulk_positions" id="bulk_positions" rows=6 cols=60></textarea>
        <br>
        in this assembly
        <select name="bulk_position_assembly" id="bulk_position_assembly">
          <option value=''></option>
          $(position-assembly-list)
        </select>
        <br><br>
        <span name="button" value="" class="button" 
                    onClick="bulkPositionSearch(\)">Submit</span>
      </form>
      <br>
    </div><!-- SEARCH BY MARKERS OR POSITIONS -->
    <br>
    
<!-- DOWNLOAD SEQUENCE -->
    <a name='list'></a>
    <div id="datacenter_gray_background" name="download_gene_list">
      <p style="margin-bottom: 8px;">
      <span style="font-family: Verdana, Arial, sans-serif; font-size: 120%; font-weight: bold; margin-bottom: 6px;">
        Download Sequence for Gene Model List
      </span>
      </p>
      <form name="gm_form" id="gm_form" method="post" class="tiny" 
            action="/search/gene/get_fasta.php" target="_blank">
        When downloading sequence please specify which type of input you are entering.
        For genomic please use the gene model name (e.g. Zm00001eb067740\).    
        For cDNA, CDS, and mRNA please use the transcript ID (e.g. Zm00001eb067740_T001\).
        For protein please use the translation ID (e.g. Zm00001eb067740_P001\). 
        If you enter only the gene model ID, please choose if you want to see
        all transcripts or only the canonical transcripts.<br><br>
        <table>
          <tr>
            <td>
              &nbsp;&nbsp;&nbsp;Enter list - 8,000 gene model limit:
              (<a href="javascript:gm_populate_gm_example('gm_seq_list'\);">Example list</a>\)
              <br>
              &nbsp;&nbsp;&nbsp;
              <textarea rows="10" cols="45" placehold="Enter gene model list here"  
                        name="gm_seq_list" id="gm_seq_list"></textarea>
            </td>
            <td width=2></td>
            <td>
              <table>
                <tr>
                  <td>Input type:</td>
                  <td>
                    <select name="in_type" id="in_type" onChange="updateOptions(\)">
                      <option value="gene">Gene Model ID</option>
                      <option value="transcript">Transcript ID</option>
                      <option value="translation">Translation ID</option>
                    </select>
                  </td>
                </tr>
                <tr>
                  <td>Output type:</td>
                  <td>  
                    <select name="out_type" id="out_type">
                      <option value="genomic">Sequence: genomic</option>
                      <option value="cdna">Sequence: cDNA - all transcripts</option>
                      <option value="cdna-canonical">Sequence: cDNA - canonical transcripts</option>
                      <option value="ncrna">Sequence: ncRNA</option>
                      <option value="protein">Sequence: protein</option>
                    </select>
                  </td>
                </tr>
              </table>
              <br><br>
              <span name="button" value="" class="button" onClick="document.getElementById('gm_form'\).submit(\)">Submit</span>
            </td>
          </tr>
        </table>
      </form>
      <br>
      <div id="sequence-results" style="display:none"></div>
    </div><!-- DOWNLOAD SEQUENCE -->
    <br>

