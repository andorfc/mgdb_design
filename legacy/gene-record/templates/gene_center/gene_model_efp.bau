            </i>
            <br><br>
          )
          
          @(efp_sekhon-atlas-no-browser {display: off}
            <i>No eFP Sekhon et al. atlas view exists for $(gm_id)</i><br>
            <br>
          )
          
          @(efp_sekhon-atlas-browser {display: off}
            <a href="#efp-sekhon-atlas" onclick="javascript:open_sb('$(efp_sekhon-atlas-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="" url="$(efp_sekhon-atlas-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            <a href='$(efp_sekhon-atlas-link)' target='_blank'>See the eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by
            <a href="https://doi.org/10.1111/j.1365-313x.2011.04527.x" target="_blank">Sekhon et al. 2011</a>. The original data set was done on the B73 RefGen_v3 annotation.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
  @(efp_tassel_browser_sec {display: off}
