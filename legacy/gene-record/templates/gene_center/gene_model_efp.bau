            <a href='$(efp_root-link)' target='_blank'>See the eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by
            <a href="https://doi.org/10.1093/jxb/erv453" target="_blank">Opitz et al. 2016</a>, <a href="https://doi.org/10.1093/jxb/erx104" target="_blank">Hey et al. 2017</a>, <a href="https://doi.org/10.1093/jxb/erw422" target="_blank">Tai et al. 2016</a>, and <a href="https://doi.org/10.1186/1471-2164-15-741" target="_blank">Opitz et al. 2014</a>. The original data set was done on the B73 RefGen_v3 annotation.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
  @(efp_sekhon-atlas_browser_sec {display: off}
