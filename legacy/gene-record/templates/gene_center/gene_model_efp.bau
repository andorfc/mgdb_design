$$SYNTAX-LEVEL 2
*(gene_model-eFP-browser-sections
<br>

  @(efp_headers_sec {display: off}
     *(gene-expression-efp-information {load: ../templates/gene_center/gene_expression_efp_information.bau})
        <br><br>
        <label class="select_label">
            <select class="select_header" onchange="toggle_tabs_efp(this.value, 'gbdiv'\)">
                @(efp_menu_opts
                  $(option)
                )
            </select>
        </label>
  )
  @(efp_browser_sec {display: off}
    <div id="efp" class="gbdiv" name="efp" style="display: inline">
      
      <!--<div class="sec_header_green">
        eFP Atlas Browser
      </div>-->
      <!--<table width="100%">
        <tr height='10px'>
          <td width='24%' class='genomebrowser_tab_focus' align="center">
            eFP Atlas Browser<sup>(<a style="cursor: pointer; color: blue;" onclick="javascript:toggleDesc('efp-desc'\)">?</a>\)</sup>
            <br>
          </td>
          @(efp-stress_tab {display: off}
          <td width='24%' class='genomebrowser_tab_unfocus' onclick="toggle_tab('efp-stress', 'gbdiv'\)" align="center">
            eFP Stress Browser
            <br>
          </td>
          )
          @(efp-kernel_tab {display: off}
          <td width='24%' class='genomebrowser_tab_unfocus' onclick="toggle_tab('efp-kernel', 'gbdiv'\)" align="center">
            eFP Kernel Browser
            <br>
          </td>
          )
          @(efp-rna_tab
          <td width='24%' align="center" 
              class='genomebrowser_tab_unfocus' onclick="toggle_tab('rna', 'gbdiv'\)">
            RNA-Seq Expression
            <br>
          </td>
          )
          <td width='4%' style='align: right; width: 20%;'>
            &nbsp;&nbsp;&nbsp;
          </td>
        </tr>
      </table>
      -->
      
      <!-- jp 
      <div width="95%" style='width: 95%; background-color: white;'>
        <div style="position:relative; left:20px;top:5px;  width:95%;">-->
      <div class="sec_green">

          <div id="efp-desc" class="exp_desc" style="display:none;width:550px;font-size:11px;">
            <div style="text-align:right;background-color: gray;">
              <a onclick="javascript:toggleDesc('efp-desc'\)" 
                style='text-decoration:none; cursor: pointer;'>
                <span style='font-size:10;color:white;'>Close X</span>
              </a>
            </div>
            <br>
            *(gene-expression-efp-information2 {load: ../templates/gene_center/gene_expression_efp_information.bau})
          </div>
            
          @(efp-error {display: off}
            <i>
              This gene model was not found in eFP browser. This is likely because
              the gene model is not part of the original atlas data, but if you believe 
              it is please contact MaizeGDB using the feedback button above. 
            </i>
            <br><br>
          )
          
          @(efp-no-browser {display: off}
            <i>No eFP view exists for $(gm_id)</i><br>
            <br>
          )
            
          @(efp-browser {display: off}
            <a href="#efp" onclick="javascript:open_sb('$(efp-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="$(efp-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            See the <a href="$(efp-link)" target="blank">eFP Browser</a>
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by the
            <a href="https://www.ncbi.nlm.nih.gov/pubmed/30537259" target="_blank">Hoopes et al. 2018</a> 
            'Maize Organ-specific and Stress-induced Gene Expression Atlas' and 
            <a href="https://www.ncbi.nlm.nih.gov/pubmed/27898762" target="_blank">Stelpflug et al. 2016</a> 
            'Maize Gene Expression Atlas.' The original data set was done on the Zm-B73-REFERENCE-GRAMENE-4.0 annotation.
            <br><br>
          ) 
          
       <!-- jp </div>
        <br>-->
      </div> 
    </div>
  )
  
  @(efp_stress_browser_sec {display: off}
    <div id="efp-stress" class="gbdiv" name="efp-stress" style="display: none">    
      <!--<label class="select_label">
        <select class="select_header" onchange="toggle_tab(this.value, 'gbdiv'\)">
            <option value="efp-stress">eFP Stress Browser</option>
            <option value="efp">eFP Atlas Browser</option>
            <option value="efp-kernel">eFP Kernel Browser</option>
            <option value="rna">RNA-Seq Expression</option>
        </select>
        </label>-->
      <!--<table width="100%">
        <tr height='10px'>
           <td width='24%' class='genomebrowser_tab_unfocus' onclick="toggle_tab('efp', 'gbdiv'\)" align="center">
            eFP Atlas Browser
            <br>
          </td>
          <td width='24%' class='genomebrowser_tab_focus' align="center">
            eFP Stress Browser(<a style="cursor: pointer; color: blue;" onclick="javascript:toggleDesc('efp_stress-desc'\)">?</a>\)
            <br>
          </td>
          @(efp_stress-kernel_tab {display: off}
          <td width='24%' class='genomebrowser_tab_unfocus' onclick="toggle_tab('efp-kernel', 'gbdiv'\)" align="center">
            eFP Kernel Browser
            <br>
          </td>
          )
          @(efp_stress-rna_tab
          <td width='24%' align="center" 
              class='genomebrowser_tab_unfocus' onclick="toggle_tab('rna', 'gbdiv'\)">
            RNA-Seq Expression
            <br>
          </td>
          )
          <td width='4%' style='align: right;'>
            &nbsp;&nbsp;&nbsp;
          </td>
        </tr>
      </table>-->
      
      <div class="sec_green">
          <div id="efp_stress-desc" class="exp_desc" style="display: none;width: 550px; font-size:11px;">
            <div style="text-align:right;background-color: gray;">
              <a onclick="javascript:toggleDesc('efp_stress-desc'\)" 
                style='text-decoration:none; cursor: pointer;'>
                <span style='font-size:10;color:white;'>Close X</span>
              </a>
           </div>
           <br>
            *(gene-expression-efp-information-stress {load: ../templates/gene_center/gene_expression_efp_information.bau})
          </div>
          <br>
          
          @(efp_stress-error {display: off}
            <i>
              This gene model was not found in eFP stress browser. This is likely because
              the gene model is not part of the original atlas data, but if you believe 
              it is please contact MaizeGDB using the feedback button above. 
            </i>
            <br><br>
          )
          
          @(efp_stress-no-browser {display: off}
            <i>No eFP stress view exists for $(gm_id)</i><br>
            <br>
          )
          
          @(efp_stress-browser {display: off}
            <a href="#efp-stress" onclick="javascript:open_sb('$(efp_stress-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="" url="$(efp_stress-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            See the <a href="$(efp_stress-link)" target="_blank">eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by the
            <a href="https://www.ncbi.nlm.nih.gov/pubmed/30537259" target="_blank">Hoopes et al. 2018</a> 
            'Maize Organ-specific and Stress-induced Gene Expression Atlas' and 
            <a href="https://www.ncbi.nlm.nih.gov/pubmed/27898762" target="_blank">Stelpflug et al. 2016</a> 
            'Maize Gene Expression Atlas',
            and by <a href="https://www.ncbi.nlm.nih.gov/pubmed/25174417" target="_blank">Opitz et al. 2014</a>,
            <a href="https://www.ncbi.nlm.nih.gov/pubmed/25569788" target="_blank">Makarevitch et al. 2015</a>, 
            and <a href="https://www.ncbi.nlm.nih.gov/pubmed/28535078" target="_blank">Swart et al. 2017</a>.
            The original data set was done on the Zm-B73-REFERENCE-GRAMENE-4.0 annotation.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
  @(efp_kernel_browser_sec {display: off}
    <div id="efp-kernel" class="gbdiv" name="efp-kernel" style="display: none">    
      <!--<label class="select_label">
        <select class="select_header" onchange="toggle_tab(this.value, 'gbdiv'\)">
            <option value="efp-kernel">eFP Kernel Browser</option>
            <option value="efp">eFP Atlas Browser</option>
            <option value="efp-stress">eFP Stress Browser</option>
            <option value="rna">RNA-Seq Expression</option>
        </select>
      </label>-->
      <!--<table width="100%">
        <tr height='10px'>
           <td width='24%' class='genomebrowser_tab_unfocus' onclick="toggle_tab('efp', 'gbdiv'\)" align="center">
            eFP Atlas Browser
            <br>
          </td>
          @(efp_kernel-stress_tab {display: off}
          <td width='24%' class='genomebrowser_tab_unfocus' onclick="toggle_tab('efp-stress', 'gbdiv'\)" align="center">
            eFP Stress Browser
            <br>
          </td>
          )
          <td width='24%' class='genomebrowser_tab_focus' align="center">
            eFP Kernel Browser(<a style="cursor: pointer; color: blue;" onclick="javascript:toggleDesc('efp_kernel-desc'\)">?</a>\)
            <br>
          </td>
          @(efp_kernel-rna_tab
          <td width='24%' align="center" 
              class='genomebrowser_tab_unfocus' onclick="toggle_tab('rna', 'gbdiv'\)">
            RNA-Seq Expression
            <br>
          </td>
          )
          <td width='4%' style='align: right;'>
            &nbsp;&nbsp;&nbsp;
          </td>
        </tr>
      </table>-->
      
      <div class="sec_green">
          <div id="efp_kernel-desc" class="exp_desc" style="display:none; width: 550px; font-size:11px;">
            <div style="text-align:right;background-color: gray;">
              <a onclick="javascript:toggleDesc('efp_kernel-desc'\)" 
                style='text-decoration:none; cursor: pointer;'>
                <span style='font-size:10;color:white;'>Close X</span>
              </a>
           </div>
           <br>
           *(gene-expression-efp-information-kernel {load: ../templates/gene_center/gene_expression_efp_information.bau})
          </div>
          <br>
          
          @(efp_kernel-error {display: off}
            <i>
              This gene model was not found in eFP kernel browser. This is likely because
              the gene model is not part of the original atlas data, but if you believe 
              it is please contact MaizeGDB using the feedback button above. 
            </i>
            <br><br>
          )
          
          @(efp_kernel-no-browser {display: off}
            <i>No eFP kernel view exists for $(gm_id)</i><br>
            <br>
          )
          
          @(efp_kernel-browser {display: off}
            <a href="#efp-kernel" onclick="javascript:open_sb('$(efp_kernel-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="" url="$(efp_kernel-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            <a href='$(efp_kernel-link)' target='_blank'>See the eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by
            <a href="https://doi.org/10.1105/tpc.19.00756" target="_blank">Doll et al. 2020</a>.
            The original data set was done on the Zm-B73-REFERENCE-GRAMENE-4.0 annotation.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
   @(efp_seed_browser_sec {display: off}
    <div id="efp-seed" class="gbdiv" name="efp-seed" style="display: none">    
      <div class="sec_green">
          <br>
          @(efp_seed-error {display: off}
            <i>
              This gene model was not found in eFP seed browser. This is likely because
              the gene model is not part of the original atlas data, but if you believe 
              it is please contact MaizeGDB using the feedback button above. 
            </i>
            <br><br>
          )
          
          @(efp_seed-no-browser {display: off}
            <i>No eFP seed view exists for $(gm_id)</i><br>
            <br>
          )
          
          @(efp_seed-browser {display: off}
            <a href="#efp-seed" onclick="javascript:open_sb('$(efp_seed-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="" url="$(efp_seed-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            <a href='$(efp_seed-link)' target='_blank'>See the eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by
            <a href="https://doi.org/10.1105/tpc.18.00961" target="_blank">Yi et al. 2019</a>.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
  @(efp_downs-atlas_browser_sec {display: off}
    <div id="efp-downs-atlas" class="gbdiv" name="efp-downs-atlas" style="display: none">    
      <div class="sec_green">
          <br>
          @(efp_downs-atlas-error {display: off}
            <i>
              This gene model was not found in eFP Downs et al. atlas browser. This is likely because
              the gene model is not part of the original atlas data, but if you believe 
              it is please contact MaizeGDB using the feedback button above. 
            </i>
            <br><br>
          )
          
          @(efp_downs-atlas-no-browser {display: off}
            <i>No eFP downs-atlas view exists for $(gm_id)</i><br>
            <br>
          )
          
          @(efp_downs-atlas-browser {display: off}
            <a href="#efp-downs-atlas" onclick="javascript:open_sb('$(efp_downs-atlas-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="" url="$(efp_downs-atlas-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            <a href='$(efp_downs-atlas-link)' target='_blank'>See the eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by
            <a href="http://dx.doi.org/10.1104/pp.112.213231" target="_blank">Downs et al. 2013</a>. The original data set was done on the B73 RefGen_v3 annotation.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
  @(efp_embryonic_browser_sec {display: off}
    <div id="efp-embryonic" class="gbdiv" name="efp-embryonic" style="display: none">    
      <div class="sec_green">
          <br>
          @(efp_embryonic-error {display: off}
            <i>
              This gene model was not found in eFP embryonic leaf development browser. This is likely because
              the gene model is not part of the original atlas data, but if you believe 
              it is please contact MaizeGDB using the feedback button above. 
            </i>
            <br><br>
          )
          
          @(efp_embryonic-no-browser {display: off}
            <i>No eFP embryonic view exists for $(gm_id)</i><br>
            <br>
          )
          
          @(efp_embryonic-browser {display: off}
            <a href="#efp-embryonic" onclick="javascript:open_sb('$(efp_embryonic-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="" url="$(efp_embryonic-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            <a href='$(efp_embryonic-link)' target='_blank'>See the eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by
            <a href="https://doi.org/10.1073/pnas.2208795119" target="_blank">Liu et al. 2022</a>.
            The original data set was done on the Zm-B73-REFERENCE-GRAMENE-4.0 annotation.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
  @(efp_root_browser_sec {display: off}
    <div id="efp-root" class="gbdiv" name="efp-root" style="display: none">    
      <div class="sec_green">
