        <br>
    </div>
  )
  
  @(efp_leaf_browser_sec {display: off}
    <div id="efp-leaf" class="gbdiv" name="efp-leaf" style="display: none">    
      <div class="sec_green">
          <br>
          @(efp_leaf-error {display: off}
            <i>
              This gene model was not found in eFP leaf browser. This is likely because
              the gene model is not part of the original atlas data, but if you believe 
