            </i>
            <br><br>
          )
          
          @(efp_leaf-no-browser {display: off}
            <i>No eFP leaf view exists for $(gm_id)</i><br>
            <br>
          )
          
          @(efp_leaf-browser {display: off}
            <a href="#efp-leaf" onclick="javascript:open_sb('$(efp_leaf-img_src)', '$(gm_name)'\);" rel="shadowbox">
              <img src="" url="$(efp_leaf-img_src)" width='100%'/>
            </a>
            <br><br>
            <b>Expression: </b>
            <a href='$(efp_leaf-link)' target='_blank'>See the eFP Browser</a> 
            (<a href='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1934936/' 
                target='_blank'>Winter et al. 2007</a>\)
            for tissue-specific expression of <b>$(gm_name)</b> as determined by
            <a href="http://dx.doi.org/10.1038/nbt.3019" target="_blank">Wang et al. 2014</a>. The original data set was done on the B73 RefGen_v3 annotation.
            <br>
          )      
        </div>
        <br>
    </div>
  )
  
  @(rna_seq_sec {display: off}
    <div id="rna" name="rna" class="gbdiv" style='display: $(rna_init_display)'>
      <!--<label class="select_label">
        <select class="select_header" onchange="toggle_tab(this.value, 'gbdiv'\)">
            <option value="rna">RNA-Seq Expression</option>
            <option value="efp">eFP Atlas Browser</option>
            <option value="efp-stress">eFP Stress Browser</option>
            <option value="efp-kernel">eFP Kernel Browser</option>
        </select>
      </label>-->
      <!--<table width="100%">
        <tr height='10px'>
        @(rna_efp_tab
          <td width='24%'  align="center" class='genomebrowser_tab_unfocus'
              onclick="toggle_tab('efp', 'gbdiv'\)">
            eFP Atlas Browser
            <br>
          </td>
        )
          @(rna_efp-stress_tab {display: off}
          <td width='24%'  align="center" class='genomebrowser_tab_unfocus'
              onclick="toggle_tab('efp-stress', 'gbdiv'\)">
            eFP Stress Browser
            <br>
          </td>
          )
          @(rna_efp-kernel_tab {display: off}
          <td width='24%'  align="center" class='genomebrowser_tab_unfocus'
              onclick="toggle_tab('efp-kernel', 'gbdiv'\)">
           eFP Kernel Browser
            <br>
          </td>
          )
          <td width='24%' align="center" 
              class='genomebrowser_tab_focus'>
            RNA-Seq Expression
            <br>
          </td>
          <td width='4%' style='align: right; width: 20%;'>
            &nbsp;&nbsp;&nbsp;
          </td>
        </tr>
      </table>-->
      
      <div class="sec_green">
          @(no-rnaseq-exp-histogram {display: off}
            <br><br>
            <i>No RNA-Seq based expression histogram exists for $(gm_id)</i><br>
            <br>
          )
            
          @(rnaseq-exp-histogram {display: off}
            <a href="#rnaseq" onclick='javascript:open_sb("$(gbrowse_url)/etc/images/$(img_path)", "$(gm_id)"\);'>
             <img src="" url="$(gbrowse_url)/etc/images/$(img_path)" width="95%">
             </a>
            <br>
            <i>Showing the canonical transcript $(hist_id). See the 
             genome browser for the complete list
            </i>
            <br><br>
            @(v3-data_desc {display: off}
              The RNA-seq gene atlas of maize inbred B73 includes 79 distinct replicated samples. 
              This includes 50 samples from the original array-based gene atlas 
              (Sekhon et al. 2011, Plant J 66:553-563\), a time-course of 12 stalk
              and leaf samples post-flowering (Sekhon et al. 2012, Plant Phys. 159:1730-1744\),
              and a novel set of 17 samples from the maize seedling and adult root system. 
              The entire dataset contains 4.6 billion mapped reads, with an average of 20.5
              million mapped reads per biological replicate, allowing for detection of genes
              with lower transcript abundance. For more information see: 
              <a href=\"/data_center/reference?id=9031218\" target=\"_blank\">
                Stelpflug, S.C., R.S. Sekhon, B. Vaillancourt, C.N. Hirsch, C.R. Buell, N. de Leon,
                and S.M. Kaeppler. 2015. An expanded maize gene expression atlas based on RNA-sequencing
                and its use to explore root development. Plant Genome.
              </a>
            )
            @(v4-data_desc {display: off}
              This RNA-seq gene atlas of maize inbred B73 includes 68 distinct samples over 23 tissues with 3 
              biological replicates per tissue (2 replicates in Vegetative Meristem\). The reads were mapped to 
              B73 RefGen_v4 using STAR.  Transcripts were observed from 43,781 genes. The entire dataset contains 
              1.35 billion uniquely mapped reads, with an average of 19.9 million uniquely mapped reads per biological 
              replicate. For more information see: 
              <a href='http://science.sciencemag.org/content/353/6301/814.full' target='_blank'>
                 Walley JW, Sartor RC, Shen Z, Schmitz RJ, Wu KJ, Urich MA, et al. 
                 2016. Integration of omic networks in a developmental atlas of maize. Science.
              </a>
            )
            <br><br>    
          )         
        </div>
        <br>
    </div>
  )   
)