$$SYNTAX-LEVEL 2
*(body
  <script type="text/javascript"> 
    var count = -1;
    function goBack(\)
    { 
      //history.go(count\);
      window.history.go(count\);
      event.preventDefault(\);
      return false;
      
    } 
    function adjust_hist(\)
    {
      count = -2;
    }
  </script>
  
  <table cellpadding=0 cellspacing=0>
    <tr>
      <td>
        <div id="centercolumn_record">
          <div align="right"> 
            <a href="#">Home</a> > <a href="#">Gene Center</a> > <a href="/gene_center/gene/$(page_url)">$(page)</a>
          </div>
          <br>
          <table width='100%'  cellpadding=0 cellspacing=0>
            <tr valign='center' class='green_curve_background'>
              <td align='left'>
                 <img src='/images/header_left.gif'></img>
              </td>
              <td width='97%' valign='center' class='green_curve_background'>
                 Gene Record
              </td>
              <td align='right'>
                 <img src='/images/header_right.gif'></img>
              </td>
            </tr>
          </table>
        </div>
      
        <div id="centercolumn_record">
          <p id="notfound">$(record_type) record not found for $(id1)!</p><br>
          If you were taken here from another link on this website then please 
          <a href="#" class="feedback-form">report
          the issue to our Webmasters</a> and we will have it fixed right 
          away. <br><br>
          
          @(withdrawn-gene-model {display: off}
            <b>This gene model has been withdrawn.</b><br>
            $(withdraw-comment)<br>
            @(replacement {display: off}
              See <a href="/gene_center/gene/$(replacement-gene-model)">$(replacement-gene-model)</a>
            )
            @(no-replacement {display: off}
              There is no replacement.
            )
            <br><br>
          )
          
          @(gene-search-help {display: off}
            If you are searching for a locus, try the 
            <a href="/data_center/locus">locus search</a> instead.
            <br>
            If you are searching
            for a gene model id, it may be deprecated or withdrawn. Check the
            <a href="https://download.maizegdb.org">MaizeGDB data downloads</a> for
            old annotations and cross-reference files.
            <br><br>
          )
          
          <a onclick="javascript:goBack(\);" href="#">Go back to the previous page</a>.
          <br>
          <p><a href="/index.php">Return to the homepage</a>.</p> 
        </div>
        
      </td>
    </tr>
  </table>
)
