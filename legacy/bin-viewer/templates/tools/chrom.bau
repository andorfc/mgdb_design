*(chrom
  <!-- create AJAX to populate sections-->
  <script language="JavaScript">  
    getData("chromosome", "top", $(chrom)\); 
    getData("chromosome", "gb_links", $(chrom)\);
    getData("chromosome", "genes", $(chrom)\);
    getData("chromosome", "other_loci", $(chrom)\);
    getData("chromosome", "hd_maps", $(chrom)\);
    getData("chromosome", "accession", $(chrom)\);

  </script>
)
