$$SYNTAX-LEVEL 2
*(insertions-data_center 
  <div id='centercolumn_record'>
    &nbsp;&nbsp;<a href='#search_insertions' id='link_blue'><img src='../../images/bulletpoint.png' border=0>
      Find insertions
    </a>
    &nbsp;&nbsp;<a href='#search_stocks' id='link_blue'><img src='../../images/bulletpoint.png' border=0>
      Find stocks
    </a>
    <br><br>

    <table width="100%">
      <tr>
        <td valien="top" width="50%">
          <a name="muinsertion"></a>
          <h2>Mu Insertion Datasets</h2>
          <br>
          <div>
            <a name="uniformmu"></a>
            <div>
              <a href="#!" onclick="simple_toggle('uniformmu_description_open','uniformmu_description'\)">
                <h3><b id="uniformmu_description_open">+</b> W22 Uniform Mu insertions</h3>
              </a>
              <div id="uniformmu_description" style="margin-left:20px;display:none">
                <a href="/uniformmu">Project page at MaizeGDB</a>
                <br>
                See track 'UniformMu' in the 'insertions' track section on the 
                <a href="http://curation-tools-dev.maizegdb.org/gbrowse/maize_v3/?l=UniformMU%1EGene_Models">B73v3</a>,
                <a href="https://maizegdb.org/gbrowse/maize_v4/?l=UniformMu%1EGene_Models">B73v4</a>,
                <a href="https://jbrowse.maizegdb.org/?loc=chr1%3A4897501..5413000&tracks=gene_models_official%2Cuniformmu">B73v5</a>,
                and 
                <a href="https://jbrowse.maizegdb.org/?data=W22&loc=chr1%3A127472..316971&tracks=gene_models%2Cuniformmu">W22v2</a>
                genome browsers.
                <br>
                Data can be downloaded from 
                <a href="https://download.maizegdb.org/Insertions/UniformMu/">here</a>
              </div>
            </div> <!-- uniformmu -->
    
            <br><br>
    
            <a name="bonnmu"></a>
            <div>
              <a href="#!" onclick="simple_toggle('bonnmu_description_open','bonnmu_description'\)">
                <h3><b id="bonnmu_description_open">+</b> BonnMu insertions</h3>
              </a>
              <div id="bonnmu_description" style="margin-left:20px;display:none">
                5th release in February, 2024.<br>
                <a href="https://www.inres.uni-bonn.de/cfg/en/c-f-g/research/bonnmu">Project website</a><br> 
                See track 'BonnMu' in the 'insertions' track section on the
                <a href="https://maizegdb.org/gbrowse/maize_v4/?l=BonnMu%1EGene_Models">B73v4</a> and 
                <a href="https://jbrowse.maizegdb.org/?tracks=gene_models_official%2Cbonnmu">B73v5</a>
                Genome browsers.
              </div>
            </div> <!-- bonnmu -->
    
            <br><br>
    
            <a name="mu-illumina"></a>
            <div>
              <a href="#!" onclick="simple_toggle('mu-illumina_description_open','mu-illumina_description'\)">
                <h3><b id="mu-illumina_description_open">+</b> Mu-Illumina insertions (browser track only\)</h3>
              </a>
              <div id="mu-illumina_description" style="margin-left:20px;display:none">
                 Developed by the <a href="http://pml.uoregon.edu/">Barkan lab</a>.
                 <a href="http://teosinte.uoregon.edu/mu-illumina/">Search Mu-illumina insertions</a>
                 See track '<i>Mu Insertions [from the Mu-Illumina Group]</i>' in the 'Insertions' section on the 
                 <a href="http://curation-tools-dev.maizegdb.org/gbrowse/maize_v3/?l=Mu_Illumina%1EGene_Models">B73v3</a>
                 and <a href="http://curation-tools-dev.maizegdb.org/gbrowse/maize_v4/?sl=Mu_Illumina%1EGene_Models">B73v4</a> 
                 genome browsers.
              </div>
            </div> <!-- mu-illumina -->
    
            <br><br>
    
            <a name="chinamu"></a>
            <div>
              <a href="#!" onclick="simple_toggle('chinamu_description_open','chinamu_description'\)">
                <h3><b id="chinamu_description_open">+</b> ChinaMu insertions (not held at MaizeGDB\)</h3>
              </a>
              <div id="chinamu_description" style="margin-left:20px;display:none">
                ChinaMu project page: <a href="http://chinamu.jaas.ac.cn/Default.html">http://chinamu.jaas.ac.cn/Default.html</a>
              </div>
            </div><!-- chinamu -->
        </td>
    
        <td valign="top" width="50%">
          <a name="acdsinsertion"></a>
          <h2>Ac/Ds Insertion Datasets</h2>
          <br>
          <div>
            <a name="doonerdu"></a>
            <div>
              <a href="#!" onclick="simple_toggle('doonerdu_description_open','doonerdu_description'\)">
                <h3><b id="doonerdu_description_open">+</b> Dooner-Du insertions</h3>
              </a>
              <div id="doonerdu_description" style="margin-left:20px;display:none">
                <i>GFP-Ds insertions (Dooner and Du, and verification by the Maize Gametophyte project\)</i>
                <a href="/documentation/dooner_du_acds_insertions">Dooner/Du project page at MaizeGDB</a><br>
                <a href="/documentation/fowler_insertion_validation">Fowler insertion verification project page at MaizeGDB</a><br>
                <a href="http://acdsinsertions.org/">Project website</a><br>
                <a href="/data_center/locus">Search for insertions</a>. Use 'tdsg' to see all insertions.<br>
                See track '<i>Ac/Ds [Dooner]</i>' in the 'insertions' track section on the 
                <a href="https://maizegdb.org/gbrowse/maize_v3/?l=AcDs_Dooner%1EGene_Models">B73v3</a>,
                <a href="https://jbrowse.maizegdb.org/?tracks=doonerDs">B73v5</a>, and
                <a href="https://jbrowse.maizegdb.org/?tracks=gene_models%2CdoonerDs">W22v2</a> 
                Genome browsers.<br>
                Data can be downloaded from 
                <a href="https://download.maizegdb.org/Insertions/AcDs_Dooner/">here</a><br>
              </div>
            </div> <!-- doonerdu -->

            <br><br>
        
            <a name="volbrecht"></a>
            <div>
              <a href="#!" onclick="simple_toggle('volbrecht_description_open','volbrecht_description'\)">
                <h3><b id="volbrecht_description_open">+</b> Ac/Ds (Volbrecht\)</h3>
              </a>
              <div id="volbrecht_description" style="margin-left:20px;display:none">
                Publication: <a href="https://doi.org/10.1105/tpc.109.073452">(Vollbrecht et al 2010 Plant Cell\)</a><br>
                See track 'Ac/Ds [Volbrecht]' in the 'insertions' track section on the 
                <a href="https://maizegdb.org/gbrowse/maize_v3/?l=AcDs%1EGene_Models">B73v3</a>,
                <a href="https://jbrowse.maizegdb.org/?loc=chr1%3A1..10310000&tracks=gene_models_official%2Cacds">B73v5</a>,
                and 
                <a href="https://jbrowse.maizegdb.org/?data=W22&loc=chr1%3A4220765..6340764&tracks=gene_models%2Cds_flanks">W22v2</a>
                Genome browsers.<br>
                Data can be downloaded from 
                <a href="https://download.maizegdb.org/Insertions/AcDs_Vollbrecht/">here</a><br>
              </div>
              </div><!-- volbrecht -->
          </div><!--As/Ds insertions-->
        </td>
      </tr>
    </table>
    
    <br><br>
  
    <a name="search_insertions"></a>
    <h2>Find insertions</h2>
    <br>
    <div id="datacenter_lite_blue_background">
      <b>By gene models</b><br>
      Note that a specific insertion datsset may not be aligned to all versions of the B73 gene models.<br> 
      <form id="by_gene_model_form">
        <table>
          <tr>
            <td>
              <b>Enter up to 50 B73 gene models</b><br>
              <textarea id="by_gene_model_list" rows=10 cols=40></textarea>
              <br>
              <a href="#!" onclick="showGeneModelExample(\)">Example</a>
            </td>
            <td width="10px"></td>
            <td valign="middle">
              <table height="100%">
                <tr>
                  <td valign="bottom"><b>Insertion dataset</b></td>
                  <td width="10px"></td>
                  <td valign="bottom"><b>Background</b></td>
                  <td width="10px"></td>
                  <td valign="bottom"><b>Structure</b></td>
                  <td width="10px"></td>
                </tr>
                <tr>
                  <td valign="top">
                    <select id="by_gene_model_datasets" onchange="setBackgrounds('by_gene_model'\)">
                      <option value='all'>All</option>
                      <option value='UniformMu'>UniformMu</option>
                      <option value='BonnMu'>BonnMu</option>
                      <option value='Dooner-Du Ac/Ds'>Dooner-Du Ac/Ds</option>
                      <option value='Volbrecht Ac/Ds'>Volbrecht Ac/Ds</option>
                    </select>
                  </td>
                  <td width="10px"></td>
                  <td valign="top">
                    <select id="by_gene_model_backgrounds">
                      <option value='any'>Any</option>
                    </select>
                  </td>
                  <td width="10px"></td>
                  <td valign="top">
                    <select id="by_gene_model_structure">
                      <option value='any'>Any</option>
                      <option value="3'UTR">3'UTR</option>
                      <option value="5'UTR">5'UTR</option>
                      <option value="core promoter">core promoter</option>
                      <option value="Exon">Exon</option>
                      <option value="Flanking region">Flanking region</option>
                      <option value="intron">intron</option>
                      <option value="proximal promoter">proximal promoter</option>
                      <option value="putative close downstream enhancer">putative close downstream enhancer</option>
                      <option value="UTR">UTR</option>
                    </select>
                    <br>
                    (Some datasets may not be aligned<br>to specific structures\)
                  </td>
                  <td width="10px"></td>
                  <td valign="top">
                    <input type="button" value="Find" onclick="doInsertionSearch('by_gene_model'\)">
                    <input type="button" value="Clear" onclick="clearSearch('by_gene_model'\)">
                  </td>
                </tr>
              </table> 
            </tr>
        </table>
      </form>
      <div id="by_gene_model_results"></div>
      
      <br><br>
  
      <b>By position and genome</b><br>
      <form id="by_position_form">
        <table>
          <tr>
            <td valign="bottom">Select an insertion dataset</td>
            <td width="10px"></td>
            <td valign="bottom">Select a background</td>
            <td width="10px"></td>
            <td valign="bottom">Assembly</td>
            <td width="10px"></td>
            <td valign="bottom">Chromosome</td>
            <td width="10px"></td>
            <td></td>
          </tr>
          <tr>
            <td valign="top">
              <select id="by_position_datasets" onchange="setBackgrounds('by_position'\)">
                <option value=''>All</option>
                <option value='UniformMu'>UniformMu</option>
<!--                <option value='Mu-illumina'>Mu-Illumina</option> -->
                <option value='BonnMu'>BonnMu</option>
                <option value='Dooner-Du Ac/Ds'>Dooner-Du Ac/Ds</option>
                <option value='Volbrecht Ac/Ds'>Volbrecht Ac/Ds</option>
              </select>
            </td>
            <td width="10px"></td>
            <td valign="top">
              <select id="by_position_backgrounds">
                <option value=''>Any</option>
              </select>
            </td>
            <td width="10px"></td>
            <td valign="top">
              <select id="by_position_assembly">
                <option value=''>Any</option>
                @(by_position_assemblies
                <option value='$(assembly_version)'>$(assembly_version)</option>
                )
              </select>
            </td>
            <td width="10px"></td>
            <td valign="top">
              <select id="by_position_chromosome">
                <option>chr1</option>
                <option>chr2</option>
                <option>chr3</option>
                <option>chr4</option>
                <option>chr5</option>
                <option>chr6</option>
                <option>chr7</option>
                <option>chr8</option>
                <option>chr9</option>
                <option>chr10</option>
              </select>
            </td>
            <td width="10px"></td>
            <td valign="top">
              Between <input id="by_position_start" type="text" size=7> 
              and <input id="by_position_end" type="text" size=7>
            </td>
            <td width="10px"></td>
            <td>
              <input type="button" value="Find" onclick="doInsertionSearch('by_position'\)">
              <input type="button" value="Clear" onclick="clearSearch('by_position'\)">
            </td>
          </tr>
        </table>
      </form>
      <br><br>
      <div id="by_position_results"></div>
    </div><!-- search_insertions -->
    
    <br><br>
    
    <a name="search_stocks"></a>
    <h2>Find stocks</h2>
    <br>
    <div id="datacenter_lite_gray_background">
      <b>By insertion</b><br>
      <form id="by_insertion_form">
        <table>
          <tr>
            <td>
              Enter up to 100 insertion identifiers<br>
              <textarea id="by_insertion_list" rows=10 cols=40></textarea><br>
              <a href="#!" onclick="showInsertionExample(\)">Example</a>
            </td>
            <td width="10px"></td>
            <td>
              <input type="button" value="Find" onclick="doInsertionSearch('by_insertion'\)">
              <input type="button" value="Clear" onclick="clearSearch('by_insertion'\)">
            </td>
          </tr>
        </table>
      </form>
      <div id="by_insertion_results"></div>
    </div><!-- search_stocks -->
  </div>
)