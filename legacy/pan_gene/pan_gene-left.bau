<!-- INFORMATION -->
    <a name='information'></a>
    <div id="pan_gene_gray_background">
      <span class="section_title">About pan-gene data at MaizeGDB</span>
      <br>
<!--
      The results of two pan-gene analyses and two gene family analyses are presented 
      at MaizeGDB: pan-Zea mays, pan-B73, Zea gene families, and grass gene families. 
      All four were generated using the "pan" and "fam" pipelines from 
-->
      The Zea mays pan-gene analysis was generated by MaizeGDB staff, using the 
      <a href="https://github.com/legumeinfo/pandagma">Pandagma</a> pipeline.
       Details of each analysis are presented on separate tabs on the pan-gene record pages.
      <br><br>
<!--
      Note that pan-gene and gene family analyses carried out by different software
      are likely to produce different results.
-->
      Note that pan-gene analyses generated out by different software is
      likely to produce different results.
      <br><br>
      
      <script src="/js/lib/plotly/plotly-2.25.2.min.js" charset="utf-8"></script>
      <div id="pan_zea_dist" class="wrap-collabsible">
        <input id="pan-zea-distribution_checkbox" class="inner_toggle_checkbox" type="checkbox"
               onclick="simpleToggle('pan-zea-distribution_div'\)">
        <label for="pan-zea-distribution_checkbox" class="simple_inner_lbl-toggle">Pan-gene 
        distribution for the Pan-Zea mays analysis</label>
        
        <div id="pan-zea-distribution_div" class="collapsible-content">
          Number of annotations represented in analysis: $(annot-count).
          Table is cut off at pan genes of size $(cutoff).
          <br><br>
          <div id="pan-gene_dist" style="width:900px;height:350px;"></div>
          <script language="javascript">
            let points = [
              @(pan-zea-distribution-histo
                [$(pan_gene_size),$(member_count)],
              )
            ];
            data = [
              {
                x: points.map(x => x[0]\),
                y: points.map(y => y[1]\),
                type: 'bar'
              }
            ];
            let layout = {
              margin: {l:50, r:0, t:0, b:50},
              showaxeslabels: true,
              xaxis: {
                title: {text: "Size"},
                margin: {l:0, r:0, t:0, b:0},
                dtick: 10,
              }, 
              yaxis: {
                title: {text: "pan-gene count"}
              },
            };

            let config = {
              displayModeBar: false,
              //frameMargins: 0,
              //margin: {l:0, r:0, t:0, b:0},
            }
            Plotly.newPlot('pan-gene_dist', data, layout, config\);
          </script>
        </div>
      </div> <!-- pan-zea mays-distribution -->
      <br>
      <div id="pan_zea_annotations" class="wrap-collabsible">
        <input id="pan-zea-annotations_checkbox" class="inner_toggle_checkbox" type="checkbox"
               onclick="simpleToggle('pan-zea-annotations_div'\)">
        <label for="pan-zea-annotations_checkbox" class="simple_inner_lbl-toggle">Annotations
        included in the Pan-Zea analysis</label>
        
        <div id="pan-zea-annotations_div" class="collapsible-content">
          Number of annotations: $(annot-count)<br>
          <table>
            <tr>
              <th align="left">Assembly</th>
              <th align="left">Annotation</th>
              <td></td>
              <th align="left">Gene model count&nbsp;</th>
              <td></td>
              <th align="left">Min length&nbsp;</th>
              <td></td>
              <th align="left">Max length&nbsp;</th>
              <td></td>
              <th align="left">Ave length&nbsp;</th>
              <td></td>
              <th align="left">% placed in pan-genes</th>
            </tr>
            @(annotation-rows
              <!-- $(analysis) -->
              <tr class="$(color_class)">
                <td align="left"><a href="/genome/assembly/$(assembly)">$(assembly)</a></td>
                <td align="left">&nbsp;$(annotation)</td>
                <td></td>
                <td align="center">$(gene_model_count)</td>
                <td></td>
                <td align="center">$(min_gene_model_length)</td>
                <td></td>
                <td align="center">$(max_gene_model_length)</td>
                <td></td>
                <td align="center">$(ave_gene_model_length)</td>
                <td></td>
                <td align="center">$(perc_gene_models_placed)</td>
              </tr>
            )
          </table>
        </div>
      </div><!-- analysis members -->

      <br><br>
      
