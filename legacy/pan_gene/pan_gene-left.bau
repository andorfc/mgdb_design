    <br>


<!-- INTRO TO PAN-GENE -->
    <div id="pan_gene_info_background" name="pan_gene_info">
      <span class="section_title">Introduction</span><br> 
      <p>
        The pan-gene and gene family datasets presented in this data center were 
        calculated by MaizeGDB staff. Details about the analyses are in the information 
        section below and in each pan-gene record page.
        <br><br>
        Note that different pan-gene and gene family analyses will produce difference 
        results, and that the accuracy of the results are impacted by assembly and
        annotation quality.
        <br><br>
        <b>We welcome comments, error reports, and suggestions. Please use the 
        <a class="feedback-form" href="#!">feedback form</a>.</b>
        <br><br>
      </p>
    </div>
    
<!-- SIMPLE SEARCH -->
    <a name='simple'></a>
    <div id="pan_gene_light_green_background" name="simple_pan_gene_search">
      <p>
        <span class="section_title">Simple Search</span><br> 
        This search form allows you to find pan-genes by locus symbol, gene model ID,
        transcript ID, or protein ID.
      </p>
      <br>
      <form name='n1' method="get" action="/pan_gene_center/pan_gene" class="tiny">
        <input type="hidden" name="dataname" id="dataname" value="gene">
        <input type="text" name="term" id="term" size="20" class="quick_search"
               value=$(pan_gene_term)>
        <span name="button" value="" class="button" 
              onClick="getSearchData('pan_gene', 'simple_results', document.getElementById\('term'\).value\);">Submit</span>
        (see example <a href="#" 
           onClick="document.getElementById('term'\).value='Zm00001eb067740'">gene model query</a>
        or <a href="#" 
           onClick="document.getElementById('term'\).value='lg1'">locus query</a>\)
<!-- something is requiring this ... what?
        @(limits
          <br>
          *(adjust_limits {load: templates/data_center/set_search_limit.bau})
        )
-->
      </form>
      <br>
      
      <div id='simple_results'></div>
      
    </div>
    <br>
    
<!-- ADVANCED SEARCH -->
    <a name='advanced'></a>
    <div id="pan_gene_gray_background" name="adv_pan_gene_search">
      <form id="pan_gene-adv_search_form">
        <table summary="A table within which you can set up your search criteria." 
               border="0" cellpadding="6" cellspacing="4" width="100%">
          <tr>
            <td class="small" valign="TOP" width="100%" colspan=2>
              <p style="margin-bottom: 8px;">
                <span class="section_title">Advanced Search</span>
                <br>
                Check the boxes next to the fields you want to search; if you 
                just want to find records that have <i>any</i> value for that 
                attribute, check the box and leave the criteria alone.
              </p>
              <br>
              Search for pan-genes:<br>
            </td>
          </tr>
          <tr>
            <td><input id="box_analysis" type="checkbox"></td>
            <td>
              in the pan-gene analysis 
              <select id="analysis">
                <option value="">Any</option>
                $(analysis_ops)
              </select>
            </td>
          </tr>
          <tr>
            <td><input id="box_gene_models" type="checkbox"></td> 
            <td>
              that contain the gene model(s\) 
              <input id="gene_models" type="text" size=60 onchange="\$('#box_gene_models'\).prop('checked', true\)">
            </td>
          </tr>
          <tr>
            <td><input id="box_locus" type="checkbox"></td>
            <td>that are associated with a gene locus</td>
          </tr>
          <tr>
            <td><input id="box_protein" type="checkbox"></td>
            <td>
              that are associated with protein(s\)
              <input id="proteins" type="text" size=60 onchange="\$('#box_protein'\).prop('checked', true\)">
            </td>
          </tr>
          <tr>
            <td><input id="box_trait" type="checkbox"></td>
            <td>that are associated with a trait</td>
          </tr>
          <tr>
            <td><input id="box_min" type="checkbox"></td> 
            <td>
              that have at least 
              <input id="min" type="text" size=4 onchange="\$('#box_min'\).prop('checked', true\)"> 
              members
            </td>
          </tr>
          <tr>
            <td><input id="box_max" type="checkbox"></td>
            <td>
              that have fewer than 
              <input id="max" type="text" size=4 onchange="\$('#box_max'\).prop('checked', true\)"> 
              members
            </td>
          </tr>
          <tr>
            <td><input id="box_min_annots" type="checkbox"></td>
            <td>
              that have members in at least 
              <input id="min_annots" type="text" size=4 maxlength=3 
                     onchange="\$('#box_min_annots'\).prop('checked', true\);verifyPercent(this\)"> 
              % of annotations
            </td>
          </tr>
          <tr>
            <td><input id="box_max_annots" type="checkbox"></td>
            <td>
              that have members in no more than 
              <input id="max_annots" type="text" size=4 maxlength=3
                     onchange="\$('#box_max_annots'\).prop('checked', true\);verifyPercent(this\)""> 
              % of annotations
            </td>
          </tr>
<!-- no data to support these
          <tr>
            <td valign="top"><input id="box_classes" type="checkbox"></td>
            <td>
              <span style="vertical-align:top">that only appear in the class(s\)</span>
              <select id="classes" multiple onchange="\$('#box_classes'\).prop('checked', true\)">
                <option value="tropical">tropical</option>
                <option value="temporate">temporate</option>
                <option value="stiff-stock">stiff-stock</option>
                <option value="non stiff-stock">non stiff-stock</option>
                <option value="sweet corn">sweet corn</option>
                <option value="popcorn">popcorn</option>
              </select>
            </td>
          </tr>
          <tr>
            <td valign="top"><input id="box_not_classes" type="checkbox"></td>
            <td valign="top">
              <span style="vertical-align:top">that do not appear in class(s\)</span>
              <select id="not_classes" multiple onchange="\$('#box_not_classes'\).prop('checked', true\)">
                <option value="tropical">tropical</option>
                <option value="temporate">temporate</option>
                <option value="stiff-stock">stiff-stock</option>
                <option value="non stiff-stock">non stiff-stock</option>
                <option value="sweet corn">sweet corn</option>
                <option value="popcorn">popcorn</option>
              </select>
            </td>
          </tr>
-->
          <tr>
            <td valign="top"><input id="box_appear" type="checkbox"></td>
            <td valign="top">
              <span style="vertical-align:top">that contain members from annotations for ALL of these assemblies</span><br>
              <select id="appear" multiple size=8 onchange="\$('#box_appear'\).prop('checked', true\)">
                $(assembly_ops)
              </select>
            </td>
          </tr>
          <tr>
            <td valign="top"><input id="box_not_appear" type="checkbox"></td>
            <td valign="top">
              <span style="vertical-align:top">that do not contain members from annotations for any of these assemblies</span><br>
              <select id="not_appear" multiple size=8 onchange="\$('#box_not_appear'\).prop('checked', true\)">
                $(assembly_ops)
              </select>
            </td>
          </tr>
          <tr><td style="margin-top:5x"></td></tr>
          <tr>
            <td colspan=2>
              <span name="button" class="button" 
                    onclick="panGeneAdvSearch('adv_results'\)">Submit</span>
              <span name="button" class="button" 
                    onclick="clearAdvSearchForm(\)">Clear</span>
            </td>
          </tr>
        </table>
        @(adv_limits
          *(adv_adjust_limits {load: templates/data_center/set_adv_search_limit.bau})
        )
      </form>
      <br>
      
      <div id="adv_results"></div>

    </div> <!-- advanced search -->
    <br>

<!-- DOWNLOADS -->
    <a name='gm_downloads'></a>
    <div id="pan_gene_light_green_background" name="pan_gene_downloads">
      <span class="section_title">Downloads</span>
      <br>
      <a href="https://download.maizegdb.org/Pan-genes/Pan-Zea/">All bulk pan-zea downloads</a><br>
<!--     
      <a href="">All pan-B73 downloads</a><br>
      <a href="">All grass gene family downloads</a><br>
      See the README in each directory for file descriptions
-->
      <br><br>
      <b>Download pan-gene exemplar sequence</b> 
      <form id="pan_gene-download_exemplar_sequence" method="POST" target="_blank"
            action="/search/pan_gene/pan_gene_exemplar_seq.php">
        <table>
          <tr>
            <td colspan=3>
              Enter up to <b>$(pan_gene-download_exemplar_limit)</b>
              gene models. Sequence for the exemplar gene models for
              the pan-genes these belong to will be downloaded.
              <br>
              <a href="#!" onclick="setDownloadExample('pan_gene-download_list'\)">Example dataset</a>
            </td>
          </tr>
          <tr>
            <td width="120px">
              <textarea id="pan_gene-download_list" name="pan_gene-download_list"
                        cols=40 rows=6></textarea>
              Sequence type: 
              <input type="radio" id="exmplar_download_seq" name="exmplar_download_seq"
                     value="CDS" checked=true> CDS
              <input type="radio" id="exmplar_download_seq" name="exmplar_download_seq"
                     value="protein"> protein
            </td>
            <td width=5px></td>
            <td valign="center" width="100%">
              in the pan-gene analysis 
              <select id="exmplar_download_analysis" name="exmplar_download_analysis">
                <option>Pan-Zea</option>
<!--                <option>Pan-B73</option>
                <option>Pan-Grass</option> -->
              </select>
            </td>
          </tr>
          <tr height="2px"></tr>
          <tr>
            <td>
              Note that one gene model from each pan-gene is selected as the exemplar
              for that pan-gene, rather than calculating a consensus gene model.
            </td>
            <td></td>
            <td></td>
          </tr>
        </table>
        <br>
        <span name="button" class="button" 
              onclick="document.getElementById('pan_gene-download_exemplar_sequence'\).submit(\)">Submit</span>
        <br><br>
      </form>
<!-- -->
    </div> <!-- downloads -->
