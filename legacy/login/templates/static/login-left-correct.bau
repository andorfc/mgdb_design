$$SYNTAX-LEVEL 2
*(login-left-correct
<div id='login_left_col'>
	<p>
		<b>Annotation Login</b>:<br>

		<div id='login_gray_background'>
			$(login_name), you are logged in!
			<br><br>
			$(login_status)
			<br>
			You can log out with the link at the top right corner of the page
			<br>
		</div>
		<br>

<!--
		<div align="center">
			<form method="post" action="\logout">
				<input type="submit" value="Log-out">
			</form>
		</div>
		<br><br>
-->
    @(register {display: off}
      <b>Create An Annotation Account</b>
      <br>
      <form method="post" action="create_account" class="tiny">
        <table>
          <tr>
            <td>
              <div id='login_green_background'>
                <p>
                  Fill out the information below to create an MaizeGDB annotation 
                  account. With this account, you can annotate the records presented 
                  here. <b>All fields are required.</b> After you fill out this form  
                  and click on the "Submit" button, an email will be sent to the email 
                  address you provided. In that email will be a link; simply click on 
                  the link in the email \(or paste that link into your web browser\)  
                  and your account will be activated.
                </p>
                <br>
                <input type="hidden" name="create" value="1">
                  <table cellpadding=1 cellspacing=1>
                    <tr>
                      <td>
                        <label for="un"><b>Username</b>:</label>
                      </td>
                      <td>
                        <input onLoad="setFocus\(document.getElementById\('un'\)\);" 
                          type="text" class="small" name="username" id="un" 
                        size="10" maxlength="10">
                      </td>
                      <td style="padding-left:10px">
                        <i>The <b>username</b> is the name you will use to log on so  
                        that you can annotate.</i>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <label for="pw"><b>Password</b>:</label>
                      </td>
                      <td>
                        <input type="password" name="password" class="small" id="pw" size="10" maxlength="50">
                      </td>
                      <td style="padding-left:10px">
                        <i>The <b>password</b> is used to identify you, along with your username, when you log in.</i>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <label for="pw2"><b>Re-Type Password</b>:</label>
                      </td>
                      <td colspan=2>
                        <input type="password" name="password2" class="small" id="pw2" size="10" maxlength="50">
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <label for="pr"><b>Password Reminder</b>:</label>
                      </td>
                      <td>
                        <input type="text" name="password_reminder" id="pr" class="small" size="30" maxlength="100">
                      </td>
                      <td style="padding-left:10px">
                        <i>A <b>password reminder</b> will be emailed to you if you forget your password, to help you remember.</i>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <label for="fn"><b>First Name</b>:</label>
                      </td>
                      <td colspan=2>
                        <input type="text" name="first_name" id="fn" class="small" size="20" maxlength="40">
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <label for="ln"><b>Last Name</b>:</label>
                      </td>
                      <td colspan=2>
                        <input type="text" name="last_name" id="ln" class="small" size="20" maxlength="40">
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <label for="em"><b>Email Address</b>:</label>
                      </td>
                      <td>
                        <input type="text" name="email" id="em" class="small" size="30" maxlength="100">
                      </td>
                      <td style="padding-left:10px">
                        <i>Remember, your <b>email address</b> must be a correct address, or else you won't be able to create an account!</i>
                      </td>
                    </tr>
                    <tr>
                      <td colspan=3><input type="checkbox" name="curator" value="Y"> 
                        <label for="cur">
                          I am interested in being a MaizeGDB curator.
                        </label>
                      </td>
                    </tr>
                  </table>
                </div>
              </td>
            </tr>
        </table>
        <br>
        <input type="image" src='../../images/submit_button.png' class="small" value="Submit" style='display: block; width: 141px; height: 27px;margin: 0px auto;'>
      </form>
    )
	</p>
</div>
)
