 <script language="javascript">
  \$("#menu_bar", document\).removeClass("menu"\);
  \$("#menu_bar", document\).removeClass("menu_green"\);
  \$("#menu_bar", document\).addClass("menu_gbrowse"\);
  \$("#menu_bar", document\).addClass("menu_green_gbrowse"\);
  document.getElementById("wrapper"\).setAttribute("style", "width:1600px"\); //2000    
  document.getElementById("logo"\).setAttribute("style", "width:1324px"\); //1724
  document.getElementById("centercolumn_record"\).setAttribute("style", "width:1300px"\);
  document.getElementById("whitecurve"\).setAttribute("style", "width:1320px"\);
  document.getElementById("content"\).setAttribute("style", "width:1300px"\);
  document.getElementById("content_top"\).src = "/images/content_top_gbrowse.png";
  document.getElementById("content_top"\).setAttribute("style", "width:1320px"\);
  document.getElementById("menu_bar"\).setAttribute("style", "width:86.5%"\);
  window.onload=function(\) {
   //need to wait for these sections to load before changing them
   \$("#footer_menu", document\).removeClass("menu"\);
   \$("#footer_menu", document\).removeClass("menu_green"\);
   \$("#footer_menu", document\).addClass("menu_gbrowse"\);
   \$("#footer_menu", document\).addClass("menu_green_gbrowse"\);
   document.getElementById("content_bottom"\).setAttribute("style", "width:1320px"\);
   document.getElementById("footer"\).setAttribute("style", "width:1320px"\);
   document.getElementById("content_bottom"\).src = "/images/content_bottom_gbrowse.png";
 }
 
 </script>
