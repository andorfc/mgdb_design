$$SYNTAX-LEVEL 2
*(genome_search
 <table cellpadding=0 cellspacing=0>
    <tr>
      <td>
        <div id="centercolumn_record">
          <table cellspacing=0 cellpadding=0>
            <tr>
              <td align="left" class="nowrap"> 
                <div style="width: 100%; overflow: hidden;">
                  <div style="width: 180px; float: left;">
                    <form action="javascript:popUpAnnotation('genome_issueform', '/curation/GenomeIssue/edit'\);" 
                          method="post" id="genome_issueform">
                      <input type="hidden" id="gene_model_id" value="">
                      <input type="hidden" id="gene_model_version" value="">
                      <input type="hidden" id="auto_num" name="auto_num" value="">
                      <a onclick="genome_issueform.submit(\)" 
                         style="color: crimson; text-decoration: underline; font-weight:bold;" href="#" >
                         Report an assembly error</a>
                    </form>
                  </div>
                  <div style="margin-left: 180px;">
                    <form action="javascript:popUpAnnotation('gene_issueform', '/curation/GenomeIssue/edit'\);" 
                           method="post" id="gene_issueform">
                      <input type="hidden" id="gene_model_id" value="Zm00001d002005">
                      <input type="hidden" id="gene_model_version" value="Zm00001d.2">
                      <input type="hidden" id="auto_num" name="auto_num" value="">
                      <a onclick="gene_issueform.submit(\)" 
                         style="color: crimson; text-decoration: underline; font-weight:bold;" href="#" >
                         Report a gene model error</a>
                    </form>
                  </div>
                </div>                  
              </td>
              <td align="right" width = "100%"> 
                <a href="/index.php"> Home</a> > 
                <a href="/genome/">Genome</a> > 
              </td>
            </tr>
          </table>
          <br>
          <table width=100% cellpadding=0 cellspacing=0>
            <tr valign='center' class='green_curve_background'>
              <td align='left'>
                <img src='/images/header_left.gif'>
              </td>
              <td width='97%' valign='center' class='green_curve_background'>
                Genome data in MaizeGDB			
              </td>
              <td align='right'>
                <img src='/images/header_right.gif'>
              </td>
            </tr>
          </table>	 
        </div>
  
  *(datacenter-left {load: templates/genome/genome-left.bau})
  *(datacenter-right {load: templates/genome/genome-right.bau})
  
      </td>
    </tr>
  </table>
)
