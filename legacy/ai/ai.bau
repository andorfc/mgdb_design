</table>

<script>
    // JavaScript code for the carousel
    const images = document.querySelectorAll('.carousel-image'\);
    const descriptionContainer = document.querySelector('.description-container'\);

    let currentIndex = 0;

    function showImage(index\) {
        images.forEach((image, i\) => {
            if (i === index\) {
                image.style.display = 'block';
            } else {
                image.style.display = 'none';
            }
        }\);
    }

    function showDescription(index\) {
        const descriptions = [
        'PanEffect Tool - Variant Effects in B73: This view provides a visualization of the variant effects of all possible amino acid substitutions in the B73 maize line.',
        'PanEffect Tool - Variant Effects in the pan-genome: This view shows the effects of naturally occurring variations on maize proteins from across the pan-genome',
        'FoldSeek Search Part #1: The FoldSeek Search tool provides an overview of the predicted protein structures for each maize gene model and protein search results against 8 proteomes.',
        'FoldSeek Search Part #2: The FoldSeek Search tool provides an overview of the predicted protein structures for each maize gene modeland protein search results against 8 proteomes.',
        'FATCAT Comparisions: The FATCAT tool compares the protein structures of ortholog predictions from three tools (DIAMOND, FoldSeek, FATCAT\).',
        'Maize Feature Store: The Maize Feature Stores lets a user explore thousands of gene features and perform exploratory analysis.',
        ];
        descriptionContainer.textContent = descriptions[index];
    }

    function nextImage(\) {
        currentIndex = (currentIndex + 1\) % images.length;
        showImage(currentIndex\);
        showDescription(currentIndex\);
    }

    function prevImage(\) {
        currentIndex = (currentIndex - 1 + images.length\) % images.length;
        showImage(currentIndex\);
        showDescription(currentIndex\);
    }

    // Initial display
    showImage(currentIndex\);
    showDescription(currentIndex\);
</script>
)
