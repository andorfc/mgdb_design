$$SYNTAX-LEVEL 2
*(blast_form
;; The BLAST form, rebuilt on the site's own form system.
;;
;; Every id, name, class and value the surrounding code reads is unchanged:
;; controllers/BLAST/BLAST.js drives this form by id and by the classes
;; .query_seq_type, .param_set, .output_format and .selected_BLAST_target, and
;; BLAST_form.php fills every replacement token below. What changed is the markup
;; around them: the 2012 layout tables are gone, the labels are real <label for>
;; elements rather than onclick handlers, and the controls are the site's.
;;
;; Three things here are load-bearing and easy to break:
;;   * #selected_targets must stay a <table>. addTarget appends a <tr> to it
;;     and restoreSettings and setDefaultTargets render <tr> rows into it.
;;     css/mgdb-blast.css takes the table out of table layout with
;;     `display: contents` instead, so the rows can be chips.
;;   * #BLAST_target_assembly must stay a text input with its datalist.
;;     fillAssemblies empties and refills #BLAST_target_assembly_datalist and
;;     clears the input. js/mgdb-blast.js mirrors that datalist into a real
;;     listbox; with the script off, the native datalist still works.
;;   * #BLAST_target must stay a real <select>, just hidden. fillTargets
;;     empties and refills it with the chosen assembly's datasets; there is no
;;     visible dropdown or Add button any more because js/mgdb-blast.js reads
;;     this select's own <option>s and renders them as the "+" buttons in the
;;     gold panel below the picker instead. With the script off the select is
;;     merely invisible, not gone -- nothing here removes fillTargets's target.
  <form class="BLAST blast-form" id="blastform">
    <input type="hidden" id="submit-form" value="true">
    <input type="hidden" id="eutil_key" value="$(eutil_key)">

    @(cached-jobs {display: off}
      <div class="blast-recent">
        <span class="blast-recent-label">Recent jobs</span>
        <ul class="blast-recent-list">
        @(cached_job_names
          <li><a href="#!" onclick="restoreJob('$(job_name)'\)">$(job_name)</a></li>
        )
        </ul>
      </div>
    )

    <section class="blast-step" id="sequence_input" aria-labelledby="blast-step-sequence">
      <div class="blast-step-head">
        <span class="blast-step-number" aria-hidden="true">1</span>
        <div>
          <h3 id="blast-step-sequence">Enter your sequence</h3>
          <p>Paste one or more sequences in FASTA format, or fetch one from GenBank by accession.</p>
        </div>
      </div>

      <div class="blast-step-body">
        <div class="blast-seq-top">
          <div class="blast-field">
            <span class="mgdb-label" id="blast-seqtype-label">Sequence type</span>
            <div class="blast-segmented" role="radiogroup" aria-labelledby="blast-seqtype-label">
              <input type="radio" name="query_seq_type" id="query_seq_nuc"
                     class="query_seq_type" value="nucleotide" $(nucleotide_checked)>
              <label for="query_seq_nuc">Nucleotide</label>
              <input type="radio" name="query_seq_type" id="query_seq_prot"
                     class="query_seq_type" value="protein" $(protein_checked)>
              <label for="query_seq_prot">Protein</label>
            </div>
          </div>
          <p class="blast-seq-count" id="blast-seq-count" aria-live="polite"></p>
        </div>

        ;; Two columns: the textarea and its own controls on the left, the
        ;; GenBank fetch beside it on the right. It used to sit under the
        ;; full-width textarea next to the Load/Clear buttons, which left a
        ;; band of empty space to its left at every width above the breakpoint.
        ;; Only the containers changed -- every id here is one BLAST.js or
        ;; js/mgdb-blast.js drives by id, never by its wrapper.
        <div class="blast-seq-layout">
          <div class="blast-seq-main">
            <label class="mgdb-label blast-sr-only" for="query_sequence">Query sequence in FASTA format</label>
            <textarea class="blast-textarea" id="query_sequence" rows="12" spellcheck="false"
                      autocapitalize="off" autocorrect="off" wrap="off"
                      data-max-queries="$(max_queries)" data-max-bp="$(max_query_size)"
                      aria-describedby="blast-seq-count blast-seq-limits"
                      placeholder="&gt;my_sequence&#10;ATGGCGACCAAGCTGGTGCTGGTG...">$(query_sequence)</textarea>
            <p class="mgdb-hint" id="blast-seq-limits">Up to $(max_queries) sequences, $(max_query_size) bp in total. Def lines, digits and spaces are ignored.</p>
            <p class="blast-seq-warning" id="blast-seq-warning" role="status" hidden></p>
            <div class="blast-seq-tools-buttons">
              <button type="button" class="mgdb-button mgdb-button-secondary" onclick="addExample(\)">Load an example</button>
              <button type="button" class="mgdb-button mgdb-button-quiet" id="blast-clear-sequence">Clear</button>
            </div>
          </div>
          <div class="blast-genbank">
            <label class="mgdb-label" for="genbank_accesion">Or fetch from GenBank</label>
            <div class="blast-genbank-row">
              <input type="text" class="mgdb-input" id="genbank_accesion" autocomplete="off"
                     placeholder="NM_001112073" aria-describedby="blast-genbank-hint">
              <button type="button" class="mgdb-button mgdb-button-secondary"
                      onclick="getGenbankSequence(\)">Fetch</button>
            </div>
            <p class="mgdb-hint" id="blast-genbank-hint">An accession from the nucleotide or protein database, matching the type above.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="blast-step" id="select_targets" aria-labelledby="blast-step-targets">
      <div class="blast-step-head">
        <span class="blast-step-number" aria-hidden="true">2</span>
        <div>
          <h3 id="blast-step-targets">Choose target datasets</h3>
          <p>Pick a species and assembly, then add its datasets with the buttons that appear below. Search as many datasets as you like.</p>
        </div>
      </div>

      <div class="blast-step-body">
        <div class="blast-target-picker">
          <div class="blast-field">
            <label class="mgdb-label" for="target_species">Species</label>
            <select class="mgdb-select" id="target_species" onchange="fillAssemblies(\)">
              @(target_species_options
                <option value=$(organism_id)>$(genus) $(species) $(infraspecific_name)</option>
              )
            </select>
          </div>

          <div class="blast-field">
            <label class="mgdb-label" for="BLAST_target_assembly">Assembly</label>
            <div class="blast-combo" data-blast-combo>
              <input type="text" class="mgdb-input" id="BLAST_target_assembly"
                     list="BLAST_target_assembly_datalist" autocomplete="off"
                     placeholder="Type or browse assemblies" onchange="fillTargets(\)">
              <datalist id="BLAST_target_assembly_datalist"></datalist>
            </div>
          </div>
        </div>

        ;; fillTargets's own output, hidden -- see the note on load-bearing
        ;; elements at the top of this file.
        <select class="blast-sr-only" id="BLAST_target" aria-hidden="true" tabindex="-1"></select>

        @(quick-targets {display: off}
          <div class="blast-quick" data-cur-ref="$(quick_assembly_attr)">
            <span class="mgdb-label" id="blast-quick-label">$(quick_assembly) &#8212; the current reference</span>
            <div class="blast-quick-row" role="group" aria-labelledby="blast-quick-label">
              @(quick_target_rows
                <button type="button" class="blast-quick-chip" aria-pressed="false"
                        data-blast-id="$(quick_id)" data-blast-label="$(quick_label)">$(quick_type)</button>
              )
            </div>
            <p class="blast-quick-empty" id="blast-quick-empty" hidden>No BLAST datasets for this assembly.</p>
          </div>
        )

        <div class="blast-selected">
          <div class="blast-selected-head">
            <span class="mgdb-label">Selected datasets</span>
            <span class="mgdb-result-count" id="blast-target-count" aria-live="polite"></span>
          </div>
          <div class="blast-target-chips">
            <table id="selected_targets">
              $(selected_targets)
            </table>
          </div>
          <p class="blast-selected-empty" id="blast-target-empty" hidden>No datasets selected. Add at least one before running the search.</p>
        </div>
      </div>
    </section>

    <section class="blast-step" id="set_parameters" aria-labelledby="blast-step-parameters">
      <div class="blast-step-head">
        <span class="blast-step-number" aria-hidden="true">3</span>
        <div>
          <h3 id="blast-step-parameters">Set the sensitivity</h3>
          <p>A preset is enough for most searches. Every value it sets can be changed below it.</p>
        </div>
      </div>

      <div class="blast-step-body">
        <div class="blast-field">
          <span class="mgdb-label" id="blast-preset-label">Preset</span>
          <div class="blast-segmented blast-segmented-wrap" role="radiogroup" aria-labelledby="blast-preset-label">
            <input type="radio" id="BLAST_param_default" name="BLAST_param_set" value='default'
                   class="param_set" $(BLAST_param_set_default_checked) onclick="setParams(\)">
            <label for="BLAST_param_default">Default</label>
            <input type="radio" id="BLAST_param_high" name="BLAST_param_set" value="high"
                   class="param_set" $(BLAST_param_set_high_checked) onclick="setParams(\)">
            <label for="BLAST_param_high">High similarity</label>
            <input type="radio" id="BLAST_param_low" name="BLAST_param_set" value="low"
                   class="param_set" $(BLAST_param_set_low_checked) onclick="setParams(\)">
            <label for="BLAST_param_low">Low similarity</label>
            <input type="radio" id="BLAST_param_short" name="BLAST_param_set" value="short"
                   class="param_set" $(BLAST_param_set_short_checked) onclick="setParams(\)">
            <label for="BLAST_param_short">Short sequence</label>
          </div>
          <p class="mgdb-hint" id="blast-preset-hint"></p>
        </div>

        <details class="blast-advanced" id="blastparameters">
          <summary><span>Advanced parameters</span></summary>
          <p class="mgdb-hint blast-advanced-note">Choosing a preset above overwrites all six.</p>

          <div class="blast-param-grid">
            <div class="blast-param">
              <label class="mgdb-label" for="BLAST_max_hits">Max target sequences</label>
              <select class="mgdb-select" id="BLAST_max_hits">
                <option $(BLAST_max_hits1_selected)>1</option>
                <option $(BLAST_max_hits10_selected)>10</option>
                <option $(BLAST_max_hits50_selected)>50</option>
                <option $(BLAST_max_hits100_selected)>100</option>
                <option $(BLAST_max_hits250_selected)>250</option>
                <option $(BLAST_max_hits500_selected)>500</option>
                <option $(BLAST_max_hits1000_selected)>1000</option>
              </select>
              <p class="mgdb-hint">Limit target sequences reported to this number.</p>
            </div>

            <div class="blast-param">
              <label class="mgdb-label" for="BLAST_max_evalue">E-value</label>
              <input class="mgdb-input" type="text" id="BLAST_max_evalue" inputmode="decimal"
                     autocomplete="off" value="$(BLAST_max_evalue)">
              <p class="mgdb-hint">Maximum e-value. Set this above 1 for short sequences.</p>
              <details class="blast-help" id="evalue_popup">
                <summary>Why a small e-value can lose a perfect match</summary>
                <p>The e-value parameter does not so much filter the results as change the behavior of the BLAST algorithms. For example, an e-value of 1e-4 may miss a short sequence even if the sequence finds a perfect match with an e-value of 0.</p>
              </details>
            </div>

            <div class="blast-param">
              <label class="mgdb-label" for="BLAST_word_size">Word size</label>
              <select class="mgdb-select" id="BLAST_word_size">
                <option $(BLAST_word_size3_selected)>3</option>
                <option $(BLAST_word_size6_selected)>6</option>
                <option $(BLAST_word_size7_selected)>7</option>
                <option $(BLAST_word_size11_selected)>11</option>
                <option $(BLAST_word_size15_selected)>15</option>
              </select>
              <p class="mgdb-hint">The length of the initial exact match. A larger word size will generally speed up the search. Because different values are accepted for nucleotide vs protein BLAST searches, the word size selected here may be changed.</p>
              <details class="blast-help" id="word_size_popup">
                <summary>Accepted values for each program</summary>
                <table class="mgdb-table blast-help-table">
                  <thead>
                    <tr><th scope="col">Program</th><th scope="col">Accepted</th></tr>
                  </thead>
                  <tbody>
                    <tr><td>nucleotide &#8594; nucleotide <code>blastn</code></td><td>7, <b>11</b></td></tr>
                    <tr><td>nucleotide &#8594; protein <code>blastx</code></td><td><b>3</b>, 6</td></tr>
                    <tr><td>protein &#8594; nucleotide <code>tblastn</code></td><td>3, <b>6</b></td></tr>
                    <tr><td>protein &#8594; protein <code>blastp</code></td><td>2, <b>3</b>, 6</td></tr>
                  </tbody>
                </table>
                <p class="mgdb-hint">Default value in bold.</p>
              </details>
            </div>

            <div class="blast-param">
              <label class="mgdb-label" for="BLAST_perc_identity">Percent identity cutoff</label>
              <input class="mgdb-input" type="number" id="BLAST_perc_identity"
                     min="0" max="100" step="1" inputmode="numeric"
                     autocomplete="off" value="$(BLAST_perc_identity)">
              <p class="mgdb-hint">A value between 0 and 100.</p>
            </div>

            <div class="blast-param">
              <label class="mgdb-label" for="BLAST_max_hsps">Max HSPs</label>
              <input class="mgdb-input" type="number" id="BLAST_max_hsps"
                     min="0" step="1" inputmode="numeric" placeholder="all"
                     autocomplete="off" value="$(BLAST_max_hsps)">
              <p class="mgdb-hint">Maximum number of HSPs to report. 1 = report only the best HSP for each hit. Leave blank to report all HSPs.</p>
            </div>

            <div class="blast-param">
              <label class="mgdb-label" for="BLAST_match_mismatch_scores">Match/mismatch costs</label>
              <select class="mgdb-select" id="BLAST_match_mismatch_scores">
                <option $(BLAST_match_mismatch_scores1,-1_selected)>1,-1</option>
                <option $(BLAST_match_mismatch_scores1,-2_selected)>1,-2</option>
                <option $(BLAST_match_mismatch_scores1,-3_selected)>1,-3</option>
                <option $(BLAST_match_mismatch_scores1,-4_selected)>1,-4</option>
                <option $(BLAST_match_mismatch_scores1,-5_selected)>1,-5</option>
                <option $(BLAST_match_mismatch_scores2,-3_selected)>2,-3</option>
                <option $(BLAST_match_mismatch_scores2,-5_selected)>2,-5</option>
                <option $(BLAST_match_mismatch_scores2,-7_selected)>2,-7</option>
                <option $(BLAST_match_mismatch_scores3,-2_selected)>3,-2</option>
                <option $(BLAST_match_mismatch_scores3,-4_selected)>3,-4</option>
                <option $(BLAST_match_mismatch_scores4,-5_selected)>4,-5</option>
                <option $(BLAST_match_mismatch_scores5,-4_selected)>5,-4</option>
              </select>
              <p class="mgdb-hint">Reward/penalty values and gap costs.</p>
            </div>
          </div>
        </details>
      </div>
    </section>

    ;; Step 4, "Choose the result format", was removed on 2026-09-05. It offered
    ;; Enhanced / Table / Text, and since the results interface was rebuilt in
    ;; September all three are views of one search: blast_submit.php runs
    ;; -outfmt 15 unconditionally and the results page renders every view from
    ;; that JSON. The radio decided nothing. blast_submit.php read output_format
    ;; only to write it into the job's .parms file, and nothing reads it back
    ;; except this form's own prefill when a job is reopened.
    ;;
    ;; THE FIELD ITSELF HAS TO STAY, hidden. runBLAST in
    ;; controllers/BLAST/BLAST.js is not repo-owned and is the results page's
    ;; engine as well; it reads the checked .output_format radio and posts its
    ;; value. With no checked radio in the DOM that value is undefined, and the
    ;; string "undefined" lands in .parms and in any legacy report reopened from
    ;; it. One checked radio keeps the contract and records the format the
    ;; modern results page actually produces.
    ;;
    ;; No parentheses in this comment on purpose: Bauplan reads a dollar sign
    ;; followed by an open bracket as a placeholder wherever it appears, and
    ;; Nary::get throws on an identifier that does not exist.
    <div class="blast-sr-only">
      <input type="radio" class="output_format" name="output_format" id="enhanced"
             value="enhanced" checked tabindex="-1" aria-hidden="true">
      <label for="enhanced">Enhanced</label>
    </div>

    <div class="blast-run-bar">
      <p class="blast-run-summary" id="blast-run-summary" aria-live="polite"></p>
      <div class="blast-run-actions">
        <span id="BLAST_in_progress"></span>
        <input id="run_BLAST" type="button" class="button mgdb-button mgdb-button-primary"
               value="Run BLAST" onclick="runBLAST(\)">
      </div>
    </div>
  </form>

<script language="javascript">
  fillAssemblies(\);
</script>
)
