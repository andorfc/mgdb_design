$$SYNTAX-LEVEL 2
*(search-box-modern
{
  include-js: /js/mgdb-search.js
}
<!-- Icon sprite for the search categories. Defined once, referenced by the
     category listbox and by the toggle, which swaps its `use` target as the
     selection changes. Each glyph is stroked in currentColor so the chip
     palette in css/mgdb-modern.css is the single place the colours live. -->
<svg class="mgdb-search-sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <!-- MaizeGDB icon set. Source of truth is icons/ in this repository:
       icons/maizegdb-icons-sprite.svg holds the 40 mzg-* symbols verbatim,
       icons/index.tsv names each slug and its brand colour, and icons/mono,
       icons/color and icons/png carry standalone copies.

       Each symbol is self-contained \(its own viewBox and fill/stroke
       presentation attributes\), so a consumer only needs
       an svg wrapping a use element pointing at #mzg-SLUG, plus a colour
       to inherit.
       Stroke is currentColor, so the .mgdb-search-icon[data-cat] tint pairs
       in mgdb-modern.css still drive the colour.

       The three mgdb-cat-* shapes below are the survivors of the previous
       set: "all data", "identifier" and "web page" are search-scope concepts
       rather than data types, and the new set has no equivalent for them. -->
  <defs>
    <g id="mgdb-cat-all">
      <rect x="3.6" y="3.6" width="7.2" height="7.2" rx="1.6"/>
      <circle cx="17" cy="7.2" r="3.6"/>
      <circle cx="7.2" cy="17" r="3.6"/>
      <rect x="13.2" y="13.2" width="7.2" height="7.2" rx="1.6"/>
    </g>
    <g id="mgdb-cat-gene-model">
      <path d="M2 12h20"/>
      <rect x="3" y="8.4" width="4.6" height="7.2" rx="1.2"/>
      <rect x="10" y="8.4" width="4" height="7.2" rx="1.2"/>
      <rect x="16.4" y="8.4" width="4.6" height="7.2" rx="1.2"/>
    </g>
    <g id="mgdb-cat-id">
      <path d="M9.4 3.4L7.4 20.6M17 3.4l-2 17.2M3.6 9h16.6M2.8 15.2h16.6"/>
    </g>
    <g id="mgdb-cat-page">
      <rect x="2.6" y="4" width="18.8" height="16" rx="2.6"/>
      <path d="M2.6 9h18.8"/>
      <circle cx="5.8" cy="6.5" r=".9" fill="currentColor"/>
      <circle cx="8.6" cy="6.5" r=".9" fill="currentColor"/>
      <path d="M6 12.8h9.4M6 16.4h6.2"/>
    </g>
  </defs>
  <symbol id="mzg-genes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Genes</title>
    <path d="M8 3c0 4.5 8 5 8 9s-8 4.5-8 9"></path><path d="M16 3c0 4.5-8 5-8 9s8 4.5 8 9"></path><path d="M9.2 7h5.6M8 12h8M9.2 17h5.6"></path>
  </symbol>
  <symbol id="mzg-loci" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Loci</title>
    <path d="M3 20h18"></path><path d="M12 20v-7"></path><path d="M12 3.5l3.6 3.6L12 10.7 8.4 7.1z"></path>
  </symbol>
  <symbol id="mzg-references" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>References</title>
    <path d="M12 7c-1.6-1.6-4.1-2.2-8-2.2v12.4c3.9 0 6.4.6 8 2.2 1.6-1.6 4.1-2.2 8-2.2V4.8c-3.9 0-6.4.6-8 2.2z"></path><path d="M12 7v12.4"></path>
  </symbol>
  <symbol id="mzg-stocks-and-germplasm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Stocks and germplasm</title>
    <path d="M12 2.8c3.5 3.5 5.3 7.4 5.3 11.5 0 3.9-2.4 6.5-5.3 6.5s-5.3-2.6-5.3-6.5c0-4.1 1.8-8 5.3-11.5z"></path><path d="M8.4 10h7.2M6.9 14.4h10.2M8.6 18h6.8"></path><path d="M9.6 6.6v13.4M14.4 6.6v13.4"></path>
  </symbol>
  <symbol id="mzg-markers-and-probes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Markers and probes</title>
    <path d="M12 20.8c4.3-4.4 6.5-7.8 6.5-10.4a6.5 6.5 0 10-13 0c0 2.6 2.2 6 6.5 10.4z"></path><circle cx="12" cy="10.4" r="2.4"></circle>
  </symbol>
  <symbol id="mzg-variations-and-alleles" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Variations and alleles</title>
    <path d="M3 8.5h18M3 15.5h18"></path><path d="M7.5 8.5v7M16.5 8.5v7"></path><circle cx="12" cy="12" r="2.1" fill="currentColor" stroke="none"></circle><path d="M12 8.5v1.4M12 14.1v1.4"></path>
  </symbol>
  <symbol id="mzg-phenotypes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Phenotypes</title>
    <path d="M12 21.2V5.4"></path><path d="M12 5.4V2.4M12 4.2l2.8-1.6M12 4.2L9.2 2.6"></path><path d="M12 11c1.2-3.4 3.9-5.2 7.8-5.4-.9 3.6-3.5 5.4-7.8 5.4z"></path><path d="M12 16c-1.2-3.4-3.9-5.2-7.8-5.4.9 3.6 3.5 5.4 7.8 5.4z"></path>
  </symbol>
  <symbol id="mzg-traits-and-terms" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Traits and terms</title>
    <path d="M4 11.6V5.4A1.4 1.4 0 015.4 4h6.2c.5 0 1 .2 1.3.6l7.1 7.1c.7.7.7 1.9 0 2.6l-5.9 5.9c-.7.7-1.9.7-2.6 0L4.6 13c-.4-.4-.6-.9-.6-1.4z"></path><circle cx="8.2" cy="8.2" r="1.4"></circle>
  </symbol>
  <symbol id="mzg-qtl-experiments" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>QTL experiments</title>
    <path d="M4 4v14a2 2 0 002 2h14"></path><path d="M7 10.6h12" stroke-dasharray="2 2.6"></path><path d="M7 16.2l3.2-3.6 2.4 2.2L15.9 6l3.1 7.4"></path>
  </symbol>
  <symbol id="mzg-gene-products" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Gene products</title>
    <rect x="3" y="8" width="18" height="8" rx="4"></rect><circle cx="8" cy="12" r="1.4"></circle><circle cx="12" cy="12" r="1.4"></circle><circle cx="16" cy="12" r="1.4"></circle>
  </symbol>
  <symbol id="mzg-maps" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Maps</title>
    <path d="M9 4.5L3.5 6.6v12.9L9 17.4l6 2.1 5.5-2.1V4.5L15 6.6z"></path><path d="M9 4.5v12.9M15 6.6v12.9"></path>
  </symbol>
  <symbol id="mzg-recombination-data" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Recombination data</title>
    <path d="M6.4 3.4v3.4c0 3 11.2 4.4 11.2 7.4v6.4"></path><path d="M17.6 3.4v3.4c0 3-11.2 4.4-11.2 7.4v6.4"></path><path d="M9.6 9.2l4.8 3.4M14.4 9.2l-4.8 3.4"></path>
  </symbol>
  <symbol id="mzg-genomes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Genomes</title>
    <rect x="3.5" y="4" width="17" height="4.5" rx="2.2"></rect><rect x="3.5" y="9.8" width="17" height="4.5" rx="2.2"></rect><rect x="3.5" y="15.5" width="17" height="4.5" rx="2.2"></rect>
  </symbol>
  <symbol id="mzg-people-and-organizations" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>People and organizations</title>
    <circle cx="9.2" cy="8.4" r="3.2"></circle><path d="M3.6 19.4c.6-3.2 2.8-5 5.6-5s5 1.8 5.6 5"></path><path d="M16.2 6.6a3 3 0 010 5.6M17.6 14.8c1.6.8 2.6 2.3 2.9 4.6"></path>
  </symbol>
  <symbol id="mzg-restriction-enzymes-and-primers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Restriction enzymes and primers</title>
    <path d="M8.6 3.4v6.1M8.6 13.4v7.2M15.4 3.4v9.7M15.4 17v3.6"></path><path d="M8.6 6.3h6.8M8.6 19.3h6.8"></path><path d="M3.4 9.4l2.8 1.9-2.8 1.9z" fill="currentColor" stroke="none"></path><path d="M20.6 13.3l-2.8 1.9 2.8 1.9z" fill="currentColor" stroke="none"></path>
  </symbol>
  <symbol id="mzg-journals" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Journals</title>
    <rect x="4" y="3.5" width="16" height="17" rx="2"></rect><path d="M8.2 3.5v17"></path><path d="M11.4 8.2h5.4M11.4 12h5.4M11.4 15.8h3.2"></path>
  </symbol>
  <symbol id="mzg-species" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Species</title>
    <circle cx="4.8" cy="12" r="1.8"></circle><circle cx="19.2" cy="5.6" r="1.8"></circle><circle cx="19.2" cy="12" r="1.8"></circle><circle cx="19.2" cy="18.4" r="1.8"></circle><path d="M6.6 12h4.6M11.2 5.6v12.8M11.2 5.6h6.2M11.2 12h6.2M11.2 18.4h6.2"></path>
  </symbol>
  <symbol id="mzg-sequences" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Sequences</title>
    <rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect><path d="M7 9h5.5M7 12h9.5M7 15h4"></path>
  </symbol>
  <symbol id="mzg-expression-atlas" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Expression atlas</title>
    <rect x="3.5" y="3.5" width="17" height="17" rx="2"></rect><rect x="9.2" y="9.2" width="5.6" height="5.6" fill="currentColor" stroke="none" opacity=".32"></rect><path d="M9.2 3.5v17M14.8 3.5v17M3.5 9.2h17M3.5 14.8h17"></path>
  </symbol>
  <symbol id="mzg-pathways" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Pathways</title>
    <circle cx="5.2" cy="7" r="2"></circle><circle cx="12" cy="13.4" r="2"></circle><circle cx="19" cy="5.6" r="2"></circle><circle cx="18.4" cy="18.6" r="2"></circle><path d="M6.7 8.4l3.9 3.7M13.6 11.9l3.9-4.3M13.5 14.7l3.6 2.8"></path>
  </symbol>
  <symbol id="mzg-datasets-and-downloads" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Datasets and downloads</title>
    <path d="M12 3.5v11"></path><path d="M8 10.6l4 4 4-4"></path><path d="M4 16.6v2.9a1 1 0 001 1h14a1 1 0 001-1v-2.9"></path>
  </symbol>
  <symbol id="mzg-images" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Images</title>
    <rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect><circle cx="8.6" cy="9.6" r="1.5"></circle><path d="M4.2 16.6l4.4-4 3.4 3 3-2.6 5 4.6"></path>
  </symbol>
  <symbol id="mzg-tools" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Tools</title>
    <path d="M3.5 7h10.2M18.2 7h2.3M3.5 17h4.3M12.3 17h8.2"></path><circle cx="16" cy="7" r="2.2"></circle><circle cx="10.1" cy="17" r="2.2"></circle>
  </symbol>
  <symbol id="mzg-artificial-intelligence" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Artificial intelligence</title>
    <rect x="6.2" y="6.2" width="11.6" height="11.6" rx="2.4"></rect><path d="M9.5 3.4v2.8M14.5 3.4v2.8M9.5 17.8v2.8M14.5 17.8v2.8M3.4 9.5h2.8M3.4 14.5h2.8M17.8 9.5h2.8M17.8 14.5h2.8"></path><path d="M12 8.9l1.05 2.06L15.1 12l-2.05 1.04L12 15.1l-1.05-2.06L8.9 12l2.05-1.04z" fill="currentColor" stroke="none"></path>
  </symbol>
  <symbol id="mzg-genome-browsers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Genome browsers</title>
    <rect x="3" y="4.5" width="18" height="15" rx="2"></rect><path d="M3 8.6h18"></path><path d="M6.2 14.2h11.6"></path><rect x="8.4" y="12.4" width="4.2" height="3.6" rx="0.8" fill="currentColor" stroke="none"></rect>
  </symbol>
  <symbol id="mzg-pan-genome-graphs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Pan-genome graphs</title>
    <path d="M2.8 12h4.4M16.8 12h4.4"></path><ellipse cx="12" cy="12" rx="4.8" ry="4.6"></ellipse><path d="M7.2 12h9.6"></path>
  </symbol>
  <symbol id="mzg-protein-structures" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Protein structures</title>
    <path d="M8 3.6c6 1.4 6 4.3 0 5.7s-6 4.3 0 5.7 6 4.3 0 5.7"></path><path d="M8 3.6h8M8 9.3h8M8 15h8M8 20.7h8"></path>
  </symbol>
  <symbol id="mzg-pan-genes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Pan-genes</title>
    <path d="M3.6 4.6v14.8"></path><rect x="7" y="4.6" width="11" height="3.6" rx="1.8"></rect><rect x="7" y="10.2" width="8" height="3.6" rx="1.8"></rect><rect x="7" y="15.8" width="13.4" height="3.6" rx="1.8"></rect>
  </symbol>
  <symbol id="mzg-nomenclature" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Nomenclature</title>
    <rect x="2.8" y="5.6" width="18.4" height="12.8" rx="2.4"></rect><path d="M7.6 14.6l2.9-5.6 2.9 5.6M8.7 12.6h3.6"></path><path d="M15.4 14.6h2.8"></path>
  </symbol>
  <symbol id="mzg-nam-genomes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>NAM genomes</title>
    <rect x="2.6" y="3.6" width="7.6" height="3.6" rx="1.8"></rect><rect x="13.8" y="3.6" width="7.6" height="3.6" rx="1.8"></rect><rect x="7.4" y="16.8" width="9.2" height="3.6" rx="1.8"></rect><path d="M6.4 7.2v4.4h11.2V7.2M12 11.6v5.2"></path>
  </symbol>
  <symbol id="mzg-panand-genomes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>PanAnd genomes</title>
    <path d="M12 20.8V9.6"></path><path d="M12 12.4c-3.6-.6-5.2-3.2-5.2-6.6 3.4.3 5.2 2.7 5.2 6.6z"></path><path d="M12 10.6c3.4-.8 4.8-3.1 4.8-6.2-3.2.4-4.8 2.6-4.8 6.2z"></path><path d="M12 17.2c-2.8-.5-4-2.4-4-4.9 2.6.3 4 2 4 4.9z"></path>
  </symbol>
  <symbol id="mzg-agbiodata" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>AgBioData</title>
    <ellipse cx="11" cy="6.4" rx="5.6" ry="2.4"></ellipse><path d="M5.4 6.4v5.4c0 1.3 2.5 2.4 5.6 2.4s5.6-1.1 5.6-2.4V6.4"></path><path d="M5.4 11.8v3.6c0 1.3 2.5 2.4 5.6 2.4h.8"></path><circle cx="18.4" cy="17.6" r="2.6"></circle><path d="M13.6 15.4l2.6 1.2"></path>
  </symbol>
  <symbol id="mzg-maize-genetics-meeting" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Maize Genetics Meeting</title>
    <rect x="3.4" y="5.4" width="17.2" height="15.2" rx="2.2"></rect><path d="M3.4 9.8h17.2M8 3.4v3.4M16 3.4v3.4"></path><circle cx="12" cy="15.4" r="2.4" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="mzg-maize-genetics-cooperation" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Maize Genetics Cooperation</title>
    <circle cx="12" cy="5.4" r="2.6"></circle><circle cx="5.6" cy="17.2" r="2.6"></circle><circle cx="18.4" cy="17.2" r="2.6"></circle><path d="M10.6 7.8l-3.6 6.8M13.4 7.8l3.6 6.8M8.2 17.2h7.6"></path>
  </symbol>
  <symbol id="mzg-maizemine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>MaizeMine</title>
    <path d="M16.6 3.4H5.4a1.6 1.6 0 00-1.6 1.6v13.2"></path><path d="M3.8 8.2h10.4M8.4 3.4v10"></path><circle cx="15.6" cy="15.6" r="4.4"></circle><path d="M18.9 18.9l2.3 2.3"></path>
  </symbol>
  <symbol id="mzg-gene-enrichment-feta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Gene enrichment \(FETA\)</title>
    <path d="M3.4 5.2h17.2l-6.6 7.8v6.2l-4 2.2v-8.4z"></path><circle cx="8" cy="8.6" r="1.2" fill="currentColor" stroke="none"></circle><circle cx="12" cy="8.6" r="1.2" fill="currentColor" stroke="none"></circle><circle cx="16" cy="8.6" r="1.2" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="mzg-gene-evolution" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Gene evolution</title>
    <path d="M2.8 12h5.4"></path><path d="M8.2 12l4.6-5h5.4M8.2 12l4.6 5h5.4"></path><path d="M16.4 5.2L18.6 7l-2.2 1.8M16.4 15.2l2.2 1.8-2.2 1.8"></path><circle cx="8.2" cy="12" r="1.8" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="mzg-editorial-board-papers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Editorial board papers</title>
    <path d="M5.4 3.4h8.2l4.8 4.8v6.2"></path><path d="M13.6 3.4v4.8h4.8"></path><path d="M5.4 3.4v17.2h5.2"></path><path d="M8.4 9h3.6M8.4 12.4h5.6"></path><circle cx="16.6" cy="17.4" r="3.6"></circle><path d="M15 17.4l1.2 1.2 2.2-2.4"></path>
  </symbol>
  <symbol id="mzg-gene-expression-profile" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>Gene expression profile</title>
    <path d="M3.4 20.6h17.2"></path><rect x="5" y="12.6" width="3.6" height="6"></rect><rect x="10.2" y="8.6" width="3.6" height="10"></rect><rect x="15.4" y="4.6" width="3.6" height="14"></rect>
  </symbol>
  <symbol id="mzg-new-genes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <title>New genes</title>
    <rect x="2.6" y="9.4" width="13.2" height="7.2" rx="3.6"></rect><path d="M6.4 13h5.6"></path><path d="M18.6 3.4v6.4M15.4 6.6h6.4"></path>
  </symbol>
</svg>

<form id="global_search_form" class="mgdb-search-form" method="POST" action="/search_engine/searchall" role="search">
  <input type="hidden" id="global_search_source" name="global_search_source" value="search_box">

  <div class="mgdb-search-shell">
    <div class="mgdb-search-category" data-search-category>
      <label class="mgdb-visually-hidden" for="global_search_type">Search category</label>
      <select id="global_search_type" name="global_search_type" class="mgdb-search-native">
        <option value="anything" selected="selected">All data</option>
        <option value="gene_product">Genes</option>
        <option value="gene_model">Gene models</option>
        <option value="genome">Genomes</option>
        <option value="locus">Loci</option>
        <option value="probe">Markers and probes</option>
        <option value="qtl_exp">QTL experiments</option>
        <option value="stock">Stocks and germplasm</option>
        <option value="reference">References</option>
        <option value="term">Traits and terms</option>
        <option value="phenotype">Phenotypes and mutants</option>
        <option value="variation">Variations and alleles</option>
        <option value="map">Maps</option>
        <option value="person">People and organizations</option>
        <option value="id">MaizeGDB ID</option>
        <option value="goog">Static web pages</option>
      </select>

      <button class="mgdb-search-category-button" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="mgdb-search-menu">
        <span class="mgdb-search-icon" data-search-category-icon data-cat="anything" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><use href="#mgdb-cat-all"></use></svg>
        </span>
        <span class="mgdb-search-category-label">
          <span class="mgdb-visually-hidden">Search category: </span><span data-search-category-label>All data</span>
        </span>
        <span class="mgdb-search-chevron" aria-hidden="true"></span>
      </button>

      <div id="mgdb-search-menu" class="mgdb-search-menu" role="listbox" aria-label="Search category" hidden>
        <button type="button" role="option" aria-selected="true"  data-value="anything" data-label="All data"><span class="mgdb-search-icon" data-cat="anything" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mgdb-cat-all"></use></svg></span><strong>All data</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="gene_product" data-label="Genes"><span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-genes"></use></svg></span><strong>Genes</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="gene_model" data-label="Gene models"><span class="mgdb-search-icon" data-cat="gene_model" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mgdb-cat-gene-model"></use></svg></span><strong>Gene models</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="genome" data-label="Genomes"><span class="mgdb-search-icon" data-cat="genome" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-genomes"></use></svg></span><strong>Genomes</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="locus" data-label="Loci"><span class="mgdb-search-icon" data-cat="locus" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-loci"></use></svg></span><strong>Loci</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="probe" data-label="Markers and probes"><span class="mgdb-search-icon" data-cat="probe" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-markers-and-probes"></use></svg></span><strong>Markers and probes</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="qtl_exp" data-label="QTL experiments"><span class="mgdb-search-icon" data-cat="qtl_exp" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-qtl-experiments"></use></svg></span><strong>QTL experiments</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="stock" data-label="Stocks and germplasm"><span class="mgdb-search-icon" data-cat="stock" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-stocks-and-germplasm"></use></svg></span><strong>Stocks and germplasm</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="reference" data-label="References"><span class="mgdb-search-icon" data-cat="reference" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-references"></use></svg></span><strong>References</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="term" data-label="Traits and terms"><span class="mgdb-search-icon" data-cat="term" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-traits-and-terms"></use></svg></span><strong>Traits and terms</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="phenotype" data-label="Phenotypes and mutants"><span class="mgdb-search-icon" data-cat="phenotype" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-phenotypes"></use></svg></span><strong>Phenotypes and mutants</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="variation" data-label="Variations and alleles"><span class="mgdb-search-icon" data-cat="variation" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-variations-and-alleles"></use></svg></span><strong>Variations and alleles</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="map" data-label="Maps"><span class="mgdb-search-icon" data-cat="map" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-maps"></use></svg></span><strong>Maps</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="person" data-label="People and organizations"><span class="mgdb-search-icon" data-cat="person" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mzg-people-and-organizations"></use></svg></span><strong>People and organizations</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="id" data-label="MaizeGDB ID"><span class="mgdb-search-icon" data-cat="id" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mgdb-cat-id"></use></svg></span><strong>MaizeGDB ID</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
        <button type="button" role="option" aria-selected="false" data-value="goog" data-label="Static web pages"><span class="mgdb-search-icon" data-cat="goog" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><use href="#mgdb-cat-page"></use></svg></span><strong>Static web pages</strong><i class="mgdb-search-check" aria-hidden="true"></i></button>
      </div>
    </div>

    <div class="mgdb-search-query">
      <label class="mgdb-visually-hidden" for="global_search_term">Search MaizeGDB</label>
      <input id="global_search_term" class="mgdb-search-input" type="search" name="global_search_term"
             placeholder="Search genes, loci, markers, stocks, &hellip;"
             autocomplete="off" autocapitalize="off" spellcheck="false"
             role="combobox" aria-autocomplete="list" aria-controls="mgdb-search-suggestions" aria-expanded="false" required>
    </div>

    <button class="mgdb-search-submit" type="submit">
      <span class="mgdb-search-submit-icon" aria-hidden="true"></span>
      <span class="mgdb-visually-hidden">Search</span>
    </button>
  </div>

  <div id="mgdb-search-suggestions" class="mgdb-suggestions" role="listbox" aria-label="Search suggestions" hidden>
    <div class="mgdb-suggestions-content" data-suggestions-content></div>
    <button class="mgdb-suggestions-footer" type="submit" data-suggestions-footer hidden></button>
  </div>

  <p id="mgdb-search-status" class="mgdb-visually-hidden" role="status" aria-live="polite"></p>
</form>
)
