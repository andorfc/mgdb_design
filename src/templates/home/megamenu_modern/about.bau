$$SYNTAX-LEVEL 2
*(about
  <a href="#" class="drop">$(about_name)</a>
  <span id="about_menu">
    <div class="dropdown_5columns mega-dropdown mega-dropdown-about">
      <div class="mega-panel-heading">
        <span class="mega-eyebrow">About MaizeGDB</span>
        <h2>Maize data, connected for discovery</h2>
        <p>A long-term USDA informatics resource serving the maize genetics and genomics community.</p>
      </div>
      <div class="mega-grid mega-grid-3 mega-compact-groups">
        <section class="mega-group">
          <h3>Project</h3>
          <a href="$(server-url)/contact"><strong>People &amp; contact</strong></a>
          <a href="$(server-url)/cite"><strong>Cite MaizeGDB</strong></a>
          <a href="$(server-url)/about/working_group"><strong>Working Group</strong></a>
        </section>
        <section class="mega-group">
          <h3>Learn</h3>
          <a href="$(server-url)/faq"><strong>Frequently asked questions</strong></a>
          <a href="$(server-url)/doc"><strong>Documentation</strong></a>
          <a href="$(server-url)/whatsnew"><strong>News &amp; updates</strong></a>
        </section>
        <aside class="mega-feature mega-feature-green">
          <span class="mega-badge">FAIR data</span>
          <h3>Part of AgBioData</h3>
          <p>MaizeGDB works with agricultural databases to make research data findable, accessible, interoperable, and reusable.</p>
          <a class="mega-feature-link" href="https://www.agbiodata.org" target="_blank" rel="noopener">Visit AgBioData <span aria-hidden="true">&#8599;</span></a>
        </aside>
      </div>
      <div class="mega-panel-footer">
        <a href="$(server-url)/sitemap">Explore the complete site map <span aria-hidden="true">&#8594;</span></a>
      </div>
    </div>
  </span>
)
