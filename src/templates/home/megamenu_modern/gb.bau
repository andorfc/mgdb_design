$$SYNTAX-LEVEL 2
*(genomes
  <a href="#" class="drop">$(gb_name)</a><!-- Begin Genomes Item -->
  <span id="genome_browsers_menu">
    <div class="dropdown_3columns"><!-- Begin Genomes container -->
      <div class="col_3 firstcolumn">
        <div class="col_2 firstcolumn">
          <table>
            <tr>
              <td>
               <a style=' text-decoration: none;' href="https://jbrowse.maizegdb.org">
                 <img style="height:127px; width:287px;" frameborder="no" src="$(image-dir)/B73_v5.png">
               </a>
              </td>
            </tr>
            <tr>
              <td>
                <a style=' text-decoration: none;' href="$(gbrowse_url)/maize_v4">
