             src="$(image-dir)/gramene.png"></a> </td><td> <a style="text-decoration: none;" 
             href="http://www.genomaize.org/"><img 
             style="height:127px; width:152px; padding:0px;" border=0 frameborder="no" 
             src="$(image-dir)/genomaize.png"></a></td></tr></table>
              </td>
            </tr>
            
          </table>
        </div>
