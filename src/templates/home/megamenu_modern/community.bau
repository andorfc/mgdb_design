$$SYNTAX-LEVEL 2
*(community
  <a href="#" class="drop">$(community_name)</a>
  <span id="community_menu">
    <div class="dropdown_fullwidth mega-dropdown mega-dropdown-wide">
      <div class="mega-panel-heading mega-panel-heading-row">
        <h2>Maize Genetics Community</h2>
        <!-- Wrapped like the About and Genomes panels so all three stack the
             same way in the drawer. -->
        <div class="mega-heading-actions">
          <a class="mega-heading-action" href="https://www.maizegenetics.org" target="_blank" rel="noopener">Visit the MGC website <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>
      <div class="mega-grid mega-grid-4 mega-grid-community mega-compact-groups">
        <section class="mega-group">
          <h3>Community</h3>
          <a href="https://www.maizegenetics.org" target="_blank" rel="noopener"><strong>Maize Genetics Cooperation</strong></a>
          <a href="https://www.maizegenetics.org/mgac" target="_blank" rel="noopener"><strong>Advocacy</strong></a>
          <a href="https://www.maizegenetics.org/awards/community-awards" target="_blank" rel="noopener"><strong>Awards</strong></a>
          <a href="$(server-url)/person"><strong>Find researchers</strong></a>
          <a href="$(server-url)/jobs"><strong>Jobs</strong></a>
          <a href="$(server-url)/maize_history"><strong>Maize research history</strong></a>
        </section>
        <section class="mega-group">
          <h3>Literature &amp; media</h3>
          <a href="$(server-url)/data_center/reference"><strong>Find a paper</strong></a>
          <a href="$(server-url)/hot_new_papers"><strong>Editorial picks</strong></a>
          <a href="$(server-url)/maize_history#history-classic-reads"><strong>Classic reads</strong></a>
          <a href="$(server-url)/mnl"><strong>Maize News Letter</strong></a>
          <a href="$(server-url)/community/videos"><strong>Videos</strong></a>
        </section>
        <section class="mega-group">
          <h3>Share data</h3>
          <a href="$(server-url)/contribute_data"><strong>Contribute data</strong></a>
          <a href="$(server-url)/FAIRpractices"><strong>FAIR practices</strong></a>
          <a href="$(server-url)/nomenclature"><strong>Nomenclature</strong></a>
          <a href="https://download.maizegdb.org" target="_blank" rel="noopener"><strong>Bulk downloads</strong></a>
        </section>
        <aside class="mega-feature mega-feature-blue">
          <span class="mega-badge">Upcoming</span>
          <h3>69th Maize Genetics Meeting</h3>
          <p>March 11–14, 2027<br>Rosemont, Illinois</p>
          <a class="mega-feature-art" href="https://www.maizegenetics.org/maize-meeting/2027" target="_blank" rel="noopener">
            <img src="/images/MGC2027_img.png" alt="69th Annual Maize Genetics Meeting, 2027" width="231" height="84" loading="lazy" decoding="async" />
          </a>
          <a class="mega-secondary-link" href="$(server-url)/maize_meeting/">Past meetings &amp; abstracts</a>
        </aside>
      </div>
    </div>
  </span>
)
