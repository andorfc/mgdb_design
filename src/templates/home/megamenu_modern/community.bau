$$SYNTAX-LEVEL 2
*(community
  <a href="#" class="drop">$(community_name)</a>
  <span id="community_menu">
    <div class="dropdown_fullwidth mega-dropdown mega-dropdown-wide">
      <div class="mega-panel-heading mega-panel-heading-row">
        <div>
          <span class="mega-eyebrow">Maize genetics community</span>
          <h2>Connect, contribute, and keep current</h2>
        </div>
        <a class="mega-heading-action" href="https://www.maizegenetics.org" target="_blank" rel="noopener">Visit the MGC website <span aria-hidden="true">&#8599;</span></a>
      </div>
      <div class="mega-grid mega-grid-4">
        <section class="mega-group">
          <h3>Community</h3>
          <a href="https://www.maizegenetics.org" target="_blank" rel="noopener"><strong>MGC website</strong><span>Maize Genetics Cooperation</span></a>
          <a href="https://www.maizegenetics.org/mgac" target="_blank" rel="noopener"><strong>Advocacy</strong><span>Maize Genetics Advocacy Committee</span></a>
          <a href="https://www.maizegenetics.org/awards/community-awards" target="_blank" rel="noopener"><strong>Awards</strong><span>Recognizing community contributions</span></a>
          <a href="$(server-url)/person"><strong>Find researchers</strong><span>People and organizations</span></a>
          <a href="$(server-url)/jobs"><strong>Jobs</strong><span>Opportunities in maize research</span></a>
        </section>
        <section class="mega-group">
          <h3>Literature &amp; media</h3>
          <a href="$(server-url)/data_center/reference"><strong>Find a paper</strong><span>Search publications and abstracts</span></a>
          <a href="$(server-url)/hot_new_papers"><strong>Editorial picks</strong><span>Noteworthy recent publications</span></a>
          <a href="$(server-url)/mnl"><strong>Maize Newsletter</strong><span>Browse the MNL archive</span></a>
          <a href="$(server-url)/community/videos"><strong>Videos</strong><span>Talks, tutorials, and outreach</span></a>
        </section>
        <section class="mega-group">
          <h3>Share data</h3>
          <a href="$(server-url)/contribute_data"><strong>Contribute data</strong><span>Submit datasets to MaizeGDB</span></a>
          <a href="$(server-url)/FAIRpractices"><strong>FAIR practices</strong><span>Prepare reusable community data</span></a>
          <a href="$(server-url)/nomenclature"><strong>Nomenclature</strong><span>Maize naming conventions</span></a>
          <a href="https://download.maizegdb.org" target="_blank" rel="noopener"><strong>Bulk downloads</strong><span>Files from the download server</span></a>
        </section>
        <aside class="mega-feature mega-feature-blue">
          <span class="mega-badge">Upcoming</span>
          <h3>69th Maize Genetics Meeting</h3>
          <p>March 11–14, 2027<br>Rosemont, Illinois</p>
          <a class="mega-feature-link" href="https://www.maizegenetics.org/maize-meeting/2027" target="_blank" rel="noopener">Meeting information <span aria-hidden="true">&#8599;</span></a>
          <a class="mega-secondary-link" href="$(server-url)/maize_meeting/">Past meetings &amp; abstracts</a>
        </aside>
      </div>
      <div class="mega-panel-footer mega-panel-footer-split">
        <a href="$(server-url)/maize_history">Explore maize research history <span aria-hidden="true">&#8594;</span></a>
        <a href="$(server-url)/cooperators">Cooperator history</a>
      </div>
    </div>
  </span>
)
