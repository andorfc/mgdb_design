$$SYNTAX-LEVEL 2
*(data-centers
  <a href="$(server-url)/data_center/" class="drop">$(dc_name)</a>
  <span id="data_center_menu">
    <div class="dropdown_fullwidth mega-dropdown mega-dropdown-wide">
      <div class="mega-panel-heading mega-panel-heading-row">
        <div class="mega-heading-text">
          <h2>Data hubs: explore maize data by data type</h2>
          <!-- Filled in by mgdb-chrome.js from the pointed-at hub's data-desc.
               aria-hidden because it is a pointer affordance duplicating the
               link the user is already on; screen readers get the label, and
               the heading action leads to the full descriptions. -->
          <p class="mega-hint" data-mgdb-hint data-mgdb-hint-default="Point at a hub to see what it holds." aria-hidden="true">Point at a hub to see what it holds.</p>
        </div>
        <div class="mega-heading-actions">
          <a class="mega-heading-action" href="$(server-url)/data_center/">Data hub descriptions <span aria-hidden="true">&#8594;</span></a>
        </div>
      </div>
      <!-- One alphabetical list flowing down each column in turn, rather than
           four themed groups. Several hubs sat awkwardly under any heading we
           tried -- Analysis projects and Data summaries are not a data type at
           all -- and with twenty entries an A-Z is faster to scan than a
           taxonomy the reader has to learn first. -->
      <div class="mega-grid mega-grid-hubs">
        <section class="mega-group mega-hub-list">
          <a href="$(server-url)/data_center/variation" data-desc="Alleles, polymorphisms, and the mutant collections behind them."><strong>Alleles &amp; polymorphisms</strong></a>
          <a href="$(server-url)/projects" data-desc="Curated analysis projects and the datasets they produced."><strong>Analysis projects</strong></a>
          <a href="$(server-url)/ai" data-desc="AI-derived datasets and tools hosted at MaizeGDB."><strong>Artificial intelligence</strong></a>
          <a href="$(server-url)/data_center/" data-desc="Record counts and release summaries across every data type."><strong>Data summaries</strong></a>
          <a href="$(server-url)/expression" data-desc="Expression atlases and per-tissue abundance for gene models."><strong>Expression</strong></a>
          <a href="$(server-url)/data_center/gene_product" data-desc="Products assigned to gene models."><strong>Gene products</strong></a>
          <a href="$(server-url)/gene_center/gene" data-desc="Look up a gene model, symbol, or locus."><strong>Genes &amp; gene models</strong></a>
          <a href="$(server-url)/genome" data-desc="Assemblies hosted at MaizeGDB, with browsers and downloads."><strong>Genomes</strong></a>
          <a href="$(server-url)/data_center/image" data-desc="Curated photographs of phenotypes, materials, and gel patterns."><strong>Images</strong></a>
          <a href="$(server-url)/insertion" data-desc="Mu, Ac/Ds, and other transposon insertion collections."><strong>Insertions</strong></a>
          <a href="$(server-url)/data_center/locus" data-desc="Classic genetic loci, cloned genes, and the alleles mapped to them."><strong>Loci</strong></a>
          <a href="$(server-url)/data_center/map" data-desc="Genetic, cytogenetic, physical, and bin maps across chromosomes 1-10."><strong>Maps</strong></a>
          <a href="$(server-url)/metabolic_pathways/" data-desc="Maize metabolic pathways and the enzymes that act in them."><strong>Metabolic pathways</strong></a>
          <a href="$(server-url)/data_center/marker" data-desc="Molecular markers, probes, SSRs, RFLPs, and sequence features."><strong>Molecular markers</strong></a>
          <a href="$(server-url)/data_center/phenotype" data-desc="Phenotype records and the mutant archives they come from."><strong>Mutants &amp; phenotypes</strong></a>
          <a href="$(server-url)/pan_gene_center/pan_gene" data-desc="Pan-gene assignments across the NAM assemblies."><strong>Pan-genes</strong></a>
          <a href="$(server-url)/data_center/protein_structure" data-desc="Predicted structures for gene model proteins, with Foldseek and FATCAT."><strong>Protein structures</strong></a>
          <a href="$(server-url)/data_center/qtl" data-desc="Quantitative trait analyses, the traits they measured, and the crosses behind them."><strong>QTL</strong></a>
          <a href="$(server-url)/data_center/reference" data-desc="The curated maize literature, searchable by topic, author, gene, or locus."><strong>References</strong></a>
          <a href="$(server-url)/genetic_variation" data-desc="SNP datasets and the traits associated with them."><strong>SNPs &amp; traits</strong></a>
          <a href="$(server-url)/data_center/stock" data-desc="Genetic stocks held by the Maize Genetics Cooperation Stock Center."><strong>Stocks &amp; germplasm</strong></a>
        </section>
      </div>
    </div>
  </span>
)
