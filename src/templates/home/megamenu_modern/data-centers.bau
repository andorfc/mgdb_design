$$SYNTAX-LEVEL 2
*(data-centers
  <a href="$(server-url)/data_center/" class="drop">$(dc_name)</a>
  <span id="data_center_menu">
    <div class="dropdown_fullwidth mega-dropdown mega-dropdown-wide">
      <div class="mega-panel-heading mega-panel-heading-row">
        <div>
          <span class="mega-eyebrow">Data Centers</span>
          <h2>Explore maize data by research question</h2>
        </div>
        <a class="mega-heading-action" href="$(server-url)/data_center/">Open Data Center hub <span aria-hidden="true">&#8594;</span></a>
      </div>
      <div class="mega-grid mega-grid-4 mega-compact-groups">
        <section class="mega-group">
          <h3>Genomes &amp; variation</h3>
          <a href="$(server-url)/genome"><strong>Genomes</strong></a>
          <a href="$(server-url)/data_center/variation"><strong>Alleles &amp; polymorphisms</strong></a>
          <a href="$(server-url)/genetic_variation"><strong>SNPs &amp; traits</strong></a>
          <a href="$(server-url)/insertion"><strong>Insertions</strong></a>
          <a href="$(server-url)/data_center/map"><strong>Maps</strong></a>
        </section>
        <section class="mega-group">
          <h3>Genes &amp; function</h3>
          <a href="$(server-url)/gene_center/gene"><strong>Genes &amp; gene models</strong></a>
          <a href="$(server-url)/pan_gene_center/pan_gene"><strong>Pan-genes</strong></a>
          <a href="$(server-url)/data_center/gene_product"><strong>Gene products</strong></a>
          <a href="$(server-url)/expression"><strong>Expression</strong></a>
          <a href="$(server-url)/metabolic_pathways/"><strong>Metabolic pathways</strong></a>
          <a href="$(server-url)/data_center/protein_structure"><strong>Protein structures</strong></a>
        </section>
        <section class="mega-group">
          <h3>Traits &amp; germplasm</h3>
          <a href="$(server-url)/data_center/locus"><strong>Loci &amp; QTL</strong></a>
          <a href="$(server-url)/data_center/phenotype"><strong>Mutants &amp; phenotypes</strong></a>
          <a href="$(server-url)/data_center/stock"><strong>Stocks &amp; germplasm</strong></a>
          <a href="$(server-url)/data_center/marker"><strong>Molecular markers</strong></a>
        </section>
        <section class="mega-group">
          <h3>Knowledge &amp; media</h3>
          <a href="$(server-url)/data_center/reference"><strong>References</strong></a>
          <a href="$(server-url)/data_center/image"><strong>Images</strong></a>
          <a href="$(server-url)/ai"><strong>Artificial intelligence</strong></a>
          <a href="$(server-url)/projects"><strong>Analysis projects</strong><span>Finished analyses with figures and downloads</span></a>
          <a href="$(server-url)/data_center/"><strong>Data summaries</strong><span>Counts, charts, and guided entry points</span></a>
        </section>
      </div>
      <div class="mega-panel-footer mega-panel-footer-split">
        <a href="$(server-url)/data_center/">Browse all Data Centers <span aria-hidden="true">&#8594;</span></a>
        <a href="$(server-url)/archive">Archived Data Centers</a>
      </div>
    </div>
  </span>
)
