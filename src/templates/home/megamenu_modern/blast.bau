$$SYNTAX-LEVEL 2

UNUSED

*(blast {include-js: js/blast.js}
  
    <a href="#" class="drop">$(blast_name)</a><!-- Begin BLAST Item -->
    <span id="blast_menu"><div class="dropdown_3columns "><!-- Begin BLAST container -->
        <div class="col_3 firstcolumn">
        <h2 class="blast">BLAST at MaizeGDB</h2>
           <div class="col_1 firstcolumn" style="padding-right: 10px;">
             <ul class="greybox">
               <li><a href="$(blast_url)">BLAST</a></li>
              </ul>
             </div>
             <div style="font-size: 12px;">
              <b>BLAST</b> allows you to simultaneously BLAST datasets at many different websites.
             </div>
             <div class="col_1 firstcolumn" style="padding-right: 10px;">
              <ul class="greybox">
                <li><a href="/popcorn/search/sequence_search/home.php?a=SEQUENCE_SEARCH_UI">Search by sequence</a></li>
               </ul>
             </div>
             <div style="font-size: 12px;">
              <b>Search by sequence</b> allows you to find resources like seed stocks and literature based on a sequence input.
             </div>
             
