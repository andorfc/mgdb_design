$$SYNTAX-LEVEL 2
*(tools
  <a href="#" class="drop">$(tools_name)</a>
  <span id="tool_menu">
    <div class="dropdown_fullwidth mega-dropdown mega-dropdown-wide">
      <div class="mega-panel-heading mega-panel-heading-row">
        <h2>Search, analyze, and visualize maize data &#8212; commonly-used tools</h2>
        <div class="mega-heading-actions">
          <a class="mega-heading-action" href="$(server-url)/sitemap">View every tool <span aria-hidden="true">&#8594;</span></a>
        </div>
      </div>
      <!-- The featured-tool column is gone, so this is four lists rather than a
           feature plus three. The AI tools that were only reachable through the
           old footer link now have a column of their own. -->
      <div class="mega-grid mega-grid-4 mega-grid-tools mega-compact-groups">
        <section class="mega-group">
          <h3>Search &amp; compare</h3>
          <a href="$(blast_url)"><strong>BLAST</strong></a>
          <a href="$(server-url)/gene_center/gene"><strong>Gene model search</strong></a>
          <a href="https://gcv.maizegdb.org" target="_blank" rel="noopener"><strong>Genome Context Viewer</strong></a>
          <a href="$(server-url)/foldseek"><strong>Foldseek</strong></a>
          <a href="$(server-url)/fatcat"><strong>FATCAT</strong></a>
        </section>
        <section class="mega-group">
          <h3>Genes &amp; function</h3>
          <a href="https://qteller.maizegdb.org" target="_blank" rel="noopener"><strong>qTeller</strong></a>
          <a href="https://corncyc-b73-v4.maizegdb.org" target="_blank" rel="noopener"><strong>CornCyc</strong></a>
          <a href="$(server-url)/data_center/protein_structure"><strong>Protein structures <span class="mega-tag mega-tag-updated">Updated</span></strong></a>
          <a href="https://phylostrata.maizegdb.org" target="_blank" rel="noopener"><strong>Phylostrata <span class="mega-tag mega-tag-new">New</span></strong></a>
        </section>
        <section class="mega-group">
          <h3>Genomes &amp; variation</h3>
          <a href="https://pangenome-viewer.maizegdb.org/?set=NAM&amp;geneID=Zm00001eb406090" target="_blank" rel="noopener"><strong>NAM pangenome gene viewer <span class="mega-tag mega-tag-new">New</span></strong></a>
          <a href="https://pangenome-viewer.maizegdb.org" target="_blank" rel="noopener"><strong>Pangenome graph <span class="mega-tag mega-tag-new">New</span></strong></a>
          <a href="https://snptools.maizegdb.org" target="_blank" rel="noopener"><strong>SNPTools <span class="mega-tag mega-tag-new">New</span></strong></a>
          <a href="https://wgs.maizegdb.org" target="_blank" rel="noopener"><strong>SNPversity</strong></a>
          <a href="https://genomeqc.maizegdb.org" target="_blank" rel="noopener"><strong>GenomeQC</strong></a>
        </section>
        <section class="mega-group">
          <h3>AI &amp; machine learning</h3>
          <a href="$(server-url)/ai"><strong>AI at MaizeGDB</strong></a>
          <a href="https://feta.maizegdb.org" target="_blank" rel="noopener"><strong>FETA <span class="mega-tag mega-tag-new">New</span></strong></a>
          <a href="$(server-url)/effect/maize_v2"><strong>PanEffect</strong></a>
          <a href="https://mfs.maizegdb.org/" target="_blank" rel="noopener"><strong>MaizeGDB Feature Store</strong></a>
        </section>
      </div>
    </div>
  </span>
)
