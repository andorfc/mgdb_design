$$SYNTAX-LEVEL 2
*(tools
  <a href="#" class="drop">$(tools_name)</a>
  <span id="tool_menu">
    <div class="dropdown_fullwidth mega-dropdown mega-dropdown-wide">
      <div class="mega-panel-heading mega-panel-heading-row">
        <div>
          <span class="mega-eyebrow">Research tools</span>
          <h2>Search, analyze, and visualize maize data</h2>
        </div>
        <a class="mega-heading-action" href="$(server-url)/sitemap">View every tool <span aria-hidden="true">&#8594;</span></a>
      </div>
      <div class="mega-grid mega-grid-tools mega-compact-groups">
        <aside class="mega-feature mega-feature-blue mega-feature-tools">
          <span class="mega-badge">Featured tool</span>
          <h3>SNPTools</h3>
          <p>Explore, compare, and annotate maize SNP data with a streamlined analysis workspace.</p>
          <a class="mega-feature-link" href="https://snptools.maizegdb.org" target="_blank" rel="noopener">Launch SNPTools <span aria-hidden="true">&#8599;</span></a>
        </aside>
        <section class="mega-group">
          <h3>Search &amp; compare</h3>
          <a href="$(blast_url)"><strong>BLAST</strong></a>
          <a href="$(server-url)/gene_center/gene"><strong>Gene model search</strong></a>
          <a href="https://gcv.maizegdb.org" target="_blank" rel="noopener"><strong>Genome Context Viewer</strong></a>
          <a href="$(server-url)/foldseek"><strong>Foldseek</strong></a>
        </section>
        <section class="mega-group">
          <h3>Genes &amp; function</h3>
          <a href="https://qteller.maizegdb.org" target="_blank" rel="noopener"><strong>qTeller</strong></a>
          <a href="https://feta.maizegdb.org" target="_blank" rel="noopener"><strong>FETA</strong></a>
          <a href="https://corncyc-b73-v4.maizegdb.org" target="_blank" rel="noopener"><strong>CornCyc</strong></a>
          <a href="$(server-url)/data_center/protein_structure"><strong>Protein structures</strong></a>
        </section>
        <section class="mega-group">
          <h3>Genomes &amp; variation</h3>
          <a href="https://pangenome-viewer.maizegdb.org/?set=NAM&amp;geneID=Zm00001eb406090" target="_blank" rel="noopener"><strong>NAM pangenome gene viewer</strong></a>
          <a href="https://pangenome-viewer.maizegdb.org" target="_blank" rel="noopener"><strong>Pangenome graph</strong></a>
          <a href="$(server-url)/effect/maize_v2"><strong>PanEffect</strong></a>
          <a href="https://genomeqc.maizegdb.org" target="_blank" rel="noopener"><strong>GenomeQC</strong></a>
          <a href="https://wgs.maizegdb.org" target="_blank" rel="noopener"><strong>SNPversity</strong></a>
        </section>
      </div>
      <div class="mega-panel-footer mega-panel-footer-split">
        <a href="$(server-url)/ai">Explore AI tools at MaizeGDB <span aria-hidden="true">&#8594;</span></a>
        <a href="$(server-url)/sitemap">All tools and genome browsers</a>
      </div>
    </div>
  </span>
)
