$$SYNTAX-LEVEL 2
*(community
    <a href="#" class="drop">$(community_name)</a><!-- Begin Community Item -->
    <span id="community_menu"><div class="dropdown_4columns"><!-- Begin Community container -->
        <div class="col_4 firstcolumn">
            <h2>Maize genetics community</h2>
            <div class="col_1 firstcolumn">
			<h3>Maize Genetics Cooperation - MGC</h3>
			<ul>
				<li><a href="https://www.maizegenetics.org/">MGC website</a></li>
				<li><a href="https://www.maizegenetics.org/mgac">Advocacy</a></li>
				<li><a href="https://www.maizegenetics.org/awards/community-awards">Awards</a></li>
				<li><a href="https://www.mgcmeeting.com">Maize Meeting</a></li>
        <li><a href="https://www.maizegenetics.org/thekernel">The Kernel</a></li>
			</ul>
      </div>
      <div class="col_1 ">
        <h3><br>Articles</h3>
        <ul>
            <li><a href="$(server-url)/data_center/reference">Find a paper</a></li>
            <li><a href="$(server-url)/hot_new_papers">Editorial Board picks</a></li>
            <li><a href="$(server-url)/maize_history#history-classic-reads">Classic reads</a></li>
            <li><a href="$(server-url)/mnl">Maize newsletter (MNL\)</a></li>
            <li><a href="$(server-url)/community/videos">Videos</a></li>
        </ul>
      </div>
      <div class="col_1 ">
        <h3><br>Data</h3>
        <ul>
            <li><a href="$(server-url)/FAIRpractices">FAIR data at MaizeGDB</a></li>
            <li><a href="$(server-url)/contribute_data">Contribute data</a></li>
            <li><a href="https://download.maizegdb.org" target="_blank">Downloads</a></li>
            <li><a href="/nomenclature">Nomenclature</a></li>
        </ul>
      </div>
      <div class="col_1 ">
          <h3><br>Resources</h3>
          <ul>
            <li><a href="$(server-url)/person">Find researchers</a></li>
            <li><a href="/projects">Research projects</a></li>
            <li><a href="$(server-url)/jobs">Jobs</a></li>
            <li><a href="$(server-url)/maize_history">Maize research history</a></li>
            <li><a href="https://rilab.ucdavis.edu/maize_history.html">Maize history</a></li>
            <br>
          </ul>
      </div>
        </div>
        <br><br>
        <div class="col_4 firstcolumn">
            <div class="col_3 firstcolumn">
                <h2><br>Maize Genetics Meeting</h2>
				<table>
                <tr>
					<td valign="top">
						<a href="/maize_meeting"><img src="$(image-dir)/MGC2027_img.png" width="193px" height="70px" border=0 frameborder='no' class="img_left" alt=""/></a>
					</td>
					<td valign="top">
						<p>The 69th Annual Maize Genetics Meeting will be held from <b>March 11th - 14th, 2027</b> at the Hyatt Regency O'Hare Chicago, Rosemont, Illinois, USA.<br></p>
					</td>
				</tr>
                <tr>
					<td valign="top">
						<a href="https://www.mgcmeeting.com" target="_blank"><img src="$(image-dir)/MGC2026_img.png" width="193px" height="70px" border=0 frameborder='no' class="img_left" alt=""/></a>
					</td>
					<td valign="top">
						<p>The 68th Annual Maize Genetics Meeting was held from <b>February 26th - March 1st, 2026</b> at the Maritim Hotel, Cologne, Germany.<br></p>
					</td>
				</tr>

				</table>
            </div>
               
            <div class="col_1">
                <h2><br>Archive</h2>
                <center>
                    <table cellspacing=7 cellpadding=5 class="black_box">

                        <tr>
                          <td>
                            <a style="color: white;" href="$(server-url)/maize_meeting/">Website</a>
                            <br>
                          </td>
                          <td>
                            <a style="color: white;" href="$(server-url)/maize_meeting/">Abstracts</a>
                            <br>
                          </td>
                        </tr>
                        <tr>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="$(server-url)/mgc/maizemeeting/2025">2025</a> <br>
                              </center>
                            </td>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="https://documents.maizegdb.org/maizemeeting/abstracts/2025Program.pdf">2025</a> <br>
                              </center>
                            </td>
                        </tr>
                        <tr>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="$(server-url)/mgc/maizemeeting/2024">2024</a> <br>
                              </center>
                            </td>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="https://documents.maizegdb.org/maizemeeting/abstracts/2024Program.pdf">2024</a> <br>
                              </center>
                            </td>
                        </tr>
                        <tr>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="$(server-url)/mgc/maizemeeting/2023">2023</a> <br>
                              </center>
                            </td>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="https://documents.maizegdb.org/maizemeeting/abstracts/2023Program.pdf">2023</a> <br>
                              </center>
                            </td>
                        </tr>
                        <tr>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="$(server-url)/mgc/maizemeeting/2022">2022</a> <br>
                              </center>
                            </td>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="https://documents.maizegdb.org/maizemeeting/abstracts/2022Program.pdf">2022</a> <br>
                              </center>
                            </td>
                        </tr>
                         <tr>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="$(server-url)/mgc/maizemeeting/2021">2021</a> <br>
                              </center>
                            </td>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="https://documents.maizegdb.org/maizemeeting/abstracts/2021Program.pdf">2021</a> <br>
                              </center>
                            </td>
                        </tr>
                         <tr>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="$(server-url)/maize_meeting/v2020">2020</a> <br>
                              </center>
                            </td>
                            <td colspan=1>
                              <center>
                                <a style="color: white;" href="https://documents.maizegdb.org/maizemeeting/abstracts/2020Program.pdf">2020</a> <br>
                              </center>
                            </td>
                        </tr>
                        <tr>
                            <td colspan=2>
                              <center>
                                <a style="color: white;" href="$(server-url)/maize_meeting/">more...</a>
                              </center>
                            </td>
                        </tr>
                    </table>
                </center>
            </div>
        </div>

    </div>
  </span>
  <!-- End Community container -->
)
