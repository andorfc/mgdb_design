$$SYNTAX-LEVEL 2
*(data-centers
    <a href="#" class="drop">$(dc_name)</a><!-- Begin Data Hubs Item -->
    <span id="data_center_menu">
    <div class="dropdown_2columns"><!-- Begin Data Hubs container -->
        <div class="col_1 firstcolumn">
            <h3>A-I</h3>
            <ul>
                <li><a href="$(server-url)/data_center/variation">Alleles/Polymorphisms</a></li>
                <li><a href="$(server-url)/ai/variation">Artificial Intelligence</a></li>
                <li><a href="$(server-url)/genetic_variation">SNPs/Traits</a></li>
                <li><a href="$(server-url)/expression">Expression</a></li>
                <li><a href="$(server-url)/gene_center/gene">Gene/Gene Models</a></li>
                <li><a href="$(server-url)/data_center/gene_product">Gene Products</a></li>
                <li><a href="$(server-url)/genome">Genomes</a></li>
                <li><a href="$(server-url)/data_center/image">Images</a></li>
                <li><a href="$(server-url)/insertion">Insertions</a></li>
            </ul>
        </div>
        <div class="col_1">
            <h3>L-Z</h3>
            <ul>
                <li><a href="$(server-url)/data_center/locus">Loci + QTL</a></li>
                <li><a href="$(server-url)/data_center/map">Maps</a></li>
                <li><a href="$(server-url)/metabolic_pathways/">Metabolic Pathways</a></li>
                <li><a href="$(server-url)/data_center/marker">Molecular Markers</a></li>
                <li><a href="$(server-url)/data_center/phenotype">Mutants & Phenotypes</a></li>
                <li><a href="$(server-url)/pan_gene_center/pan_gene">Pan-genes</a></li>
                <li><a href="$(server-url)/data_center/protein_structure">Protein Structure</a></li>
                <li><a href="$(server-url)/data_center/reference">References</a></li>
                <li><a href="$(server-url)/data_center/stock">Stocks</a></li>
            </ul>
        </div>
        <hr>
        <div align="center" width="100%" class="smalltext">
          <a href="/archive">Archived data hubs</a>
        </div>
    </div>
  </span>
  <!-- End Data Hubs container -->
)
