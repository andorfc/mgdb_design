$$SYNTAX-LEVEL 2
*(mgdb-coop-order-completed
<main class="mgdb-page mgdb-coop-order-page" id="mgdb-coop-order-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/stock_catalog">Stocks</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Request submitted</span>
  </nav>

  <section class="coop-done">
    <span class="coop-done-check" aria-hidden="true">
      <svg viewBox="0 0 84 84" role="presentation" focusable="false">
        <circle cx="42" cy="42" r="34" fill="none" stroke="currentColor" stroke-width="5"/>
        <path d="M27 43l11 11 20-24" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <h1>Your request was submitted</h1>
    <p>The Maize Genetics Cooperation Stock Center has your request. If you do not hear back within 24 hours, write to <a href="mailto:maize@uiuc.edu">maize@uiuc.edu</a> to confirm it was received.</p>
    <div class="mgdb-form-actions coop-done-actions">
      <a class="mgdb-button mgdb-button-secondary" href="/stock_catalog">Browse the stock catalog</a>
      <a class="mgdb-button mgdb-button-quiet" href="/ordering/coop_order">Start another request</a>
    </div>
  </section>

</main>
)
