$$SYNTAX-LEVEL 2
*(mgdb-genome-issue
;; css/curation.css is deliberately NOT loaded here. It carries bare
;; `body,td,th`, `p`, `a`, `h1`, `fieldset` and `legend` rules, which on a modern
;; page reach the megamenu and the hero as well as this form. The controller
;; loads css/mgdb-genome-issue.css instead, which styles the same controls
;; scoped to this page. js/GenomeIssue.js IS still loaded, by the controller:
;; validateIssueForm, Check and resetField are referenced from the markup
;; below and are unchanged.

<a class="mgdb-skip-link" href="#gi-main">Skip to main content</a>

<main class="mgdb-page mgdb-hub-page mgdb-genome-issue-page" id="gi-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span>
    <a href="/genome">Genomes</a><span aria-hidden="true">&rsaquo;</span>
    <span aria-current="page">Report an issue</span>
  </nav>
  <section class="mgdb-hero" aria-labelledby="gi-title">
    <div class="mgdb-hero-emblem gi-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="A sequence track with a flag on one feature">
        <path d="M10 58h76" stroke="#7fae8c" stroke-width="4" stroke-linecap="round" />
        <rect x="18" y="50" width="14" height="16" rx="2" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <rect x="40" y="50" width="12" height="16" rx="2" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <rect x="60" y="50" width="18" height="16" rx="2" fill="#f7e2b0" stroke="#8a5a0f" stroke-width="3" />
        <path d="M69 50V22" stroke="#8a5a0f" stroke-width="3.5" stroke-linecap="round" />
        <path d="M69 24h18l-5 7 5 7H69z" fill="#d99a0b" stroke="#8a5a0f" stroke-width="2.5" stroke-linejoin="round" />
      </svg>
      <strong>Report an issue</strong>
      <span class="gi-emblem-meta">Assembly &middot; Gene model</span>
    </div>
    <div class="mgdb-hero-body">
      @(genome-issue {display: off}
      <h1 id="gi-title">Report an assembly problem</h1>
      <p class="mgdb-hero-description">If you have found a region of the maize reference genome assembly or a gene model that seems to be in error or is missing from the assembly, or a region of variation that needs to be better represented, tell us. Give as much detail as you can and someone at MaizeGDB will get back to you.</p>
      )
      @(gene-model-issue {display: off}
      <h1 id="gi-title">Report a gene model problem</h1>
      <p class="mgdb-hero-description">If you have found a problem with a gene model, tell us. Give as much detail as you can and someone at MaizeGDB will get back to you.</p>
      )
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#gi-form" class="is-current" aria-current="true">The report</a>
    <a href="#gi-next">What happens next</a>
    <a href="#gi-related">Related resources</a>
  </nav>

  <section id="gi-form" aria-labelledby="gi-form-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gi-form-title">The report</h2></div>
    </div>

    @(error {display: off}
      <div class="mgdb-message mgdb-message-error" role="alert">
        $(error-msg)
      </div>
    )

    @(edit-form {display: on}
          <p class="gi-required-note">Fields marked <span class="gi-req" aria-hidden="true">*</span> are required.</p>
          <form class="grc_form" onsubmit="return validateIssueForm(\);" name="problem" 
                action="/curation/GenomeIssue/save" method="POST" 
                enctype="multipart/form-data">
            <input type="hidden" id="URL" name="URL">
            <fieldset>
              <legend>
                Genome Information
              </legend>
              <p class="gi-hint">Provide information about the genome assembly which this issue addresses.</p>
              <label for="genome_assembly">Genome version: </label>
              <select id="genome_assembly" name="genome_assembly">
                <option value="Zm-B73-REFERENCE-NAM-5.0" $(Zm-B73-REFERENCE-NAM-5.0-selected)>Zm-B73-REFERENCE-NAM-5.0 (B73 RefGen_v5\)</option>
                <option value="Zm-B73-REFERENCE-GRAMENE-4.0" $(Zm-B73-REFERENCE-GRAMENE-4.0-selected)>Zm-B73-REFERENCE-GRAMENE-4.0 (B73 RefGen_v4\)</option>
                <option value="B73 RefGen_v3" $(B73_RefGen_v3-selected)>B73 RefGen_v3</option>
                <option value="B73 RefGen_v2" $(B73_RefGen_v2-selected)>B73 RefGen_v2</option>
                <option value="Zm-B97-REFERENCE-NAM-1.0" $(Zm-B97-REFERENCE-NAM-1.0-selected)>Zm-B97-REFERENCE-NAM-1.0</option>
                <option value="Zm-B104-DRAFT-ISU_USDA-0.1" $(Zm-B104-DRAFT-ISU_USDA-0.1-selected)>Zm-B104-DRAFT-ISU_USDA-0.1 (B104 pre-release\)</option>
                <option value="Zm-CML52-REFERENCE-NAM-1.0" $(Zm-CML52-REFERENCE-NAM-1.0-selected)>Zm-CML52-REFERENCE-NAM-1.0</option>
                <option value="Zm-CML69-REFERENCE-NAM-1.0" $(Zm-CML69-REFERENCE-NAM-1.0-selected)>Zm-CML69-REFERENCE-NAM-1.0</option>
                <option value="Zm-CML103-REFERENCE-NAM-1.0" $(Zm-CML103-REFERENCE-NAM-1.0-selected)>Zm-CML103-REFERENCE-NAM-1.0</option>
                <option value="Zm-CML228-REFERENCE-NAM-1.0" $(Zm-CML228-REFERENCE-NAM-1.0-selected)>Zm-CML228-REFERENCE-NAM-1.0</option>
                <option value="Zm-CML247-REFERENCE-NAM-1.0" $(Zm-CML247-REFERENCE-NAM-1.0-selected)>Zm-CML247-REFERENCE-NAM-1.0</option>
                <option value="Zm-CML247-DRAFT-PANZEA-1.0" $(Zm-CML247-DRAFT-PANZEA-1.0-selected)>Zm-CML247-DRAFT-PANZEA-1.0</option>
                <option value="Zm-CML277-REFERENCE-NAM-1.0" $(Zm-CML277-REFERENCE-NAM-1.0-selected)>Zm-CML277-REFERENCE-NAM-1.0</option>
                <option value="Zm-CML322-REFERENCE-NAM-1.0" $(Zm-CML322-REFERENCE-NAM-1.0-selected)>Zm-CML322-REFERENCE-NAM-1.0</option>
                <option value="Zm-CML333-REFERENCE-NAM-1.0" $(Zm-CML333-REFERENCE-NAM-1.0-selected)>Zm-CML333-REFERENCE-NAM-1.0</option>
                <option value="Zm-EP1-REFERENCE-TUM-1.0" $(Zm-EP1-REFERENCE-TUM-1.0-selected)>Zm-EP1-REFERENCE-TUM-1.0</option>
                <option value="Zm-F7-REFERENCE-TUM-1.0" $(Zm-F7-REFERENCE-TUM-1.0-selected)>Zm-F7-REFERENCE-TUM-1.0</option>
                <option value="Zm-HP301-REFERENCE-NAM-1.0" $(Zm-HP301-REFERENCE-NAM-1.0-selected)>Zm-HP301-REFERENCE-NAM-1.0</option>
                <option value="Zm-Il14H-REFERENCE-NAM-1.0" $(Zm-Il14H-REFERENCE-NAM-1.0-selected)>Zm-Il14H-REFERENCE-NAM-1.0</option>
                <option value="Zm-Ki3-REFERENCE-NAM-1.0" $(Zm-Ki3-REFERENCE-NAM-1.0-selected)>Zm-Ki3-REFERENCE-NAM-1.0</option>
                <option value="Zm-Ki11-REFERENCE-NAM-1.0" $(Zm-Ki11-REFERENCE-NAM-1.0-selected)>Zm-Ki11-REFERENCE-NAM-1.0</option>
                <option value="Zm-Ky21-REFERENCE-NAM-1.0" $(Zm-Ky21-REFERENCE-NAM-1.0-selected)>Zm-Ky21-REFERENCE-NAM-1.0</option>
                <option value="Zm-M37W-REFERENCE-NAM-1.0" $(Zm-M37W-REFERENCE-NAM-1.0-selected)>Zm-M37W-REFERENCE-NAM-1.0</option>
                <option value="Zm-M162W-REFERENCE-NAM-1.0" $(Zm-M162W-REFERENCE-NAM-1.0-selected)>Zm-M162W-REFERENCE-NAM-1.0</option>
                <option value="Zm-Mo17-REFERENCE-NRGENE-1.0" $(Zm-Mo17-REFERENCE-NRGENE-1.0-selected)>Zm-Mo17-REFERENCE-NRGENE-1.0</option>
                <option value="Zm-Mo17-REFERENCE-YAN-1.0" $(Zm-Mo17-REFERENCE-YAN-1.0-selected)>Zm-Mo17-REFERENCE-YAN-1.0 (Mo17 - Yan lab\)</option>
                <option value="Zm-Mo18-REFERENCE-NAM-1.0" $(Zm-Mo18-REFERENCE-NAM-1.0-selected)>Zm-Mo18-REFERENCE-NAM-1.0</option>
                <option value="Zm-Ms71-REFERENCE-NAM-1.0" $(Zm-Ms71-REFERENCE-NAM-1.0-selected)>Zm-Ms71-REFERENCE-NAM-1.0</option>
                <option value="Zm-NC350-REFERENCE-NAM-1.0" $(Zm-MoNC35018-REFERENCE-NAM-1.0-selected)>Zm-NC350-REFERENCE-NAM-1.0</option>
                <option value="Zm-NC358-REFERENCE-NAM-1.0" $(Zm-NC358-REFERENCE-NAM-1.0-selected)>Zm-NC358-REFERENCE-NAM-1.0</option>
                <option value="Zm-Oh7B-REFERENCE-NAM-1.0" $(Zm-Oh7B-REFERENCE-NAM-1.0-selected)>Zm-Oh7B-REFERENCE-NAM-1.0</option>
                <option value="Zm-Oh43-REFERENCE-NAM-1.0" $(Zm-Oh43-REFERENCE-NAM-1.0-selected)>Zm-Oh43-REFERENCE-NAM-1.0</option>
                <option value="Zm-P39-REFERENCE-NAM-1.0" $(Zm-P39-REFERENCE-NAM-1.0-selected)>Zm-P39-REFERENCE-NAM-1.0</option>
                <option value="Zm-PH207-REFERENCE_NS-UIUC_UMN-1.0" $(Zm-PH207-REFERENCE_NS-UIUC_UMN-1.0-selected)>Zm-PH207-REFERENCE_NS-UIUC_UMN-1.0</option>
                <option value="Zm-Tx303-REFERENCE-NAM-1.0" $(Zm-Tx303-REFERENCE-NAM-1.0-selected)>Zm-Tx303-REFERENCE-NAM-1.0</option>
                <option value="Zm-Tzi8-REFERENCE-NAM-1.0" $(Zm-Tzi8-REFERENCE-NAM-1.0-selected)>Zm-Tzi8-REFERENCE-NAM-1.0</option>
                <option value="Zm-W22-REFERENCE-NRGENE-2.0" $(Zm-W22-REFERENCE-NRGENE-2.0-selected)>Zm-W22-REFERENCE-NRGENE-2.0</option>
                <option value="Zx-PI566673-REFERENCE-YAN-1.0" $(Zx-PI566673-REFERENCE-YAN-1.0-selected)>Zx-PI566673-REFERENCE-YAN-1.0</option>
              </select>
            </fieldset>
            @(gene-model-section {display: off}
            <fieldset>
              <legend>
                Gene Model Information
              </legend>
              <p class="gi-hint">If this issue is regarding a gene model, make sure the correct gene model is listed here.</p>
              <label for="gene_model">Gene Model</label>
              <input name="gene_model" id="gene_model" value="$(gene-model)">
              <br>
              <label for="gene_model_version">Gene Model Version</label>
              <select name="gene_model_version" id="gene_model_version">
                <option value="Zm00001eb.1" $(Zm00001eb-selected)$(default-selected)>Zm00001eb.1 (B73 RefGen_v5\)</option>
                <option value="Zm00001d.2" $(Zm00001d-selected)$(default-selected)>Zm00001d.2 (B73 RefGen_v4\)</option>
                <option value="B73 RefGen_v3" $(B73_RefGen_v3-selected)>B73 RefGen_v3</option>
                <option value="B73 RefGen_v2" $(B73_RefGen_v2-selected)>B73 RefGen_v2</option>
                <option value="Zm00004b.1" $(Zm00004b-selected)>Zm00004b.1 (W22 v2.0\)</option>
                <option value="Zm00007a.1" $(Zm00007a-selected)>Zm00007a.1 (B104 v0.1\)</option>
                <option value="Zm00008a.1" $(Zm00008a-selected)>Zm00008a.1 (PH207 v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00009a-selected)>Zm00009a.1 (Mo17 Yan lab v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00018ab-selected)>Zm00018ab.1 (B97 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00019ab-selected)>Zm00019ab.1 (CML52 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00020ab-selected)>Zm00020ab.1 (CML69 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00021ab-selected)>Zm00021ab.1 (CML103 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00022ab-selected)>Zm00022ab.1 (CML228 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00023ab-selected)>Zm00023ab.1 (CML247 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00024ab-selected)>Zm00024ab.1 (CML277 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00025ab-selected)>Zm00025ab.1 (CML322 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00026ab-selected)>Zm00026ab.1 (CML333 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00027ab-selected)>Zm00027ab.1 (HP301 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00028ab-selected)>Zm00028ab.1 (Il14H NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00029ab-selected)>Zm00029ab.1 (Ki3 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00030ab-selected)>Zm00030ab.1 (Ki11 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00031ab-selected)>Zm00031ab.1 (Ky21 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00032ab-selected)>Zm00032ab.1 (M37W NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00033ab-selected)>Zm00033ab.1 (M162W NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00034ab-selected)>Zm00034ab.1 (Mo18 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00035ab-selected)>Zm00035ab.1 (Ms71 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00036ab-selected)>Zm00036ab.1 (NC350 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00037ab-selected)>Zm00037ab.1 (NC358 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00038ab-selected)>Zm00038ab.1 (Oh7B NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00039ab-selected)>Zm00039ab.1 (Oh43 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00040ab-selected)>Zm00040ab.1 (P39 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00041ab-selected)>Zm00041ab.1 (Tx303 NAM v1.0\)</option>
                <option value="Zm00009a.1" $(Zm00042ab-selected)>Zm00042ab.1 (Tzi8 NAM v1.0\)</option>
                <option value="Zx00001a.1" $(Zx00001a-selected)>Zx00001a.1 (mexicana\)</option>
              </select>
            </fieldset>
            )
            @(genome-location-section {display: off}
            <fieldset>
              <legend>
                Location Information
              </legend>
              <p class="gi-hint">If this issue is regarding the assembly, give the location of the issue using either bp coordinates or flanking BACs &#40;give GenBank accessions&#41;.</p>
              <p>Please provide information concerning the location of the issue. 
                You can either provide information using the chromosome coordinates 
                or the flanking accessions used to generate the genome build. If 
                the location is unknown or you are reporting sequence not found on 
                the assembly, then select 'None' from the chromosome pulldown menu.
              </p>
              <br>
              <label for="chromosome">Chromosome</label>
              <select name="chromosome" id="chromosome" onclick="resetField('chromosome'\)">
                <option value = "0" selected="selected">Select one</option>
                <option value="0">NONE</option>
                <option name="chr1" value="1">chr1</option>
                <option name="chr2" value="2">chr2</option>
                <option name="chr3" value="3">chr3</option>
                <option name="chr4" value="4">chr4</option>
                <option name="chr5" value="5">chr5</option>
                <option name="chr6" value="6">chr6</option>
                <option name="chr7" value="7">chr7</option>
                <option name="chr8" value="8">chr8</option>
                <option name="chr9" value="9">chr9</option>
                <option name="chr10 "value="10">chr10</option>
                <option value="7955">chrUnknown</option>
              </select>                     
              <div class="gi-split">
                  <div>
                    <fieldset id="chr_position" class="minor">
                      <legend>Specify by Chromosome coordinates</legend>
                      <label for="range_id" id="range_type_label">Range Type</label>
                      <input type="radio" name="range_type" id="range_id" value="loc" 
                             checked="checked" onclick = "Check(\)">
                      <br>
                      <div id="chr_pos_els">
                        <label for="chr_start" id="chr_start_label">Chromosome Start</label>
                        <input name="chr_start" id="chr_start">
                        <br>
                        <span id="chr_start_errortext"></span>
                        <label for="chr_end" id="chr_end_label">Chromosome End&nbsp;</label>
                        <input name="chr_end" id="chr_end">
                        <br>
                        <span id="chr_end_errortext"></span>
                      </div>
                    </fieldset>
                  </div>
                  <div>
                    <fieldset id="acc_list" class="minor">
                      <legend>Specify by Flanking accessions</legend>
                      <label for="range_acc" id="range_acc_label">Flanking Accessions</label> 
                      <input type="radio" name="range_type" id="range_acc" value="acc" 
                             onclick = "Check(\)">
                      <br>
                      <div id="acc_list_els" class="disabled">
                        <label for="first_acc" id="first_acc_label">
                          First Accession
                        </label>
                        <input name="first_acc" id="first_acc" disabled="disabled">
                        <br>
                        <label for="last_acc" id="last_acc_label">
                          Last Accession
                        </label>
                        <input name="last_acc" id="last_acc" disabled="disabled">
                      </div>
                    </fieldset>
                  </div>
              </div>
            </fieldset>
          )
          <fieldset>
            <legend>
              Submitter Information
            </legend>
            <p class="gi-hint">Please provide enough information about yourself or your research leader so that we or other researchers may contact you for more information.</p>
            <p>Please provide some information about yourself.</p>
            <label for="sub_name">Name:
            <span style="color:red"><em>*</em></span></label>
            <input type="text" name="sub_name" id="sub_name" value="$(cur_name)">
            <br>
            <label for="email">Submitter Email 
            <span style="color:red"><em>*</em></span> </label>
            <input name="email" id="email" value="$(cur_email)"
                   onclick="resetField('email'\)">
            <br>
            <label for="affiliation">Affiliation 
            <span style="color:red"><em>*</em></span></label>
            <input name= "affiliation" id="affiliation" 
                   onclick="resetField('affiliation'\)"/>
            <br>
            <label for="position">Position 
            <span style="color:red"><em>*</em></span></label>
            <select name="position" id="position" onclick="resetField('position'\)">
              <option value = "" >select one</option>
              <option value="grad student">grad student</option>
              <option value="lab head">lab head</option>
              <option value="post doc">post doc</option>
              <option value="staff scientist">staff scientist</option>
              <option value="programmer/bioinformatician">programmer/bioinformatician</option>
              <option value="other">other</option>
            </select>
          </fieldset>
          <fieldset>
            <legend>
              Issue Detail
            </legend>
            <p class="gi-hint">Provide a description of the issue, including supporting sequence. You may also upload a figure or diagram. <strong>There must be supporting sequence for an issue to be considered, the sequence must belong to the genotype or inbred of the selected genome assembly, and the sequence must be in GenBank.</strong></p>
            <p>Please provide detailed information about the genome issue you are 
              reporting. List any sequence accessions used to define the issue.
            </p>
            <label style="text-align:top" for="description">
              Description of issue <span style="color:red"><em>*</em></span>
            </label>
            <br>
            <textarea style="text-align:middle" name="description" 
                      id="description" cols="70" rows="10" 
                      onclick="resetField('description'\)"></textarea>
            <br>
            <div class="gi-field">
                  <label for="sequence">Supporting sequence
                  <span class="gi-field-hint">must be a GenBank accession</span></label>
                  <input name="sequence" id="sequence" 
                         onclick="resetField('sequence'\)">
            </div>
            <br>
            <input type="hidden" name="MAX_FILE_SIZE" value="50000000">
            <label for="attachment">
              Attach a figure describing the issue (no bigger than 5MB\):
            </label>
            <input type="file" name="attachment" id="attachment">
          </fieldset>
          <p class="gi-submit"><input class="submit_button" type="submit" value="Submit Issue"></p>
        </form>
    )
  </section>

  <section id="gi-next" aria-labelledby="gi-next-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gi-next-title">What happens next</h2></div>
    </div>

    <div class="gi-prose">
      <p>Your report goes to MaizeGDB's curators, who work it with the group that produced the assembly or annotation. You will be contacted at the address you gave if more is needed.</p>
      <p>While it is open, the report is listed publicly &mdash; without your contact details &mdash; on the page for its kind, so anyone else who hits the same problem can see it is already known. A report drops off that list when it is resolved.</p>
    </div>

    <p class="gi-actions">
      <a class="mgdb-button mgdb-button-secondary" href="/curation/assemblyIssues">Open assembly issues <span aria-hidden="true">&rarr;</span></a>
      <a class="mgdb-button mgdb-button-secondary" href="/curation/geneModelIssues">Open gene model issues <span aria-hidden="true">&rarr;</span></a>
    </p>
  </section>

  <section id="gi-related" class="mgdb-hub-related" aria-labelledby="gi-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gi-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/genomebrowser">
          <strong>Genome Browser Data Hub</strong>
          <span>Look at the region first, and copy the coordinates this form asks for</span>
        </a>
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>Find the gene model identifier, and check which annotation it belongs to</span>
        </a>
        <a href="/genome">
          <strong>Genome Data Hub</strong>
          <span>Every assembly and annotation MaizeGDB holds, and how each was built</span>
        </a>
        <a href="/nomenclature_summary">
          <strong>Assembly and annotation names</strong>
          <span>How to read the assembly and gene model identifiers this form lists</span>
        </a>
        <a href="/feedback">
          <strong>Feedback</strong>
          <span>Anything about MaizeGDB that is not an assembly or gene model problem</span>
        </a>
      </div>
    </div>
  </section>

  ;; The form records the page the reporter came from, so a curator can see what
  ;; they were looking at. Left exactly as it was.
  <script language="Javascript">
    $\('#URL'\).val(document.referrer\);
  </script>

</main>
)
