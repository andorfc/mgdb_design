*(mgdb-nomenclature-assembly
<main class="mgdb-page mgdb-hub-page mgdb-nomenclature-assembly-page" id="nomenclature-assembly-main">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
