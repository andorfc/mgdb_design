<table cellspacing=0 width="100%"
       summary="A table containing the main page content.">
  <tr valign='center'>
    <td class="padding">
      <p style="margin-bottom: 8px;">
        <span style="font-family: Verdana, Arial, sans-serif; font-size: 120%; font-weight: bold; margin-bottom: 6px;">
          A Standard For Maize Genetics Nomenclature
        </span>
      </p>
      <p>
        From <a href="https://mnl.maizegdb.org/mnl/69/00MNL 69or.pdf">MNL 69:182-184</a> (1995\), 
        as updated Sep 1996; Apr 2000; Apr 2002; 
        Oct 2006.
        <br><br>
        Gene model identifiers updated in 2015 and 2021.
      </p>
      <br><br>
      <a NAME="INDEX"></a><h2>Index:</h2><br>
      <div>
        <ul class="listmenu">
          <li class="listmenu">
            <a HREF="#PREAMBLE">Preamble</a>
          </li>
          <li class="listmenu">
            <a HREF="#DEFINITIONS">1. Definitions</a>
          </li>
          <li class="listmenu">
            <a HREF="#ANONYMOUS">2. Anonymous Transcripts</a> &mdash; Sep 1996 update
          </li>
