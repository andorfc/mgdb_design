$$SYNTAX-LEVEL 2
*(fpt-notfound
<main class="mgdb-page mgdb-hub-page fpt-page fpt-notfound-page" id="fnf-main">
  <section class="mgdb-hero fpt-hero" aria-labelledby="fnf-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/fusarium/fpt-mark.png" alt="" class="fpt-hero-mark" width="240" height="115" />
      <strong>Not found</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="fnf-title">There is no toolkit page at this address</h1>
      <p class="mgdb-hero-description">Nothing in the Fusarium Protein Toolkit is at <code>$(requested)</code>. The toolkit's pages are below, and a protein can be looked up from the home page.</p>
      <div class="mgdb-hero-actions">
        <a class="mgdb-button mgdb-button-primary" href="/fusarium">Toolkit home</a>
        <a class="mgdb-button mgdb-button-secondary" href="/fusarium/foldseek">Foldseek</a>
        <a class="mgdb-button mgdb-button-secondary" href="/fusarium/structures">Structures</a>
        <a class="mgdb-button mgdb-button-secondary" href="/fusarium/effectors">Effectors</a>
        <a class="mgdb-button mgdb-button-secondary" href="/fusarium/help">Help</a>
      </div>
    </div>
  </section>
</main>
)
