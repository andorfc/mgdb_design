$$SYNTAX-LEVEL 2
*(maizegdb-main-modern
  {
   include-css: /css/megamenu.css |
   include-js: https\://cdnjs.cloudflare.com/ajax/libs/jquery/1.8.0/jquery.min.js |
   include-js: /js/api_js.js
  }

  @(lambda {display: off}
    $(image-dir {default: /images})
  )

  ;; translation.php calls get()->replace() on every variable below, and
  ;; Nary::get() throws when an identifier is missing. Declaring them inside an
  ;; HTML comment keeps them resolvable without rendering anything — the same
  ;; idiom used by templates/home/maizegdb_header.bau for $(gbrowse_url).
  <!-- $(topright_download) $(topright_preferences) $(topright_login) $(topright_logout) $(translate_wording) $(translate_site) $(logo-id) $(search_name) $(search_value) -->

  <a class="mgdb-skip-link" href="#mgdb-main">Skip to main content</a>

  <div id="wrapper">
    <header class="mgdb-site-header">
      <div class="mgdb-site-header-inner">
        <a class="mgdb-site-brand" href="$(server-url)">
          <img src="$(image-dir)/logo.png" alt="MaizeGDB — Maize Genetics and Genomics Database" />
        </a>
        <div class="mgdb-site-search">
          *(search-box {load: templates/home/search-box-modern.bau}
            &(lambda
              $image_dir  = $this->reflect(\)->upstream('maizegdb-main-modern'\)->get('image-dir'\);
              $server_url = $this->reflect(\)->upstream('maizegdb-main-modern'\)->get('server-url'\);

              $loaded = $this->reflect(\)->_parent(\);
              if ($loaded->has('image-dir'\)\)
                $loaded->get('image-dir'\)->replace($image_dir->value(\)\);
              if ($loaded->has('server-url'\)\)
                $loaded->get('server-url'\)->replace($server_url->value(\)\);
            )
          )
        </div>
      </div>
    </header>

    <nav class="mgdb-site-nav" aria-label="Main">
      *(megamenu)
    </nav>

    <div id="content">
      <div id="mgdb-main">
        *(body)
      </div>
    </div>

    <!-- One block, not two. This was a brand-and-columns section plus a
         separate bottom bar, which read as two stacked footers with a band of
         empty space between them. Everything that earned its place is now on
         three lines: the mark, the statement, and one row of links.
         The white lockup, not the colour one -- the footer ground is dark
         green and the colour lockup sets its wordmark in near-black. -->
    <footer class="mgdb-site-footer" role="contentinfo">
      <div class="mgdb-site-footer-inner">
        <p class="mgdb-footer-tagline">MaizeGDB is the community database for maize genetics and genomics, curated and supported by the USDA-ARS</p>

        <div class="mgdb-footer-row">
          <a class="mgdb-footer-usda" href="https\://www.usda.gov/" target="_blank" rel="noopener">
            <img src="/images/usda-v2-white-lockup.svg" alt="United States Department of Agriculture" width="200" height="46" />
          </a>

          <ul class="mgdb-footer-links">
            <li><a href="/contact">$(footer_contact)</a></li>
            <li><a href="/cite">$(footer_cite)</a></li>
            <li><a href="https\://www.usda.gov/accessibility-statement" target="_blank" rel="noopener">Accessibility</a></li>
            <li><a href="https\://www.usda.gov/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a></li>
            <li><a href="https\://www.usda.gov/non-discrimination-statement" target="_blank" rel="noopener">Non-Discrimination</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </div>
)
