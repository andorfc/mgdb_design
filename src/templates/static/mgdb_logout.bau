$$SYNTAX-LEVEL 2
*(mgdb-logout
<main class="mgdb-page mgdb-login-page" id="mgdb-logout-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Logged out</span>
  </nav>

  <section class="mgdb-hero-basic" aria-labelledby="logout-title">
    <span class="mgdb-hero-basic-icon" aria-hidden="true">
      <svg viewBox="0 0 84 84" role="presentation" focusable="false">
        <rect x="18" y="38" width="48" height="34" rx="6" fill="none" stroke="currentColor" stroke-width="5"/>
        <path d="M28 38V28a14 14 0 0 1 28 0v6" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
        <path d="M35 55h14" fill="none" stroke="#2f5e2a" stroke-width="4" stroke-linecap="round"/>
      </svg>
    </span>
    <div>
      <h1 id="logout-title">You are logged out</h1>
      <p>Your community-curator session has ended.</p>
    </div>
  </section>

  <section class="mgdb-login-state" aria-labelledby="logout-state-title">
    <h2 id="logout-state-title" class="mgdb-visually-hidden">Logout status</h2>
    <div class="mgdb-message mgdb-message-ok">
      <div><p><strong>Signed out.</strong> Log in again whenever you want to add or edit annotations.</p></div>
    </div>
    <p class="mgdb-login-actions">
      <a class="mgdb-button mgdb-button-primary" href="/">Go to the homepage</a>
      <a class="mgdb-button mgdb-button-quiet" href="/login">Log in again</a>
    </p>
  </section>

</main>
)
