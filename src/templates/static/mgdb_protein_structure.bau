$$SYNTAX-LEVEL 2
*(mgdb-protein-structure
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https\://maizegdb.org/data_center/protein_structure">
<meta property="og:title" content="MaizeGDB Protein Structures | AlphaFold Monomers, Homodimers &amp; Heterodimers">
<meta property="og:description" content="Search over 40,000 predicted maize protein structures with pLDDT confidence, ipTM, ipSAE and pDockQ interface scores, plus ESMFold models.">

<a class="mgdb-skip-link" href="#ps-main">Skip to main content</a>
<main class="mgdb-page mgdb-hub-page mgdb-protein-structure-page" id="ps-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Protein Structures</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="ps-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/data_center/protein_structure.png?v=20260822" alt="Protein structure icon" class="ps-hero-icon" width="80" height="80" />
      <strong>Structure<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; $(data-date)</p>
      <h1 id="ps-title">Explore predicted protein structures &amp; complexes</h1>
      <p class="mgdb-hero-description">Search any gene model, locus, gene symbol, or UniProt accession to view predicted AlphaFold monomers, homodimers, and heterodimers with confidence metrics and interface scores, plus ESMFold isoform models.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#ps-find" class="is-current" aria-current="true">Search</a>
    <a href="#ps-esmfold">ESMFold isoforms</a>
    <a href="#ps-tools">Comparison tools</a>
    <a href="#ps-variants">Variant effects</a>
    <a href="#ps-reading">Interpreting predictions</a>
    <a href="#ps-sources">Data sources</a>
    <a href="#ps-references">References</a>
    <a href="#ps-metrics">Metrics</a>
    <a href="#ps-related">Related resources</a>
  </nav>

  <!-- ====================================================================
       1. Interactive search & 3D structure workspace \(Search at top\)
       ==================================================================== -->
  <section class="mgdb-panel ps-workspace marker-search-panel" id="ps-find" aria-labelledby="ps-find-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-find-title">Search</h2></div>
    </div>

    <form class="ps-search" id="ps-search-form" autocomplete="off" role="search">
      <label class="mgdb-label" for="ps-search-input">Gene model, locus, symbol or UniProt accession</label>
      <div class="ps-search-row">
        <div class="ps-search-field">
          <input class="mgdb-input ps-search-input" id="ps-search-input" type="search" name="term"
                 role="combobox" aria-autocomplete="list" aria-expanded="false"
                 aria-controls="ps-suggestions" aria-describedby="ps-search-hint"
                 placeholder="Zm00001eb168550, ADH2, P04707, 168550&hellip;" />
          <div class="mgdb-suggestions ps-suggestions" id="ps-suggestions" role="listbox"
               aria-label="Matching proteins" hidden></div>
        </div>
        <button class="mgdb-button mgdb-button-primary ps-search-submit" type="submit">Find structures</button>
      </div>
      <p class="mgdb-hint" id="ps-search-hint">Type at least two characters. The numeric tail of a gene model works on its own &mdash; <code>168550</code> finds <code>Zm00001eb168550</code>.</p>
      <div class="marker-example-row ps-examples" aria-label="Example protein searches">
        <span>Examples</span>
        <button class="mgdb-chip" type="button" data-ps-example="Zm00001eb168550">Zm00001eb168550</button>
        <button class="mgdb-chip" type="button" data-ps-example="P11428">P11428 \(SOD\)</button>
        <button class="mgdb-chip" type="button" data-ps-example="TIF5A">TIF5A</button>
        <button class="mgdb-chip" type="button" data-ps-example="Zm00001eb099910">many partners</button>
      </div>
    </form>

    <noscript>
      <p class="mgdb-message mgdb-message-info">The structure search and the 3D viewer need JavaScript. Every model on this page is also reachable directly at the <a href="https\://alphafold.ebi.ac.uk/">AlphaFold Protein Structure Database</a>.</p>
    </noscript>

    <div id="ps-results" class="ps-results" aria-live="polite">
      <div class="mgdb-empty ps-welcome">
        <p><strong>Search to open a structure.</strong></p>
        <p>Results are grouped by assembly state, ranked so the best-supported model in each group is first, and open in a viewer with per-residue confidence and interface scores.</p>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       2. ESMFold isoform models
       ==================================================================== -->
  <section class="mgdb-panel" id="ps-esmfold" aria-labelledby="ps-esmfold-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-esmfold-title">ESMFold isoforms</h2></div>
    </div>

    <form class="ps-search ps-search-compact" id="ps-esm-form" autocomplete="off" role="search">
      <label class="mgdb-label" for="ps-esm-input">Gene model or protein isoform</label>
      <div class="ps-search-row">
        <input class="mgdb-input" id="ps-esm-input" type="search" name="term"
               placeholder="Zm00001eb057920 or Zm00001eb057920_P002" />
        <button class="mgdb-button mgdb-button-secondary" type="submit">Load model</button>
      </div>
      <div class="marker-example-row ps-examples" aria-label="Example ESMFold searches">
        <span>Examples</span>
        <button class="mgdb-chip" type="button" data-ps-esm-example="Zm00001eb057920">Zm00001eb057920</button>
        <button class="mgdb-chip" type="button" data-ps-esm-example="Zm00001eb168550">Zm00001eb168550</button>
      </div>
    </form>

    <div id="ps-esm-results" class="ps-results" aria-live="polite">
      <div class="mgdb-empty">
        <p>Enter a RefGen_v5 gene model to load its canonical isoform, or a <code>_P###</code> protein name to load that isoform exactly.</p>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       3. Structural comparison and search tools
       ==================================================================== -->
  <section id="ps-tools" aria-labelledby="ps-tools-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-tools-title">Comparison tools</h2></div>
    </div>

    <div class="mgdb-card-grid ps-tool-grid">
      <article class="mgdb-card ps-tool-card">
        <span class="mgdb-pill mgdb-pill-info">Structure Alignment</span>
        <h3>Foldseek structure search</h3>
        <p>Align a maize protein structure against Arabidopsis, soybean, rice, maize, human, yeast, fission yeast and sorghum proteomes. Structure search finds relatives that sequence search misses.</p>
        <form class="ps-search-row" action="/foldseek" method="get">
          <label class="mgdb-visually-hidden" for="ps-foldseek">Identifier for Foldseek search</label>
          <input class="mgdb-input" id="ps-foldseek" name="uniprot" type="search" placeholder="Zm00001eb374230" />
          <button class="mgdb-button mgdb-button-secondary" type="submit">Search</button>
        </form>
      </article>

      <article class="mgdb-card ps-tool-card">
        <span class="mgdb-pill mgdb-pill-ok">Ortholog Comparison</span>
        <h3>FATCAT comparison</h3>
        <p>Compare the top ortholog candidates from DIAMOND, Foldseek and FATCAT across four plant proteomes. Where three independent methods agree, the relationship is confident.</p>
        <form class="ps-search-row" action="/fatcat" method="get">
          <label class="mgdb-visually-hidden" for="ps-fatcat">Identifier for FATCAT comparison</label>
          <input class="mgdb-input" id="ps-fatcat" name="uniprot" type="search" placeholder="Zm00001eb374230" />
          <button class="mgdb-button mgdb-button-secondary" type="submit">Compare</button>
        </form>
      </article>

      <article class="mgdb-card ps-tool-card">
        <span class="mgdb-pill mgdb-pill-ok">Ligands &amp; Cofactors</span>
        <h3>AlphaFill transplants</h3>
        <p>A structure without a ligand is only half the picture. AlphaFill copies cofactors, substrates and metal ions from homologous PDB entries onto these models &mdash; 624,456 transplants across 16,933 maize genes, each with its donor and confidence.</p>
        <form class="ps-search-row" action="/data_center/alphafill" method="get">
          <label class="mgdb-visually-hidden" for="ps-alphafill">Gene model for predicted ligands</label>
          <input class="mgdb-input" id="ps-alphafill" name="gene" type="search" placeholder="Zm00001eb086870" />
          <button class="mgdb-button mgdb-button-secondary" type="submit">Ligands</button>
        </form>
      </article>

      <article class="mgdb-card ps-tool-card">
        <span class="mgdb-pill mgdb-pill-warn">Domain Atlas</span>
        <h3>Protein domain atlas</h3>
        <p>InterPro domain assignments across the maize pan-genome. Check whether a predicted interface falls inside a known functional domain or an unstructured linker region.</p>
        <p><a class="mgdb-button mgdb-button-quiet" href="/projects/interpro_domain_atlas">Open domain atlas <span aria-hidden="true">&rarr;</span></a></p>
      </article>

      <article class="mgdb-card ps-tool-card">
        <span class="mgdb-pill">Homology</span>
        <h3>Sequence search</h3>
        <p>No structure for your protein? BLAST it against the maize genomes and annotations first &mdash; a close homolog with a model is often the fastest route to a usable structure.</p>
        <p><a class="mgdb-button mgdb-button-quiet" href="$(blast-url)">Open BLAST <span aria-hidden="true">&rarr;</span></a></p>
      </article>
    </div>
  </section>

  <!-- ====================================================================
       4. Variant effects on structure \(PanEffect, SNPFold\)
       ==================================================================== -->
  <section id="ps-variants" aria-labelledby="ps-variants-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-variants-title">Variant effects on structure</h2></div>
    </div>

    <div class="mgdb-card-grid ps-tool-grid">
      <article class="mgdb-card ps-tool-card">
        <span class="mgdb-pill mgdb-pill-info">Variant Effects</span>
        <h3>PanEffect</h3>
        <p>See how every possible amino-acid substitution is predicted to affect a maize protein. PanEffect maps ESM language-model effect scores onto the sequence and the AlphaFold structure, with a heatmap across all positions and substitutions.</p>
        <form class="ps-search-row" action="https\://www.maizegdb.org/effect/maize_v2/index.html" method="get" target="_blank" rel="noopener">
          <label class="mgdb-visually-hidden" for="ps-paneffect">Gene model for PanEffect</label>
          <input class="mgdb-input" id="ps-paneffect" name="id" type="search" placeholder="Zm00001eb260000" />
          <input type="hidden" name="option" value="both" />
          <input type="hidden" name="esm" value="ESM2" />
          <button class="mgdb-button mgdb-button-secondary" type="submit">Open PanEffect</button>
        </form>
      </article>

      <article class="mgdb-card ps-tool-card">
        <span class="mgdb-pill mgdb-pill-ok">Variants on Structure</span>
        <h3>SNPFold</h3>
        <p>Maps coding variants onto predicted protein structure. A linear protein browser aligns variants with Pfam domains, secondary structure, and per-residue pLDDT confidence; an on-demand 3D viewer shows the fold colored by confidence, domain, or impact; and a per-variant readout interprets each change \(domain, local confidence, secondary structure, predicted &Delta;&Delta;G\).</p>
        <p><a class="mgdb-button mgdb-button-secondary" href="https\://snptools.maizegdb.org/" target="_blank" rel="noopener">Open SNPFold <span aria-hidden="true">&rarr;</span></a></p>
      </article>
    </div>
  </section>

  <!-- ====================================================================
       5. How to read a predicted complex
       ==================================================================== -->
  <section id="ps-reading" aria-labelledby="ps-reading-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-reading-title">Interpreting predictions</h2></div>
    </div>

    <div class="mgdb-card-grid ps-reading-grid">
      <article class="mgdb-card">
        <h3>pLDDT &mdash; is the fold right?</h3>
        <p>Per-residue confidence, 0&ndash;100, written into the B-factor column of every model file. Above 90 the backbone is usually right; 70&ndash;90 is a confident fold with looser side chains; 50&ndash;70 should be treated cautiously; below 50 is frequently a disordered region.</p>
        <p class="mgdb-small">Long low-pLDDT tails are common and normal. Judge the domain, not the average.</p>
      </article>
      <article class="mgdb-card">
        <h3>ipTM &mdash; is the complex right?</h3>
        <p>A whole-complex confidence score. Useful, but it is dominated by how well each chain folds on its own: two confidently folded proteins parked next to each other without touching can still score well. Treat ipTM as necessary, not sufficient.</p>
      </article>
      <article class="mgdb-card ps-card-flag">
        <h3>ipSAE &mdash; is the <em>interface</em> right?</h3>
        <p>Computed over the predicted interface rather than the whole complex, separating a real predicted contact from two chains that merely share a box. This is the primary score the candidate lists are ranked by.</p>
      </article>
      <article class="mgdb-card">
        <h3>pDockQ and contacts</h3>
        <p>pDockQ estimates interface quality from the number of contacts and the confidence around them. The contact count is the raw quantity behind it. A high pDockQ over very few contacts is a small interface.</p>
      </article>
    </div>

    <aside class="mgdb-note mgdb-note-info">
      <p><strong>Predicted is not observed.</strong> A high-scoring heterodimer means two proteins <em>could</em> form the modelled interface, not that they are ever in the same cell, tissue or compartment at the same time. Check that both partners are expressed together &mdash; the gene records linked from every result are the place to start.</p>
    </aside>
  </section>

  <!-- ====================================================================
       5. Where these models come from
       ==================================================================== -->
  <section id="ps-sources" aria-labelledby="ps-sources-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-sources-title">Data sources</h2></div>
    </div>
    <p class="ps-section-lead">Every model is fetched from the archive that published it; what follows is which archive, and how each set was produced.</p>

    <div class="mgdb-table-scroll">
      <table class="mgdb-table">
        <caption class="mgdb-visually-hidden">Sources, methods and coverage for the structure collections on this page</caption>
        <thead>
          <tr><th scope="col">Collection</th><th scope="col">Method</th><th scope="col">Keyed on</th><th scope="col">Files served from</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Monomers</strong><br /><span class="mgdb-small">$(monomer-count) models</span></td>
            <td>AlphaFold Monomer v2.0 pipeline</td>
            <td>UniProt accession</td>
            <td><a href="https\://alphafold.ebi.ac.uk/" rel="noopener">AlphaFold DB</a> at EMBL-EBI</td>
          </tr>
          <tr>
            <td><strong>Homodimers</strong><br /><span class="mgdb-small">$(homodimer-count) models</span></td>
            <td>AlphaFold-Multimer, via ColabFold and OpenFold-TRT</td>
            <td>AF model identifier</td>
            <td><a href="https\://alphafold.ebi.ac.uk/" rel="noopener">AlphaFold DB</a> at EMBL-EBI</td>
          </tr>
          <tr>
            <td><strong>Heterodimers</strong><br /><span class="mgdb-small">$(heterodimer-count) models</span></td>
            <td>AlphaFold-Multimer, via ColabFold and OpenFold-TRT</td>
            <td>AF model identifier</td>
            <td><a href="https\://alphafold.ebi.ac.uk/" rel="noopener">AlphaFold DB</a> at EMBL-EBI</td>
          </tr>
          <tr>
            <td><strong>ESMFold</strong></td>
            <td>ESMFold, over official RefGen_v5 annotation</td>
            <td>Protein isoform name</td>
            <td>MaizeGDB</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="mgdb-small ps-provenance-note">Structure files are fetched by your browser directly from the archive that holds them, so what you see in the viewer is the file as published. The $(record-count) records behind the search &mdash; the identifier mapping and the scores &mdash; are indexed here and were last rebuilt $(data-date).</p>

    <!-- Bauplan reads an unescaped close-paren as a scope close, including
         inside an HTML comment, so every literal parenthesis below is
         backslash-escaped. See legacy/protein_structure/README.md. -->
    <p class="mgdb-small">Citing a model from this page means citing its source. AlphaFold: Jumper et al. \(2021\) <i>Nature</i> 596:583&ndash;589, and Varadi et al. \(2024\) <i>Nucleic Acids Research</i> 52:D368&ndash;D375 for the database. AlphaFold-Multimer: Evans et al. \(2021\). ESMFold: Lin et al. \(2023\) <i>Science</i> 379:1123&ndash;1130. For the MaizeGDB structure resource: Andorf et al. \(2023\) <i>Genetics</i> 223:iyad016.</p>
  </section>

  <!-- ====================================================================
       6. References
       ==================================================================== -->
  <section id="ps-references" aria-labelledby="ps-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <!-- ====================================================================
       6. Dashboard / Corpus statistics \(second to last item\)
       ==================================================================== -->
  <section id="ps-metrics" aria-labelledby="ps-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <span class="mgdb-metric-icon" aria-hidden="true">Mon</span>
        <div><strong class="mgdb-metric-value">$(monomer-count)</strong><h3>Monomer models</h3><p>Single-chain AlphaFold predictions across $(gene-count) B73 RefGen_v5 genes.</p></div>
      </article>
      <article class="mgdb-metric mgdb-tone-amber">
        <span class="mgdb-metric-icon" aria-hidden="true">Hom</span>
        <div><strong class="mgdb-metric-value">$(homodimer-count)</strong><h3>Homodimer models</h3><p>Self-interacting pairs for classical enzymes and transcription factors.</p></div>
      </article>
      <article class="mgdb-metric mgdb-tone-blue">
        <span class="mgdb-metric-icon" aria-hidden="true">Het</span>
        <div><strong class="mgdb-metric-value">$(heterodimer-count)</strong><h3>Heterodimer models</h3><p>Predicted complexes between two distinct maize proteins.</p></div>
      </article>
      <article class="mgdb-metric mgdb-tone-burgundy">
        <span class="mgdb-metric-icon" aria-hidden="true">3D</span>
        <div><strong class="mgdb-metric-value">$(model-count)</strong><h3>Models indexed</h3><p>Searchable by gene model, locus, symbol or UniProt accession.</p></div>
      </article>
    </div>
  </section>

  <!-- ====================================================================
       7. External and related resources \(final item\)
       ==================================================================== -->
  <section id="ps-related" class="mgdb-hub-related" aria-labelledby="ps-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ps-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/pan_gene_center/pan_gene">
          <strong>Pan-Gene Data Hub</strong>
          <span>Syntenic pan-genome analysis across 66 maize genome assemblies</span>
        </a>
        <a href="/genome">
          <strong>Genome Data Hub</strong>
          <span>Chromosome-level reference genomes and pseudomolecules</span>
        </a>
        <a href="/projects/interpro_domain_atlas">
          <strong>InterPro Domain Atlas</strong>
          <span>Predicted protein domain annotations across maize lines</span>
        </a>
        <a href="https\://alphafold.ebi.ac.uk/" target="_blank" rel="noopener">
          <strong>AlphaFold Protein Structure Database</strong>
          <span>EMBL-EBI open-access predicted structure repository</span>
        </a>
        <a href="https\://www.rcsb.org/" target="_blank" rel="noopener">
          <strong>RCSB Protein Data Bank &#40;PDB&#41;</strong>
          <span>Primary global archive of 3D macromolecular structures</span>
        </a>
      </div>
    </div>
  </section>

</main>
)
