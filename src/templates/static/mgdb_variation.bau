$$SYNTAX-LEVEL 2
*(mgdb-variation
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/variation">
<meta property="og:title" content="MaizeGDB Variation Data Hub | Alleles, Mutants &amp; Polymorphisms">
<meta property="og:description" content="Search 1.7 million curated maize variations: classical alleles, transposon insertions, polymorphisms, their phenotypic effects, and the stocks that carry them.">

<main class="mgdb-page mgdb-hub-page mgdb-variation-page" id="mgdb-variation-main">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Variation Data Hub</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="variation-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/quicklinks/variation.png" alt="" width="128" height="128" decoding="async" />
      <strong>Variation<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; September 2026</p>
      <h1 id="variation-title">Maize variations, alleles, and mutant stocks</h1>
      <p class="mgdb-hero-description">MaizeGDB curates $(metric_variations) variations: the classical allele series with their dominance, viability and phenotype records, transposon insertion alleles, sequence polymorphisms, and the seed stocks that carry them.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#variation-search">Search</a>
    <a href="#variation-types">Browse by type</a>
    <a href="#variation-collections">Mutant collections</a>
    <a href="#variation-downloads">Downloads</a>
    <a href="#variation-references">References</a>
    <a href="#variation-metrics">Metrics</a>
    <a href="#variation-related">Related resources</a>
  </nav>

  <!-- ====================================================================
       Search
       ==================================================================== -->
  <section id="variation-search" aria-labelledby="variation-search-title">
    <div class="mgdb-section-heading">
      <div><h2 id="variation-search-title">Search</h2></div>
    </div>

    <form id="variation-search-form" class="variation-search" role="search">
      <div class="variation-query-row">
        <div class="variation-query-field">
          <label class="mgdb-visually-hidden" for="variation-query">Search variations</label>
          <div class="variation-query-control">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input id="variation-query" name="term" type="search" placeholder="Variation name, gene symbol, synonym, or allele descriptor" autocomplete="off" aria-describedby="variation-query-hint" />
            <button id="variation-query-clear" type="button" hidden>Clear</button>
          </div>
        </div>
        <button class="mgdb-button mgdb-button-primary variation-query-submit" type="submit">Search</button>
      </div>

      <p class="mgdb-hint" id="variation-query-hint">A gene symbol returns its whole allele series. Matching is exact first; use <strong>Search all fields</strong> in the results header to widen it to any part of a name.</p>

      <div class="variation-examples" aria-label="Example searches">
        <span>Examples&#58;</span>
        <button type="button" data-variation-example="bz1">bz1</button>
        <button type="button" data-variation-example="c1-n">c1-n</button>
        <button type="button" data-variation-example="o2-676">o2-676</button>
        <button type="button" data-variation-example="p1-ww">p1-ww</button>
        <button type="button" data-variation-example="r1-r">r1-r</button>
        <button type="button" data-variation-example="y1-8549">y1-8549</button>
        <button type="button" data-variation-example="bz1-m13CS1">bz1-m13CS1</button>
      </div>

      <details class="variation-advanced" id="variation-advanced">
        <summary>
          <span class="variation-advanced-label">Advanced search</span>
          <span class="variation-advanced-count" id="variation-advanced-count" hidden></span>
        </summary>

        <div class="variation-advanced-body">
          <div class="variation-advanced-grid">
            <div class="mgdb-hub-field">
              <label for="variation-type">Variation type</label>
              <select id="variation-type" name="type">
                $(type_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="variation-dominance">Dominance</label>
              <select id="variation-dominance" name="dominance">
                $(dominance_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="variation-viability">Viability</label>
              <select id="variation-viability" name="viability">
                $(viability_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="variation-mutagen">Mutagen or origin</label>
              <select id="variation-mutagen" name="mutagen">
                $(mutagen_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="variation-phenotype">Phenotypic effect</label>
              <select id="variation-phenotype" name="phenotype">
                $(phenotype_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="variation-sort">Sort results by</label>
              <select id="variation-sort" name="sort">
                <option value="relevance">Best match</option>
                <option value="name-asc">Name A&ndash;Z</option>
                <option value="name-desc">Name Z&ndash;A</option>
                <option value="locus-asc">Gene A&ndash;Z</option>
                <option value="locus-desc">Gene Z&ndash;A</option>
                <option value="type-asc">Type A&ndash;Z</option>
                <option value="type-desc">Type Z&ndash;A</option>
              </select>
            </div>
          </div>

          <div class="variation-advanced-toggles">
            <label class="mgdb-hub-check">
              <input type="checkbox" id="variation-has-stock" name="has_stock" value="1" />
              <span>Only variations available as a stock</span>
            </label>
            <label class="mgdb-hub-check">
              <input type="checkbox" id="variation-has-pheno" name="has_pheno" value="1" />
              <span>Only variations with a recorded phenotype</span>
            </label>
            <label class="mgdb-hub-check">
              <input type="checkbox" id="variation-notes" name="notes" value="1" />
              <span>Also search curation notes &#40;slower&#41;</span>
            </label>
          </div>

          <div class="variation-advanced-actions">
            <button class="mgdb-button mgdb-button-primary" type="submit">Apply filters</button>
            <button class="mgdb-button mgdb-button-quiet" id="variation-advanced-reset" type="button">Reset filters</button>
          </div>
        </div>
      </details>
    </form>
  </section>

  <!-- ====================================================================
       Results. Hidden until a search runs, then revealed by the page script.
       ==================================================================== -->
  <section id="variation-results-section" aria-labelledby="variation-results-title" hidden>
    <div class="mgdb-section-heading">
      <div><h2 id="variation-results-title">Results</h2></div>
    </div>

    <p class="variation-results-status" id="variation-results-status" role="status" aria-live="polite">Searching&hellip;</p>

    <div class="variation-results-toolbar">
      <div class="mgdb-hub-field variation-results-filter">
        <label for="variation-results-filter">Filter these results</label>
        <input id="variation-results-filter" type="search" autocomplete="off" placeholder="Name, gene, type, mutagen, phenotype" />
        <span class="mgdb-result-count" id="variation-filter-count" aria-live="polite"></span>
      </div>

      <div class="mgdb-hub-field">
        <label for="variation-page-size">Results shown</label>
        <select id="variation-page-size">
          <option value="10">Top 10</option>
          <option value="25" selected>Top 25</option>
          <option value="50">Top 50</option>
          <option value="all">All results</option>
        </select>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action variation-results-actions">
        <a class="mgdb-button mgdb-button-secondary" id="variation-export-tsv" href="#" download>Export TSV</a>
        <a class="mgdb-button mgdb-button-secondary" id="variation-export-csv" href="#" download>Export CSV</a>
      </div>
    </div>

    <p class="variation-results-note" id="variation-results-note" hidden></p>

    <div class="mgdb-table-scroll" id="variation-table-scroll" tabindex="0" role="region" aria-labelledby="variation-results-title">
      <table class="mgdb-table variation-table" id="variation-table">
        <thead>
          <tr>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="name">Variation</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="locus">Gene</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="type">Type</button></th>
            <th scope="col">Dominance</th>
            <th scope="col">Viability</th>
            <th scope="col">Mutagen or origin</th>
            <th scope="col">Phenotypic effects</th>
            <th scope="col">Stocks</th>
          </tr>
        </thead>
        <tbody id="variation-results-body"></tbody>
      </table>
    </div>

    <div class="mgdb-empty" id="variation-empty" hidden>
      <h3>No variations matched</h3>
      <p>Try a gene symbol such as <code>bz1</code>, widen the search with <strong>Search all fields</strong>, or clear the advanced filters.</p>
      <button class="mgdb-button mgdb-button-secondary" id="variation-empty-reset" type="button">Clear search and filters</button>
    </div>

    <nav class="variation-pagination" id="variation-pagination" aria-label="Result pages"></nav>
  </section>

  <!-- ====================================================================
       Browse by type
       ==================================================================== -->
  <section id="variation-types" aria-labelledby="variation-types-title">
    <div class="mgdb-section-heading">
      <div><h2 id="variation-types-title">Browse by type</h2></div>
    </div>

    <div class="variation-type-grid">
      $(type_tiles)
    </div>

    <details class="mgdb-chart-data variation-type-table">
      <summary>Every variation type, with its share of the collection</summary>
      <div class="mgdb-table-scroll">
        <table class="mgdb-table" data-sortable>
          <caption>Curated variations by type</caption>
          <thead>
            <tr>
              <th scope="col" data-sort="text">Type</th>
              <th scope="col" class="mgdb-numeric" data-sort="number">Variations</th>
              <th scope="col" class="mgdb-numeric" data-sort="number">Share</th>
            </tr>
          </thead>
          <tbody>
            $(type_table_rows)
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <!-- ====================================================================
       Mutant collections
       ==================================================================== -->
  <section id="variation-collections" aria-labelledby="variation-collections-title">
    <div class="mgdb-section-heading">
      <div><h2 id="variation-collections-title">Mutant collections</h2></div>
    </div>

    <div class="mgdb-card-grid variation-collection-grid">
      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-warn">Transposon</span>
        <h3>UniformMu</h3>
        <p>Sequence-indexed Robertson&rsquo;s Mutator insertion alleles in a uniform W22 background, with cosegregating seedling and ear traits.</p>
        <a href="/uniformmu">Explore UniformMu <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">Diversity</span>
        <h3>SNPTools and SNPVersity</h3>
        <p>Query single nucleotide polymorphisms across the maize pan-genome and compare genotypes between accessions.</p>
        <a class="mgdb-external" href="https://snptools.maizegdb.org/" target="_blank" rel="noopener">Open SNPTools</a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-info">Predicted effects</span>
        <h3>PanEffect</h3>
        <p>Predicted missense variant effects for every possible substitution, across the NAM founders and the wider pan-genome.</p>
        <a href="/effect/maize_v2/">Open PanEffect <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill">Phenotypes</span>
        <h3>Phenotype Data Hub</h3>
        <p>Curated mutant phenotypes, the plant structures they affect, and their Plant Ontology terms.</p>
        <a href="/data_center/phenotype">Explore phenotypes <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill">Germplasm</span>
        <h3>Maize Genetics Cooperation Stock Center</h3>
        <p>Order the seed stocks that carry these alleles, including the classical mutant collection and chromosome translocations.</p>
        <a href="/data_center/stock">Search stocks <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-info">Insertions</span>
        <h3>Insertion sites</h3>
        <p>Mapped transposon insertion sites across the reference assemblies, with the flanking sequence each call was made from.</p>
        <a href="/insertion">Search insertions <span aria-hidden="true">&rarr;</span></a>
      </article>
    </div>
  </section>

  <!-- ====================================================================
       Downloads
       ==================================================================== -->
  <section id="variation-downloads" aria-labelledby="variation-downloads-title">
    <div class="mgdb-section-heading">
      <div><h2 id="variation-downloads-title">Downloads</h2></div>
    </div>

    <div class="mgdb-card-grid variation-download-grid">
      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">TSV</span>
        <h3>Variation catalog</h3>
        <p>Name, gene, type, dominance, viability, mutagen, phenotypic effects, allele descriptor and synonyms. Up to 10,000 rows, matching whatever is currently searched.</p>
        <a href="/search/variation/variation_search_api.php?format=tsv&amp;sort=name-asc">Download TSV <span aria-hidden="true">&darr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-info">CSV</span>
        <h3>Variation catalog, comma separated</h3>
        <p>The same columns in the format spreadsheets and pandas open without an import step.</p>
        <a href="/search/variation/variation_search_api.php?format=csv&amp;sort=name-asc">Download CSV <span aria-hidden="true">&darr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-warn">Scores</span>
        <h3>Variant effect scores</h3>
        <p>Protein language model scores for every possible missense substitution in B73, W22 and the NAM founders.</p>
        <a class="mgdb-external" href="https://iastate.app.box.com/v/maizegdb-public/folder/362583128761" target="_blank" rel="noopener">Download ESM scores</a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill">Whole genome</span>
        <h3>Resequencing variant files</h3>
        <p>VCF and HDF5 variant calls behind SNPVersity, for whole-genome analyses that the table above is not sized for.</p>
        <a class="mgdb-external" href="https://download.maizegdb.org/" target="_blank" rel="noopener">Open the download server</a>
      </article>
    </div>
  </section>

  <!-- ====================================================================
       Metrics, and the charts that sit under them
       ==================================================================== -->
  <!-- ====================================================================
       References
       ==================================================================== -->
  <section id="variation-references" aria-labelledby="variation-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="variation-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <!-- ====================================================================
       Metrics
       ==================================================================== -->
  <section id="variation-metrics" aria-labelledby="variation-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="variation-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Curated variations</h3>
          <span class="mgdb-metric-badge">Collection</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_variations)</strong>
        </div>
        <p class="mgdb-metric-description">Alleles, insertions, polymorphisms and rearrangements at curation level 0.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>Linked to a gene</h3>
          <span class="mgdb-metric-badge">Loci</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_genes)</strong>
        </div>
        <p class="mgdb-metric-description">Variations attached to a named locus, so they can be found by gene symbol.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>Available as a stock</h3>
          <span class="mgdb-metric-badge">Germplasm</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_stocks)</strong>
        </div>
        <p class="mgdb-metric-description">Variations carried by at least one stock that can be requested.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>Phenotype recorded</h3>
          <span class="mgdb-metric-badge">Traits</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_phenotypes)</strong>
        </div>
        <p class="mgdb-metric-description">Variations with at least one curated phenotypic effect.</p>
      </article>
    </div>

    <div class="mgdb-chart-grid variation-charts">
      <figure class="mgdb-figure">
        <h3>Variations by type</h3>
        <div class="mgdb-chart" id="variation-type-chart" role="img"
             aria-label="Horizontal bar chart of curated variation counts by type, on a logarithmic scale"
             data-series="$(chart_types)">
          <div class="mgdb-chart-fallback">Loading the type breakdown&hellip;</div>
        </div>
        <figcaption>The axis is logarithmic&#58; the two bulk classes are four orders of magnitude larger than the curated ones, and a linear axis would draw everything below them as nothing. The exact counts are in the table above.</figcaption>
      </figure>

      <figure class="mgdb-figure">
        <h3>Mutagens and origins</h3>
        <div class="mgdb-chart" id="variation-mutagen-chart" role="img"
             aria-label="Horizontal bar chart of the mutagens and origins recorded most often, on a logarithmic scale"
             data-series="$(chart_mutagens)">
          <div class="mgdb-chart-fallback">Loading the mutagen breakdown&hellip;</div>
        </div>
        <figcaption>Mutator accounts for most recorded mutageneses, a legacy of the transposon tagging populations. The axis is logarithmic.</figcaption>
      </figure>

      <figure class="mgdb-figure variation-chart-wide">
        <h3>Most recorded phenotypic effects</h3>
        <div class="mgdb-chart" id="variation-phenotype-chart" role="img"
             aria-label="Horizontal bar chart of the phenotypic effects recorded against the most variations"
             data-series="$(chart_phenotypes)">
          <div class="mgdb-chart-fallback">Loading the phenotype breakdown&hellip;</div>
        </div>
        <figcaption>Kernel and seedling traits lead, followed by the allozyme mobility variants scored across the classical mapping panels.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ====================================================================
       Related resources
       ==================================================================== -->
  <section id="variation-related" class="mgdb-hub-related" aria-labelledby="variation-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="variation-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/phenotype">
          <strong>Phenotype Data Hub</strong>
          <span>The trait side of these records&#58; observable phenotypes, the structures they affect, and their ontology terms</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Center</strong>
          <span>Search and request the seed stocks that carry an allele, including the classical mutant collection</span>
        </a>
        <a href="/gene_center/gene">
          <strong>Gene Center</strong>
          <span>Gene models, annotations and cross-references for the loci these variations are attached to</span>
        </a>
        <a href="/uniformmu">
          <strong>UniformMu</strong>
          <span>Sequence-indexed Mutator insertion alleles in a uniform W22 background</span>
        </a>
        <a class="mgdb-external" href="https://snptools.maizegdb.org/" target="_blank" rel="noopener">
          <strong>SNPTools</strong>
          <span>Whole-genome polymorphism queries and genotype comparison across the pan-genome</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
