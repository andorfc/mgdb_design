$$SYNTAX-LEVEL 2
*(mgdb-gene_product
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/gene_product">
<meta property="og:title" content="MaizeGDB Gene Product Data Hub">
<meta property="og:description" content="Search curated maize gene products, enzymes, EC numbers, and metabolic pathways mapped to encoding genetic loci and gene models.">

<main class="mgdb-page mgdb-hub-page mgdb-gene-product-page" id="gene-product-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Gene Product Data Hub</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="gene-product-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="Gene product and enzyme icon">
        <circle cx="48" cy="48" r="38" fill="none" stroke="#235c37" stroke-width="5" stroke-dasharray="6 4" />
        <path d="M30 48 C30 36, 40 28, 48 28 C56 28, 66 36, 66 48 C66 60, 56 68, 48 68 C40 68, 30 60, 30 48 Z" fill="#e8f4ec" stroke="#235c37" stroke-width="4" />
        <circle cx="48" cy="40" r="6" fill="#d99a0b" />
        <circle cx="42" cy="54" r="5" fill="#7a4a10" />
        <circle cx="54" cy="54" r="5" fill="#235c37" />
        <path d="M48 20 L48 28 M48 68 L48 76 M20 48 L28 48 M68 48 L76 48" stroke="#d99a0b" stroke-width="3" stroke-linecap="round" />
      </svg>
      <strong>Gene Product<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="gene-product-title">Maize gene products and functional proteins</h1>
      <p class="mgdb-hero-description">$(total_products) curated gene products in $(class_count) functional classes, including $(total_enzymes) enzymes across $(distinct_ec_nums) EC numbers, linked to $(loci_with_products) genetic loci.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#gene-product-search" class="is-current" aria-current="true">Search</a>
    <a href="#gene-product-classes">Classes</a>
    <a href="#gene-product-catalogs">Catalogs</a>
    <a href="#gene-product-references">References</a>
    <a href="#gene-product-metrics">Metrics</a>
    <a href="#gene-product-related">Related resources</a>
  </nav>

  <!-- ── Search ───────────────────────────────────────────────────────────── -->
  <section id="gene-product-search" aria-labelledby="gp-search-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gp-search-title">Search</h2></div>
    </div>

    <form id="gp-search-form" class="gp-search" role="search">
      <div class="gp-query-row">
        <div class="gp-query-field">
          <label class="mgdb-visually-hidden" for="gp-query">Search gene products</label>
          <div class="gp-query-control">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input id="gp-query" name="term" type="search" placeholder="Product name, enzyme, EC number, locus, or gene model" autocomplete="off" aria-describedby="gp-query-hint" />
            <button id="gp-query-clear" type="button" hidden>Clear</button>
          </div>
        </div>
        <button class="mgdb-button mgdb-button-primary gp-query-submit" type="submit">Search gene products</button>
      </div>

      <p class="mgdb-hint" id="gp-query-hint">Enter a product name, enzyme, EC number \(e.g., <code>1.1.1.1</code>\), or gene symbol. Wildcard <code>*</code> is supported \(e.g., <code>adh*</code>\).</p>

      <div class="gp-examples" aria-label="Example searches">
        <span>EXAMPLES&#58;</span>
        <button type="button" data-gp-example="alcohol dehydrogenase">alcohol dehydrogenase</button>
        <button type="button" data-gp-example="glutathione S-transferase">glutathione S-transferase</button>
        <button type="button" data-gp-example="synthase">synthase</button>
        <button type="button" data-gp-example="kinase">kinase</button>
        <button type="button" data-gp-example="1.1.1.1">EC 1.1.1.1</button>
        <button type="button" data-gp-example="adh1">adh1</button>
        <button type="button" data-gp-example="adh*">adh*</button>
      </div>

      <details class="gp-advanced" id="gp-adv">
        <summary>
          <span class="gp-advanced-label">Advanced search</span>
        </summary>
        <div class="gp-advanced-body">
          <div class="gp-advanced-grid">
            <div class="mgdb-hub-field">
              <label for="gp-filter-type">Functional class</label>
              <select id="gp-filter-type" name="type">
                $(type_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="gp-filter-ec">EC number</label>
              <input id="gp-filter-ec" name="ec_num" type="search" placeholder="1.1.1.* or 2.7.1.1" autocomplete="off" />
            </div>

            <div class="mgdb-hub-field">
              <label for="gp-filter-loc">Subcellular localization</label>
              <select id="gp-filter-loc" name="localization">
                $(localization_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="gp-filter-pathway">Metabolic pathway</label>
              <select id="gp-filter-pathway" name="pathway">
                $(pathway_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="gp-adv-sort">Sort results by</label>
              <select id="gp-adv-sort" name="sort">
                <option value="">Best match / Name A&ndash;Z</option>
                <option value="name-desc">Name Z&ndash;A</option>
                <option value="type-asc">Class A&ndash;Z</option>
                <option value="type-desc">Class Z&ndash;A</option>
                <option value="ec-asc">EC number A&ndash;Z</option>
                <option value="ec-desc">EC number Z&ndash;A</option>
                <option value="encoded-asc">Encoded by A&ndash;Z</option>
                <option value="encoded-desc">Encoded by Z&ndash;A</option>
              </select>
            </div>
          </div>

          <div class="gp-advanced-actions">
            <button class="mgdb-button mgdb-button-primary" type="submit">Apply filters</button>
            <button class="gp-advanced-reset-btn" id="gp-adv-reset" type="button">Reset filters</button>
          </div>
        </div>
      </details>
    </form>
  </section>

  <!-- ── Search results: hidden until a search runs ───────────────────────── -->
  <section id="gene-product-results-section" class="gp-results-section" aria-labelledby="gp-results-title" hidden>
    <div class="mgdb-section-heading">
      <div><h2 id="gp-results-title">Results</h2></div>
    </div>

    <p class="gp-results-status" id="gp-results-status" role="status" aria-live="polite">Searching gene products&hellip;</p>

    <div class="gp-results-toolbar">
      <div class="mgdb-hub-field gp-results-filter">
        <label for="gp-results-filter">Filter these results</label>
        <input id="gp-results-filter" type="search" autocomplete="off" placeholder="Product name, class, EC, locus, pathway" />
        <span class="mgdb-result-count" id="gp-filter-count" aria-live="polite"></span>
      </div>

      <div class="mgdb-hub-field">
        <label for="gp-page-size">Results shown</label>
        <select id="gp-page-size">
          <option value="10">Top 10</option>
          <option value="25" selected>Top 25</option>
          <option value="50">Top 50</option>
          <option value="all">All results</option>
        </select>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action gp-results-export">
        <a class="mgdb-button mgdb-button-secondary" id="gp-export-tsv" href="#" download>Export TSV</a>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action gp-results-view">
        <div class="mgdb-view-toggle" role="group" aria-label="Result view">
          <button class="mgdb-view-btn" id="gp-view-cards" type="button" data-view="cards" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"/></svg>Cards
          </button>
          <button class="mgdb-view-btn is-active" id="gp-view-table" type="button" data-view="table" aria-pressed="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="7" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="12" width="14" height="2" rx="1" fill="currentColor"/></svg>Table
          </button>
        </div>
      </div>
    </div>

    <div class="mgdb-table-scroll" id="gp-table-scroll" tabindex="0" role="region" aria-labelledby="gp-results-title">
      <table class="mgdb-table gp-results-table" id="gp-results-table">
        <thead>
          <tr>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="name">Gene product</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="type">Class</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="ec">EC numbers</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="encoded">Encoded by</button></th>
            <th scope="col"><span class="gp-th-text">Pathways &amp; localizations</span></th>
          </tr>
        </thead>
        <tbody id="gp-results-body"></tbody>
      </table>
    </div>

    <div class="gp-card-grid" id="gp-cards-view" hidden></div>

    <div class="mgdb-empty" id="gp-results-empty" hidden>
      <h3>No gene products matched</h3>
      <p>Try a broader term such as <code>kinase</code> or <code>synthase</code>, check the EC number format, or reset the advanced filters.</p>
      <button class="mgdb-button mgdb-button-secondary" id="gp-empty-reset" type="button">Reset search</button>
    </div>

    <nav class="gp-pagination" id="gp-pagination" aria-label="Search result pages"></nav>
  </section>

  <!-- ── Classes ──────────────────────────────────────────────────────────── -->
  <section id="gene-product-classes" aria-labelledby="gp-classes-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gp-classes-title">Functional classes</h2></div>
    </div>
    <div class="mgdb-card-grid gp-class-grid">
          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-ok">Catalytic</span>
            <h3>Enzymes</h3>
            <p>$(total_enzymes) cataloged enzymes categorized across $(distinct_ec_nums) EC numbers with associated biochemical reaction pathways.</p>
            <button type="button" class="gp-filter-shortcut" data-type="1835">Filter enzymes <span aria-hidden="true">&rarr;</span></button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-info">Transport</span>
            <h3>Membrane Transport</h3>
            <p>Transporters, channel proteins, and pumps mediating ion, sugar, and metabolite flux across cellular membranes.</p>
            <button type="button" class="gp-filter-shortcut" data-type="24697">Filter transporters <span aria-hidden="true">&rarr;</span></button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-warn">Regulation</span>
            <h3>Transcription Factors</h3>
            <p>Sequence-specific DNA binding proteins and transcriptional regulators modulating gene expression networks.</p>
            <button type="button" class="gp-filter-shortcut" data-type="716013">Filter transcription factors <span aria-hidden="true">&rarr;</span></button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-warn">Signaling</span>
            <h3>Regulatory Proteins</h3>
            <p>Kinases, phosphatases, receptors, and signaling effectors controlling signal transduction cascades.</p>
            <button type="button" class="gp-filter-shortcut" data-type="24616">Filter regulatory proteins <span aria-hidden="true">&rarr;</span></button>
          </article>
        </div>
  </section>

  <!-- ── Catalogs ─────────────────────────────────────────────────────────── -->
  <section id="gene-product-catalogs" aria-labelledby="gp-catalogs-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gp-catalogs-title">Catalogs and pathways</h2></div>
    </div>
    <div class="mgdb-card-grid gp-download-grid" aria-label="Catalogs and pathways">
          <article class="mgdb-card gp-download-card">
            <div class="gp-download-header">
              <span class="mgdb-pill mgdb-pill-ok">Pathways</span>
              <h3>CornCyc / MaizeCYC</h3>
            </div>
            <p>Curated metabolic pathway database for maize, linking enzymes to substrate-product reaction diagrams and metabolic networks.</p>
            <a class="mgdb-button mgdb-button-secondary" href="https://pathway.gramene.org/gramene/corncyc.shtml">Explore CornCyc <span aria-hidden="true">&nearr;</span></a>
          </article>

          <article class="mgdb-card gp-download-card">
            <div class="gp-download-header">
              <span class="mgdb-pill mgdb-pill-info">Enzyme Nomenclature</span>
              <h3>Enzyme Commission \(EC\)</h3>
            </div>
            <p>Hierarchical enzyme classification system maintained by IUBMB defining catalytic activity and reaction mechanisms.</p>
            <a class="mgdb-button mgdb-button-secondary" href="https://enzyme.expasy.org/">Browse ExPASy ENZYME <span aria-hidden="true">&nearr;</span></a>
          </article>

          <article class="mgdb-card gp-download-card">
            <div class="gp-download-header">
              <span class="mgdb-pill mgdb-pill-warn">Protein Knowledgebase</span>
              <h3>UniProtKB</h3>
            </div>
            <p>Universal protein resource providing sequence annotations, functional domains, and cross-references for maize proteins.</p>
            <a class="mgdb-button mgdb-button-secondary" href="https://www.uniprot.org/taxonomy/4577">Search UniProt Maize <span aria-hidden="true">&nearr;</span></a>
          </article>
        </div>
  </section>

  <!-- ── References ───────────────────────────────────────────────────────── -->
  <section id="gene-product-references" aria-labelledby="gp-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gp-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <!-- ── Metrics ──────────────────────────────────────────────────────────── -->
  <section id="gene-product-metrics" aria-labelledby="gp-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gp-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Gene products</h3>
          <span class="mgdb-metric-badge">Curated</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total_products)</strong>
        </div>
        <p class="mgdb-metric-description">Curated functional protein and gene product records at curation level 0.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>Enzymes</h3>
          <span class="mgdb-metric-badge">Catalytic</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total_enzymes)</strong>
        </div>
        <p class="mgdb-metric-description">Products classed as enzymes, catalyzing metabolic and cellular reactions.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>EC numbers</h3>
          <span class="mgdb-metric-badge">Classification</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(distinct_ec_nums)</strong>
        </div>
        <p class="mgdb-metric-description">Distinct Enzyme Commission identifiers mapped to maize catalytic activities.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>Encoding loci</h3>
          <span class="mgdb-metric-badge">Genomic</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(loci_with_products)</strong>
        </div>
        <p class="mgdb-metric-description">Genetic loci linked to at least one functional gene product record.</p>
      </article>
    </div>

    <figure class="mgdb-figure gp-figure">
      <h3>Gene products by functional class</h3>
      <div class="mgdb-chart" id="gp-class-chart" role="img"
           aria-label="Horizontal bar chart of curated gene product counts for each functional class"
           data-labels="$(chart_labels)" data-values="$(chart_values)" data-ids="$(chart_ids)">
        <div class="mgdb-chart-fallback">Loading the functional class breakdown&hellip;</div>
      </div>
      <figcaption>The ten largest of the $(class_count) functional classes. Select a bar to search that class.</figcaption>
    </figure>
  </section>

  <!-- ── Related resources ────────────────────────────────────────────────── -->
  <section id="gene-product-related" class="mgdb-hub-related" aria-labelledby="gp-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gp-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/protein_structure">
          <strong>Protein Structure Data Hub</strong>
          <span>Predicted 3D structures for the proteins these products describe, with structural search</span>
        </a>
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>The gene models that encode these products, with functional descriptions and GO terms</span>
        </a>
        <a href="/data_center/locus">
          <strong>Locus Data Hub</strong>
          <span>Classic genetic loci, mutants, and alleles encoding characterized gene products</span>
        </a>
        <a href="/data_center/phenotype">
          <strong>Phenotype Data Hub</strong>
          <span>Curated phenotypes for the loci whose products lose or change function</span>
        </a>
        <a href="https://pathway.gramene.org/gramene/corncyc.shtml" target="_blank" rel="noopener">
          <strong>CornCyc</strong>
          <span>The curated maize metabolic pathway database these enzyme assignments feed</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
