  <!-- HERO

       Same treatment as /PanAnd_project: the description uses the width it is
       given rather than the shared 62ch measure, each action link is named
       rather than described so all five sit on one row, and the emblem is the
       artwork the homepage NAM quick link uses.

       No "Updated" stamp. It printed date\('F j, Y'\) -- the day the page was
       served -- so it always claimed the assemblies had been updated today.
       Put it back when there is a real release date to print. -->
  <section class="mgdb-hero" aria-labelledby="nam-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/quicklinks/NAM.png" alt="" width="128" height="128" decoding="async" />
      <strong>NAM<br />Project</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="nam-title">Nested Association Mapping \(NAM\) Parent Genomes</h1>
      <p class="mgdb-hero-description">High-quality de novo PacBio reference genome assemblies and gene model annotations for 26 diverse founder inbreds representing a broad cross-section of modern maize genetic variation.</p>

      <div class="nam-hero-actions-row">
        <a class="nam-hero-link" href="/genomebrowser"><span class="nam-link-dot nam-dot-green" aria-hidden="true"></span> JBrowse 2</a>
        <a class="nam-hero-link" href="https://nam-genomes.github.io/" target="_blank" rel="noopener"><span class="nam-link-dot nam-dot-gold" aria-hidden="true"></span> Project website &#8599;</a>
        <a class="nam-hero-link" href="/download#downloads-nam"><span class="nam-link-dot nam-dot-blue" aria-hidden="true"></span> Downloads</a>
        <a class="nam-hero-link" href="https://maizecoopsc.org/nam-rils.php" target="_blank" rel="noopener"><span class="nam-link-dot nam-dot-purple" aria-hidden="true"></span> Order RILs &#8599;</a>
        <a class="nam-hero-link" href="/curation/GenomeIssue/edit"><span class="nam-link-dot nam-dot-rose" aria-hidden="true"></span> Report issue</a>
      </div>
    </div>
  </section>

