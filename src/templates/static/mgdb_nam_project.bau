  <!-- SECTION 2: SUBPOPULATION STRUCTURE & GENOMIC DIVERSITY -->
  <section id="nam-subpopulations" aria-labelledby="nam-subpop-title">
    <div class="mgdb-section-heading">
      <div><h2 id="nam-subpop-title">Subpopulations</h2></div>
    </div>

    <div class="mgdb-panel">
<div class="nam-subpop-grid">
      <!-- Stiff Stalk -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-stiff">Stiff Stalk</span>
          <span class="nam-subpop-count">1 inbred</span>
        </div>
        <h3 class="nam-subpop-name">Stiff Stalk Synthetic \(SS\)</h3>
        <p class="nam-subpop-desc">Iowa Stiff Stalk Synthetic derivatives characterized by stalk strength and lodging resistance, forming one of the primary heterotic groups in North American hybrid breeding.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>B73 \(Common Reference\)</span>
        </div>
      </article>

      <!-- Non-Stiff Stalk -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-nonstiff">Non-Stiff Stalk</span>
          <span class="nam-subpop-count">6 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Non-Stiff Stalk \(NSS\)</h3>
        <p class="nam-subpop-desc">Diverse temperate inbreds originating from Lancaster Sure Crop, Reid Yellow Dent, and Leaming pools, providing maximal heterosis when crossed to Stiff Stalk parents.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>B97, Ky21, M162W, Ms71, Oh43, Oh7B</span>
        </div>
      </article>

      <!-- Tropical / Subtropical -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-tropical">Tropical / Subtropical</span>
          <span class="nam-subpop-count">13 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Tropical &amp; Subtropical Inbreds</h3>
        <p class="nam-subpop-desc">Bred at CIMMYT, IITA, and Suwan lines in Thailand, harboring vast allelic diversity, photoperiod sensitivity, disease resistance alleles, and distinct genomic architecture.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>CML52, CML69, CML103, CML228, CML247, CML277, CML322, CML333, Ki3, Ki11, NC350, NC358, Tzi8</span>
        </div>
      </article>

      <!-- Mixed -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-mixed">Mixed</span>
          <span class="nam-subpop-count">3 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Temperate / Tropical Mixed</h3>
        <p class="nam-subpop-desc">Lines adapted through hybrid crosses between temperate dent lines and tropical germplasm, bridging distinct climatic adaptations and maturity zones.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>M37W, Mo18W, Tx303</span>
        </div>
      </article>

      <!-- Popcorn -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-popcorn">Popcorn</span>
          <span class="nam-subpop-count">1 inbred</span>
        </div>
        <h3 class="nam-subpop-name">Popcorn Line</h3>
        <p class="nam-subpop-desc">Specialty endosperm architecture characterized by a hard, dense pericarp and high expansion volume upon heating.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>HP301</span>
        </div>
      </article>

      <!-- Sweet Corn -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-sweet">Sweet Corn</span>
          <span class="nam-subpop-count">2 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Sweet Corn Inbreds</h3>
        <p class="nam-subpop-desc">Specialty table corn lines carrying endosperm mutations that retard starch conversion, increasing sugar accumulation in kernels.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>Il14H, P39</span>
        </div>
      </article>
    </div>
  </div>

  </section>

  <!-- SECTION 3: KEY PUBLICATIONS & ABSTRACT PREVIEWS -->
  <section id="nam-publications" aria-labelledby="nam-pub-title">
    <div class="mgdb-section-heading">
      <div><h2 id="nam-pub-title">Publications</h2></div>
    </div>

    <div class="mgdb-panel">
      <div class="nam-publications-grid">
      <!-- Publication 1: Hufford et al. 2021 -- the paper describing these
           assemblies and their annotations, so the one to cite for the data -->
      <article class="nam-pub-card">
        <div class="nam-pub-meta-top">
          <span class="nam-pub-journal-badge">Science &bull; 2021</span>
          <span class="nam-pub-doi">DOI&#58; 10.1126/science.abg5289</span>
        </div>
        <h3 class="nam-pub-title">De novo assembly, annotation, and comparative analysis of 26 diverse maize genomes</h3>
        <p class="nam-pub-authors">Matthew B. Hufford, Arun S. Seetharam, Margaret R. Woodhouse, Kapeel Chougule, Fang Ou, Jianing Liu, Scott T. Higgins, John L. Portwood II, Carson M. Andorf, et al. \(NAM Consortium\)</p>
        <p class="nam-pub-citation"><em>Science</em> 2021 Aug 6; 373\(6555\)&#58;655&ndash;662.</p>
        
        <div class="nam-pub-abstract-wrap">
          <h4 class="nam-pub-abstract-heading">Abstract</h4>
          <p class="nam-pub-abstract-text">Maize is an important crop with extraordinary levels of genetic and phenotypic diversity. To understand this diversity, we produced de novo chromosome-scale genome assemblies for 26 inbred lines representing the founders of the nested association mapping population. Comparative analyses revealed that although the genome architecture is broadly conserved, the maize pan-genome contains substantial structural variation, with thousands of genes exhibiting presence-absence variation or copy number variation across lines. We identified widespread structural diversity in intergenic regulatory regions, demonstrating how transposable element proliferation and local sequence divergence shape the transcriptional landscape and phenotypic diversity of modern maize.</p>
        </div>

        <div class="nam-pub-actions">
          <a class="mgdb-button mgdb-button-primary" href="https://www.science.org/doi/10.1126/science.abg5289" target="_blank" rel="noopener">Full Text on Science &#8599;</a>
          <a class="mgdb-button mgdb-button-secondary" href="https://pubmed.ncbi.nlm.nih.gov/34353948/" target="_blank" rel="noopener">PubMed 34353948 &#8599;</a>
          <a class="mgdb-button mgdb-button-quiet" href="/data_center/reference?id=9023933">MaizeGDB Record</a>
        </div>
      </article>

      <!-- Publication 2: McMullen et al. 2009 -->
      <article class="nam-pub-card">
        <div class="nam-pub-meta-top">
          <span class="nam-pub-journal-badge">Science &bull; 2009</span>
          <span class="nam-pub-doi">DOI&#58; 10.1126/science.1174320</span>
        </div>
        <h3 class="nam-pub-title">Genetic Properties of the Maize Nested Association Mapping Population</h3>
        <p class="nam-pub-authors">Michael D. McMullen, Stephen Kresovich, Hector Sanchez Villeda, Peter Bradbury, Huihui Li, Qi Sun, Sherry Flint-Garcia, Jeffrey Thornsberry, Charlotte Acharya, Christopher Bottoms, et al.</p>
        <p class="nam-pub-citation"><em>Science</em> 2009 Aug 7; 325\(5941\)&#58;737&ndash;740.</p>
        
        <div class="nam-pub-abstract-wrap">
          <h4 class="nam-pub-abstract-heading">Abstract</h4>
          <p class="nam-pub-abstract-text">Nested association mapping \(NAM\) takes advantage of both historical recombination events and structured biparental crosses to provide high statistical power and high resolution for dissecting complex quantitative traits. The maize NAM population consists of 25 recombinant inbred line \(RIL\) families with 200 lines each \(5,000 RILs total\) crossed to the common parent B73. We characterized recombination landscapes and genetic architecture across the population, demonstrating the utility of NAM for high-resolution QTL mapping in crops.</p>
        </div>

        <div class="nam-pub-actions">
          <a class="mgdb-button mgdb-button-primary" href="https://www.science.org/doi/10.1126/science.1174320" target="_blank" rel="noopener">Full Text on Science &#8599;</a>
          <a class="mgdb-button mgdb-button-secondary" href="https://pubmed.ncbi.nlm.nih.gov/19661427/" target="_blank" rel="noopener">PubMed 19661427 &#8599;</a>
        </div>
      </article>

      <!-- Publication 3: Yu et al. 2008 -->
      <article class="nam-pub-card">
        <div class="nam-pub-meta-top">
          <span class="nam-pub-journal-badge">Genetics &bull; 2008</span>
          <span class="nam-pub-doi">DOI&#58; 10.1534/genetics.107.074245</span>
        </div>
        <h3 class="nam-pub-title">Genetic Design and Statistical Power of a Nested Association Mapping Population in Maize</h3>
        <p class="nam-pub-authors">Jianming Yu, James B. Holland, Michael D. McMullen, Edward S. Buckler</p>
        <p class="nam-pub-citation"><em>Genetics</em> 2008 Jan; 178\(1\)&#58;539&ndash;551.</p>
        
        <div class="nam-pub-abstract-wrap">
          <h4 class="nam-pub-abstract-heading">Abstract</h4>
          <p class="nam-pub-abstract-text">We evaluate the genetic properties and statistical power of the Nested Association Mapping \(NAM\) strategy. By nesting diverse parental lines into a reference design, NAM integrates the benefits of linkage analysis with association mapping, circumventing allele frequency limitations and population structure confounding.</p>
        </div>

        <div class="nam-pub-actions">
          <a class="mgdb-button mgdb-button-primary" href="https://doi.org/10.1534/genetics.107.074245" target="_blank" rel="noopener">Full Text on Genetics &#8599;</a>
          <a class="mgdb-button mgdb-button-secondary" href="https://pubmed.ncbi.nlm.nih.gov/18202393/" target="_blank" rel="noopener">PubMed 18202393 &#8599;</a>
        </div>
      </article>
    </div>
  </div>

  </section>

  <!-- SECTION 4: DATA HOSTED AT MAIZEGDB -->
  <section id="nam-data-hosted" aria-labelledby="nam-hosted-title">
    <div class="mgdb-section-heading">
      <div><h2 id="nam-hosted-title">Hosted data</h2></div>
    </div>

    <div class="mgdb-panel">
<div class="nam-hosted-grid">
      <!-- 1: JBrowse 2 -->
      <article class="nam-hosted-card">
        <h3>Genome Browsers \(JBrowse 2\)</h3>
        <p>Interactive chromosome-scale browsers for all 26 assemblies with multi-tissue RNA-seq, gene models, repeat elements, and synteny tracks.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/genomebrowser">Open Genome Browsers &#8599;</a>
      </article>

      <!-- 2: BLAST -->
      <article class="nam-hosted-card">
        <h3>Sequence BLAST Tool</h3>
        <p>Align nucleotide or peptide queries directly against full NAM founder assemblies, predicted CDS, and annotated gene model targets.</p>
        <a class="mgdb-button mgdb-button-secondary" href="$(blast_url)">Run BLAST Search &#8599;</a>
      </article>

      <!-- 3: Bulk Downloads -->
      <article class="nam-hosted-card">
        <h3>Bulk Downloads &amp; Globus</h3>
        <p>Retrieve whole-genome FASTA, GFF3 annotations, canonical CDS/PEP sequences, and pre-indexed BigWig tracks via HTTP or Globus.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/download#downloads-nam">NAM Downloads &#8599;</a>
      </article>

      <!-- 4: Gene & Pan-Gene Center -->
      <article class="nam-hosted-card">
        <h3>Gene &amp; Pan-Gene Centers</h3>
        <p>Query pan-gene matrix assignments, homolog cluster groupings, and functional GO/InterPro domain annotations across all 26 lines.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/pan_gene_center">Explore Pan-Genes &#8599;</a>
      </article>
    </div>

