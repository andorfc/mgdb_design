  <!-- SECTION 2: SUBPOPULATION STRUCTURE & GENOMIC DIVERSITY -->
  <section id="nam-subpopulations" aria-labelledby="nam-subpop-title">
    <div class="mgdb-section-heading">
      <div><h2 id="nam-subpop-title">Subpopulations</h2></div>
    </div>

<div class="nam-subpop-grid">
      <!-- Stiff Stalk -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-stiff">Stiff Stalk</span>
          <span class="nam-subpop-count">1 inbred</span>
        </div>
        <h3 class="nam-subpop-name">Stiff Stalk Synthetic \(SS\)</h3>
        <p class="nam-subpop-desc">Iowa Stiff Stalk Synthetic derivatives characterized by stalk strength and lodging resistance, forming one of the primary heterotic groups in North American hybrid breeding.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>B73 \(Common Reference\)</span>
        </div>
      </article>

      <!-- Non-Stiff Stalk -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-nonstiff">Non-Stiff Stalk</span>
          <span class="nam-subpop-count">6 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Non-Stiff Stalk \(NSS\)</h3>
        <p class="nam-subpop-desc">Diverse temperate inbreds originating from Lancaster Sure Crop, Reid Yellow Dent, and Leaming pools, providing maximal heterosis when crossed to Stiff Stalk parents.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>B97, Ky21, M162W, Ms71, Oh43, Oh7B</span>
        </div>
      </article>

      <!-- Tropical / Subtropical -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-tropical">Tropical / Subtropical</span>
          <span class="nam-subpop-count">13 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Tropical &amp; Subtropical Inbreds</h3>
        <p class="nam-subpop-desc">Bred at CIMMYT, IITA, and Suwan lines in Thailand, harboring vast allelic diversity, photoperiod sensitivity, disease resistance alleles, and distinct genomic architecture.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>CML52, CML69, CML103, CML228, CML247, CML277, CML322, CML333, Ki3, Ki11, NC350, NC358, Tzi8</span>
        </div>
      </article>

      <!-- Mixed -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-mixed">Mixed</span>
          <span class="nam-subpop-count">3 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Temperate / Tropical Mixed</h3>
        <p class="nam-subpop-desc">Lines adapted through hybrid crosses between temperate dent lines and tropical germplasm, bridging distinct climatic adaptations and maturity zones.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>M37W, Mo18W, Tx303</span>
        </div>
      </article>

      <!-- Popcorn -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-popcorn">Popcorn</span>
          <span class="nam-subpop-count">1 inbred</span>
        </div>
        <h3 class="nam-subpop-name">Popcorn Line</h3>
        <p class="nam-subpop-desc">Specialty endosperm architecture characterized by a hard, dense pericarp and high expansion volume upon heating.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>HP301</span>
        </div>
      </article>

      <!-- Sweet Corn -->
      <article class="nam-subpop-card">
        <div class="nam-subpop-head">
          <span class="nam-badge nam-badge-sweet">Sweet Corn</span>
          <span class="nam-subpop-count">2 inbreds</span>
        </div>
        <h3 class="nam-subpop-name">Sweet Corn Inbreds</h3>
        <p class="nam-subpop-desc">Specialty table corn lines carrying endosperm mutations that retard starch conversion, increasing sugar accumulation in kernels.</p>
        <div class="nam-subpop-lines">
          <strong>Members&#58;</strong> <span>Il14H, P39</span>
        </div>
      </article>
    </div>

  </section>

