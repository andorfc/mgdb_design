<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/map">
<meta property="og:title" content="MaizeGDB Map Data Hub | Genetic, Cytogenetic &amp; Physical Maps">
<meta property="og:description" content="Explore and search over 2,100 curated maize genetic, cytogenetic, physical, and bin maps across chromosomes 1–10.">

<main class="mgdb-page mgdb-hub-page mgdb-map-page" id="map-main">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Map Data Hub</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="map-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="Chromosome map icon">
        <rect x="28" y="16" width="16" height="64" rx="8" fill="none" stroke="#235c37" stroke-width="4"/>
        <line x1="28" y1="32" x2="44" y2="32" stroke="#d99a0b" stroke-width="3"/>
        <line x1="28" y1="44" x2="44" y2="44" stroke="#235c37" stroke-width="3"/>
        <line x1="28" y1="52" x2="44" y2="52" stroke="#d99a0b" stroke-width="3"/>
        <line x1="28" y1="68" x2="44" y2="68" stroke="#235c37" stroke-width="3"/>
        <rect x="52" y="24" width="16" height="56" rx="8" fill="none" stroke="#235c37" stroke-width="4"/>
        <line x1="52" y1="40" x2="68" y2="40" stroke="#d99a0b" stroke-width="3"/>
        <line x1="52" y1="56" x2="68" y2="56" stroke="#235c37" stroke-width="3"/>
        <line x1="52" y1="64" x2="68" y2="64" stroke="#d99a0b" stroke-width="3"/>
      </svg>
      <strong>Map<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="map-title">Explore maize chromosome &amp; linkage maps</h1>
      <p class="mgdb-hero-description">Discover over 2,100 curated genetic, cytogenetic, recombinant inbred, physical, and bin maps comprising more than 738,000 locus coordinates across the 10 maize chromosomes.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Map resource sections">
    <a href="#map-search-section" class="is-current" aria-current="true">Search</a>
    <a href="#map-key-maps">Key maps</a>
    <a href="#map-chromosomes">Chromosomes</a>
    <a href="#map-collections">Collections</a>
    <a href="#map-downloads">Downloads</a>
    <a href="#map-references">References</a>
    <a href="#map-statistics">Metrics</a>
    <a href="#map-related">Related resources</a>
  </nav>

  <!-- Search & Advanced Filters Panel -->
  <section id="map-search-section" class="map-search-panel" aria-labelledby="map-search-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="map-search-title">Search</h2>
      </div>
    </div>

    <form id="map-search-form" class="map-search-form" role="search">
      <div class="map-query-row">
        <div class="map-query-field">
          <label class="mgdb-visually-hidden" for="map-query">Search map name, author, or panel</label>
          <div class="map-query-control">
            <svg class="map-search-icon" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input id="map-query" name="term" type="search" placeholder="Try IBM2, ISU, Bins, Cornfed, FSU, UMC 98, or B73…" autocomplete="off" aria-describedby="map-query-hint" />
            <button id="map-query-clear" type="button" hidden>Clear</button>
          </div>
        </div>

        <button class="mgdb-button mgdb-button-primary map-query-submit" id="map-search-submit" type="submit">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
          Search maps
        </button>
      </div>

      <p class="map-search-hint mgdb-muted mgdb-small" id="map-query-hint">Search terms are case-insensitive. Matches map names, authors, mapping panels, and mapped loci. Use * as a wildcard.</p>

      <div class="map-examples" aria-label="Example searches">
        <span class="map-example-label">EXAMPLES&#58;</span>
        <button type="button" class="map-example-btn" data-map-example="IBM2">IBM2 Neighbors</button>
        <button type="button" class="map-example-btn" data-map-example="Bins">Bin maps</button>
        <button type="button" class="map-example-btn" data-map-example="ISU">ISU integrated</button>
        <button type="button" class="map-example-btn" data-map-example="UMC 98">UMC 98</button>
        <button type="button" class="map-example-btn" data-map-example="Cornfed">Cornfed composite</button>
        <button type="button" class="map-example-btn" data-map-example="FSU">FSU cytogenetic</button>
        <button type="button" class="map-example-btn" data-map-example="Chromosome 1">Chromosome 1</button>
      </div>

      <details class="map-advanced" id="map-adv">
        <summary>
          <span class="map-advanced-label">Advanced search</span>
          <span class="map-advanced-count" id="map-advanced-count" hidden></span>
        </summary>
        <div class="map-advanced-body">
          <div class="map-advanced-grid">
            <div class="mgdb-hub-field">
              <label class="mgdb-label" for="map-linkage">Chromosome / Linkage group</label>
              <select class="mgdb-select" id="map-linkage" name="linkage">
                <option value="0">All chromosomes &amp; linkage groups</option>
                $(linkage_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label class="mgdb-label" for="map-has-loci">Locus filter</label>
              <select class="mgdb-select" id="map-has-loci" name="has_loci">
                <option value="0">All maps</option>
                <option value="1">With mapped locus coordinates</option>
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label class="mgdb-label" for="map-locus-filter">Contains locus / marker name &#40;e.g. kn1, tub1, bz1&#41;</label>
              <input class="mgdb-input" type="text" id="map-locus-filter" name="locus" placeholder="Enter locus symbol or comma-separated list…" />
            </div>

            <div class="mgdb-hub-field">
              <label class="mgdb-label" for="map-source-filter">Mapping source / Contributor</label>
              <select class="mgdb-select" id="map-source-filter" name="source">
                <option value="0">All mapping sources &amp; authors</option>
                $(source_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label class="mgdb-label" for="map-panel-filter">Mapping panel of stocks</label>
              <select class="mgdb-select" id="map-panel-filter" name="panel">
                <option value="0">All mapping panels &#40;IBM-94, IBM-302, NAM, etc.&#41;</option>
                $(panel_options)
              </select>
            </div>
          </div>

          <div class="map-advanced-actions">
            <button class="mgdb-button mgdb-button-primary" id="map-adv-submit" type="submit">Apply filters</button>
            <button class="map-advanced-reset-btn" id="map-adv-reset" type="button">Reset filters</button>
          </div>
        </div>
      </details>
    </form>
  </section>

  <!-- Results Section -->
  <section id="map-results-section" class="map-results-section" aria-labelledby="map-results-title" hidden>
    <div class="mgdb-section-heading">
      <div>
        <h2 id="map-results-title">Results</h2>
      </div>
    </div>

    <p class="map-results-status" id="map-results-status" role="status" aria-live="polite">Enter a search term above or choose a chromosome filter to inspect maps.</p>

    <div class="map-results-toolbar" id="map-results-toolbar">
      <div class="mgdb-hub-field map-results-filter">
        <label for="map-results-filter">Filter these results</label>
        <input id="map-results-filter" type="search" placeholder="Narrow this page" autocomplete="off" />
        <span class="mgdb-result-count" id="map-filter-count" aria-live="polite"></span>
      </div>

      <div class="mgdb-hub-field">
        <label for="map-page-size">Results shown</label>
        <select class="mgdb-select" id="map-page-size">
          <option value="10">Top 10</option>
          <option value="25" selected>Top 25</option>
          <option value="50">Top 50</option>
          <option value="all">All results</option>
        </select>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action map-results-export">
        <a class="mgdb-button mgdb-button-quiet" id="map-export-tsv" href="#" download>Export TSV</a>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action map-results-view">
        <div class="mgdb-view-toggle" role="group" aria-label="Result view">
          <button class="mgdb-view-btn" id="map-view-cards" type="button" data-view="card" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"/></svg>Cards
          </button>
          <button class="mgdb-view-btn is-active" id="map-view-table" type="button" data-view="table" aria-pressed="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="7" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="12" width="14" height="2" rx="1" fill="currentColor"/></svg>Table
          </button>
        </div>
      </div>
    </div>

    <div id="map-results" class="map-results-container map-view-table"></div>

    <div id="map-empty" class="mgdb-empty" hidden>
      <h3>No maps matched your query</h3>
      <p>Try searching with a broader keyword &#40;e.g. <code>IBM</code>, <code>Bins</code>, <code>1</code>&#41; or resetting chromosome and locus filters.</p>
      <button class="mgdb-button mgdb-button-secondary" id="map-empty-reset" type="button">Reset search</button>
    </div>

    <nav id="map-pagination" class="map-pagination" aria-label="Search result pages"></nav>
  </section>

