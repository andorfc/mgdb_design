$$SYNTAX-LEVEL 2
*(mgdb-gene-record-v4
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:title" content="$(gene_title) &mdash; MaizeGDB gene record">
<meta property="og:description" content="$(gene_summary)">

;; Gene record header mockup, version 4. The header alone -- no synonym table,
;; nothing below it. One green panel rather than v3's two white cards: the gene
;; and its genetic map on the left, the gene model and its physical map on the
;; right, divided by a single vertical rule running the height of the panel.
<main class="mgdb-page mgdb-arrows-v2 mgdb-hub-page mgdb-record-page mgdb-gene-record-v4-page" id="gene-record-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/gene_center/gene">Gene and Locus Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">$(gene_title)</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-hero v4-hero" aria-labelledby="gene-record-title">
    <div class="mgdb-hero-body v4-hero-body">
      $(status_notice)
      <div class="v4-split">
        <div class="v4-side v4-side-gene">$(locus_side)</div>
        <div class="v4-side v4-side-model">$(model_side)</div>
      </div>
    </div>
  </section>

  <p class="v4-note mgdb-muted">Header mockup only. The record's sections are on <a href="/gene_center/gene/$(requested_identifier_path)">the current page</a>, beside <a href="/gene_center/gene_v2/$(requested_identifier_path)">the four-view mockup</a> and <a href="/gene_center/gene_v3/$(requested_identifier_path)">the two-column header</a>.</p>
</main>
)
