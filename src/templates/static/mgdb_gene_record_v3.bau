$$SYNTAX-LEVEL 2
*(mgdb-gene-record-v3
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:title" content="$(gene_title) &mdash; MaizeGDB gene record">
<meta property="og:description" content="$(gene_summary)">

;; Gene record header mockup, version 3. The header alone: a left column
;; for the gene locus, a right column for its most current gene model, and a
;; slim synonym table under both. Everything is rendered by the controller
;; from indexed lookups; there is no page script and no API call.
<main class="mgdb-page mgdb-arrows-v2 mgdb-hub-page mgdb-record-page mgdb-gene-record-v3-page" id="gene-record-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/gene_center/gene">Gene and Locus Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">$(gene_title)</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-hero v3-hero" aria-labelledby="gene-record-title">
    <div class="mgdb-hero-body v3-hero-body">
      $(status_notice)
      <div class="v3-columns">
        <div class="v3-col v3-col-locus">
          <h2 class="v3-col-title">Gene locus</h2>
          $(locus_column)
        </div>
        <div class="v3-col v3-col-model">
          <h2 class="v3-col-title">Gene model</h2>
          $(model_column)
        </div>
      </div>
      $(synonyms_strip)
    </div>
  </section>

  <p class="v3-note mgdb-muted">Header mockup only. The record's sections are on <a href="/gene_center/gene/$(requested_identifier_path)">the current page</a> and <a href="/gene_center/gene_v2/$(requested_identifier_path)">the four-view mockup</a>.</p>
</main>
)
