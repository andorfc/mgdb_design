$$SYNTAX-LEVEL 2
*(mgdb-reference-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No reference found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="ref-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/reference">Literature Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="ref-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="ref-notfound-title">No reference matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB curates $(total_references) references. None of them carries that MaizeGDB ID, DOI, or PubMed ID.</p>
    </div>
  </section>

  <section id="ref-notfound-search" aria-labelledby="ref-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="ref-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/reference" method="get" role="search">
      <label class="mgdb-visually-hidden" for="ref-notfound-query">Title, author, journal, DOI, or MaizeGDB ID</label>
      <input class="mgdb-input" id="ref-notfound-query" name="q" type="search" autocomplete="off" value="$(requested_value)" placeholder="Title, author, journal, DOI, or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search the literature</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/reference?id=9043389">9043389</a>
      <a class="mgdb-rec-example" href="/data_center/reference?id=10.1016/j.molp.2020.03.003">10.1016/j.molp.2020.03.003</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs one reference&#58; its MaizeGDB ID, its DOI, or its PubMed ID. An author name or a phrase from a title is a search rather than a record, and the Literature Data Hub answers those.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="ref-notfound-resources" aria-labelledby="ref-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="ref-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/reference">
          <strong>Literature Data Hub</strong>
          <span>Search every curated maize reference by title, author, journal, or year</span>
        </a>
        <a href="/hot_new_papers">
          <strong>Editorial Board picks</strong>
          <span>Papers the Board nominated as being of particular community interest</span>
        </a>
        <a href="/cite">
          <strong>Cite MaizeGDB</strong>
          <span>The papers behind MaizeGDB itself, and how to cite the database</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="https\://pubmed.ncbi.nlm.nih.gov/" target="_blank" rel="noopener">
          <strong>PubMed</strong>
          <span>Abstracts and full-text links beyond the MaizeGDB collection</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
