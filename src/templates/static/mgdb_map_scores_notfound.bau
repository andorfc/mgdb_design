$$SYNTAX-LEVEL 2
*(mgdb-map-scores-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No map score found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="ms-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/map">Map Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="ms-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="ms-notfound-title">No map score matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB holds $(total_scores) curated map scores. None of them carries that name or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="ms-notfound-search" aria-labelledby="ms-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="ms-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/map" method="get" role="search">
      <label class="mgdb-visually-hidden" for="ms-notfound-query">Map score name or MaizeGDB ID</label>
      <input class="mgdb-input" id="ms-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Map score name or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search maps</button>
    </form>
    <p class="mgdb-rec-hint">A map score is named for the marker and the mapping population it was scored in. Map scores are reached from the map and locus records that use them rather than searched directly.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="ms-notfound-resources" aria-labelledby="ms-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="ms-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>Genetic, cytogenetic, and physical maps, and the scores behind them</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>Loci carry their map scores in the Genetic information section</span>
        </a>
        <a href="/data_center/marker">
          <strong>Marker Data Hub</strong>
          <span>The probes that produce map scores</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Data Hub</strong>
          <span>The mapping panels scores are recorded against</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across every data type</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
