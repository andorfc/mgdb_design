$$SYNTAX-LEVEL 2
*(mgdb-image
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/image">
<meta property="og:title" content="MaizeGDB Image Data Center">
<meta property="og:description" content="Explore over 113,000 maize mutant ear photographs, agarose gel patterns, stock germplasm, teosinte species, and anatomical traits.">

<main class="mgdb-page mgdb-image-page" id="image-top" data-initial-category="$(initial_category)">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data centers</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Images</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="image-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="Maize visual media and camera lens icon">
        <rect x="14" y="24" width="68" height="52" rx="10" fill="none" stroke="#235c37" stroke-width="5" />
        <circle cx="48" cy="50" r="16" fill="none" stroke="#d99a0b" stroke-width="5" />
        <circle cx="48" cy="50" r="8" fill="#437d57" />
        <circle cx="68" cy="36" r="4" fill="#7a4a10" />
        <path d="M34 24 L40 14 L56 14 L62 24 Z" fill="#235c37" />
      </svg>
      <strong>Image<br />Center</strong>
      <span>MaizeGDB</span>
    </div>
    <div class="mgdb-hero-body">
      <span class="mgdb-eyebrow">Visual genetics &amp; genomics archive</span>
      <h1 id="image-title">Explore photographs, mutant specimens, and molecular assays</h1>
      <p class="mgdb-hero-tagline">Visual records for $(total_images) images across $(mutant_count) mutant variations, $(gel_count) gel patterns, $(stock_count) germplasm stocks, and wild teosinte species.</p>
      <p class="mgdb-hero-description">Unifying mutant ear photographs from the classic Neuffer collection, agarose gel hybridization patterns, seedling phenotypes, Plant Ontology anatomy, and wild maize relatives.</p>
      <div class="mgdb-hero-actions">
        <a class="mgdb-button mgdb-button-primary" href="#image-search-panel">Search gallery</a>
        <a class="mgdb-button mgdb-button-secondary" href="#image-categories">Browse categories</a>
      </div>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#image-overview">Overview</a>
    <a href="#image-search-panel">Search &amp; Gallery</a>
    <a href="#image-categories">Categories</a>
    <a href="#image-collections">Collections</a>
    <a href="#image-downloads">Downloads</a>
  </nav>

  <section id="image-overview" aria-labelledby="image-overview-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Visual archive summary</span>
        <h2 id="image-overview-title">Image collection at a glance</h2>
      </div>
      <p>Curated photographs, microscopic images, gel patterns, and anatomical diagrams maintained at MaizeGDB.</p>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric-quiet">
        <strong class="mgdb-metric-value">$(total_images)</strong>
        <p>total curated images</p>
      </article>
      <article class="mgdb-metric-quiet">
        <strong class="mgdb-metric-value">$(mutant_count)</strong>
        <p>mutants &amp; variations</p>
      </article>
      <article class="mgdb-metric-quiet">
        <strong class="mgdb-metric-value">$(gel_count)</strong>
        <p>gel pattern assays</p>
      </article>
      <article class="mgdb-metric-quiet">
        <strong class="mgdb-metric-value">$(stock_count)</strong>
        <p>germplasm stock photos</p>
      </article>
      <article class="mgdb-metric-quiet">
        <strong class="mgdb-metric-value">$(species_count)</strong>
        <p>species &amp; teosinte photos</p>
      </article>
      <article class="mgdb-metric-quiet">
        <strong class="mgdb-metric-value">$(probe_count)</strong>
        <p>probe hybridization images</p>
      </article>
    </div>
  </section>

  <section id="image-search-panel" class="image-search-panel" aria-labelledby="image-search-title">
    <div class="image-section-heading">
      <div>
        <span class="mgdb-eyebrow">Visual search &amp; filter</span>
        <h2 id="image-search-title">Search image archive</h2>
      </div>
      <p>Filter by image category or search by gene symbol, mutant name, stock accession, probe identifier, or caption text.</p>
    </div>

    <div class="image-category-pill-bar" role="tablist" aria-label="Image category filter">
      <button class="image-cat-pill is-active" type="button" data-cat="all" role="tab" aria-selected="true">All Images</button>
      <button class="image-cat-pill" type="button" data-cat="mutant" role="tab" aria-selected="false">Mutants &amp; Variations</button>
      <button class="image-cat-pill" type="button" data-cat="gel_pattern" role="tab" aria-selected="false">Gel Patterns</button>
      <button class="image-cat-pill" type="button" data-cat="stock" role="tab" aria-selected="false">Stocks &amp; Germplasm</button>
      <button class="image-cat-pill" type="button" data-cat="species" role="tab" aria-selected="false">Species &amp; Teosinte</button>
      <button class="image-cat-pill" type="button" data-cat="trait" role="tab" aria-selected="false">Traits &amp; Anatomy</button>
      <button class="image-cat-pill" type="button" data-cat="probe" role="tab" aria-selected="false">Probes &amp; Markers</button>
    </div>

    <form id="image-search-form" role="search">
      <div class="image-main-search">
        <label for="image-query">Search keywords, symbols, or captions</label>
        <div class="image-query-control">
          <svg class="image-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
          <input id="image-query" name="q" type="search" placeholder="Try purple, Ac Ds transposon, umc90, teosinte, shrunken, B73, or dwarf" autocomplete="off" />
          <button id="image-query-clear" type="button" hidden>Clear</button>
        </div>
      </div>

      <div class="image-sort-select">
        <label for="image-sort">Sort order</label>
        <select id="image-sort" name="sort">
          <option value="relevance">Relevance</option>
          <option value="latest" selected>Latest curated</option>
          <option value="name-asc">Name \(A&ndash;Z\)</option>
          <option value="name-desc">Name \(Z&ndash;A\)</option>
          <option value="category">Category</option>
        </select>
      </div>

      <div class="image-search-submit">
        <button class="mgdb-button mgdb-button-primary" type="submit">Search gallery</button>
      </div>

      <div class="image-example-row" aria-label="Example image searches">
        <span>Examples</span>
        <button type="button" data-img-example="purple">purple aleurone</button>
        <button type="button" data-img-example="Ac Ds">Ac/Ds transposon</button>
        <button type="button" data-img-example="umc90">umc90</button>
        <button type="button" data-img-example="teosinte">teosinte</button>
        <button type="button" data-img-example="shrunken">shrunken kernel</button>
        <button type="button" data-img-example="dwarf">dwarf plant</button>
      </div>
    </form>
  </section>

  <section id="image-gallery-section" class="image-gallery-section" aria-labelledby="image-gallery-title">
    <div class="image-results-heading">
      <div>
        <span class="mgdb-eyebrow">Visual gallery</span>
        <h2 id="image-gallery-title">Matching images</h2>
        <p id="image-results-status" aria-live="polite">Loading images&hellip;</p>
      </div>
      <div class="image-results-controls">
        <div class="image-export-buttons">
          <a class="mgdb-button mgdb-button-quiet" id="image-export-tsv" href="#" download>Export TSV</a>
          <a class="mgdb-button mgdb-button-quiet" id="image-export-csv" href="#" download>Export CSV</a>
        </div>
      </div>
    </div>

    <div id="image-results-grid" class="image-results-grid"></div>

    <div id="image-empty" class="mgdb-empty" hidden>
      <h3>No images matched your query</h3>
      <p>Try searching with a broader keyword or switching to 'All Images'.</p>
      <button class="mgdb-button mgdb-button-secondary" id="image-empty-reset" type="button">Reset search</button>
    </div>

    <nav id="image-pagination" class="image-pagination" aria-label="Image gallery pages"></nav>
  </section>

  <section id="image-categories" aria-labelledby="image-categories-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Category index</span>
        <h2 id="image-categories-title">Explore by media category</h2>
      </div>
      <p>Navigate directly to curated image sets for specific experimental and genetic domains.</p>
    </div>

    <div class="mgdb-card-grid image-category-grid">
      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">$(mutant_count) Photos</span>
        <h3>Mutants &amp; Variations</h3>
        <p>Photographs of mutant ears, seedlings, and kernel mosaicism from the Gerald Neuffer pollen mutagenesis collection and classical alleles.</p>
        <button class="image-category-card-btn" type="button" data-switch-cat="mutant">Browse Mutants &rarr;</button>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-info">$(gel_count) Assays</span>
        <h3>Gel Pattern Archive</h3>
        <p>Agarose and polyacrylamide gel hybridization assays linked to restriction fragment length polymorphism \(RFLP\) and SSR markers.</p>
        <button class="image-category-card-btn" type="button" data-switch-cat="gel_pattern">Browse Gel Patterns &rarr;</button>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-warn">$(stock_count) Photos</span>
        <h3>Stocks &amp; Germplasm</h3>
        <p>Specimen photographs of maize inbred lines, landraces, seed packets, and mutant lines distributed by the COOP Stock Center.</p>
        <button class="image-category-card-btn" type="button" data-switch-cat="stock">Browse Stocks &rarr;</button>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill">$(species_count) Photos</span>
        <h3>Species &amp; Teosinte</h3>
        <p>Field photographs, botanical illustrations, and spikelet architecture across wild Zea species and Tripsacum relatives.</p>
        <button class="image-category-card-btn" type="button" data-switch-cat="species">Browse Species &rarr;</button>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">$(probe_count) Probes</span>
        <h3>Probes &amp; Clones</h3>
        <p>Autoradiographs, clone hybridizations, and physical map contig anchoring images for maize genomic probes.</p>
        <button class="image-category-card-btn" type="button" data-switch-cat="probe">Browse Probes &rarr;</button>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-warn">300+ Illustrations</span>
        <h3>Traits &amp; Anatomy</h3>
        <p>Plant Ontology \(PO\) and Trait Ontology \(TO\) anatomical diagrams, vegetative tissues, and developmental growth stages.</p>
        <button class="image-category-card-btn" type="button" data-switch-cat="trait">Browse Traits &rarr;</button>
      </article>
    </div>
  </section>

  <section id="image-collections" aria-labelledby="image-collections-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Curated collections</span>
        <h2 id="image-collections-title">Specialized mutant guides &amp; tools</h2>
      </div>
      <p>Deep-dive archives and sister data centers featuring specialized image sets.</p>
    </div>

    <div class="mgdb-card-grid image-special-grid">
      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">External Guide</span>
        <h3>Guide to Maize Mutant Phenotypes</h3>
        <p>Classic online monograph by M. Gerald Neuffer with pollen EMS mutagenesis history, detailed phenotypic descriptions, and high-res plates.</p>
        <a href="https://mutants.maizegdb.org/doku.php">Launch Guide <span aria-hidden="true">&nearr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-info">Data Center</span>
        <h3>Phenotype Data Center</h3>
        <p>Search over 1,190 mutant phenotypes classified by plant body part and trait ontologies.</p>
        <a href="/data_center/phenotype">Open Phenotype Center <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-warn">Data Center</span>
        <h3>Molecular Marker &amp; Probe Center</h3>
        <p>Over 771,000 marker records with mapped chromosome bin positions, primer sets, and gel assay evidence.</p>
        <a href="/data_center/marker">Open Marker Center <span aria-hidden="true">&rarr;</span></a>
      </article>
    </div>
  </section>

  <section id="image-downloads" aria-labelledby="image-downloads-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Bulk data</span>
        <h2 id="image-downloads-title">Image archives &amp; downloads</h2>
      </div>
      <p>High-resolution batch image downloads for offline analysis, teaching, and publication.</p>
    </div>

    <div class="image-download-grid" aria-label="Image downloads">
      <article class="image-download-card">
        <div class="image-download-header">
          <span class="mgdb-pill mgdb-pill-ok">ZIP Archive</span>
          <h3>Neuffer High-Res Mutant Images</h3>
        </div>
        <p>Download the complete collection of Dr. M. Gerald Neuffer's original high-resolution maize mutant photographs.</p>
        <a class="mgdb-button mgdb-button-secondary" href="https://download.maizegdb.org/Neuffer_Mutant_Images/Neuffer_Mutant_Images.zip">Download ZIP Archive <span aria-hidden="true">&darr;</span></a>
      </article>

      <article class="image-download-card">
        <div class="image-download-header">
          <span class="mgdb-pill mgdb-pill-info">Export</span>
          <h3>Full Image Metadata TSV</h3>
        </div>
        <p>Export full metadata for all 113,000+ images with record IDs, direct image URLs, and captions.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/search/image/image_search_api.php?category=all&amp;format=tsv">Download Metadata TSV <span aria-hidden="true">&darr;</span></a>
      </article>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <dialog id="image-lightbox-modal" class="image-lightbox-modal" aria-labelledby="lightbox-title">
    <div class="lightbox-dialog-content">
      <button id="lightbox-close-btn" class="lightbox-close-btn" type="button" aria-label="Close preview">&times;</button>
      <div class="lightbox-image-wrap">
        <img id="lightbox-img" src="" alt="Full size image preview" />
      </div>
      <div class="lightbox-details">
        <div class="lightbox-meta">
          <span id="lightbox-badge" class="image-card-badge"></span>
          <h3 id="lightbox-title"></h3>
        </div>
        <p id="lightbox-caption"></p>
        <div class="lightbox-actions">
          <a id="lightbox-record-link" class="mgdb-button mgdb-button-primary" href="#">View Database Record &rarr;</a>
          <a id="lightbox-download-link" class="mgdb-button mgdb-button-secondary" href="#" target="_blank" rel="noopener noreferrer">Open Original File &nearr;</a>
          <button id="lightbox-copy-url-btn" class="mgdb-button mgdb-button-quiet" type="button">Copy URL</button>
        </div>
      </div>
    </div>
  </dialog>
</main>
)
