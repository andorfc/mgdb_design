$$SYNTAX-LEVEL 2
*(mgdb-image
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/image">
<meta property="og:title" content="MaizeGDB Image Data Hub">
<meta property="og:description" content="Search over 113,000 maize mutant photographs, gel patterns, germplasm stocks, teosinte species, and anatomical illustrations.">

<main class="mgdb-page mgdb-hub-page mgdb-image-page" id="image-main" data-initial-category="$(initial_category)">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Image Data Hub</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="image-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="Maize visual media and camera lens icon">
        <rect x="14" y="24" width="68" height="52" rx="10" fill="none" stroke="#235c37" stroke-width="5" />
        <circle cx="48" cy="50" r="16" fill="none" stroke="#d99a0b" stroke-width="5" />
        <circle cx="48" cy="50" r="8" fill="#437d57" />
        <circle cx="68" cy="36" r="4" fill="#7a4a10" />
        <path d="M34 24 L40 14 L56 14 L62 24 Z" fill="#235c37" />
      </svg>
      <strong>Image<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; August 2026</p>
      <h1 id="image-title">Maize photographs, specimens, and molecular assays</h1>
      <p class="mgdb-hero-description">$(total_images) curated images&#58; $(mutant_count) of mutants and variations, $(gel_count) gel patterns, $(stock_count) germplasm stocks, $(probe_count) probes, and $(species_count) of wild species.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#image-search" class="is-current" aria-current="true">Search</a>
    <a href="#image-categories">Categories</a>
    <a href="#image-downloads">Downloads</a>
    <a href="#image-references">References</a>
    <a href="#image-metrics">Metrics</a>
    <a href="#image-related">Related resources</a>
  </nav>

  <!-- ── Search ───────────────────────────────────────────────────────────── -->
  <section id="image-search" aria-labelledby="image-search-title">
    <div class="mgdb-section-heading">
      <div><h2 id="image-search-title">Search</h2></div>
    </div>

    <form id="image-search-form" class="image-search-form" role="search">
      <div class="mgdb-hub-field image-field-query">
        <label for="image-query">Keyword, gene symbol, stock, or caption text</label>
        <div class="image-query-control">
          <svg class="image-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
          <input id="image-query" name="q" type="search" placeholder="Keyword, gene symbol, stock accession, probe, or caption text" autocomplete="off" />
          <button id="image-query-clear" type="button" hidden>Clear</button>
        </div>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action">
        <button class="mgdb-button mgdb-button-primary" type="submit">Search images</button>
      </div>

      <div class="image-example-row" aria-label="Example searches">
        <span>Examples&#58;</span>
        <button type="button" data-img-example="purple">purple aleurone</button>
        <button type="button" data-img-example="Ac Ds">Ac/Ds transposon</button>
        <button type="button" data-img-example="umc90">umc90</button>
        <button type="button" data-img-example="teosinte">teosinte</button>
        <button type="button" data-img-example="shrunken">shrunken kernel</button>
        <button type="button" data-img-example="dwarf">dwarf plant</button>
      </div>

      <details class="image-adv" id="image-adv">
        <summary>
          <strong>Advanced search criteria</strong>
          <span>Restrict to one image category, or change how matches are ordered</span>
        </summary>
        <div class="image-adv-body">
          <div class="mgdb-hub-field">
            <label for="image-filter-category">Image category</label>
            <select id="image-filter-category" name="category">
              <option value="all">All categories</option>
              <option value="mutant">Mutants and variations</option>
              <option value="gel_pattern">Gel patterns</option>
              <option value="stock">Stocks and germplasm</option>
              <option value="species">Species and teosinte</option>
              <option value="trait">Traits and anatomy</option>
              <option value="probe">Probes and markers</option>
            </select>
          </div>

          <div class="mgdb-hub-field">
            <label for="image-sort">Sort order</label>
            <select id="image-sort" name="sort">
              <option value="latest" selected>Latest curated</option>
              <option value="relevance">Best match</option>
              <option value="name-asc">Name &#40;A&ndash;Z&#41;</option>
              <option value="name-desc">Name &#40;Z&ndash;A&#41;</option>
              <option value="category">Category</option>
            </select>
          </div>
        </div>

        <div class="image-adv-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit">Apply advanced filters</button>
          <button class="mgdb-button mgdb-button-quiet" id="image-adv-reset" type="button">Reset advanced filters</button>
        </div>
      </details>
    </form>
  </section>

  <!-- ── Search results: hidden until a search runs ───────────────────────── -->
  <section id="image-gallery-section" class="image-gallery-section" aria-labelledby="image-gallery-title" hidden>
    <div class="image-results-heading">
      <div>
        <h2 id="image-gallery-title">Search results</h2>
        <p id="image-results-status" role="status" aria-live="polite"></p>
      </div>
      <div class="image-results-controls">
        <div class="mgdb-hub-field">
          <label for="image-results-filter">Filter results</label>
          <input id="image-results-filter" type="search" placeholder="Narrow this page" autocomplete="off" />
        </div>
        <div class="mgdb-hub-field">
          <label for="image-page-size">Results per page</label>
          <select id="image-page-size">
            <option value="10">Top 10</option>
            <option value="25" selected>Top 25</option>
            <option value="50">Top 50</option>
            <option value="all">All results</option>
          </select>
        </div>
        <div class="mgdb-hub-field mgdb-hub-field-action">
          <div class="image-view-toggle" role="group" aria-label="View style">
            <button class="image-view-btn" type="button" data-view="card" aria-pressed="true">Cards</button>
            <button class="image-view-btn" type="button" data-view="table" aria-pressed="false">Table</button>
          </div>
        </div>
        <div class="mgdb-hub-field mgdb-hub-field-action">
          <a class="mgdb-button mgdb-button-quiet" id="image-export-tsv" href="#" download>Export TSV</a>
        </div>
      </div>
    </div>

    <div id="image-results" class="image-results-container image-view-card"></div>

    <div id="image-empty" class="mgdb-empty" hidden>
      <h3>No images matched that search</h3>
      <p>Try a broader keyword such as <code>purple</code> or <code>kernel</code>, or clear the category filter.</p>
      <button class="mgdb-button mgdb-button-secondary" id="image-empty-reset" type="button">Reset search</button>
    </div>

    <nav id="image-pagination" class="image-pagination" aria-label="Search result pages"></nav>
  </section>

  <!-- ── Categories ───────────────────────────────────────────────────────── -->
  <section id="image-categories" aria-labelledby="image-categories-title">
    <div class="mgdb-section-heading">
      <div><h2 id="image-categories-title">Categories</h2></div>
    </div>
    <div class="mgdb-card-grid image-category-grid">
          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-ok">$(mutant_count) Photos</span>
            <h3>Mutants &amp; Variations</h3>
            <p>Photographs of mutant ears, seedlings, and kernel mosaicism from the Gerald Neuffer pollen mutagenesis collection and classical alleles.</p>
            <button class="image-category-card-btn" type="button" data-switch-cat="mutant">Browse Mutants &rarr;</button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-info">$(gel_count) Assays</span>
            <h3>Gel Pattern Archive</h3>
            <p>Agarose and polyacrylamide gel hybridization assays linked to restriction fragment length polymorphism \(RFLP\) and SSR markers.</p>
            <button class="image-category-card-btn" type="button" data-switch-cat="gel_pattern">Browse Gel Patterns &rarr;</button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-warn">$(stock_count) Photos</span>
            <h3>Stocks &amp; Germplasm</h3>
            <p>Specimen photographs of maize inbred lines, landraces, seed packets, and mutant lines distributed by the COOP Stock Center.</p>
            <button class="image-category-card-btn" type="button" data-switch-cat="stock">Browse Stocks &rarr;</button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill">$(species_count) Photos</span>
            <h3>Species &amp; Teosinte</h3>
            <p>Field photographs, botanical illustrations, and spikelet architecture across wild Zea species and Tripsacum relatives.</p>
            <button class="image-category-card-btn" type="button" data-switch-cat="species">Browse Species &rarr;</button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-ok">$(probe_count) Probes</span>
            <h3>Probes &amp; Clones</h3>
            <p>Autoradiographs, clone hybridizations, and physical map contig anchoring images for maize genomic probes.</p>
            <button class="image-category-card-btn" type="button" data-switch-cat="probe">Browse Probes &rarr;</button>
          </article>

          <article class="mgdb-card">
            <span class="mgdb-pill mgdb-pill-warn">300+ Illustrations</span>
            <h3>Traits &amp; Anatomy</h3>
            <p>Plant Ontology \(PO\) and Trait Ontology \(TO\) anatomical diagrams, vegetative tissues, and developmental growth stages.</p>
            <button class="image-category-card-btn" type="button" data-switch-cat="trait">Browse Traits &rarr;</button>
          </article>
        </div>
  </section>

  <!-- ── Downloads ────────────────────────────────────────────────────────── -->
  <section id="image-downloads" aria-labelledby="image-downloads-title">
    <div class="mgdb-section-heading">
      <div><h2 id="image-downloads-title">Downloads</h2></div>
    </div>
    <div class="mgdb-card-grid image-download-grid" aria-label="Image downloads">
          <article class="mgdb-card image-download-card">
            <div class="image-download-header">
              <span class="mgdb-pill mgdb-pill-ok">ZIP Archive</span>
              <h3>Neuffer High-Res Mutant Images</h3>
            </div>
            <p>Download the complete collection of Dr. M. Gerald Neuffer's original high-resolution maize mutant photographs.</p>
            <a class="mgdb-button mgdb-button-secondary" href="https\://download.maizegdb.org/Neuffer_Mutant_Images/Neuffer_Mutant_Images.zip">Download ZIP Archive <span aria-hidden="true">&darr;</span></a>
          </article>

          <article class="mgdb-card image-download-card">
            <div class="image-download-header">
              <span class="mgdb-pill mgdb-pill-info">Export</span>
              <h3>Full Image Metadata TSV</h3>
            </div>
            <p>Export full metadata for all 113,000+ images with record IDs, direct image URLs, and captions.</p>
            <a class="mgdb-button mgdb-button-secondary" href="/search/image/image_search_api.php?category=all&amp;format=tsv">Download Metadata TSV <span aria-hidden="true">&darr;</span></a>
          </article>
        </div>
  </section>

  <!-- ── References ───────────────────────────────────────────────────────── -->
  <section id="image-references" aria-labelledby="image-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="image-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <!-- ── Metrics ──────────────────────────────────────────────────────────── -->
  <section id="image-metrics" aria-labelledby="image-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="image-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Images</h3>
          <span class="mgdb-metric-badge">Curated</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total_images)</strong>
        </div>
        <p class="mgdb-metric-description">Curated images with a resolvable file, at curation level 0.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>Mutants and variations</h3>
          <span class="mgdb-metric-badge">Phenotypes</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(mutant_count)</strong>
        </div>
        <p class="mgdb-metric-description">Photographs attached to a variation record, largely the Neuffer collection.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>Gel patterns</h3>
          <span class="mgdb-metric-badge">Assays</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(gel_count)</strong>
        </div>
        <p class="mgdb-metric-description">Hybridization and electrophoresis assays linked to marker records.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>Stocks and germplasm</h3>
          <span class="mgdb-metric-badge">Specimens</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(stock_count)</strong>
        </div>
        <p class="mgdb-metric-description">Specimen photographs of inbred lines, landraces, and distributed stocks.</p>
      </article>
    </div>

    <figure class="mgdb-figure image-figure">
      <h3>Images by category</h3>
      <div class="mgdb-chart" id="image-category-chart" role="img"
           aria-label="Horizontal bar chart of the number of curated images in each category"
           data-labels="$(chart_labels)" data-values="$(chart_values)" data-cats="$(chart_cats)">
        <div class="mgdb-chart-fallback">Loading the category breakdown&hellip;</div>
      </div>
      <figcaption>Traits and anatomy are not shown&#58; they are ontology illustrations rather than photographs and are counted separately. Select a bar to search that category.</figcaption>
    </figure>
  </section>

  <!-- ── Related resources ────────────────────────────────────────────────── -->
  <section id="image-related" class="mgdb-hub-related" aria-labelledby="image-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="image-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/variation">
          <strong>Variations &amp; Alleles Data Hub</strong>
          <span>The mutant records most of these photographs are attached to</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Center &amp; Germplasm</strong>
          <span>Order the seed behind the specimen photographs, from the COOP Stock Center</span>
        </a>
        <a href="/data_center/phenotype">
          <strong>Phenotype Data Hub</strong>
          <span>Curated phenotype descriptions and the trait ontology terms these images illustrate</span>
        </a>
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>Gene models, annotations, and cross-references for the loci in these captions</span>
        </a>
        <a href="https://images.maizegdb.org/" target="_blank" rel="noopener">
          <strong>MaizeGDB image server</strong>
          <span>The original files behind every thumbnail on this page</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <dialog id="image-lightbox-modal" class="image-lightbox-modal" aria-labelledby="lightbox-title">
    <div class="lightbox-dialog-content">
      <button id="lightbox-close-btn" class="lightbox-close-btn" type="button" aria-label="Close preview">&times;</button>
      <div class="lightbox-image-wrap">
        <img id="lightbox-img" src="" alt="Full size image preview" />
      </div>
      <div class="lightbox-details">
        <div class="lightbox-meta">
          <span id="lightbox-badge" class="image-card-badge"></span>
          <h3 id="lightbox-title"></h3>
        </div>
        <p id="lightbox-caption"></p>
        <div class="lightbox-actions">
          <a id="lightbox-record-link" class="mgdb-button mgdb-button-primary" href="#">View Database Record &rarr;</a>
          <a id="lightbox-download-link" class="mgdb-button mgdb-button-secondary" href="#" target="_blank" rel="noopener noreferrer">Open Original File &nearr;</a>
          <button id="lightbox-copy-url-btn" class="mgdb-button mgdb-button-quiet" type="button">Copy URL</button>
        </div>
      </div>
    </div>
  </dialog>
</main>
)
