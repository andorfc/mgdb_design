$$SYNTAX-LEVEL 2
*(mgdb-cytogenetic-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No cytogenetics record found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="cyto-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/cytogenetic">Cytogenetics Resources</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="cyto-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="cyto-notfound-title">No cytogenetics record matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">Cytogenetics is not a record type of its own. This data centre gathers three kinds of record that live elsewhere&#58; $(total_maps) cytological maps, $(total_landmarks) cytological landmarks, and $(total_stocks) structural-variant stocks. Nothing in any of them carries that name or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="cyto-notfound-search" aria-labelledby="cyto-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="cyto-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/cytogenetic" method="get" role="search">
      <label class="mgdb-visually-hidden" for="cyto-notfound-query">Cytological map, landmark, or structural-variant stock</label>
      <input class="mgdb-input" id="cyto-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Cytological map, landmark, or structural-variant stock" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Open Cytogenetics Resources</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/cytogenetic?id=Cytological%201">Cytological 1</a>
      <a class="mgdb-rec-example" href="/data_center/cytogenetic?id=922D">922D</a>
      <a class="mgdb-rec-example" href="/data_center/cytogenetic">Browse the hub</a>
    </p>
    <p class="mgdb-rec-hint">A cytogenetic identifier is a map, a locus, or a stock, and each has its own record page. Give this address one and it will take you there; the hub itself lists all three collections.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="cyto-notfound-resources" aria-labelledby="cyto-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="cyto-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/cytogenetic">
          <strong>Cytogenetics Resources</strong>
          <span>Cytological maps, chromosomal landmarks, and the structural-variant stock collection</span>
        </a>
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>Every genetic and physical map, including the cytological series</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Data Hub</strong>
          <span>Germplasm, including the translocation, inversion and ploidy stocks</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="/downloads">
          <strong>Downloads</strong>
          <span>Cytogenetic and mapping datasets</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
