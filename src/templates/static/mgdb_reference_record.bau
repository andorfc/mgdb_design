$$SYNTAX-LEVEL 2
*(mgdb-reference-record
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:title" content="$(reference_title)">
<meta property="og:description" content="$(reference_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-reference-record-page" id="ref-record-top" data-requested-id="$(requested_identifier)" data-reference-id="$(reference_id)">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/reference">Literature Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Reference $(reference_id)</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-hero" aria-labelledby="ref-record-title">
    <div class="mgdb-hero-body">
      <h1 id="ref-record-title">$(reference_title)$(editorial_badge)</h1>
      <p class="mgdb-rec-synonyms" id="ref-record-byline" hidden></p>
      <dl class="mgdb-record-facts mgdb-rec-headfacts" id="ref-record-facts">$(identity_facts)</dl>
    </div>
  </section>

  <nav class="mgdb-section-tabs mgdb-rec-tabs" id="ref-record-tabs" aria-label="Sections on this record">
    <a href="#ref-record-overview">Overview</a>
  </nav>

  <div class="mgdb-loading" id="ref-record-loading"><span class="mgdb-spinner" aria-hidden="true"></span><span>Loading the full record&hellip;</span></div>

  <div class="mgdb-message mgdb-message-error" id="ref-record-error" role="alert" hidden>
    <div>
      <strong>The rest of this record could not be loaded.</strong>
      <span>The citation above is correct. Reload to try again, or report it if it keeps happening.</span>
      <button class="mgdb-button mgdb-button-secondary" id="ref-record-retry" type="button">Retry</button>
    </div>
  </div>

  <div class="mgdb-message mgdb-message-info" id="ref-record-notice" role="status" hidden></div>

  <section id="ref-record-overview" aria-labelledby="ref-record-overview-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-overview-title">Overview</h2></div></div>
    <div id="ref-record-overview-body"></div>
  </section>

  <section id="ref-record-editorial" aria-labelledby="ref-record-editorial-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-editorial-title">Editorial Board pick</h2></div></div>
    <div id="ref-record-editorial-body"></div>
  </section>

  <section id="ref-record-abstract" aria-labelledby="ref-record-abstract-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-abstract-title">Abstract</h2></div></div>
    <div id="ref-record-abstract-body"></div>
  </section>

  <section id="ref-record-authors" aria-labelledby="ref-record-authors-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-authors-title">Authors</h2></div></div>
    <div id="ref-record-authors-body"></div>
  </section>

  <section id="ref-record-describes" aria-labelledby="ref-record-describes-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-describes-title">What this paper describes</h2></div></div>
    <div id="ref-record-describes-body"></div>
  </section>

  <section id="ref-record-citation" aria-labelledby="ref-record-citation-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-citation-title">Cite this paper</h2></div></div>
    <div id="ref-record-citation-body"></div>
  </section>

  <section id="ref-record-links" aria-labelledby="ref-record-links-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-links-title">Identifiers and full text</h2></div></div>
    <div id="ref-record-links-body"></div>
  </section>

  <section id="ref-record-metrics" aria-labelledby="ref-record-metrics-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ref-record-metrics-title">Metrics</h2></div></div>
    <div class="mgdb-metric-grid" id="ref-record-metrics-body"></div>
    <div class="mgdb-chart-grid mgdb-rec-charts" id="ref-record-charts">
      <figure class="mgdb-figure" id="ref-record-authors-figure" hidden>
        <h3>Papers in MaizeGDB by each author</h3>
        <div class="mgdb-chart" id="ref-record-authors-chart" role="img" aria-label="Horizontal bar chart of how many papers MaizeGDB holds for each author of this paper">
          <div class="mgdb-chart-fallback">Loading the author breakdown&hellip;</div>
        </div>
        <figcaption id="ref-record-authors-caption"></figcaption>
      </figure>
      <figure class="mgdb-figure" id="ref-record-connections-figure">
        <h3>Record connections</h3>
        <div class="mgdb-chart" id="ref-record-connections-chart" role="img" aria-label="Horizontal bar chart of how many authors, described records and identifiers are attached to this reference">
          <div class="mgdb-chart-fallback">Loading the record connections&hellip;</div>
        </div>
        <figcaption id="ref-record-connections-caption"></figcaption>
      </figure>
    </div>
  </section>

  <section class="mgdb-hub-related" id="ref-record-resources" aria-labelledby="ref-record-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="ref-record-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/reference">
          <strong>Literature Data Hub</strong>
          <span>Search every curated maize reference by title, author, journal, or year</span>
        </a>
        <a href="/hot_new_papers">
          <strong>Editorial Board picks</strong>
          <span>Papers the Board nominated as being of particular community interest</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>The loci this literature is curated against, and their gene models</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Data Hub</strong>
          <span>Germplasm described in the literature, and how to request it</span>
        </a>
        <a href="https\://pubmed.ncbi.nlm.nih.gov/" target="_blank" rel="noopener">
          <strong>PubMed</strong>
          <span>Abstracts and full-text links beyond the MaizeGDB collection</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mgdb-rec-api mgdb-hub-tone-blue" id="ref-record-api" aria-labelledby="ref-record-api-title">
    <div class="mgdb-section-heading"><div><h2 id="ref-record-api-title">API data access</h2></div></div>
    <div class="mgdb-rec-api-row">
      <code id="ref-record-api-endpoint">GET /api/v1/records/reference/$(requested_identifier)</code>
      <div class="mgdb-rec-api-actions">
        <a class="mgdb-button mgdb-button-quiet" id="ref-record-api-link" href="/api/v1/records/reference/$(requested_identifier_path)" target="_blank" rel="noopener">Raw JSON <span aria-hidden="true">&nearr;</span></a>
        <button class="mgdb-button mgdb-button-quiet" id="ref-copy-json-btn" type="button">Copy JSON</button>
        <a class="mgdb-button mgdb-button-quiet" href="/api/v1/openapi">API documentation</a>
      </div>
    </div>
    <p class="mgdb-rec-api-note">Every author, described record, identifier and citation format on this page is retrieved in one structured JSON response.</p>
  </section>
</main>
)
