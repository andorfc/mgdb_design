    <div class="mgdb-hero-emblem">
      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Grass branch / phylogenetic nodes -->
        <rect x="8" y="14" width="48" height="36" rx="6" fill="#f0fdf4" stroke="#1b5e20" stroke-width="2.5" />
        <!-- Phylogenetic branching tracks -->
        <path d="M16 41C24 41 26 32 34 32C42 32 44 23 50 23" stroke="#2e7d32" stroke-width="3" stroke-linecap="round" fill="none" />
        <path d="M34 32C42 32 44 41 50 41" stroke="#d97706" stroke-width="3" stroke-linecap="round" fill="none" />
        <!-- Node dots -->
        <circle cx="16" cy="41" r="3" fill="#2e7d32" />
        <circle cx="34" cy="32" r="3" fill="#ca8a04" />
        <circle cx="50" cy="23" r="3" fill="#2563eb" />
        <circle cx="50" cy="41" r="3" fill="#16a34a" />
      </svg>
      <strong>PanAnd<br />Genomes</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; $(data_date)</p>
      <h1 id="panand-title">Pan-Andropogoneae Reference Genomes &amp; Evolutionary Models</h1>
      <p class="mgdb-hero-description">De novo chromosome-scale genome assemblies, annotations, and evolutionary constraint models across 36+ wild panicoid grasses, teosintes, and outgroups to predict adaptations to abiotic stress in maize and sorghum.</p>

      <div class="panand-hero-actions-row">
        <a class="panand-hero-link" href="/genomebrowser">
          <span class="panand-link-dot panand-dot-green" aria-hidden="true"></span> Explore in JBrowse 2 &#8599;
        </a>
        <a class="panand-hero-link" href="https://panandropogoneae.com/" target="_blank" rel="noopener">
          <span class="panand-link-dot panand-dot-gold" aria-hidden="true"></span> PanAnd Website &#8599;
        </a>
        <a class="panand-hero-link" href="https://mcstitzer.github.io/panand_assemblies" target="_blank" rel="noopener">
          <span class="panand-link-dot panand-dot-purple" aria-hidden="true"></span> PanAnd GitHub Portal &#8599;
        </a>
        <a class="panand-hero-link" href="/download#downloads-panand">
          <span class="panand-link-dot panand-dot-blue" aria-hidden="true"></span> Bulk Downloads &#8595;
        </a>
        <a class="panand-hero-link" href="https://www.biorxiv.org/content/10.1101/2025.01.22.633974v1" target="_blank" rel="noopener">
          <span class="panand-link-dot panand-dot-rose" aria-hidden="true"></span> bioRxiv Preprint &#8599;
        </a>
        <a class="panand-hero-link" href="/curation/GenomeIssue/edit">
          <span class="panand-link-dot panand-dot-dark" aria-hidden="true"></span> Report Issue &#8599;
        </a>
      </div>
    </div>
  </section>

