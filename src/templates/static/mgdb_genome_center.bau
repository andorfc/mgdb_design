$$SYNTAX-LEVEL 2
*(mgdb-genome-center
<main class="mgdb-page mgdb-genomes-page" id="mgdb-genome-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Genome Center</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="genome-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/assembly_puzzle.png" alt="Genome assembly puzzle icon" />
      <strong>Genome<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; August 2026</p>
      <h1 id="genome-title">Explore maize and Andropogoneae genomes</h1>
      <p class="mgdb-hero-description">Search and compare $(total-assemblies) hosted genome assemblies across $(total-species) species. Filter reference pseudomolecules, cultivar sequences, and downstream annotation tools.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#genome-assemblies">Assemblies</a>
    <a href="#genome-progress">In progress</a>
    <a href="#genome-history">History</a>
    <a href="#genome-taxa">Taxa</a>
    <a href="#genome-overview">Statistics</a>
    <a href="#genome-tools">Related resources</a>
  </nav>

  <section id="genome-assemblies" aria-labelledby="genome-assemblies-title">
    <div class="mgdb-section-heading">
      <div><span class="mgdb-eyebrow">Find an assembly</span><h2 id="genome-assemblies-title">Assembly explorer</h2></div>
      <p>Search and filter every hosted assembly. Sort any column by activating its header.</p>
    </div>

    <div class="mgdb-search">
      <div class="mgdb-search-row">
        <div class="mgdb-field">
          <label class="mgdb-label" for="genome-query">Search assemblies</label>
          <p class="mgdb-hint" id="genome-query-hint">Match an assembly, cultivar, species, or accession. Example: <code>B73</code>, <code>Mo17</code>, or <code>Tripsacum</code></p>
          <input class="mgdb-input" id="genome-query" name="q" type="search" aria-describedby="genome-query-hint" autocomplete="off">
        </div>
        <div class="mgdb-field">
          <label class="mgdb-label" for="genome-status">Status</label>
          <select class="mgdb-select" id="genome-status">
            <option value="">Any status</option>
            <option value="current">Current</option>
            <option value="superseded">Superseded</option>
          </select>
        </div>
        <button class="mgdb-button mgdb-button-quiet" id="genome-reset" type="button" hidden>Reset</button>
      </div>
      <div class="mgdb-filters">
        <span aria-hidden="true" class="mgdb-small mgdb-muted">Taxon:</span>
        $(group-chips)
        <span class="mgdb-result-count" id="genome-count" aria-live="polite"></span>
      </div>
    </div>

    <div class="mgdb-table-scroll mgdb-spaced">
      <table class="mgdb-table" id="genome-table" data-sortable>
        <caption>
          Genome assemblies hosted at MaizeGDB
          <span class="mgdb-muted">Read live from the assembly database, B73 reference first. Quality is taken from the assembly name, which carries the REFERENCE or DRAFT designation; blank fields are shown as &ldquo;Not reported&rdquo; rather than left empty.</span>
        </caption>
        <thead>
          <tr>
            <th scope="col" data-sort="text"><button type="button">Assembly</button></th>
            <th scope="col" data-sort="text"><button type="button">Cultivar</button></th>
            <th scope="col" data-sort="text"><button type="button">Species</button></th>
            <th scope="col" data-sort="text"><button type="button">Quality</button></th>
            <th scope="col" data-sort="text"><button type="button">Accession</button></th>
            <th scope="col" data-sort="text"><button type="button">Status</button></th>
          </tr>
        </thead>
        <tbody>$(assembly-rows)</tbody>
      </table>
    </div>

    <div class="mgdb-empty" id="genome-empty" hidden>
      <h3>No assemblies match those filters</h3>
      <p>Check the spelling of the cultivar or species name, or clear the filters to see the full collection.</p>
      <button class="mgdb-button mgdb-button-secondary" id="genome-empty-reset" type="button">Clear search and filters</button>
    </div>
  </section>

  <section id="genome-progress" aria-labelledby="genome-progress-title">
    <div class="mgdb-section-heading">
      <div><span class="mgdb-eyebrow">Announced</span><h2 id="genome-progress-title">Assemblies in progress</h2></div>
      <p>$(total-progress) sequencing projects recorded in the database but not yet released.</p>
    </div>
    <div class="mgdb-table-scroll">
      <table class="mgdb-table">
        <caption>Genome assemblies in progress</caption>
        <thead>
          <tr>
            <th scope="col">Assembly</th>
            <th scope="col">Cultivar</th>
            <th scope="col">Sequencing technologies</th>
            <th scope="col">Collaborators</th>
          </tr>
        </thead>
        <tbody>$(progress-rows)</tbody>
      </table>
    </div>
  </section>

  <section id="genome-history" aria-labelledby="genome-history-title">
    <div class="mgdb-section-heading">
      <div><span class="mgdb-eyebrow">Growth over time</span><h2 id="genome-history-title">A history of genome stewardship</h2></div>
      <p>Assemblies hosted at MaizeGDB from 2008 to 2026, with landmark releases marked.</p>
    </div>
    <figure class="mgdb-figure">
      <div class="mgdb-chart" id="genome-growth-chart" role="img" aria-label="Line chart of genome assemblies hosted at MaizeGDB from 2008 to 2026, rising from 1 to 158, with landmark releases annotated">
        <span class="mgdb-chart-fallback">Loading assembly history&hellip;</span>
      </div>
      <figcaption>Growth was slow through 2015, when fewer than five assemblies were hosted. Sequencing of the NAM founders lifted the total past fifty by 2020, and the Andropogoneae and landrace panels roughly tripled it again by 2026.</figcaption>
      <details class="mgdb-chart-data">
        <summary>View the data behind this chart</summary>
        <div class="mgdb-table-scroll">
          <table class="mgdb-table" id="genome-growth-table">
            <caption>Genome assemblies hosted at MaizeGDB by year</caption>
            <thead><tr><th scope="col">Year</th><th scope="col" class="mgdb-numeric">Assemblies</th><th scope="col">Landmark release</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </details>
    </figure>
    <p class="mgdb-note"><strong>Data note:</strong> this timeline is a curated historical record maintained for the redesign, not a figure derived from the assembly table. The database stores a release date for only some assemblies and in inconsistent formats, so a year-by-year count cannot be computed from it reliably. Every other figure on this page is read directly from the database.</p>
  </section>

  <section id="genome-taxa" aria-labelledby="genome-taxa-title">
    <div class="mgdb-section-heading">
      <div><span class="mgdb-eyebrow">How the collection breaks down</span><h2 id="genome-taxa-title">Assemblies by taxon</h2></div>
      <p>Live counts grouped the same way the Genome Center has always grouped them.</p>
    </div>
    <figure class="mgdb-figure">
      <div class="mgdb-chart mgdb-chart-tall" id="genome-taxa-chart" role="img" aria-label="Horizontal bar chart of assembly counts by taxonomic group">
        <span class="mgdb-chart-fallback">Loading taxon breakdown&hellip;</span>
      </div>
      <figcaption>Cultivated maize accounts for most of the collection, with the remainder spread across the wild <i>Zea</i> subspecies and the wider Andropogoneae.</figcaption>
    </figure>
  </section>

  <section id="genome-overview" aria-labelledby="genome-overview-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Corpus summary</span>
        <h2 id="genome-overview-title">Genome dataset at a glance</h2>
      </div>
      <p>Curated assembly statistics read live from the MaizeGDB database.</p>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Total Assemblies</h3>
          <span class="mgdb-metric-badge">Hosted</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total-assemblies)</strong>
        </div>
        <p class="mgdb-metric-description">Completed and publicly visible genome assemblies.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Species Count</h3>
          <span class="mgdb-metric-badge">Taxa</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total-species)</strong>
          <span class="mgdb-metric-unit">species</span>
        </div>
        <p class="mgdb-metric-description">Distinct species across the tribe Andropogoneae.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Cultivated Maize</h3>
          <span class="mgdb-metric-badge">Z. mays</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(maize-count)</strong>
        </div>
        <p class="mgdb-metric-description">Assemblies of cultivated maize lines and landraces.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Reference Quality</h3>
          <span class="mgdb-metric-badge">Reference</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(reference-count)</strong>
        </div>
        <p class="mgdb-metric-description">Chromosome-level references, including the B73 benchmark.</p>
      </article>
    </div>
  </section>

  <section id="genome-tools" aria-labelledby="genome-tools-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Connected tools</span>
        <h2 id="genome-tools-title">Related resources</h2>
      </div>
      <p>Explore related MaizeGDB tools, comparative maps, and downstream annotation resources.</p>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/genome/genomebrowser">
          <strong>Genome Browser</strong>
          <span>Browse JBrowse tracks and gene models across all assemblies</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="/blast">
          <strong>Sequence Search &#40;BLAST&#41;</strong>
          <span>BLAST a nucleotide or protein sequence against any hosted genome</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="https\://download.maizegdb.org">
          <strong>Bulk Downloads</strong>
          <span>FASTA, GFF3, pseudomolecules, and related annotation archives</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="/gene_center">
          <strong>Gene Model Center</strong>
          <span>Annotations, cross-references, and functional data by assembly</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="/pan_gene_center/pan_gene">
          <strong>Pan-Gene Center</strong>
          <span>Syntenic orthology relationships across 66 maize genome assemblies</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="/genome/whole_genome">
          <strong>Whole-Genome Views</strong>
          <span>Comparative synteny and karyotype chromosome views</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
      </div>
    </div>
  </section>

  <script id="genome-group-data" type="application/json">$(group-data)</script>

</main>
)
