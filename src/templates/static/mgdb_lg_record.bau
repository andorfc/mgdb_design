$$SYNTAX-LEVEL 2
*(mgdb-lg-record
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:title" content="$(lg_name) &mdash; MaizeGDB linkage group record">
<meta property="og:description" content="$(lg_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-lg-record-page" id="lg-record-top" data-requested-id="$(requested_identifier)" data-canonical-id="$(lg_id)" data-locus-hub="$(locus_hub_link)">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/lg">Linkage Groups</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">$(lg_name)</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-hero" aria-labelledby="lg-record-title">
    <div class="mgdb-hero-body">
      <h1 id="lg-record-title">$(lg_name)</h1>
      <p class="mgdb-rec-synonyms" id="lg-record-synonyms" hidden></p>
      <dl class="mgdb-record-facts mgdb-rec-headfacts" id="lg-record-facts">$(identity_facts)</dl>
    </div>
  </section>

  <nav class="mgdb-section-tabs mgdb-rec-tabs" id="lg-record-tabs" aria-label="Sections on this record">
    <a href="#lg-record-overview">Overview</a>
  </nav>

  <div class="mgdb-loading" id="lg-record-loading"><span class="mgdb-spinner" aria-hidden="true"></span><span>Loading the full record&hellip;</span></div>

  <div class="mgdb-message mgdb-message-error" id="lg-record-error" role="alert" hidden>
    <div>
      <strong>The rest of this record could not be loaded.</strong>
      <span>The identity above is correct. Reload to try again, or report it if it keeps happening.</span>
      <button class="mgdb-button mgdb-button-secondary" id="lg-record-retry" type="button">Retry</button>
    </div>
  </div>

  <div class="mgdb-message mgdb-message-info" id="lg-record-notice" role="status" hidden></div>

  <section id="lg-record-overview" aria-labelledby="lg-record-overview-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="lg-record-overview-title">Overview</h2></div></div>
    <div id="lg-record-overview-body"></div>
  </section>

  <section id="lg-record-maps" aria-labelledby="lg-record-maps-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="lg-record-maps-title">Maps of this linkage group</h2></div></div>
    <div id="lg-record-maps-body"></div>
  </section>

  <section id="lg-record-loci" aria-labelledby="lg-record-loci-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="lg-record-loci-title">Loci placed here</h2></div></div>
    <div id="lg-record-loci-body"></div>
  </section>

  <section id="lg-record-external" aria-labelledby="lg-record-external-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="lg-record-external-title">External records</h2></div></div>
    <div id="lg-record-external-body"></div>
  </section>

  <section id="lg-record-references" aria-labelledby="lg-record-references-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="lg-record-references-title">References</h2></div></div>
    <div id="lg-record-references-body"></div>
  </section>

  <section id="lg-record-metrics" aria-labelledby="lg-record-metrics-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="lg-record-metrics-title">Metrics</h2></div></div>
    <div class="mgdb-metric-grid" id="lg-record-metrics-body"></div>
    <div class="mgdb-chart-grid mgdb-rec-charts" id="lg-record-charts">
      <figure class="mgdb-figure" id="lg-record-connections-figure">
        <h3>Record connections</h3>
        <div class="mgdb-chart" id="lg-record-connections-chart" role="img" aria-label="Horizontal bar chart of how many maps, loci, external records and references are attached to this linkage group">
          <div class="mgdb-chart-fallback">Loading the record connections&hellip;</div>
        </div>
        <figcaption id="lg-record-connections-caption"></figcaption>
      </figure>
    </div>
  </section>

  <section class="mgdb-hub-related" id="lg-record-resources" aria-labelledby="lg-record-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="lg-record-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>Search every genetic, cytogenetic, and physical chromosome map</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>The loci placed on this linkage group, and the gene models behind them</span>
        </a>
        <a href="/data_center/lg">
          <strong>All linkage groups</strong>
          <span>The chromosomes, plasmids, phage, and organellar genomes loci are placed on</span>
        </a>
        <a href="/tools/bin_viewer">
          <strong>Bin Viewer</strong>
          <span>Explore data in the regions defined by genetic bins</span>
        </a>
        <a href="https\://jbrowse.maizegdb.org/" target="_blank" rel="noopener">
          <strong>MaizeGDB JBrowse 2</strong>
          <span>Explore maize features in their genomic context</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mgdb-rec-api mgdb-hub-tone-blue" id="lg-record-api" aria-labelledby="lg-record-api-title">
    <div class="mgdb-section-heading"><div><h2 id="lg-record-api-title">API data access</h2></div></div>
    <div class="mgdb-rec-api-row">
      <code id="lg-record-api-endpoint">GET /api/v1/records/linkage_group/$(requested_identifier)</code>
      <div class="mgdb-rec-api-actions">
        <a class="mgdb-button mgdb-button-quiet" id="lg-record-api-link" href="/api/v1/records/linkage_group/$(requested_identifier_path)" target="_blank" rel="noopener">Raw JSON <span aria-hidden="true">&nearr;</span></a>
        <button class="mgdb-button mgdb-button-quiet" id="lg-copy-json-btn" type="button">Copy JSON</button>
        <a class="mgdb-button mgdb-button-quiet" href="/api/v1/openapi">API documentation</a>
      </div>
    </div>
    <p class="mgdb-rec-api-note">Every fact, map, locus, external record, and reference on this page is retrieved in one structured JSON response.</p>
  </section>
</main>
)
