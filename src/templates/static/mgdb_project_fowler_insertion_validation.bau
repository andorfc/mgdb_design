  <section class="mgdb-hero" aria-labelledby="fw-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="A maize ear with fluorescent and non-fluorescent kernels">
        <rect x="34" y="12" width="28" height="72" rx="14" fill="#c9d6bd" />
        <circle cx="43" cy="27" r="5" fill="#2f5e2a" /><circle cx="55" cy="27" r="5" fill="#501719" />
        <circle cx="43" cy="41" r="5" fill="#501719" /><circle cx="55" cy="41" r="5" fill="#2f5e2a" />
        <circle cx="43" cy="55" r="5" fill="#2f5e2a" /><circle cx="55" cy="55" r="5" fill="#501719" />
        <circle cx="43" cy="69" r="5" fill="#501719" /><circle cx="55" cy="69" r="5" fill="#2f5e2a" />
      </svg>
      <strong>Community<br />Resource</strong>
      <span>NSF IOS-1340050</span>
