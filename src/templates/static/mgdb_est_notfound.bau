$$SYNTAX-LEVEL 2
*(mgdb-est-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No EST found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="est-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/est">EST Data Center</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="est-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="est-notfound-title">No EST matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB holds $(total_ests) expressed sequence tags. None of them carries that name, synonym, or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="est-notfound-search" aria-labelledby="est-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="est-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/est" method="get" role="search">
      <label class="mgdb-visually-hidden" for="est-notfound-query">EST name, synonym, or MaizeGDB ID</label>
      <input class="mgdb-input" id="est-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="EST name, synonym, or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search ESTs</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/est?id=p-bcd98">p-bcd98</a>
      <a class="mgdb-rec-example" href="/data_center/est?id=bcd98">bcd98</a>
      <a class="mgdb-rec-example" href="/data_center/est?id=110916">110916</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs one EST&#58; its name, one of its synonyms, or its MaizeGDB ID. Names are written with and without the <em>p-</em> prefix and both reach the record. An EST is one kind of molecular marker, so a marker that is not an EST has its record in the Molecular Marker Data Hub instead.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="est-notfound-resources" aria-labelledby="est-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="est-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/est">
          <strong>EST Data Center</strong>
          <span>Search the expressed sequence tag collection by name, synonym, or chromosome bin</span>
        </a>
        <a href="/data_center/marker">
          <strong>Molecular Marker Data Hub</strong>
          <span>Every marker and probe MaizeGDB holds, of which ESTs are one kind</span>
        </a>
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>The genetic and physical maps these probes are placed on</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="/downloads">
          <strong>Downloads</strong>
          <span>Marker and mapping datasets, including the EST collection</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
