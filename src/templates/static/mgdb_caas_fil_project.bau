<!-- FILTER & SEARCH TOOLBAR -->
    <div class="caas-table-toolbar">
      <div class="caas-search-wrap">
        <label for="caas-search-input" class="mgdb-visually-hidden">Search CAAS-FIL assemblies</label>
        <input type="text" id="caas-search-input" class="mgdb-input caas-search-input" placeholder="Search line name, assembly ID, heterotic group, or GenBank accession..." autocomplete="off" spellcheck="false" />
      </div>

      <div class="caas-filter-chips-wrap" role="group" aria-label="Filter by heterotic group">
        <span class="caas-toolbar-label">Group&#58;</span>
        <button type="button" class="caas-chip is-active" data-filter="all">All \(12\)</button>
        <button type="button" class="caas-chip caas-chip-tspt" data-filter="tspt">Tang Sipingtou / TSPT \(3\)</button>
        <button type="button" class="caas-chip caas-chip-pgroup" data-filter="pgroup">P-Group / PA &amp; PB \(3\)</button>
        <button type="button" class="caas-chip caas-chip-lancaster" data-filter="lancaster">Lancaster \(2\)</button>
        <button type="button" class="caas-chip caas-chip-ss" data-filter="ss">Stiff Stalk &amp; Iodent \(2\)</button>
        <button type="button" class="caas-chip caas-chip-other" data-filter="other">X-Group &amp; Mixed \(2\)</button>
      </div>
    </div>

