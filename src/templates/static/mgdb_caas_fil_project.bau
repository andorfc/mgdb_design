    <div class="mgdb-hero-emblem" aria-hidden="true" style="background:#ffffff; border:1px solid #e2e8f0;">
      <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Central network hub representing 12 founder lines -->
        <circle cx="32" cy="32" r="22" stroke="#dc2626" stroke-width="2.5" fill="#fef2f2"/>
        <circle cx="32" cy="32" r="6" fill="#b91c1c"/>
        <!-- 6 radial nodes -->
        <circle cx="32" cy="14" r="3" fill="#dc2626"/>
