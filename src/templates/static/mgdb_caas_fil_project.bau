        <line x1="36" y1="29" x2="45" y2="24" stroke="#b91c1c" stroke-width="1.5"/>
        <line x1="36" y1="35" x2="45" y2="40" stroke="#b91c1c" stroke-width="1.5"/>
        <line x1="32" y1="38" x2="32" y2="47" stroke="#b91c1c" stroke-width="1.5"/>
        <line x1="28" y1="35" x2="19" y2="40" stroke="#b91c1c" stroke-width="1.5"/>
        <line x1="28" y1="29" x2="19" y2="24" stroke="#b91c1c" stroke-width="1.5"/>
      </svg>
      <strong>CAAS-FIL<br />Genomes</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="caas-title">CAAS 12 Founder Inbred Lines Genomes Project \(FIL\)</h1>
      <p class="mgdb-hero-description">
        De novo chromosome-scale genome assemblies, annotations, and heterotic group architecture across 12 foundational Chinese and international maize founder lines shaping modern hybrid breeding.
      </p>

      <div class="caas-hero-actions-row">
        <a class="caas-hero-link" href="/genomebrowser">
          <span class="caas-link-dot caas-dot-green" aria-hidden="true"></span> JBrowse 2
        </a>
        <a class="caas-hero-link" href="/download#downloads-caas-fil">
          <span class="caas-link-dot caas-dot-blue" aria-hidden="true"></span> Downloads
        </a>
        <a class="caas-hero-link" href="https://doi.org/10.1038/s41588-022-01283-w" target="_blank" rel="noopener">
          <span class="caas-link-dot caas-dot-rose" aria-hidden="true"></span> Paper &#8599;
        </a>
        <a class="caas-hero-link" href="/gene_center/gene">
          <span class="caas-link-dot caas-dot-purple" aria-hidden="true"></span> Gene Center
        </a>
        <a class="caas-hero-link" href="$(blast_url)">
          <span class="caas-link-dot caas-dot-dark" aria-hidden="true"></span> BLAST
        </a>
      </div>
    </div>
  </section>

