$$SYNTAX-LEVEL 2
*(mgdb-rhubarb-crisp
<main class="mgdb-page mgdb-hub-page mgdb-rhubarb-page" id="rhubarb-top">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Rhubarb crisp</span>
  </nav>

  <section class="mgdb-hero-basic rhubarb-hero" aria-labelledby="rhubarb-title">
    <span class="mgdb-hero-basic-icon" aria-hidden="true">
      <svg viewBox="0 0 84 84" role="presentation" focusable="false">
        <path d="M20 46h44a4 4 0 0 1 4 4v4a16 16 0 0 1-16 16H32a16 16 0 0 1-16-16v-4a4 4 0 0 1 4-4z" fill="none" stroke="currentColor" stroke-width="5"/>
        <path d="M30 40c0-6 4-9 4-14M42 38c0-8 5-11 5-17M54 40c0-6 4-9 4-14" fill="none" stroke="#2f5e2a" stroke-width="4" stroke-linecap="round"/>
      </svg>
    </span>
    <div>
      <h1 id="rhubarb-title">Rhubarb crisp</h1>
      <p>The official dessert of MaizeGDB. Serves a lab meeting; keeps about as long as one.</p>
    </div>
  </section>

  <section id="rhubarb-recipe" aria-labelledby="rhubarb-recipe-title">
    <div class="mgdb-section-heading">
      <div><h2 id="rhubarb-recipe-title">The recipe</h2></div>
    </div>

    <div class="rhubarb-layout">
      <div class="rhubarb-steps">
        <article class="rhubarb-step">
          <h3><span class="rhubarb-step-mark" aria-hidden="true">1</span> The filling</h3>
          <ul class="rhubarb-ingredients">
            <li><b>4 cups</b> rhubarb, cleaned</li>
            <li><b>&frac23; cup</b> flour</li>
            <li><b>1&frac13; cups</b> sugar</li>
          </ul>
          <p>Mix together and pour into a greased 9 &times; 9 &#40;or 7 &times; 11&#41; baking pan.</p>
        </article>

        <article class="rhubarb-step">
          <h3><span class="rhubarb-step-mark" aria-hidden="true">2</span> The topping</h3>
          <ul class="rhubarb-ingredients">
            <li><b>&frac12; cup</b> butter, softened</li>
            <li><b>1 cup</b> flour</li>
            <li><b>&frac12; cup</b> brown sugar, packed</li>
          </ul>
          <p>Mix together thoroughly and sprinkle over the rhubarb.</p>
        </article>

        <article class="rhubarb-step">
          <h3><span class="rhubarb-step-mark" aria-hidden="true">3</span> Bake</h3>
          <p class="rhubarb-bake"><b>350&deg;F</b> for <b>60 minutes</b>, or until golden brown.</p>
        </article>
      </div>

      <figure class="rhubarb-figure">
        <img src="/images/rbcrisp.jpg" width="250" height="250" alt="A baked rhubarb crisp in a dish, golden brown on top." decoding="async" />
      </figure>
    </div>
  </section>
</main>
)
