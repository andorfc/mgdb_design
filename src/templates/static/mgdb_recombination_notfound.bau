$$SYNTAX-LEVEL 2
*(mgdb-recombination-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No recombination dataset found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="rc-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/map">Map Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="rc-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="rc-notfound-title">No recombination dataset matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB holds $(total_datasets) curated recombination datasets. None of them carries that name or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="rc-notfound-search" aria-labelledby="rc-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="rc-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/map" method="get" role="search">
      <label class="mgdb-visually-hidden" for="rc-notfound-query">Dataset name or MaizeGDB ID</label>
      <input class="mgdb-input" id="rc-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Dataset name or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search maps</button>
    </form>
    <p class="mgdb-rec-hint">A recombination dataset is named for the cross it records. Datasets are reached from the locus and map records that use them rather than searched directly.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="rc-notfound-resources" aria-labelledby="rc-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="rc-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>Genetic maps built from crosses like these</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>Loci carry their recombination data in the Genetic information section</span>
        </a>
        <a href="/data_center/variation">
          <strong>Variations &amp; Alleles Data Hub</strong>
          <span>The alleles parents carry into a mapping cross</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Data Hub</strong>
          <span>The lines behind the mapping populations</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across every data type</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
