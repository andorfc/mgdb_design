$$SYNTAX-LEVEL 2
*(mgdb-projects-notfound
<main class="mgdb-page mgdb-projects-page" id="mgdb-projects-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/projects">Analysis projects</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <div class="mgdb-empty">
    <h1>No analysis project called &ldquo;$(requested-slug)&rdquo;</h1>
    <p>The project may have been renamed, or the address may contain a typo. The listing page shows every published project.</p>
    <a class="mgdb-button mgdb-button-primary" href="/projects">Browse all projects</a>
  </div>

</main>
)
