$$SYNTAX-LEVEL 2
*(mgdb-projects-notfound
<main class="mgdb-page mgdb-hub-page mgdb-projects-page" id="mgdb-projects-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/projects">Analysis projects</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  ;; A section rather than a bare div: on the shell the page ground is tinted
  ;; and it is `> section` that becomes the white card, so an unwrapped empty
  ;; state would sit straight on the tint with nothing under it.
  <section id="projects-notfound" aria-labelledby="projects-notfound-title">
    <div class="mgdb-empty">
      <h1 id="projects-notfound-title">No analysis project called &ldquo;$(requested-slug)&rdquo;</h1>
      <p>The project may have been renamed, or the address may contain a typo. The listing page shows every published project.</p>
      <a class="mgdb-button mgdb-button-primary" href="/projects">Browse all projects</a>
    </div>
  </section>

</main>
)
