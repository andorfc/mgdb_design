        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value mgdb-metric-value-compact">panEDTA</strong>
        </div>
        <p class="mgdb-metric-description">High-precision comprehensive repeat annotation across all seven chromosome-scale assemblies.</p>
      </article>
      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Gene models per line</h3>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value mgdb-metric-value-compact">40,000+</strong>
        </div>
        <p class="mgdb-metric-description">High-confidence structural and functional annotations indexed across MaizeGDB.</p>
      </article>
    </div>

  </section>

