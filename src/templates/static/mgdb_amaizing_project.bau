        <!-- European hex/star pattern with maize ear -->
        <polygon points="32,8 54,20 54,44 32,56 10,44 10,20" fill="#eff6ff" stroke="#1d4ed8" stroke-width="2.5"/>
        <path d="M32 16C26 16 22 26 22 36C22 46 27 50 32 50C37 50 42 46 42 36C42 26 38 16 32 16Z" fill="#fef08a" stroke="#ca8a04" stroke-width="2"/>
        <circle cx="28" cy="28" r="2" fill="#d97706"/>
