$$SYNTAX-LEVEL 2
*(mgdb-marker-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No marker found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="marker-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/marker">Molecular Marker Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="marker-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="marker-notfound-title">No marker matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">No probe, primer, or molecular marker in MaizeGDB carries that name, synonym, or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="marker-notfound-search" aria-labelledby="marker-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="marker-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/marker" method="get" role="search">
      <label class="mgdb-visually-hidden" for="marker-notfound-query">Marker name, synonym, or MaizeGDB ID</label>
      <input class="mgdb-input" id="marker-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Marker name, synonym, or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search markers</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/marker?id=p-umc10">p-umc10</a>
      <a class="mgdb-rec-example" href="/data_center/marker?id=umc10">umc10</a>
      <a class="mgdb-rec-example" href="/data_center/marker?id=44544">44544</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs one marker&#58; its name, one of its synonyms, or its MaizeGDB ID. Marker names carry a <em>p-</em> prefix by convention, and both spellings reach the same record. A gene symbol names a locus, and a locus is detected by markers rather than being one.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="marker-notfound-resources" aria-labelledby="marker-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="marker-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/marker">
          <strong>Molecular Marker Data Hub</strong>
          <span>Search every probe, primer, and molecular marker</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>Classical loci and the gene models that represent them</span>
        </a>
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>Genetic, cytogenetic, and physical chromosome maps</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="https\://www.ncbi.nlm.nih.gov/genbank/" target="_blank" rel="noopener">
          <strong>GenBank</strong>
          <span>Sequence records beyond the MaizeGDB collection</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
