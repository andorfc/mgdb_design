$$SYNTAX-LEVEL 2
*(mgdb-map-record
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:title" content="$(map_name) &mdash; MaizeGDB map record">
<meta property="og:description" content="$(map_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-map-record-page" id="map-record-top" data-requested-id="$(requested_identifier)" data-canonical-id="$(map_id)">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/map">Map Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">$(map_name)</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-hero" aria-labelledby="map-record-title">
    <div class="mgdb-hero-body">
      <h1 id="map-record-title">$(map_name)</h1>
      <p class="mgdb-rec-synonyms" id="map-record-synonyms" hidden></p>
      <dl class="mgdb-record-facts mgdb-rec-headfacts" id="map-record-facts">$(identity_facts)</dl>
    </div>
  </section>

  <nav class="mgdb-section-tabs mgdb-rec-tabs" id="map-record-tabs" aria-label="Sections on this record">
    <a href="#map-record-overview">Overview</a>
  </nav>

  <div class="mgdb-loading" id="map-record-loading"><span class="mgdb-spinner" aria-hidden="true"></span><span>Loading the full record&hellip;</span></div>

  <div class="mgdb-message mgdb-message-error" id="map-record-error" role="alert" hidden>
    <div>
      <strong>The rest of this record could not be loaded.</strong>
      <span>The identity above is correct. Reload to try again, or report it if it keeps happening.</span>
      <button class="mgdb-button mgdb-button-secondary" id="map-record-retry" type="button">Retry</button>
    </div>
  </div>

  <div class="mgdb-message mgdb-message-info" id="map-record-notice" role="status" hidden></div>

  <section id="map-record-overview" aria-labelledby="map-record-overview-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="map-record-overview-title">Overview</h2></div></div>
    <div id="map-record-overview-body"></div>
  </section>

  <section id="map-record-loci" aria-labelledby="map-record-loci-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="map-record-loci-title">Mapped loci</h2></div></div>
    <div id="map-record-loci-body"></div>
  </section>

  <section id="map-record-series" aria-labelledby="map-record-series-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="map-record-series-title">Maps in this series</h2></div></div>
    <div id="map-record-series-body"></div>
  </section>

  <section id="map-record-alt" aria-labelledby="map-record-alt-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="map-record-alt-title">Other maps on this chromosome</h2></div></div>
    <div id="map-record-alt-body"></div>
  </section>

  <section id="map-record-qtls" aria-labelledby="map-record-qtls-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="map-record-qtls-title">QTL experiments</h2></div></div>
    <div id="map-record-qtls-body"></div>
  </section>

  <section id="map-record-references" aria-labelledby="map-record-references-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="map-record-references-title">References</h2></div></div>
    <div id="map-record-references-body"></div>
  </section>

  <section id="map-record-metrics" aria-labelledby="map-record-metrics-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="map-record-metrics-title">Metrics</h2></div></div>
    <div class="mgdb-metric-grid" id="map-record-metrics-body"></div>
    <div class="mgdb-chart-grid mgdb-rec-charts" id="map-record-charts">
      <figure class="mgdb-figure" id="map-record-density-figure" hidden>
        <h3>Marker density along the map</h3>
        <div class="mgdb-chart" id="map-record-density-chart" role="img" aria-label="Bar chart of how many loci fall in each interval along the map">
          <div class="mgdb-chart-fallback">Loading the marker density&hellip;</div>
        </div>
        <figcaption id="map-record-density-caption"></figcaption>
      </figure>
      <figure class="mgdb-figure" id="map-record-connections-figure">
        <h3>Record connections</h3>
        <div class="mgdb-chart" id="map-record-connections-chart" role="img" aria-label="Horizontal bar chart of how many loci, related maps, QTL experiments and references are attached to this map">
          <div class="mgdb-chart-fallback">Loading the record connections&hellip;</div>
        </div>
        <figcaption id="map-record-connections-caption"></figcaption>
      </figure>
    </div>
  </section>

  <section class="mgdb-hub-related" id="map-record-resources" aria-labelledby="map-record-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="map-record-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>Search every genetic, cytogenetic, and physical chromosome map</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>The loci placed on this map, and the gene models behind them</span>
        </a>
        <a href="/data_center/qtl">
          <strong>QTL Experiments</strong>
          <span>Trait experiments and the map intervals their QTL fall in</span>
        </a>
        <a href="/tools/bin_viewer">
          <strong>Bin Viewer</strong>
          <span>Explore data in the regions defined by genetic bins</span>
        </a>
        <a href="https\://jbrowse.maizegdb.org/" target="_blank" rel="noopener">
          <strong>MaizeGDB JBrowse 2</strong>
          <span>Explore maize features in their genomic context</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mgdb-rec-api mgdb-hub-tone-blue" id="map-record-api" aria-labelledby="map-record-api-title">
    <div class="mgdb-section-heading"><div><h2 id="map-record-api-title">API data access</h2></div></div>
    <div class="mgdb-rec-api-row">
      <code id="map-record-api-endpoint">GET /api/v1/records/map/$(requested_identifier)</code>
      <div class="mgdb-rec-api-actions">
        <a class="mgdb-button mgdb-button-quiet" id="map-record-api-link" href="/api/v1/records/map/$(requested_identifier_path)" target="_blank" rel="noopener">Raw JSON <span aria-hidden="true">&nearr;</span></a>
        <button class="mgdb-button mgdb-button-quiet" id="map-copy-json-btn" type="button">Copy JSON</button>
        <a class="mgdb-button mgdb-button-quiet" href="/api/v1/openapi">API documentation</a>
      </div>
    </div>
    <p class="mgdb-rec-api-note">Every fact, mapped locus, related map, QTL experiment, and reference on this page is retrieved in one structured JSON response.</p>
  </section>
</main>
)
