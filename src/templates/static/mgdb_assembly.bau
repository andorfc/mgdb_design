      <svg viewBox="0 0 96 96" role="img" aria-label="Genome assembly chromosome icon">
        <!-- Chromosome scaffold / contig puzzle motif -->
        <rect x="18" y="16" width="26" height="28" rx="6" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <rect x="52" y="16" width="26" height="28" rx="6" fill="#235c37" />
        <rect x="18" y="52" width="26" height="28" rx="6" fill="#d99a0b" stroke="#7a4a10" stroke-width="2" />
        <rect x="52" y="52" width="26" height="28" rx="6" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <!-- Connection links -->
        <path d="M44 30 L52 30 M31 44 L31 52 M65 44 L65 52 M44 66 L52 66" stroke="#235c37" stroke-width="3" stroke-linecap="round" />
        <circle cx="48" cy="48" r="5" fill="#d99a0b" stroke="#ffffff" stroke-width="2" />
      </svg>
      <strong>B73<br />genome</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="assembly-title">B73 Maize Genome Assembly</h1>
      <p class="mgdb-hero-description">Explore the maize B73 representative reference genome assemblies \(v1 through v5\), structural gene model annotations, change histories, GenBank accessions, and bulk downloads.</p>
    </div>
  </section>

