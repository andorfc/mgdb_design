      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>NAM Founders</h3>
          <span class="mgdb-metric-badge">Pan-Genome</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(nam_genomes)</strong>
        </div>
        <p class="mgdb-metric-description">Chromosome-level de novo founder inbred genomes sequenced alongside B73 RefGen_v5.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Nuclear Chromosomes</h3>
          <span class="mgdb-metric-badge">Pseudomolecules</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(chromosomes)</strong>
        </div>
        <p class="mgdb-metric-description">Pseudomolecules anchored to genetic linkage maps plus organellar genomes.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Gene Model Sets</h3>
          <span class="mgdb-metric-badge">Annotations</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(gene_model_sets)</strong>
        </div>
        <p class="mgdb-metric-description">Structural annotation releases indexed with cross-reference translation tables.</p>
      </article>
    </div>
  
    </div>
  </section>

