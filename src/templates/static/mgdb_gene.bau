$$SYNTAX-LEVEL 2
*(mgdb-gene
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/gene_center/gene">
<meta property="og:title" content="MaizeGDB Gene Data Hub | Maize Genes and Gene Models">
<meta property="og:description" content="Search maize genes and gene models by name, identifier, sequence or position, translate identifiers between annotations, and download gene model sets.">

<main class="mgdb-page mgdb-hub-page mgdb-gene-page" id="gene-top">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Genes</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="gene-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/quicklinks/gene_center.png" alt="" width="128" height="128" decoding="async" />
      <strong>Gene<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="gene-title">Maize genes and gene models</h1>
      <p class="mgdb-hero-description">$(total_gene_models) gene models from $(total_annotations) current annotations of $(total_lines) maize lines, including the $(reference_models) gene models of the B73 v5 reference annotation.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#gene-search" class="is-current" aria-current="true">Search</a>
    <a href="#gene-blast">BLAST</a>
    <a href="#gene-region">Genome regions</a>
    <a href="#gene-lists">Gene model lists</a>
    <a href="#gene-downloads">Downloads</a>
    <a href="#gene-nomenclature">Nomenclature</a>
    <a href="#gene-about">About</a>
    <a href="#gene-references">References</a>
    <a href="#gene-metrics">Metrics</a>
    <a href="#gene-related">Related resources</a>
  </nav>

  <!-- ==================================================================
       1. Search
       ================================================================== -->
  <section id="gene-search" aria-labelledby="gene-search-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gene-search-title">Search</h2></div>
    </div>

    <form id="gene-search-form" class="gene-search" role="search">
      <div class="gene-query-row">
        <div class="gene-query-field">
          <label class="mgdb-visually-hidden" for="gene-search-term">Search genes and gene models</label>
          <div class="gene-query-control">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input id="gene-search-term" name="term" type="search" placeholder="Zm00001eb067740, lg1, or chromosome position" autocomplete="off" aria-describedby="gene-search-hint" />
            <button id="gene-query-clear" type="button" hidden>Clear</button>
          </div>
        </div>
        <button class="mgdb-button mgdb-button-primary gene-query-submit" type="submit">Search genes</button>
      </div>

      <p class="mgdb-hint" id="gene-search-hint">Wildcards&#58; <code>^lg1</code> starts with, <code>lg1$</code> ends with, <code>*</code> anywhere \(e.g., <code>lg*</code>\).</p>

      <div class="gene-examples" aria-label="Example searches">
        <span>EXAMPLES&#58;</span>
        <button type="button" data-gene-example="lg1">lg1</button>
        <button type="button" data-gene-example="liguleless1">liguleless1</button>
        <button type="button" data-gene-example="Zm00001eb067740">Zm00001eb067740</button>
        <button type="button" data-gene-example="GRMZM2G036297">GRMZM2G036297</button>
        <button type="button" data-gene-example="DAA35605">DAA35605</button>
        <button type="button" data-gene-example="Zm00001d002005_T001">Zm00001d002005_T001</button>
        <button type="button" data-gene-example="^lg1">^lg1</button>
        <button type="button" data-gene-example="lg1$">lg1$</button>
        <button type="button" data-gene-example="adh*">adh*</button>
      </div>

      <details class="gene-advanced" id="gene-advanced">
        <summary>
          <span class="gene-advanced-label">Advanced search</span>
        </summary>
        <div class="gene-advanced-body">
          <div class="gene-advanced-grid">
            <div class="mgdb-hub-field">
              <label for="adv-annotation">Annotation set</label>
              <select class="mgdb-select" id="adv-annotation" name="annotation">
                <option value="all">All annotations</option>
                $(annotation_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="adv-type">Gene model type</label>
              <select class="mgdb-select" id="adv-type" name="model_type">
                <option value="all">All types</option>
                $(model_type_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="adv-chr">Chromosome</label>
              <select class="mgdb-select" id="adv-chr" name="chromosome">
                <option value="all">All chromosomes</option>
                <option value="Chr1">Chromosome 1</option>
                <option value="Chr2">Chromosome 2</option>
                <option value="Chr3">Chromosome 3</option>
                <option value="Chr4">Chromosome 4</option>
                <option value="Chr5">Chromosome 5</option>
                <option value="Chr6">Chromosome 6</option>
                <option value="Chr7">Chromosome 7</option>
                <option value="Chr8">Chromosome 8</option>
                <option value="Chr9">Chromosome 9</option>
                <option value="Chr10">Chromosome 10</option>
                <option value="Unplaced">Unplaced</option>
                <option value="ChrMt">Mitochondrial</option>
                <option value="ChrPt">Plastid</option>
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="adv-range-start">Genomic position range</label>
              <div class="gene-range-inputs">
                <input class="mgdb-input" type="text" id="adv-range-start" name="range_start" inputmode="numeric" placeholder="Start bp" />
                <span class="gene-range-join" aria-hidden="true">&ndash;</span>
                <input class="mgdb-input" type="text" id="adv-range-end" name="range_end" inputmode="numeric" placeholder="End bp" />
              </div>
            </div>

            <div class="mgdb-hub-field">
              <label for="adv-product">Gene product</label>
              <select class="mgdb-select" id="adv-product" name="gene_product" data-gene-options="gene_product">
                <option value="all">Any gene product</option>
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="adv-pheno">Phenotype</label>
              <select class="mgdb-select" id="adv-pheno" name="phenotype" data-gene-options="phenotype">
                <option value="0">Any phenotype</option>
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="adv-trait">Associated trait</label>
              <select class="mgdb-select" id="adv-trait" name="trait" data-gene-options="trait">
                <option value="0">Any trait</option>
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="adv-protein">Protein or enzyme</label>
              <input class="mgdb-input" type="text" id="adv-protein" name="protein" placeholder="UniProt, Pfam, or EC number" />
            </div>

            <div class="mgdb-hub-field">
              <label for="gene-search-limit">Maximum records</label>
              <select class="mgdb-select" id="gene-search-limit" name="limit">
                <option value="50">50</option>
                <option value="100" selected>100</option>
                <option value="250">250</option>
                <option value="500">500</option>
                <option value="1000">1,000</option>
                <option value="$(search_limit_max)">$(search_limit_max_label)</option>
              </select>
            </div>
          </div>

          <div class="gene-advanced-toggles">
            <label class="mgdb-hub-check">
              <input type="checkbox" id="adv-locus-box" name="use_locus_assoc" value="1" />
              <span>Associated with a classic gene locus</span>
            </label>
            <label class="mgdb-hub-check">
              <input type="checkbox" id="adv-tandem-box" name="use_tandem" value="1" />
              <span>Belongs to a tandem array</span>
            </label>
          </div>

          <div class="gene-advanced-actions">
            <button class="mgdb-button mgdb-button-primary" id="gene-adv-submit" type="button">Apply filters</button>
            <button class="gene-advanced-reset-btn" id="gene-adv-reset" type="button">Reset filters</button>
          </div>
        </div>
      </details>
    </form>
  </section>

  <!-- ── Search results: hidden until a search runs ───────────────────────── -->
  <section id="gene-results-section" class="gene-results-section" aria-labelledby="gene-results-title" hidden>
    <div class="mgdb-section-heading">
      <div><h2 id="gene-results-title">Results</h2></div>
    </div>

    <p class="gene-results-status" id="gene-results-status" role="status" aria-live="polite">Searching gene models&hellip;</p>

    <div id="gene-notes"></div>

    <div class="gene-results-toolbar" id="gene-results-toolbar">
      <div class="mgdb-hub-field gene-results-filter">
        <label for="gene-results-filter">Filter these results</label>
        <input id="gene-results-filter" type="search" autocomplete="off" placeholder="Gene model, annotation, line, locus, type, chromosome" />
        <span class="mgdb-result-count" id="gene-filter-count" aria-live="polite"></span>
      </div>

      <div class="mgdb-hub-field">
        <label for="gene-page-size">Results shown</label>
        <select id="gene-page-size">
          <option value="10">Top 10</option>
          <option value="25" selected>Top 25</option>
          <option value="50">Top 50</option>
          <option value="100">Top 100</option>
          <option value="all">All results</option>
        </select>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action gene-results-export">
        <a class="mgdb-button mgdb-button-secondary" id="gene-export-tsv" href="#" download>Export TSV</a>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action gene-results-view">
        <div class="mgdb-view-toggle" role="group" aria-label="Result view">
          <button class="mgdb-view-btn" id="gene-view-cards" type="button" data-view="cards" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"/></svg>Cards
          </button>
          <button class="mgdb-view-btn is-active" id="gene-view-table" type="button" data-view="table" aria-pressed="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="7" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="12" width="14" height="2" rx="1" fill="currentColor"/></svg>Table
          </button>
        </div>
      </div>
    </div>

    <!-- Table view container -->
    <div class="gene-table-view" id="gene-table-view">
      <div id="gene-results"></div>
    </div>

    <!-- Cards view container -->
    <div class="gene-card-grid" id="gene-cards-view" hidden></div>

    <div class="mgdb-empty" id="gene-empty" hidden>
      <h3>No genes or gene models matched</h3>
      <p>Check the spelling of the identifier, try a synonym, or search the <a href="/data_center/locus">Locus Data Hub</a> for classic genetic loci that carry no gene model. Retired gene models are searched too, so an identifier that returns nothing here was never in a MaizeGDB annotation.</p>
    </div>
  </section>

  

  <!-- ==================================================================
       3. BLAST
       ================================================================== -->
  <section id="gene-blast" aria-labelledby="gene-blast-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gene-blast-title">BLAST</h2></div>
    </div>
    <p class="gene-section-lead">Find gene models by the sequence they contain. This is the search form from the <a href="/BLAST">BLAST page</a>, not a smaller copy of it&#58; three steps, with the current B73 assembly already selected, so a sequence and a press of Run BLAST is a complete search. Results open on the BLAST page.</p>
    ;; The same form as /BLAST, not a smaller lookalike of it: this loads
    ;; controllers/BLAST/BLAST_form.bau, the one template that page uses, and
    ;; gene_search_modern.php calls the same blastFormSetup\(\) on it. runBLAST\(\)
    ;; in BLAST.js posts a form it builds itself to /BLAST/BLAST_form.php, so a
    ;; search started here runs and reports exactly as one started there.
    ;;
    ;; The wrapper carries .mgdb-blast-page because every rule in
    ;; css/mgdb-blast.css is scoped to that class. On a div rather than the
    ;; page it scopes them to the form instead -- and the page-level rules in
    ;; that sheet \(the hero, the section tabs, > section[id]\) match nothing
    ;; inside it, so the gene hub's own chrome is untouched.
    <div class="mgdb-blast-page gene-blast-embed">
      *(blast-form)
    </div>
  </section>

  <!-- ==================================================================
       3b. Genome regions
       ================================================================== -->
  <section id="gene-region" aria-labelledby="gene-region-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gene-region-title">Genome regions</h2></div>
    </div>
    <p class="gene-section-lead">Go between coordinates and gene models in both directions&#58; from a stretch of an assembly to the gene models inside it, and from a list of gene models to where they sit.</p>

    <h3 class="mgdb-leaf-heading">Search by region</h3>
    <p class="gene-leaf-lead">Name one region &#8212; by assembly coordinates, by the interval between two markers, or by a gene model and a window around it &#8212; and open it in the genome browser or list what it contains.</p>

    <form id="gene-region-form" class="gene-panel" method="get" target="_blank" action="/search/gene/gene_chr_position.php">
      <fieldset class="gene-fieldset">
        <legend class="mgdb-label">Define the region by</legend>

        <div class="gene-region-choice">
          <label class="gene-region-radio">
            <input type="radio" name="region" id="region-assembly" value="assembly" checked />
            <span>assembly coordinates</span>
          </label>

          <div class="gene-region-fields" data-region="assembly">
            <div class="mgdb-search-row">
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-gm-version">Annotation</label>
                <select class="mgdb-select" name="gm_version" id="region-gm-version">
                  $(annotation_options)
                </select>
              </div>
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-chr">Chromosome</label>
                <select class="mgdb-select" name="chr" id="region-chr">
                  <option value="chr1">Chromosome 1</option>
                  <option value="chr2">Chromosome 2</option>
                  <option value="chr3">Chromosome 3</option>
                  <option value="chr4">Chromosome 4</option>
                  <option value="chr5">Chromosome 5</option>
                  <option value="chr6">Chromosome 6</option>
                  <option value="chr7">Chromosome 7</option>
                  <option value="chr8">Chromosome 8</option>
                  <option value="chr9">Chromosome 9</option>
                  <option value="chr10">Chromosome 10</option>
                  <option value="UNKNOWN">Unmapped</option>
                  <option value="chrMt">Mitochondria</option>
                  <option value="chrPt">Chloroplast</option>
                  <option value="chrAll">All</option>
                </select>
              </div>
            </div>
            <div class="mgdb-search-row">
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-model-type">Model type</label>
                <select class="mgdb-select" name="model_type" id="region-model-type">
                  <option value="any">any</option>
                  <option value="protein_coding">Protein Coding</option>
                  <option value="miRNA">miRNA</option>
                  <option value="transposable_element">Transposable Element</option>
                  <option value="low_confidence">Low Confidence</option>
                </select>
              </div>
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-data-type">Data type</label>
                <select class="mgdb-select" name="data_type" id="region-data-type">
                  <option value="all">All Genes/Gene Models</option>
                  <option value="canonical">Canonical Transcripts</option>
                  <option value="genes">Only Gene Models Linked to Genes</option>
                </select>
              </div>
            </div>
            <div class="mgdb-search-row">
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-start">Start position</label>
                <input class="mgdb-input" type="text" name="start_pos" id="region-start" inputmode="numeric" />
              </div>
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-end">End position</label>
                <input class="mgdb-input" type="text" name="end_pos" id="region-end" inputmode="numeric" />
              </div>
            </div>
            <p class="mgdb-hint">\(enter positions w/o commas or spaces, or leave both empty for entire chromosome\)</p>
          </div>
        </div>

        <div class="gene-region-choice">
          <label class="gene-region-radio">
            <input type="radio" name="region" id="region-marker" value="marker" />
            <span>marker</span>
          </label>

          <div class="gene-region-fields" data-region="marker">
            <div class="mgdb-search-row">
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-start-marker">Start</label>
                <input class="mgdb-input" type="text" name="start_marker" id="region-start-marker" />
              </div>
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-end-marker">End</label>
                <input class="mgdb-input" type="text" name="end_marker" id="region-end-marker" />
              </div>
              <div class="mgdb-field">
                <label class="mgdb-label" for="region-assembly-select">Assembly</label>
                <select class="mgdb-select" name="assembly" id="region-assembly-select">
                  $(annotation_options)
                </select>
              </div>
            </div>
            <p class="mgdb-hint">Enter two markers to get gene models within the span. Both must be on the same chromosome. Only applicable for assemblies with aligned markers.</p>
          </div>
        </div>

        <div class="gene-region-choice">
          <label class="gene-region-radio">
            <input type="radio" name="region" id="region-gm" value="gm" />
            <span>Assembly Annotation Positions</span>
          </label>

          <div class="gene-region-fields" data-region="gm">
            <div class="mgdb-field">
              <label class="mgdb-label" for="region-gm-list">Enter List - 8,000 gene model limit</label>
              <textarea class="mgdb-textarea" name="gm_pos_list" id="region-gm-list" rows="8"></textarea>
              <p class="mgdb-hint">Enter a list of gene models, transcripts, and/or proteins to retrieve their physical coordinates. <button type="button" class="gene-example" data-gene-fill="region-gm-list" data-gene-example="mixed">Example list</button></p>
            </div>
          </div>
        </div>
      </fieldset>

      <div class="mgdb-form-actions">
        <button class="mgdb-button mgdb-button-primary" type="submit">Submit</button>
      </div>
    </form>

    <h3 class="mgdb-leaf-heading mgdb-spaced">Find gene models by position</h3>
    <p class="gene-leaf-lead">Give one or more genomic intervals and get back every gene model they contain. Useful for turning a QTL interval, a BLAST hit or a mapping window into the list of genes that fall inside it.</p>
    <form id="gene-bulk-position-form" class="gene-panel" method="POST" target="_blank" action="/search/gene/gene_bulk_position.php">
      <div class="mgdb-field">
        <label class="mgdb-label" for="bulk-positions">Positions</label>
        <p class="mgdb-hint" id="bulk-positions-hint">Enter one or more lines in comma-separated format with the columns&#58; <i>[chromosome]:[start]..[end]</i> Limit the number of positions to 100 or fewer.</p>
        <textarea class="mgdb-textarea" name="bulk_positions" id="bulk-positions" rows="6" aria-describedby="bulk-positions-hint"></textarea>
      </div>
      <div class="mgdb-field gene-field-narrow">
        <label class="mgdb-label" for="bulk-position-assembly">in this assembly</label>
        <select class="mgdb-select" name="bulk_position_assembly" id="bulk-position-assembly">
          <option value=""></option>
          $(position_options)
        </select>
      </div>
      <p class="gene-example-line"><button type="button" class="gene-example" data-gene-fill="bulk-positions" data-gene-example="positions">Example list</button></p>
      <div class="mgdb-form-actions gene-tool-actions">
        <button class="mgdb-button mgdb-button-primary" type="submit">Show gene models</button>
        <button class="mgdb-button mgdb-button-quiet" type="submit" name="format" value="tsv">Download TSV</button>
        <button class="mgdb-button mgdb-button-quiet" type="submit" name="format" value="csv">Download CSV</button>
      </div>
    </form>
  </section>

  <!-- ==================================================================
       4. Gene model lists
       ================================================================== -->
  <section id="gene-lists" aria-labelledby="gene-lists-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gene-lists-title">Gene model lists</h2></div>
    </div>

    <div class="gene-tool-grid">

      <form id="gene-translate-form" class="gene-panel gene-tool" method="post" target="_blank" action="/search/gene/gene_translate.php">
        <h3 class="mgdb-leaf-heading">Translate Gene Model IDs</h3>
        <p class="gene-panel-lead">Take an identifier from one annotation and get the matching identifiers in another.</p>
        <div class="gene-tool-cols">
          <div class="gene-tool-input">
            <div class="mgdb-field">
              <label class="mgdb-label" for="translate-list">Enter a list &#8212; 8,000 identifiers at most</label>
              <textarea class="mgdb-textarea" name="gm_list" id="translate-list" rows="8"></textarea>
              <p class="gene-example-line"><button type="button" class="gene-example" data-gene-fill="translate-list" data-gene-example="mixed">Example list</button></p>
            </div>
          </div>
          <div class="gene-tool-side">
            <div class="gene-accepts">
              <p class="gene-accepts-title">What goes in</p>
              <ul>
                <li><b>Gene models</b> &#8212; <code>Zm00001eb067740</code></li>
                <li><b>Transcripts</b> &#8212; <code>Zm00001eb067740_T001</code></li>
                <li><b>Protein isoforms</b> &#8212; <code>Zm00001eb067740_P001</code></li>
                <li><b>GenBank accessions</b> &#8212; <code>DAA35605</code>, <code>ZEAMMB73_*</code></li>
              </ul>
              <p class="mgdb-hint">Mixed lists are fine, and identifiers from retired annotations are matched too.</p>
            </div>
            <div class="mgdb-field">
              <label class="mgdb-label" for="translate-to">Translate to</label>
              <select class="mgdb-select" name="trans_to" id="translate-to">
                <option value="all">All gene sets</option>
                <option value="B73">All B73 gene sets</option>
                <option value="NAM">All NAM founders</option>
                <option value="genbank_gene">GenBank Gene accessions \(Entrez\)</option>
                <option value="genbank_id">GenBank protein accessions \(ZEAMMB*\)</option>
                $(assembly_options)
              </select>
              <p class="mgdb-hint">A translation is not always one to one&#58; one gene model can match several in another annotation, one, or none, so a cell may hold a comma-separated list or be empty.</p>
            </div>
          </div>
        </div>
        <div class="mgdb-form-actions gene-tool-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit">Show results</button>
          <button class="mgdb-button mgdb-button-quiet" type="submit" name="format" value="tsv">Download TSV</button>
          <button class="mgdb-button mgdb-button-quiet" type="submit" name="format" value="csv">Download CSV</button>
        </div>
        <p class="mgdb-small">Alternatively, <a href="https://download.maizegdb.org/Pan-genes/Pan-Zea">download the full gene model associations table between the B73 assemblies and all other assemblies in our database</a>.</p>
      </form>

      <form id="gene-fasta-form" class="gene-panel gene-tool" method="post" target="_blank" action="/search/gene/get_fasta.php">
        <h3 class="mgdb-leaf-heading">Download sequence for a gene model list</h3>
        <p class="gene-panel-lead">FASTA for a list of identifiers, in whichever sequence type you need.</p>
        <div class="gene-tool-cols">
          <div class="gene-tool-input">
            <div class="mgdb-field">
              <label class="mgdb-label" for="fasta-list">Enter a list &#8212; 8,000 identifiers at most</label>
              <textarea class="mgdb-textarea" name="gm_seq_list" id="fasta-list" rows="8"></textarea>
              <p class="gene-example-line"><button type="button" class="gene-example" data-gene-fill="fasta-list" data-gene-example="models">Example list</button></p>
            </div>
          </div>
          <div class="gene-tool-side">
            <div class="gene-accepts">
              <p class="gene-accepts-title">Match the identifier to the sequence</p>
              <ul>
                <li><b>Genomic</b> &#8212; the gene model name, <code>Zm00001eb067740</code></li>
                <li><b>cDNA, CDS and mRNA</b> &#8212; the transcript ID, <code>Zm00001eb067740_T001</code></li>
                <li><b>Protein</b> &#8212; the translation ID, <code>Zm00001eb067740_P001</code></li>
              </ul>
              <p class="mgdb-hint">Giving only gene model IDs is fine&#58; choose whether you want every transcript or only the canonical one.</p>
            </div>
            <div class="mgdb-field">
              <label class="mgdb-label" for="fasta-in-type">Input type</label>
              <select class="mgdb-select" name="in_type" id="fasta-in-type">
                <option value="gene">Gene Model ID</option>
                <option value="transcript">Transcript ID</option>
                <option value="translation">Translation ID</option>
              </select>
            </div>
            <div class="mgdb-field">
              <label class="mgdb-label" for="fasta-out-type">Output type</label>
              <select class="mgdb-select" name="out_type" id="fasta-out-type">
                <option value="genomic">Sequence&#58; genomic</option>
                <option value="cdna">Sequence&#58; cDNA - all transcripts</option>
                <option value="cdna-canonical">Sequence&#58; cDNA - canonical transcripts</option>
                <option value="ncrna">Sequence&#58; ncRNA</option>
                <option value="protein">Sequence&#58; protein</option>
              </select>
            </div>
          </div>
        </div>
        <div class="mgdb-form-actions gene-tool-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit">Show sequence</button>
        </div>
      </form>

      <form id="gene-scores-form" class="gene-panel gene-tool" method="post" target="_blank" action="/search/gene/get_scores.php">
        <h3 class="mgdb-leaf-heading">Get scores for a set of gene models</h3>
        <p class="gene-panel-lead">Eleven measures of how well supported a gene model is, and of the protein it predicts.</p>
        <div class="gene-tool-cols">
          <div class="gene-tool-input">
            <div class="mgdb-field">
              <label class="mgdb-label" for="scores-list">Enter one or more B73 v5 or NAM gene model names</label>
              <textarea class="mgdb-textarea" name="bulk_score_gms" id="scores-list" rows="8"></textarea>
              <p class="gene-example-line"><button type="button" class="gene-example" data-gene-fill="scores-list" data-gene-example="scores">Example list</button></p>
            </div>
          </div>
          <div class="gene-tool-side">
            <div class="gene-accepts">
              <p class="gene-accepts-title">What comes back</p>
              <ul>
                <li><b>AED</b> &#8212; annotation edit distance, how far the model sits from the evidence it was built on. Lower is better.</li>
                <li><b>reelGene</b> &#8212; exon, protein and average scores from a model trained to tell real gene structures from spurious ones.</li>
                <li><b>pSAURON</b> &#8212; whether the model looks like a protein-coding gene, and how well its reading frame holds.</li>
                <li><b>AlphaFold2</b> and <b>ESMFold</b> average pLDDT &#8212; how confident each structure predictor is about the folded protein.</li>
                <li><b>IUPred2</b> and <b>ANCHOR2</b> &#8212; the percentage of residues predicted to be disordered, and to be disordered binding sites.</li>
              </ul>
              <p class="mgdb-hint">One row per transcript. A blank cell means that measure was not calculated for it.</p>
            </div>
          </div>
        </div>
        <div class="mgdb-form-actions gene-tool-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit">Show scores</button>
          <button class="mgdb-button mgdb-button-quiet" type="submit" name="format" value="tsv">Download TSV</button>
          <button class="mgdb-button mgdb-button-quiet" type="submit" name="format" value="csv">Download CSV</button>
        </div>
      </form>

      ;; One request, one file. This used to POST to search/gene/download_all.php,
      ;; which ran download_all.pl synchronously through shell_exec and only then
      ;; answered, while the page polled search/download/checkQuery.php -- which
      ;; sleeps five seconds per call -- and finally tried to click an
      ;; <a download target="_blank"> that a popup blocker can refuse without a
      ;; word. It now posts straight to an endpoint that answers with the file.
      <form id="gene-downloadall-form" class="gene-panel gene-tool" method="POST"
            action="/search/gene/gene_download_all.php" enctype="multipart/form-data" target="_blank">
        <h3 class="mgdb-leaf-heading">Download all data for a list of gene models</h3>
        <p class="gene-panel-lead">One row for each gene model, carrying everything the record pages show.</p>
        <div class="gene-tool-cols">
          <div class="gene-tool-input">
            <div class="mgdb-field">
              <label class="mgdb-label" for="downloadall_list">Enter a list of gene models</label>
              <textarea class="mgdb-textarea" name="downloadall_list" id="downloadall_list" rows="8"></textarea>
              <p class="gene-example-line"><button type="button" class="gene-example" data-gene-fill="downloadall_list" data-gene-example="models">Example list</button> <span class="mgdb-hint">Separate with newlines, commas, spaces or semicolons &#8212; up to $(downloadall_limit).</span></p>
            </div>
            <div class="mgdb-field">
              <label class="mgdb-label" for="downloadall_file">Or upload a file</label>
              <input type="file" name="downloadall_file" id="downloadall_file" aria-describedby="downloadall-file-hint" />
              <p class="mgdb-hint" id="downloadall-file-hint">A plain text file of gene models, one per line. \(Maximum file size is 50kb\)</p>
            </div>
          </div>
          <div class="gene-tool-side">
            <div class="gene-accepts">
              <p class="gene-accepts-title">What comes back</p>
              <ul>
                <li>The assembly and annotation the gene model belongs to</li>
                <li>Its coordinates, and its canonical transcript's</li>
                <li>Transcript count and tandem array count</li>
                <li>The gene locus it is associated with, symbol and full name</li>
                <li>Its gene products, and its GO terms with their names</li>
              </ul>
              <p class="mgdb-hint">An identifier that matches nothing keeps its row, with the rest of the columns empty.</p>
            </div>
            <p class="mgdb-small">To download data for <i>all</i> gene models in a B73 assembly&#58;</p>
            <ul class="gene-link-list">
              <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0-GMs-GOTerms.csv.gz">Zm-B73-REFERENCE-NAM-5.0</a></li>
              <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-GRAMENE-4.0/Zm-B73-REFERNECE-GRAMENE-4.0-GMs-GOTerms.csv.gz">Zm-B73-REFERENCE-GRAMENE-4.0</a></li>
              <li><a href="https://download.maizegdb.org/B73_RefGen_v3/B73_RefGen_v3-GMs-GOTerms.csv.gz">B73 RefGen_v3</a></li>
            </ul>
          </div>
        </div>
        <div class="mgdb-form-actions gene-tool-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit" name="format" value="tsv">Download TSV</button>
          <button class="mgdb-button mgdb-button-quiet" type="submit" name="format" value="csv">Download CSV</button>
          <button class="mgdb-button mgdb-button-quiet" type="reset">Reset</button>
        </div>
      </form>

    </div>

    <div class="mgdb-resource-panel mgdb-spaced gene-maizemine">
      <div>
        <h3 class="mgdb-leaf-heading">MaizeMine</h3>
        <p><a href="https://maizemine.rnet.missouri.edu/maizemine/begin.do" target="_blank" rel="noopener">MaizeMine</a> provides an alternative view into the MaizeGDB data, with an emphasis on genomic, gene expression data, and metabolics.</p>
        <p>The "Quick Search" feature on the <a href="https://maizemine.rnet.missouri.edu/maizemine/begin.do" target="_blank" rel="noopener">MaizeMine home page</a> gives quick access to individual gene models, pathways, proteins, et cetera.</p>
        <p>To get data associated with a set of gene models, for example expression levels, pathways, GO terms, start by <a href="https://maizemine.rnet.missouri.edu/maizemine/bag.do?subtab=upload" target="_blank" rel="noopener">creating a list</a>. Then you can attach data and analyze the list in multiple ways.</p>
        <p>You can see the list of data sources <a href="https://maizemine.rnet.missouri.edu/maizemine/dataCategories.do" target="_blank" rel="noopener">here</a>. The MaizeMine tutorial is <a href="https://maizemine.readthedocs.io/en/v1.4/" target="_blank" rel="noopener">here</a>.</p>
        <p class="mgdb-small">MaizeMine is currently hosted by the <a href="https://elsiklab.missouri.edu/" target="_blank" rel="noopener">Elsik Lab</a> at the University of Missouri.</p>
      </div>
    </div>

    <div class="mgdb-resource-panel mgdb-spaced gene-featurestore">
      <div>
        <h3 class="mgdb-leaf-heading">Maize Feature Store</h3>
        <p>The <a href="https://mfs.maizegdb.org/" target="_blank" rel="noopener">Maize Feature Store</a> holds over 14,000 gene-based features for the B73 reference genome, built from published genomic, transcriptomic, epigenomic, variomic and proteomic datasets and kept in the shape a machine learning model expects.</p>
        <p>Where the tools above answer questions about one gene or one list, the Feature Store is for training and evaluating models across all of them&#58; features are versioned, documented and downloadable, so a model can be rebuilt on the same inputs later.</p>
        <p class="mgdb-small">Sen S, Woodhouse MR, Portwood JL, Andorf CM. <a href="https://doi.org/10.1093/database/baad078" target="_blank" rel="noopener">Maize Feature Store&#58; a centralized resource to manage and analyze curated maize multi-omics features for machine learning applications</a>. <i>Database</i>, 2023.</p>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       5. Downloads
       ================================================================== -->
  <section id="gene-downloads" aria-labelledby="gene-downloads-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gene-downloads-title">Downloads</h2></div>
    </div>

    <div class="mgdb-card-grid gene-download-grid">
      <article class="mgdb-card">
        <h3>Zm00001eb.1 gene model files</h3>
        <ul class="gene-link-list">
          <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3.gz">Zm00001eb.1 gene model GFF</a></li>
          <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.cdna.fa.gz">Zm00001eb.1 gene model cDNA fasta</a></li>
          <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.cds.fa.gz">Zm00001eb.1 gene model CDS fasta</a></li>
          <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gene.fa.gz">Zm00001eb.1 gene model genomic fasta</a></li>
          <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.protein.fa.gz">Zm00001eb.1 gene model protein fasta</a></li>
        </ul>
      </article>

      <article class="mgdb-card">
        <h3>Functional annotations and orthologs</h3>
        <p class="mgdb-small"><b>Zm-B73-REFERENCE-NAM-5.0</b></p>
        <ul class="gene-link-list">
          <li><a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.interproscan.tsv.gz">InterproScan results</a> \(Also available in the <a href="https://download.maizegdb.org">MaizeGDB downloads</a> for all <a href="https://nam-genomes.github.io/" target="_blank" rel="noopener">NAM founder assemblies</a>\)</li>
        </ul>
        <p class="mgdb-small"><b>Phytozome</b></p>
        <ul class="gene-link-list">
          <li><a href="https://genome.jgi.doe.gov/portal/pages/dynamicOrganismDownload.jsf?organism=Zmays" target="_blank" rel="noopener">Download files</a> include functional Annotations for B73 RefGen_v2 \("Ensembl-18"\) and B73 RefGen_v4, and orthologs for B73 RefGen_v4. \(account required\)</li>
        </ul>
      </article>

      <article class="mgdb-card">
        <h3>Gene models with associated genes</h3>
        <p>Gene models that carry an associated classical or curated gene, for B73 RefGen_v3 and Zm-B73-REFERENCE-GRAMENE-4.0 &#40;B73 RefGen_v4&#41;. Read each set in the browser, or take the whole thing as a file.</p>
        <div class="mgdb-table-scroll">
          <table class="mgdb-table gene-assoc-table">
            <caption class="mgdb-visually-hidden">Gene models with associated genes, by gene set, as a browsable table or a tab-delimited file</caption>
            <thead>
              <tr>
                <th scope="col">Gene set</th>
                <th scope="col">View</th>
                <th scope="col">Download</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Classical genes</th>
                <td><a href="/associated_genes?type=classical&amp;style=table">Browse table</a></td>
                <td><a href="/associated_genes?type=classical&amp;style=tab" download>Tab-delimited</a></td>
              </tr>
              <tr>
                <th scope="row">MaizeGDB curated genes</th>
