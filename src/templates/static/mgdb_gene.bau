            <thead><tr></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </details>
    </figure>

    <figure class="mgdb-figure mgdb-spaced">
      <div class="mgdb-chart" id="gene-transcript-chart" role="img" aria-label="Bar chart of the number of Zm00001eb.1 gene models against how many transcripts each one has">
