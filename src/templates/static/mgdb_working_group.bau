  <section class="mgdb-hero" aria-labelledby="working-group-title">
    <div class="mgdb-hero-emblem">
      <svg class="wg-hero-mark" viewBox="0 0 96 96" role="img" aria-label="A compass rose over an open document">
        <rect x="18" y="14" width="60" height="68" rx="6" fill="#ffffff" stroke="#235c37" stroke-width="3" />
        <path d="M28 26h26M28 34h20" stroke="#235c37" stroke-width="3" stroke-linecap="round" />
        <circle cx="48" cy="56" r="18" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <path d="M48 42l5 11 11 5-11 5-5 11-5-11-11-5 11-5z" fill="#d99a0b" />
