$$SYNTAX-LEVEL 2
*(mgdb-overgo-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No overgo found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="overgo-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/overgo">Overgo Data Center</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="overgo-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="overgo-notfound-title">No overgo matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB holds $(total_overgos) overgo probes. None of them carries that name, synonym, or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="overgo-notfound-search" aria-labelledby="overgo-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="overgo-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/overgo" method="get" role="search">
      <label class="mgdb-visually-hidden" for="overgo-notfound-query">Overgo name, synonym, or MaizeGDB ID</label>
      <input class="mgdb-input" id="overgo-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Overgo name, synonym, or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search overgos</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/overgo?id=CL0_-2_ov">CL0_-2_ov</a>
      <a class="mgdb-rec-example" href="/data_center/overgo?id=389357">389357</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs one overgo&#58; its name, one of its synonyms, or its MaizeGDB ID. Names are written with and without the <em>p-</em> prefix and both reach the record. An overgo is one kind of molecular marker, so a marker that is not an overgo has its record in the Molecular Marker Data Hub instead.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="overgo-notfound-resources" aria-labelledby="overgo-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="overgo-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/overgo">
          <strong>Overgo Data Center</strong>
          <span>Search the overgo probe collection by name, synonym, or the unigene it came from</span>
        </a>
        <a href="/data_center/marker">
          <strong>Molecular Marker Data Hub</strong>
          <span>Every marker and probe MaizeGDB holds, of which overgos are one kind</span>
        </a>
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>The genetic and physical maps these probes are placed on</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="/downloads">
          <strong>Downloads</strong>
          <span>Marker and mapping datasets, including the overgo collection</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
