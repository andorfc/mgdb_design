$$SYNTAX-LEVEL 2
*(mgdb-map-scores-record
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:title" content="$(record_name) &mdash; MaizeGDB map score">
<meta property="og:description" content="$(record_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-map-scores-record-page" id="ms-record-top" data-record-id="$(record_id)" data-requested-id="$(requested_identifier)">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/map">Map Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">$(record_name)</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-hero" aria-labelledby="ms-record-title">
    <div class="mgdb-hero-body">
      <h1 id="ms-record-title">$(record_name)</h1>
      <p class="mgdb-rec-synonyms" id="ms-record-synonyms" hidden></p>
      <dl class="mgdb-record-facts mgdb-rec-headfacts" id="ms-record-facts">$(identity_facts)</dl>
    </div>
  </section>

  <nav class="mgdb-section-tabs mgdb-rec-tabs" id="ms-record-tabs" aria-label="Sections on this record">
    <a href="#ms-record-overview">Overview</a>
  </nav>

  <div class="mgdb-loading" id="ms-record-loading"><span class="mgdb-spinner" aria-hidden="true"></span><span>Loading the full record&hellip;</span></div>

  <div class="mgdb-message mgdb-message-error" id="ms-record-error" role="alert" hidden>
    <div>
      <strong>The rest of this record could not be loaded.</strong>
      <span>The identity above is correct. Reload to try again, or report it if it keeps happening.</span>
      <button class="mgdb-button mgdb-button-secondary" id="ms-record-retry" type="button">Retry</button>
    </div>
  </div>

  <div class="mgdb-message mgdb-message-info" id="ms-record-notice" role="status" hidden></div>

  <section id="ms-record-overview" aria-labelledby="ms-record-overview-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ms-record-overview-title">Overview</h2></div></div>
    <div id="ms-record-overview-body"></div>
  </section>

  <section id="ms-record-scores" aria-labelledby="ms-record-scores-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ms-record-scores-title">Scores</h2></div></div>
    <div id="ms-record-scores-body"></div>
  </section>

  <section id="ms-record-maps" aria-labelledby="ms-record-maps-title" hidden>
    <div class="mgdb-section-heading"><div><h2 id="ms-record-maps-title">Maps</h2></div></div>
    <div id="ms-record-maps-body"></div>
  </section>

  <section class="mgdb-hub-related" id="ms-record-resources" aria-labelledby="ms-record-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="ms-record-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>The genetic and physical maps this score contributed to</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>The probed site and other markers this score positions</span>
        </a>
        <a href="/data_center/marker">
          <strong>Marker Data Hub</strong>
          <span>The probe that produced this score, and the rest of the probe collection</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Data Hub</strong>
          <span>The mapping panel lines the genotype string was scored across</span>
        </a>
        <a href="/data_center/bin">
          <strong>Bin Viewer</strong>
          <span>Genetic bin boundaries, and the data placed within them</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mgdb-rec-api mgdb-hub-tone-blue" id="ms-record-api" aria-labelledby="ms-record-api-title">
    <div class="mgdb-section-heading"><div><h2 id="ms-record-api-title">API data access</h2></div></div>
    <div class="mgdb-rec-api-row">
      <code id="ms-record-api-endpoint">GET /api/v1/records/map_scores/$(requested_identifier)</code>
      <div class="mgdb-rec-api-actions">
        <a class="mgdb-button mgdb-button-quiet" id="ms-record-api-link" href="/api/v1/records/map_scores/$(requested_identifier_path)" target="_blank" rel="noopener">Raw JSON <span aria-hidden="true">&nearr;</span></a>
        <button class="mgdb-button mgdb-button-quiet" id="ms-copy-json-btn" type="button">Copy JSON</button>
        <a class="mgdb-button mgdb-button-quiet" href="/api/v1/openapi">API documentation</a>
      </div>
    </div>
    <p class="mgdb-rec-api-note">Every fact, score, and map on this page is retrieved in one structured JSON response.</p>
  </section>
</main>
)
