$$SYNTAX-LEVEL 2
*(mgdb-pattern-library
<a class="mgdb-skip-link" href="#pattern-main">Skip to main content</a>
<main class="mgdb-page mgdb-pattern-library" id="pattern-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Design pattern library</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="pattern-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/maize_meeting/mgc-mark.png?v=1" alt="" />
      <strong>MaizeGDB<br />Design System</strong>
      <span>Pattern library</span>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; August 2026</p>
      <h1 id="pattern-title">Shared interface components</h1>
      <p class="mgdb-hero-description">This reference renders every component defined in the shared stylesheet so that spacing, contrast, keyboard behavior, and responsive breakpoints can be verified in one place before a pattern is applied to a production page.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#pattern-reference" class="is-current">Reference pages</a>
