$$SYNTAX-LEVEL 2
*(mgdb-stock
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/stock">
<meta property="og:title" content="MaizeGDB Stock Center | Genetic Stocks & Germplasm">
<meta property="og:description" content="Search curated maize genetic stocks, inbred lines, mutant alleles, phenotypes, and germplasm providers, and find where to order them.">

<main class="mgdb-page mgdb-hub-page mgdb-stock-page" id="stock-main">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Stock Center</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="stock-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/stock/mgcsc-ear.png?v=20260902" alt="" class="stock-hero-icon" width="80" height="80" />
      <strong>Stock<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="stock-title">Explore maize genetic stocks &amp; germplasm</h1>
      <p class="mgdb-hero-description">Discover curated maize genetic stocks, inbred lines, diversity panels, mutant alleles, and chromosomal translocations, linked directly to distribution collections and ordering portals.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#stock-search-section" class="is-current" aria-current="true">Search</a>
    <a href="#stock-collections">Collections</a>
    <a href="#stock-nam">NAM founders</a>
    <a href="#stock-downloads">Downloads</a>
    <a href="#stock-references">References</a>
    <a href="#stock-metrics">Metrics</a>
    <a href="#stock-related">Related resources</a>
  </nav>

  <section id="stock-search-section" class="stock-search-panel" aria-labelledby="stock-search-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="stock-search-title">Search</h2>
      </div>
    </div>

    <form id="stock-search-form" class="stock-search" role="search">
      <div class="stock-query-row">
        <div class="stock-query-field">
          <label class="mgdb-visually-hidden" for="stock-query">Search stocks</label>
          <div class="stock-query-control">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input id="stock-query" name="term" type="search" placeholder="Try B73, Mo17, W22, &#40;wx1-m1&#41;, Ky21, Ames, or NAM…" autocomplete="off" aria-describedby="stock-query-hint" />
            <button class="stock-query-clear" id="stock-query-clear" type="button" aria-label="Clear query" hidden>
              <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
              </svg>
            </button>
          </div>
        </div>
        <button class="mgdb-button mgdb-button-primary stock-query-submit" id="stock-search-submit" type="submit">Search stocks</button>
      </div>

      <p class="mgdb-hint" id="stock-query-hint">A gene or variation goes in parentheses&#58; <code>&#40;wx1-m1&#41;</code>. Descriptions, synonyms and external accessions are all searched.</p>

      <div class="stock-examples" aria-label="Example searches">
        <span>EXAMPLES&#58;</span>
        <button type="button" data-stock-example="B73">B73</button>
        <button type="button" data-stock-example="Mo17">Mo17</button>
        <button type="button" data-stock-example="W22">W22</button>
        <button type="button" data-stock-example="&#40;wx1-m1&#41;">&#40;wx1-m1&#41;</button>
        <button type="button" data-stock-example="&#40;r1-m3&#41;">&#40;r1-m3&#41;</button>
        <button type="button" data-stock-example="Ky21">Ky21</button>
        <button type="button" data-stock-example="Ames">Ames</button>
      </div>

      <details class="stock-advanced" id="stock-adv">
        <summary>
          <span class="stock-advanced-label">Advanced search</span>
          <span class="stock-advanced-count" id="stock-advanced-count" hidden></span>
        </summary>

        <div class="stock-advanced-body">
          <div class="stock-advanced-grid">
            <div class="mgdb-hub-field">
              <label for="stock-type">Stock type</label>
              <select id="stock-type" name="type">
                <option value="0">All stock types</option>
                $(type_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="stock-available">Available from</label>
              <select id="stock-available" name="available">
                <option value="0">All providers &amp; centers</option>
                $(provider_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="stock-linkage">Focus linkage group</label>
              <select id="stock-linkage" name="linkage">
                <option value="0">All linkage groups</option>
                $(linkage_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="stock-phenotype">Phenotypic effect</label>
              <select id="stock-phenotype" name="phenotype">
                <option value="0">All phenotypic traits</option>
                $(phenotype_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="stock-karyotype">Karyotypic variation</label>
              <select id="stock-karyotype" name="karyotype">
                <option value="0">All karyotypes</option>
                $(karyotype_options)
              </select>
            </div>

            <div class="mgdb-hub-field">
              <label for="stock-sort">Sort results by</label>
              <select id="stock-sort" name="sort">
                <option value="relevance">Best match</option>
                <option value="name">Identifier A&ndash;Z</option>
                <option value="name-desc">Identifier Z&ndash;A</option>
              </select>
            </div>
          </div>

          <div class="stock-advanced-toggles">
            <label class="mgdb-hub-check">
              <input type="checkbox" id="stock-f-mgsc" name="f_mgsc" value="1" />
              <span>Available from the Stock Center</span>
            </label>
            <label class="mgdb-hub-check">
              <input type="checkbox" id="stock-f-bank" name="f_bank" value="1" />
              <span>From germplasm bank &#40;CIMMYT/NCRPIS&#41;</span>
            </label>
            <label class="mgdb-hub-check">
              <input type="checkbox" id="stock-f-expvp" name="f_expvp" value="1" />
              <span>Ex-PVP line</span>
            </label>
          </div>

          <div class="stock-advanced-actions">
            <button class="mgdb-button mgdb-button-primary" type="submit">Apply filters</button>
            <button class="mgdb-button stock-advanced-reset-btn" id="stock-adv-reset" type="button">Reset filters</button>
          </div>
        </div>
      </details>
    </form>
  </section>

  <!-- ====================================================================
       Results. Hidden until a search runs, then revealed by the page script.
       ==================================================================== -->
  <section id="stock-results-section" class="stock-results-section" aria-labelledby="stock-results-title" hidden>
    <div class="mgdb-section-heading">
      <div>
        <h2 id="stock-results-title">Results</h2>
      </div>
    </div>

    <p class="stock-results-status" id="stock-results-status" role="status" aria-live="polite">Enter a search term above or choose a filter to inspect stocks.</p>

    <div class="stock-results-toolbar">
      <div class="mgdb-hub-field stock-results-filter">
        <label for="stock-results-filter">Filter these results</label>
        <input id="stock-results-filter" type="search" placeholder="Filter current page" autocomplete="off" />
        <span class="mgdb-result-count" id="stock-filter-count" aria-live="polite"></span>
      </div>

      <div class="mgdb-hub-field">
        <label for="stock-page-size">Results shown</label>
        <select id="stock-page-size">
          <option value="10">Top 10</option>
          <option value="25" selected>Top 25</option>
          <option value="50">Top 50</option>
          <option value="all">All results</option>
        </select>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action stock-results-export">
        <a class="mgdb-button mgdb-button-secondary" id="stock-export-tsv" href="#" download>Export TSV</a>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action stock-results-view">
        <div class="mgdb-view-toggle" role="group" aria-label="Result view">
          <button class="mgdb-view-btn" id="stock-view-cards" type="button" data-view="card" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"/></svg>Cards
          </button>
          <button class="mgdb-view-btn is-active" id="stock-view-table" type="button" data-view="table" aria-pressed="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="7" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="12" width="14" height="2" rx="1" fill="currentColor"/></svg>Table
          </button>
        </div>
      </div>
    </div>

    <div class="stock-sources" id="stock-sources" hidden>
      <button class="mgdb-chip is-active" id="stock-source-mgdb" type="button" aria-pressed="true">MaizeGDB stocks</button>
      <button class="mgdb-chip" id="stock-source-grin" type="button" aria-pressed="false">GRIN accessions</button>
      <span class="mgdb-small mgdb-muted" id="stock-source-note">GRIN is a mirror of the USDA collection. The full collection is at <a href="https\://npgsweb.ars-grin.gov/gringlobal/search.aspx" target="_blank" rel="noopener">GRIN-Global <span aria-hidden="true">&nearr;</span></a>.</span>
    </div>

    <div id="stock-results" class="stock-results-container stock-view-table"></div>

    <div id="stock-empty" class="mgdb-empty" hidden>
      <h3>No stocks matched your query</h3>
      <p>Try searching with a broader keyword &#40;e.g. <code>B73</code>, <code>Mo17</code>, <code>inbred</code>&#41; or resetting provider and type filters.</p>
      <button class="mgdb-button mgdb-button-secondary" id="stock-empty-reset" type="button">Reset search</button>
    </div>

    <nav id="stock-pagination" class="stock-pagination" aria-label="Search result pages"></nav>
  </section>

  <section id="stock-collections" aria-labelledby="stock-collections-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="stock-collections-title">Collections</h2>
      </div>
    </div>

    <div class="mgdb-card-grid stock-collection-grid">
      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">Primary Repository</span>
        <h3>Maize Genetics Cooperation Stock Center</h3>
        <p>The primary source of maize genetic stocks, mutant alleles, and translocation lines. Seed ordering and accession listings.</p>
        <a href="https\://maizecoopsc.org/" target="_blank" rel="noopener">Open Stock Center <span aria-hidden="true">&nearr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-info">Stock Catalog</span>
        <h3>Stock Center Catalog</h3>
        <p>Categorized directory of stocks distributed by the Maize Genetics Cooperation Stock Center.</p>
        <a href="/stock_catalog">Browse Catalog <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-warn">Nomenclature Guide</span>
        <h3>Decrypt Seed Packet Labels</h3>
        <p>Comprehensive guide to the Stock Center&rsquo;s pedigree and accession labeling conventions for deciphering seed packets.</p>
        <a href="/stock_decryption">Decrypt Packet <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill">USDA Repository</span>
        <h3>North Central Regional PI Station</h3>
        <p>NCRPIS non-mutant germplasm, open-pollinated landraces, and lines with molecular or phenotype data held at Ames, Iowa.</p>
        <a href="https\://maizecoopsc.org/ncrpis/" target="_blank" rel="noopener">Explore NCRPIS <span aria-hidden="true">&nearr;</span></a>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">Transposon Mutants</span>
        <h3>UniformMu Insertion Lines</h3>
        <p>Over 31,000 sequence-indexed Robertson&rsquo;s Mutator insertion alleles with cosegregating seedling and ear traits in uniform W22 background.</p>
        <a href="/uniformmu">Explore UniformMu <span aria-hidden="true">&rarr;</span></a>
      </article>

      ;; The "EMS Inflorescence Mutants" card was removed on 2026-09-07 with
      ;; /ems-phenotype itself. That page was an iframe onto
      ;; cur.maizegdb.org/ems-phenotype.php, which answers HTTP 502, and the
      ;; collection is not in MaizeGDB's own stock data either -- a stock
      ;; search for EMS returns nothing. The card promised a resource that no
      ;; longer exists. Restoring it means restoring the collection first.
    </div>
  </section>

  <section id="stock-nam" aria-labelledby="stock-nam-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="stock-nam-title">NAM founders</h2>
      </div>
    </div>

    <p class="stock-section-intro">Stocks may be ordered from the <a href="https\://maizecoopsc.org/nam-rils" target="_blank" rel="noopener">Maize Genetics Cooperation Stock Center <span aria-hidden="true">&nearr;</span></a>. Key reference&#58; <a href="https\://doi.org/10.1534/genetics.107.074245" target="_blank" rel="noopener">Yu et al., 2008 <span aria-hidden="true">&nearr;</span></a>.</p>

    <div class="stock-nam-grid" aria-label="NAM founder lines">
      <a href="/data_center/stock/B97"><strong>B97</strong><span>Northern Flint</span></a>
      <a href="/data_center/stock/CML103"><strong>CML103</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/CML228"><strong>CML228</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/CML247"><strong>CML247</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/CML277"><strong>CML277</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/CML322"><strong>CML322</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/CML333"><strong>CML333</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/CML052"><strong>CML52</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/CML069"><strong>CML69</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/Hp301"><strong>Hp301</strong><span>Popcorn</span></a>
      <a href="/data_center/stock/Il14H"><strong>Il14H</strong><span>Sweet Corn</span></a>
      <a href="/data_center/stock/Ki11"><strong>Ki11</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/Ki3"><strong>Ki3</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/Ky21"><strong>Ky21</strong><span>Non-Stiff Stalk</span></a>
      <a href="/data_center/stock/M162W"><strong>M162W</strong><span>White Corn</span></a>
      <a href="/data_center/stock/M37W"><strong>M37W</strong><span>White Corn</span></a>
      <a href="/data_center/stock/Mo17"><strong>Mo17</strong><span>Non-Stiff Stalk</span></a>
      <a href="/data_center/stock/Mo18W"><strong>Mo18W</strong><span>White Corn</span></a>
      <a href="/data_center/stock/MS71"><strong>MS71</strong><span>Non-Stiff Stalk</span></a>
      <a href="/data_center/stock/NC350"><strong>NC350</strong><span>Tropical Highland</span></a>
      <a href="/data_center/stock/NC358"><strong>NC358</strong><span>Tropical Highland</span></a>
      <a href="/data_center/stock/Oh43"><strong>Oh43</strong><span>Non-Stiff Stalk</span></a>
      <a href="/data_center/stock/Oh7B"><strong>Oh7B</strong><span>Non-Stiff Stalk</span></a>
      <a href="/data_center/stock/P39"><strong>P39</strong><span>Sweet Corn</span></a>
      <a href="/data_center/stock/Tx303"><strong>Tx303</strong><span>Tropical Lowland</span></a>
      <a href="/data_center/stock/Tzi8"><strong>Tzi8</strong><span>Tropical Lowland</span></a>
    </div>
  </section>

  <section id="stock-downloads" aria-labelledby="stock-downloads-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="stock-downloads-title">Downloads</h2>
      </div>
    </div>

    <div class="stock-download-grid" aria-label="Stock downloads">
      <article class="stock-download-card">
        <div class="stock-download-header">
          <span class="mgdb-pill mgdb-pill-ok">Full TSV</span>
          <h3>Tabulated Stock Catalog</h3>
        </div>
        <p>Complete curated stock catalog with stock identifiers, types, providers, variations, phenotypes, and pedigree links in TSV format.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/search/stock/stock_search_api.php?format=tsv">Download Full TSV <span aria-hidden="true">&darr;</span></a>
      </article>

      <article class="stock-download-card">
        <div class="stock-download-header">
          <span class="mgdb-pill mgdb-pill-info">CSV Export</span>
          <h3>Tabulated Stock CSV</h3>
        </div>
        <p>Comma-separated export of curated stock records, providers, and annotations suitable for Excel, Python, and R workflows.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/search/stock/stock_search_api.php?format=csv">Download Full CSV <span aria-hidden="true">&darr;</span></a>
      </article>

      <article class="stock-download-card">
        <div class="stock-download-header">
          <span class="mgdb-pill mgdb-pill-warn">Flow Cytometry</span>
          <h3>Genome Size Measurements</h3>
        </div>
        <p>Flow cytometry nuclear 2C DNA content and genome size measurements for selected maize inbred lines and landraces.</p>
        <a class="mgdb-button mgdb-button-secondary" href="https\://iastate.app.box.com/v/maizegdb-public/file/1876142430468" target="_blank" rel="noopener">Download Flow Cytometry <span aria-hidden="true">&nearr;</span></a>
      </article>
    </div>
  </section>

  <section id="stock-references" aria-labelledby="stock-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="stock-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <section id="stock-metrics" aria-labelledby="stock-metrics-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="stock-metrics-title">Metrics</h2>
      </div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Curated Stocks</h3>
          <span class="mgdb-metric-badge">Germplasm</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_active)</strong>
        </div>
        <p class="mgdb-metric-description">Active curated records; $(metric_with_provider) have an assigned provider.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>Stock Types</h3>
          <span class="mgdb-metric-badge">Types</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_types)</strong>
        </div>
        <p class="mgdb-metric-description">From inbred lines to TILLING and chromosome marker stocks.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>Providers &amp; Centers</h3>
          <span class="mgdb-metric-badge">Centers</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_providers)</strong>
        </div>
        <p class="mgdb-metric-description">Stock centers, germplasm banks, and research programs.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>GRIN Accessions</h3>
          <span class="mgdb-metric-badge">USDA GRIN</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_grin)</strong>
        </div>
        <p class="mgdb-metric-description">USDA germplasm records mirrored and searched at MaizeGDB.</p>
      </article>
    </div>

    <div class="stock-chart-panel">
      <figure class="mgdb-figure mgdb-stock-figure-wide">
        <h3>Largest stock categories</h3>
        <p>Current stock records by curated stock type.</p>
        <div class="mgdb-chart" id="stock-type-chart" role="img"
             aria-label="Bar chart of the number of current stock records in each of the largest curated stock types"
             data-labels="$(chart_labels)" data-values="$(chart_values)">
          <div class="mgdb-chart-fallback">Loading the category breakdown&hellip;</div>
        </div>
        <figcaption>$(chart_caption)</figcaption>
        <details class="mgdb-chart-data">
          <summary>Show the values as a table</summary>
          <div class="mgdb-table-scroll">
            <table class="mgdb-table">
              <thead><tr><th scope="col">Stock type</th><th scope="col" class="mgdb-numeric">Current records</th></tr></thead>
              <tbody id="stock-type-rows"></tbody>
            </table>
          </div>
        </details>
      </figure>
    </div>
  </section>

  <section id="stock-related" class="mgdb-hub-related" aria-labelledby="stock-related-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="stock-related-title">Related resources</h2>
      </div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="https\://maizecoopsc.org/" target="_blank" rel="noopener">
          <strong>Maize Genetics Cooperation Stock Center</strong>
          <span>Order seed stocks, mutant alleles, and chromosome translocation lines</span>
        </a>
        <a href="/data_center/variation">
          <strong>Variations &amp; Alleles Data Hub</strong>
          <span>Over 1.7 million curated variations, gene mutations, and allele descriptors</span>
        </a>
        <a href="/data_center/phenotype">
          <strong>Phenotype Data Hub</strong>
          <span>Curated observable traits, anatomical mutant profiles, and Plant Ontology terms</span>
        </a>
        <a href="/genome">
          <strong>Genome Data Hub</strong>
          <span>160 hosted genome assemblies across 31 maize and wild relative species</span>
        </a>
        <a href="/ai">
          <strong>AI &amp; Machine Learning Data Hub</strong>
          <span>Machine-learning feature stores, ESM protein scores, and predicted structures</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
