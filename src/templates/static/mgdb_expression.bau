$$SYNTAX-LEVEL 2
*(mgdb-expression
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/expression">
<meta property="og:title" content="MaizeGDB Expression Data Hub">
<meta property="og:description" content="Search maize gene expression across the B73 reference assemblies and the NAM founder lines, open a per-gene expression profile, and reach qTeller, the eFP browser, JBrowse RNA-seq tracks and the bulk downloads.">

<main class="mgdb-page mgdb-arrows-v2 mgdb-hub-page mgdb-expression-page" id="expression-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Expression Data Hub</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="expression-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/quicklinks/gene_expression.png" alt="" width="192" height="150" decoding="async" />
      <strong>Expression<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="expression-title">Maize gene expression and RNA-seq transcriptomics</h1>
      <p class="mgdb-hero-description">Expression for gene models across $(release_count) assemblies, including the $(nam_count) NAM founder inbred lines.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#expression-search" class="is-current" aria-current="true">Search</a>
    <a href="#expression-tools">Tools</a>
    <a href="#expression-releases">Releases</a>
    <a href="#expression-downloads">Downloads</a>
    <a href="#expression-references">References</a>
    <a href="#expression-metrics">Metrics</a>
    <a href="#expression-related">Related resources</a>
  </nav>

  <!-- ── Search ───────────────────────────────────────────────────────────── -->
  <section id="expression-search" aria-labelledby="expression-search-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-search-title">Search</h2></div>
    </div>

    <form id="expression-search-form" class="expression-search" role="search">
      <div class="expression-query-row">
        <div class="expression-query-field">
          <label class="mgdb-visually-hidden" for="expression-query">Search expression</label>
          <div class="expression-query-control">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input id="expression-query" data-suggest="gene" name="term" type="search" placeholder="Gene model ID, locus symbol, or gene name" autocomplete="off" aria-describedby="expression-query-hint" />
            <button id="expression-query-clear" type="button" hidden>Clear</button>
          </div>
        </div>
        <button class="mgdb-button mgdb-button-primary expression-query-submit" type="submit">Search expression</button>
      </div>

      <p class="mgdb-hint" id="expression-query-hint">Enter a gene model ID \(e.g., <code>Zm00001eb056510</code>\) or locus symbol \(e.g., <code>adh1</code>\) to find its models across assemblies, then open a model&#8217;s expression profile from the results. Wildcard <code>*</code> is supported \(e.g., <code>adh*</code>\).</p>

      <div class="expression-examples" aria-label="Example searches">
        <span>EXAMPLES&#58;</span>
        <button type="button" data-expression-example="adh1">adh1</button>
        <button type="button" data-expression-example="tb1">tb1</button>
        <button type="button" data-expression-example="kn1">kn1</button>
        <button type="button" data-expression-example="bz1">bz1</button>
        <button type="button" data-expression-example="o2">o2</button>
        <button type="button" data-expression-example="mybr4">mybr4</button>
        <button type="button" data-expression-example="Zm00001eb056510">Zm00001eb056510</button>
        <button type="button" data-expression-example="Zm00026ab084980">Zm00026ab084980</button>
        <button type="button" data-expression-example="adh*">adh*</button>
      </div>

      <details class="expression-advanced" id="expression-adv">
        <summary>
          <span class="expression-advanced-label">Advanced search</span>
        </summary>
        <div class="expression-advanced-body">
          <div class="expression-advanced-grid">
            <div class="mgdb-hub-field">
              <label for="expression-filter-assembly">Reference assembly</label>
              <select id="expression-filter-assembly" name="assembly">
                $(assembly_options)
              </select>
            </div>
            <div class="mgdb-hub-field">
              <label for="expression-adv-sort">Sort results by</label>
              <select id="expression-adv-sort" name="sort">
                <option value="">Best match</option>
                <option value="gene_name-asc">Gene model A&ndash;Z</option>
                <option value="gene_name-desc">Gene model Z&ndash;A</option>
                <option value="locus_name-asc">Locus symbol A&ndash;Z</option>
                <option value="locus_name-desc">Locus symbol Z&ndash;A</option>
                <option value="assembly_version-asc">Assembly version A&ndash;Z</option>
                <option value="assembly_version-desc">Assembly version Z&ndash;A</option>
                <option value="coordinates-asc">Coordinates \(Chr &amp; Position\)</option>
              </select>
            </div>
            <div class="mgdb-hub-field expression-check-field">
              <label class="expression-check" for="expression-expression-only">
                <input id="expression-expression-only" name="expression_only" type="checkbox" value="1" />
                <span>Only assemblies with expression profiles</span>
              </label>
              <span class="mgdb-hint">The $(release_count) assemblies qTeller has data for; leave off to see every gene model.</span>
            </div>
          </div>

          <div class="expression-advanced-actions">
            <button class="mgdb-button mgdb-button-primary" type="submit">Apply filters</button>
            <button class="expression-advanced-reset-btn" id="expression-adv-reset" type="button">Reset filters</button>
          </div>
        </div>
      </details>
    </form>
  </section>

  <!-- ── Search results: hidden until a search runs ───────────────────────── -->
  <section id="expression-results-section" aria-labelledby="expression-results-title" hidden>
    <div class="mgdb-section-heading">
      <div><h2 id="expression-results-title">Results</h2></div>
    </div>

    <p class="expression-results-status" id="expression-results-status" role="status" aria-live="polite">Searching gene models&hellip;</p>

    <div class="expression-results-toolbar">
      <div class="mgdb-hub-field expression-results-filter">
        <label for="expression-results-filter">Filter these results</label>
        <input id="expression-results-filter" type="search" autocomplete="off" placeholder="Gene model, locus, assembly, coordinates" />
        <span class="mgdb-result-count" id="expression-filter-count" aria-live="polite"></span>
      </div>

      <div class="mgdb-hub-field">
        <label for="expression-page-size">Results shown</label>
        <select id="expression-page-size">
          <option value="10">Top 10</option>
          <option value="25" selected>Top 25</option>
          <option value="50">Top 50</option>
          <option value="all">All results</option>
        </select>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action expression-results-export">
        <a class="mgdb-button mgdb-button-secondary" id="expression-export-tsv" href="#" download>Export TSV</a>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action expression-results-view">
        <div class="mgdb-view-toggle" role="group" aria-label="Result view">
          <button class="mgdb-view-btn" id="expression-view-cards" type="button" data-view="cards" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"/></svg>Cards
          </button>
          <button class="mgdb-view-btn is-active" id="expression-view-table" type="button" data-view="table" aria-pressed="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="7" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="12" width="14" height="2" rx="1" fill="currentColor"/></svg>Table
          </button>
        </div>
      </div>
    </div>

    <div class="mgdb-table-scroll" id="expression-table-scroll" tabindex="0" role="region" aria-labelledby="expression-results-title">
      <table class="mgdb-table expression-results-table" id="expression-results-table">
        <thead>
          <tr>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="gene_name">Gene model</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="locus_name">Locus</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="assembly_version">Assembly</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="coordinates">Coordinates</button></th>
            <th scope="col" class="expression-col-open">Expression</th>
          </tr>
        </thead>
        <tbody id="expression-results-body"></tbody>
      </table>
    </div>

    <div class="expression-card-grid" id="expression-cards-view" hidden></div>

    <div class="mgdb-empty" id="expression-results-empty" hidden>
      <h3>No gene models matched that search</h3>
      <p>Try a locus symbol such as <code>adh1</code>, a v5 gene model such as <code>Zm00001eb056510</code>, or clear the assembly filter.</p>
      <button class="mgdb-button mgdb-button-secondary" id="expression-empty-reset" type="button">Clear search and filters</button>
    </div>

    <nav class="expression-pagination" id="expression-pagination" aria-label="Search result pages"></nav>
  </section>

  <!-- ── Expression profile: hidden until a result is opened ─────────────── -->
  <section id="expression-profile" aria-labelledby="expression-profile-title" hidden>
    <div class="mgdb-section-heading">
      <div><h2 id="expression-profile-title">Expression profile</h2></div>
      <button class="expression-profile-close" id="expression-profile-close" type="button">Close</button>
    </div>

    <div class="expression-profile-head" id="expression-profile-head"></div>
    <p class="expression-profile-status" id="expression-profile-status" role="status" aria-live="polite" hidden></p>
    <div class="expression-profile-figure" id="expression-profile-figure"></div>
  </section>

  <!-- ── Tools ────────────────────────────────────────────────────────────── -->
  <section id="expression-tools" aria-labelledby="expression-tools-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-tools-title">Expression tools</h2></div>
    </div>
    <div class="mgdb-card-grid expression-tools-grid">
          <!-- MaizeGDB's own analysis application over these releases, so it
               leads, across the full row: the six cards below stay two even
               rows of three. -->
          <article class="mgdb-card expression-tool-card expression-tool-card-wide">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/><circle cx="7" cy="15" r="1"/><circle cx="11" cy="11" r="1"/><circle cx="14" cy="14" r="1"/><circle cx="19" cy="8" r="1"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title"><a href="/expression/tools">Expression Tools</a></h3>
                <span class="expression-tool-badge">B73 v5 &bull; B73 v4 &bull; 26 NAM genomes &bull; Pan-genes</span>
              </div>
            </div>
            <p class="expression-tool-desc">Analyze the releases this hub reads: a report for any gene, genome-wide co-expression, tissue-specific genes, sample comparisons and maps, and GO enrichment for any gene list. For the pan-genome, every copy of a pan-gene compared across the 26 NAM genomes in the 23 samples they share, and the pan-genes a genome carries but does not express.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="/expression/tools">Open Expression Tools</a>
              <a class="expression-link" href="/expression/tools#gene?id=tb1">Gene report</a>
              <a class="expression-link" href="/expression/tools#coexp?id=tb1">Co-expression</a>
              <a class="expression-link" href="/expression/tools#specific">Tissue-specific genes</a>
              <a class="expression-link" href="/expression/tools#landscape">Presence and expression</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">FETA Functional Enrichment</h3>
                <span class="expression-tool-badge">B73 &bull; 26 NAM Proteomes &bull; DEGs</span>
              </div>
            </div>
            <p class="expression-tool-desc">Functional Enrichment Term Analysis \(FETA\) is a one-stop web platform to perform multiple, simultaneous enrichments across GO terms, biological pathways \(KEGG, Reactome\), protein domains, subcellular and single-cell distributions, gene families, and agronomic traits in B73 and 26 NAM founder proteomes. Complements transcriptomics pipelines \(DESeq2, edgeR, limma\) for visualizing differentially expressed genes \(DEGs\) and performing direct functional enrichments with table, PNG, and SVG exports.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://feta.maizegdb.org/" target="_blank" rel="noopener">Launch FETA Platform</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">qTeller Comparative Expression</h3>
                <span class="expression-tool-badge">B73v5 &bull; B73v4 &bull; 26 NAM Lines</span>
              </div>
            </div>
            <p class="expression-tool-desc">Compare and visualize normalized RNA-seq expression across maize developmental tissues, inbred lines, and abiotic and biotic stress treatments.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://qteller.maizegdb.org/index_B73v5.php" target="_blank" rel="noopener">qTeller B73v5</a>
              <a class="expression-link" href="https://qteller.maizegdb.org/index_B73v4.php" target="_blank" rel="noopener">qTeller B73v4</a>
              <a class="expression-link" href="https://qteller.maizegdb.org/index_NAM.php" target="_blank" rel="noopener">qTeller NAM Founders</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">Maize eFP Pictograph Browser</h3>
              </div>
            </div>
            <p class="expression-tool-desc">The electronic Fluorescent Pictograph \(eFP\) Browser projects gene expression levels onto anatomically accurate maize pictographs across developmental tissues and abiotic/biotic conditions.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://bar.utoronto.ca/efp_maize/cgi-bin/efpWeb.cgi" target="_blank" rel="noopener">Launch eFP Browser</a>
              <a class="expression-link" href="https://bar.utoronto.ca/eplant_maize/" target="_blank" rel="noopener">ePlant Maize</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">JBrowse &amp; GBrowse RNA-seq Tracks</h3>
              </div>
            </div>
            <p class="expression-tool-desc">Visualize aligned RNA-seq read bigwig files directly mapped onto genome coordinates in JBrowse and GBrowse.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://jbrowse.maizegdb.org/?data=B73&tracks=gene_models_official,16dap_embryo_mn01101,16dap_endosperm_mn01091,8das_root_mn01011,8das_shoot_mn01021,r1_anther_mn01081,v11_base_mn01031,v11_middle_mn01041,v11_tip_mn01051,v18_ear_mn01071,v18_tassel_mn01061" target="_blank" rel="noopener">JBrowse B73v5 RNA-seq</a>
              <a class="expression-link" href="https://gbrowse.maizegdb.org/gb2/gbrowse/maize_v4/" target="_blank" rel="noopener">GBrowse B73v4</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4zM4 10h16M10 4v16"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">Expression API</h3>
                <span class="expression-tool-badge">JSON &bull; TSV &bull; $(release_count) releases</span>
              </div>
            </div>
            <p class="expression-tool-desc">The profiles behind this page, one request per gene or up to 200 genes at a time: every sample value with its study, tissue reading and stress condition, plus the mean, median, maximum and tissue specificity per assay.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="/api#api-datasets">API documentation</a>
              <a class="expression-link" href="/api/v1/data/expression">Releases \(JSON\)</a>
              <a class="expression-link" href="/api/v1/data/expression/Zm-B73-REFERENCE-NAM-5.0/Zm00001eb093920">Example gene</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">External Expression Repositories</h3>
                <span class="expression-tool-badge">NCBI GEO &bull; SRA</span>
              </div>
            </div>
            <p class="expression-tool-desc">Query and retrieve primary raw sequencing read archives \(FASTQ/SRA\) and microarray series matrices for all published <em>Zea mays</em> transcriptomic studies at NCBI.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://www.ncbi.nlm.nih.gov/gds/?term=zea+mays[ORGN]" target="_blank" rel="noopener">NCBI GEO DataSets</a>
              <a class="expression-link" href="https://www.ncbi.nlm.nih.gov/sra/?term=zea+mays" target="_blank" rel="noopener">NCBI SRA Runs</a>
            </div>
          </article>
        </div>
  </section>

  <!-- ── Releases ─────────────────────────────────────────────────────────── -->
  <section id="expression-releases" aria-labelledby="expression-releases-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-releases-title">Expression releases</h2></div>
    </div>
    <p class="expression-section-intro">One release per assembly, built from qTeller&#8217;s own data files \(release <code>$(b73_release)</code>\). Genes are the models with a profile; a sample is one tissue, stage or treatment with its replicates averaged. The B73 v5 release also carries the Walley 2019 proteomics samples. <strong>Search</strong> lists the assembly&#8217;s gene models above.</p>
    <div class="mgdb-table-scroll" tabindex="0" role="region" aria-labelledby="expression-releases-title">
      <table class="mgdb-table expression-releases-table">
        <thead>
          <tr>
            <th scope="col">Assembly</th>
            <th scope="col">Annotation</th>
            <th scope="col" class="mgdb-num">Genes</th>
            <th scope="col" class="mgdb-num">RNA samples</th>
            <th scope="col" class="mgdb-num">Protein samples</th>
            <th scope="col" class="mgdb-num">Studies</th>
            <th scope="col">Open</th>
          </tr>
        </thead>
        <tbody>
          $(release_rows)
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── Downloads ────────────────────────────────────────────────────────── -->
  <section id="expression-downloads" aria-labelledby="expression-downloads-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-downloads-title">Downloads</h2></div>
      <a class="expression-section-link" href="/download">All MaizeGDB downloads</a>
    </div>
    <div class="mgdb-card-grid expression-downloads-grid">
          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">qTeller FPKM matrices</h3>
              <p class="expression-dl-desc">The normalized expression tables qTeller is built from, for Zm-B73-REFERENCE-NAM-5.0, Zm-B73-REFERENCE-GRAMENE-4.0 and the NAM founder lines, in the MaizeGDB Box share.</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/362581633349" target="_blank" rel="noopener">Open qTeller_FPKM_MaizeGDB</a>
            </div>
          </article>

          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">B73 v5 RNA-seq alignments</h3>
              <p class="expression-dl-desc">The RNA-seq files behind the Zm-B73-REFERENCE-NAM-5.0 JBrowse tracks, in the Box folder <code>B73v5_JBROWSE_AND_ANALYSES/B73v5_RNA-seq</code>.</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/362581614626" target="_blank" rel="noopener">Open B73v5_RNA-seq</a>
            </div>
          </article>

          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">eFP data for B73 v5</h3>
              <p class="expression-dl-desc">The expression tables supplied to the BAR for the B73 v5 eFP pictographs.</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/362582432633" target="_blank" rel="noopener">Open eFP_data_B73v5</a>
            </div>
          </article>

          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">Developmental atlas tables</h3>
              <p class="expression-dl-desc">The Walley et al. developmental atlas FPKM table on the MaizeGDB download host, mapped to B73 RefGen_v3 and to Zm-B73-REFERENCE-GRAMENE-4.0, with a README beside each.</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://download.maizegdb.org/GeneFunction_and_Expression/Sekon_expression_atlas/" target="_blank" rel="noopener">Browse the directory</a>
            </div>
          </article>

          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4zM4 10h16M10 4v16"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">Per-gene tables from the API</h3>
              <p class="expression-dl-desc">Every sample value for one gene as TSV, or for up to 200 genes in one request, and the sample catalogue of each release. No account and no rate key needed.</p>
              <div class="expression-dl-links">
                <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="/api/v1/data/expression/Zm-B73-REFERENCE-NAM-5.0/Zm00001eb093920?format=tsv">Example gene TSV</a>
                <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="/api/v1/data/expression/Zm-B73-REFERENCE-NAM-5.0/batch?ids=Zm00001eb093920,Zm00001eb056510&amp;format=tsv">Example batch TSV</a>
                <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="/api/v1/data/expression/Zm-B73-REFERENCE-NAM-5.0/samples?format=tsv">B73 v5 samples</a>
              </div>
            </div>
          </article>
        </div>
  </section>

  <!-- ── References ───────────────────────────────────────────────────────── -->
  <section id="expression-references" aria-labelledby="expression-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <!-- ── Metrics ──────────────────────────────────────────────────────────── -->
  <section id="expression-metrics" aria-labelledby="expression-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Assemblies with expression</h3>
          <span class="mgdb-metric-badge">Releases</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(release_count)</strong>
        </div>
        <p class="mgdb-metric-description">Genomes with a qTeller expression release&#58; the B73 v5 and v4 references and the NAM founder inbred lines.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>Genes profiled</h3>
          <span class="mgdb-metric-badge">B73 v5</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(b73_genes)</strong>
        </div>
        <p class="mgdb-metric-description">B73 v5 gene models with an expression profile; $(b73_detected) reach 1 FPKM or TPM in at least one RNA-seq sample.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>Samples</h3>
          <span class="mgdb-metric-badge">B73 v5</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(b73_samples)</strong>
        </div>
        <p class="mgdb-metric-description">$(b73_samples_rna) RNA-seq and $(b73_samples_protein) proteomics samples in the B73 v5 release, replicates averaged; $(total_samples) across all releases.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>Studies</h3>
          <span class="mgdb-metric-badge">B73 v5</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(b73_sources)</strong>
        </div>
        <p class="mgdb-metric-description">Published data sets behind the B73 v5 profiles; $(b73_stress) of them are stress-response studies with abiotic or biotic treatments.</p>
      </article>
    </div>

    <figure class="mgdb-figure expression-figure">
      <h3>B73 v5 samples by tissue reading</h3>
      <div class="mgdb-chart" id="expression-tissue-chart" role="img"
           aria-label="Horizontal stacked bar chart of the samples in the B73 v5 expression release for each tissue reading, split into RNA-seq samples from non-stress studies, abiotic stress, biotic stress and control samples from stress studies, and proteomics samples"
           data-labels="$(tissue_labels)" data-other="$(tissue_other)" data-abiotic="$(tissue_abiotic)" data-biotic="$(tissue_biotic)" data-control="$(tissue_control)" data-protein="$(tissue_protein)">
        <div class="mgdb-chart-fallback">Loading the sample breakdown&hellip;</div>
      </div>
      <figcaption>The tissue is a keyword reading of each sample label, kept beside the label it was read from&#58; a convenience for summaries, not an ontology term. Samples that name a treatment rather than an organ read as &#8220;other&#8221;. The stress condition is read the same way, inside stress-response studies only&#58; abiotic stress, biotic stress, or that study&#8217;s untreated control. RNA-seq samples from the other studies carry no condition.</figcaption>
    </figure>
    <div class="mgdb-table-scroll expression-figure-table">
      <table class="mgdb-table" id="expression-tissue-table">
        <caption class="mgdb-visually-hidden">Samples per tissue reading in the B73 v5 release, by assay and stress condition</caption>
        <thead>
          <tr>
            <th scope="col">Tissue reading</th>
            <th scope="col" class="mgdb-num">RNA-seq</th>
            <th scope="col" class="mgdb-num">Abiotic stress</th>
            <th scope="col" class="mgdb-num">Biotic stress</th>
            <th scope="col" class="mgdb-num">Control</th>
            <th scope="col" class="mgdb-num">Proteomics</th>
            <th scope="col" class="mgdb-num">Samples</th>
          </tr>
        </thead>
        <tbody>
          $(tissue_rows)
        </tbody>
        <tfoot>
          $(tissue_total)
        </tfoot>
      </table>
    </div>
  </section>

  <!-- ── Related resources ────────────────────────────────────────────────── -->
  <section id="expression-related" class="mgdb-hub-related" aria-labelledby="expression-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>Reference gene models, functional descriptions, and the same expression profile on every gene record</span>
        </a>
        <a href="/pan_gene_center/pan_gene">
          <strong>Pan-Gene Data Hub</strong>
          <span>Syntenic pan-gene clusters across the NAM founder lines the atlases above are built from</span>
        </a>
        <a href="/genome">
          <strong>Genome Data Hub</strong>
          <span>The assemblies these gene models are called against, with browsers and sequence files</span>
        </a>
        <a href="/data_center/phenotype">
          <strong>Phenotype Data Hub</strong>
          <span>Curated mutant phenotypes and trait ontology terms for the loci in these results</span>
        </a>
        <a href="https://qteller.maizegdb.org/" target="_blank" rel="noopener">
          <strong>qTeller</strong>
          <span>Compare and visualize normalized RNA-seq expression across tissues, inbred lines, and stress treatments</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
