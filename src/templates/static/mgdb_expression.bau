$$SYNTAX-LEVEL 2
*(mgdb-expression
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/expression">
<meta property="og:title" content="MaizeGDB Expression Data Hub">
<meta property="og:description" content="Search maize gene expression across reference assemblies and NAM founder lines, and reach qTeller, the eFP browser, JBrowse RNA-seq tracks, and bulk FPKM downloads.">

<main class="mgdb-page mgdb-hub-page mgdb-expression-page" id="expression-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Expression Data Hub</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="expression-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="Gene expression and RNA-seq icon">
        <rect x="18" y="20" width="16" height="12" rx="3" fill="#e8f4ec" stroke="#235c37" stroke-width="2" />
        <rect x="40" y="20" width="16" height="12" rx="3" fill="#235c37" />
        <rect x="62" y="20" width="16" height="12" rx="3" fill="#d99a0b" stroke="#7a4a10" stroke-width="2" />
        <rect x="18" y="38" width="16" height="12" rx="3" fill="#d99a0b" stroke="#7a4a10" stroke-width="2" />
        <rect x="40" y="38" width="16" height="12" rx="3" fill="#e8f4ec" stroke="#235c37" stroke-width="2" />
        <rect x="62" y="38" width="16" height="12" rx="3" fill="#235c37" />
        <path d="M14 74 C 24 74, 30 54, 42 54 C 54 54, 60 76, 72 76 C 78 76, 82 68, 86 64" fill="none" stroke="#235c37" stroke-width="4" stroke-linecap="round" />
        <circle cx="42" cy="54" r="4" fill="#d99a0b" stroke="#7a4a10" stroke-width="2" />
        <circle cx="72" cy="76" r="4" fill="#235c37" />
      </svg>
      <strong>Expression<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; August 2026</p>
      <h1 id="expression-title">Maize gene expression and RNA-seq transcriptomics</h1>
      <p class="mgdb-hero-description">Expression for $(total_gene_models) gene models across $(assembly_count) assemblies, including the $(nam_lines) NAM founder inbred lines and $(distinct_tissues) developmental tissues.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#expression-search" class="is-current" aria-current="true">Search</a>
    <a href="#expression-tools">Tools</a>
    <a href="#expression-atlases">Atlases</a>
    <a href="#expression-downloads">Downloads</a>
    <a href="#expression-references">References</a>
    <a href="#expression-metrics">Metrics</a>
    <a href="#expression-related">Related resources</a>
  </nav>

  <!-- ── Search ───────────────────────────────────────────────────────────── -->
  <section id="expression-search" aria-labelledby="expression-search-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-search-title">Search</h2></div>
    </div>

    <form id="expression-search-form" class="expression-search-form" role="search">
      <div class="mgdb-hub-field expression-field-query">
        <label for="expression-query">Gene model or locus symbol</label>
        <div class="expression-query-control">
          <svg class="expression-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
          <input id="expression-query" name="term" type="search" placeholder="Gene model ID or locus symbol" autocomplete="off" />
          <button id="expression-query-clear" type="button" hidden>Clear</button>
        </div>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action">
        <button class="mgdb-button mgdb-button-primary" type="submit">Search expression</button>
      </div>

      <div class="expression-example-row" aria-label="Example searches">
        <span>Examples&#58;</span>
        <button type="button" data-expression-example="adh1">adh1</button>
        <button type="button" data-expression-example="tb1">tb1</button>
        <button type="button" data-expression-example="kn1">kn1</button>
        <button type="button" data-expression-example="bz1">bz1</button>
        <button type="button" data-expression-example="o2">o2</button>
        <button type="button" data-expression-example="Zm00001eb056510">Zm00001eb056510</button>
        <button type="button" data-expression-example="GRMZM2G442658">GRMZM2G442658</button>
      </div>

      <details class="expression-adv" id="expression-adv">
        <summary>
          <strong>Advanced search criteria</strong>
          <span>Restrict the lookup to one reference assembly or pan-genome</span>
        </summary>
        <div class="expression-adv-body">
          <div class="mgdb-hub-field">
            <label for="expression-filter-assembly">Reference assembly or pan-genome</label>
            <select id="expression-filter-assembly" name="assembly">
              $(assembly_options)
            </select>
          </div>
        </div>

        <div class="expression-adv-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit">Apply advanced filters</button>
          <button class="mgdb-button mgdb-button-quiet" id="expression-adv-reset" type="button">Reset advanced filters</button>
        </div>
      </details>
    </form>
  </section>

  <!-- ── Search results: hidden until a search runs ───────────────────────── -->
  <section id="expression-results-section" class="expression-results-section" aria-labelledby="expression-results-title" hidden>
    <div class="expression-results-heading">
      <div>
        <h2 id="expression-results-title">Search results</h2>
        <p id="expression-results-status" role="status" aria-live="polite"></p>
      </div>
      <div class="expression-results-controls">
        <div class="mgdb-hub-field">
          <label for="expression-results-filter">Filter results</label>
          <input id="expression-results-filter" type="search" placeholder="Narrow this table" autocomplete="off" />
        </div>
        <div class="mgdb-hub-field">
          <label for="expression-page-size">Results per page</label>
          <select id="expression-page-size">
            <option value="10">Top 10</option>
            <option value="25" selected>Top 25</option>
            <option value="50">Top 50</option>
            <option value="all">All results</option>
          </select>
        </div>
        <div class="mgdb-hub-field mgdb-hub-field-action">
          <a class="mgdb-button mgdb-button-quiet" id="expression-export" href="#" download>Export TSV</a>
        </div>
      </div>
    </div>

    <div class="mgdb-table-scroll">
      <table class="mgdb-table expression-results-table" id="expression-results-table">
        <caption>
          Matching gene models
          <span class="mgdb-muted">Sort any column by activating its header. Each row opens in qTeller, the Gene Center, JBrowse, or the eFP browser.</span>
        </caption>
        <thead>
          <tr>
            <th scope="col" data-expression-sort="gene_name" aria-sort="none"><button type="button">Gene model</button></th>
            <th scope="col" data-expression-sort="locus_name" aria-sort="none"><button type="button">Locus</button></th>
            <th scope="col" data-expression-sort="assembly_version" aria-sort="none"><button type="button">Assembly</button></th>
            <th scope="col" data-expression-sort="coordinates" aria-sort="none"><button type="button">Coordinates</button></th>
            <th scope="col" class="expression-col-open">Open</th>
          </tr>
        </thead>
        <tbody id="expression-results-body"></tbody>
      </table>
    </div>

    <div class="mgdb-empty" id="expression-results-empty" hidden>
      <h3>No gene models matched that search</h3>
      <p>Try a locus symbol such as <code>adh1</code>, a v5 gene model such as <code>Zm00001eb056510</code>, or clear the assembly filter.</p>
      <button class="mgdb-button mgdb-button-secondary" id="expression-empty-reset" type="button">Reset search</button>
    </div>

    <nav class="expression-pagination" id="expression-pagination" aria-label="Search result pages"></nav>
  </section>

  <!-- ── Tools ────────────────────────────────────────────────────────────── -->
  <section id="expression-tools" aria-labelledby="expression-tools-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-tools-title">Expression tools</h2></div>
    </div>
    <div class="mgdb-card-grid expression-tools-grid">
          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">FETA Functional Enrichment</h3>
                <span class="expression-tool-badge">B73 &bull; 26 NAM Proteomes &bull; DEGs</span>
              </div>
            </div>
            <p class="expression-tool-desc">Functional Enrichment Term Analysis \(FETA\) is a one-stop web platform to perform multiple, simultaneous enrichments across GO terms, biological pathways \(KEGG, Reactome\), protein domains, subcellular and single-cell distributions, gene families, and agronomic traits in B73 and 26 NAM founder proteomes. Complements transcriptomics pipelines \(DESeq2, edgeR, limma\) for visualizing differentially expressed genes \(DEGs\) and performing direct functional enrichments with table, PNG, and SVG exports.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://feta.maizegdb.org/" target="_blank" rel="noopener">Launch FETA Platform</a>
              <a class="expression-link" href="https://feta.maizegdb.org/" target="_blank" rel="noopener">DEG &amp; Enrichment Tools</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">qTeller Comparative Expression</h3>
                <span class="expression-tool-badge">B73v5 &bull; B73v4 &bull; 26 NAM Lines</span>
              </div>
            </div>
            <p class="expression-tool-desc">Compare normalized RNA-seq expression across maize developmental tissues, inbred lines, and abiotic stress treatments \(heat, drought, cold\). Provides interactive bar charts and FPKM matrices.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://qteller.maizegdb.org/index_B73v5.php" target="_blank" rel="noopener">qTeller B73v5</a>
              <a class="expression-link" href="https://qteller.maizegdb.org/index_B73v4.php" target="_blank" rel="noopener">qTeller B73v4</a>
              <a class="expression-link" href="https://qteller.maizegdb.org/index_NAM.php" target="_blank" rel="noopener">qTeller NAM Founders</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">Maize eFP Pictograph Browser</h3>
                <span class="expression-tool-badge">60 Developmental Tissues</span>
              </div>
            </div>
            <p class="expression-tool-desc">The electronic Fluorescent Pictograph \(eFP\) Browser projects gene expression levels onto anatomically accurate plant pictographs across 60 developmental tissues as reported by Sekhon et al. \(2011\).</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="http://bar.utoronto.ca/efp_maize/cgi-bin/efpWeb.cgi?dataSource=Sekhon_et_al_Atlas" target="_blank" rel="noopener">Launch eFP Browser</a>
              <a class="expression-link" href="https://doi.org/10.1111/j.1365-313X.2011.04527.x" target="_blank" rel="noopener">Sekhon et al. Paper</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">JBrowse &amp; GBrowse RNA-seq Tracks</h3>
                <span class="expression-tool-badge">Read Depth &bull; Splice Junctions</span>
              </div>
            </div>
            <p class="expression-tool-desc">Visualize aligned RNA-seq read depths, exon coverage, and novel transcript splice junctions directly mapped onto reference chromosomes in JBrowse and GBrowse.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://jbrowse.maizegdb.org/?data=data%2FZm-B73-REFERENCE-NAM-5.0&tracks=RNA-seq" target="_blank" rel="noopener">JBrowse B73v5 RNA-seq</a>
              <a class="expression-link" href="https://www.maizegdb.org/gbrowse/maize_v4" target="_blank" rel="noopener">GBrowse B73v4</a>
            </div>
          </article>

          <article class="mgdb-card expression-tool-card">
            <div class="expression-tool-header">
              <div class="expression-tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
              </div>
              <div>
                <h3 class="expression-tool-title">External Expression Repositories</h3>
                <span class="expression-tool-badge">NCBI GEO &bull; SRA</span>
              </div>
            </div>
            <p class="expression-tool-desc">Query and retrieve primary raw sequencing read archives \(FASTQ/SRA\) and microarray series matrices for all published *Zea mays* transcriptomic studies at NCBI.</p>
            <div class="expression-tool-links">
              <a class="expression-link" href="https://www.ncbi.nlm.nih.gov/gds/?term=zea+mays[ORGN]" target="_blank" rel="noopener">NCBI GEO DataSets</a>
              <a class="expression-link" href="https://www.ncbi.nlm.nih.gov/sra/?term=zea+mays" target="_blank" rel="noopener">NCBI SRA Runs</a>
            </div>
          </article>
        </div>
  </section>

  <!-- ── Atlases ──────────────────────────────────────────────────────────── -->
  <section id="expression-atlases" aria-labelledby="expression-atlases-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-atlases-title">Genome atlases</h2></div>
    </div>
    <div class="mgdb-card-grid expression-atlas-list">
          <article class="mgdb-card expression-atlas-card">
            <div class="expression-atlas-header">
              <h3 class="expression-atlas-title"><a href="/genome/assembly/Zm-B73-REFERENCE-NAM-5.0">Zm-B73-REFERENCE-NAM-5.0</a></h3>
              <span class="mgdb-badge">Current Gold Standard</span>
            </div>
            <p class="expression-atlas-desc">Comprehensive RNA-seq tracks on JBrowse with normalized FPKM values available in qTeller and downloadable matrices. Associated pan-gene expression available on individual gene model records.</p>
            <div class="expression-atlas-actions">
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://qteller.maizegdb.org/index_B73v5.php" target="_blank" rel="noopener">Search qTeller v5</a>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://jbrowse.maizegdb.org/?data=data%2FZm-B73-REFERENCE-NAM-5.0&tracks=RNA-seq" target="_blank" rel="noopener">JBrowse RNA-seq</a>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/323420910680" target="_blank" rel="noopener">Download FPKM</a>
            </div>
          </article>

          <article class="mgdb-card expression-atlas-card">
            <div class="expression-atlas-header">
              <h3 class="expression-atlas-title"><a href="/genome/assembly/Zm-B73-REFERENCE-GRAMENE-4.0">Zm-B73-REFERENCE-GRAMENE-4.0</a></h3>
              <span class="mgdb-badge">Reference Assembly v4</span>
            </div>
            <p class="expression-atlas-desc">Gene model expression searchable in qTeller B73v4 and GBrowse v4. Cross-referenced to RefGen_v5 and pan-genes in MaizeGDB Gene Center.</p>
            <div class="expression-atlas-actions">
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://qteller.maizegdb.org/index_B73v4.php" target="_blank" rel="noopener">Search qTeller v4</a>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://www.maizegdb.org/gbrowse/maize_v4" target="_blank" rel="noopener">GBrowse v4</a>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/323420910680" target="_blank" rel="noopener">Download FPKM</a>
            </div>
          </article>

          <article class="mgdb-card expression-atlas-card">
            <div class="expression-atlas-header">
              <h3 class="expression-atlas-title"><a href="https://www.maizegdb.org/NAM_project">26 NAM Pan-Genome Founder Inbred Lines</a></h3>
              <span class="mgdb-badge">Pan-Genome Transcriptomics</span>
            </div>
            <p class="expression-atlas-desc">RNA-seq expression across the 26 Nested Association Mapping \(NAM\) founder inbred lines. Searchable in qTeller NAM and visualized across founder genomes in JBrowse.</p>
            <div class="expression-atlas-actions">
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://qteller.maizegdb.org/index_NAM.php" target="_blank" rel="noopener">Search qTeller NAM</a>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://jbrowse.maizegdb.org/" target="_blank" rel="noopener">JBrowse NAM Founder Genomes</a>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/323420601134" target="_blank" rel="noopener">Download NAM BAMs</a>
            </div>
          </article>

          <article class="mgdb-card expression-atlas-card">
            <div class="expression-atlas-header">
              <h3 class="expression-atlas-title"><a href="/genome/assembly/B73%20RefGen_v3">B73 RefGen_v3 &amp; RefGen_v2</a></h3>
              <span class="mgdb-badge">Classic Gene Atlases</span>
            </div>
            <p class="expression-atlas-desc">Classic microarray and RNA-seq developmental atlases mapped to RefGen_v3/v2 gene models \(GRMZM... prefix\), integrated with the Maize eFP Pictograph Browser and GBrowse v3/v2.</p>
            <div class="expression-atlas-actions">
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="http://bar.utoronto.ca/efp_maize/cgi-bin/efpWeb.cgi?dataSource=Sekhon_et_al_Atlas" target="_blank" rel="noopener">eFP Pictograph Browser</a>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://www.maizegdb.org/gbrowse/maize_v3" target="_blank" rel="noopener">GBrowse v3</a>
            </div>
          </article>
        </div>
  </section>

  <!-- ── Downloads ────────────────────────────────────────────────────────── -->
  <section id="expression-downloads" aria-labelledby="expression-downloads-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-downloads-title">Downloads</h2></div>
      <a class="expression-section-link" href="https://iastate.app.box.com/v/maizegdb-public" target="_blank" rel="noopener">Browse all downloads <span aria-hidden="true">&nearr;</span></a>
    </div>
    <div class="mgdb-card-grid expression-downloads-grid">
          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">Normalized FPKM Matrices</h3>
              <p class="expression-dl-desc">Normalized FPKM expression tables for Zm-B73-REFERENCE-NAM-5.0, Zm-B73-REFERENCE-GRAMENE-4.0, and all 26 NAM founder lines \(qTeller input datasets\).</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/323420910680" target="_blank" rel="noopener">Download FPKM Tables</a>
            </div>
          </article>

          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">B73 RefGen_v5 BAM &amp; BigWig Files</h3>
              <p class="expression-dl-desc">Un-normalized BAM alignment files and BigWig continuous coverage tracks for Zm-B73-REFERENCE-NAM-5.0 developmental tissues.</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/323417838073" target="_blank" rel="noopener">Download B73v5 BAMs</a>
            </div>
          </article>

          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">26 NAM Founder Lines BAM &amp; BigWig Files</h3>
              <p class="expression-dl-desc">Un-normalized aligned BAM files and BigWig tracks for all 26 Nested Association Mapping \(NAM\) founder inbreds.</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/323420601134" target="_blank" rel="noopener">Download NAM BAMs</a>
            </div>
          </article>

          <article class="mgdb-card expression-download-card">
            <div class="expression-dl-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            </div>
            <div class="expression-dl-content">
              <h3 class="expression-dl-title">CAU B73v5 / Mo17 Developmental RNA-seq</h3>
              <p class="expression-dl-desc">B73v5 and Mo17 CAU RNA-seq BAM alignments and BigWig continuous coverage files across developmental series.</p>
              <a class="mgdb-button mgdb-button-secondary mgdb-button-sm" href="https://iastate.app.box.com/v/maizegdb-public/folder/323421040011" target="_blank" rel="noopener">Download CAU Series</a>
            </div>
          </article>
        </div>
  </section>

  <!-- ── References ───────────────────────────────────────────────────────── -->
  <section id="expression-references" aria-labelledby="expression-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <!-- ── Metrics ──────────────────────────────────────────────────────────── -->
  <section id="expression-metrics" aria-labelledby="expression-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Gene models</h3>
          <span class="mgdb-metric-badge">Indexed</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total_gene_models)</strong>
        </div>
        <p class="mgdb-metric-description">Distinct annotated gene models across the B73, W22, and Mo17 reference assemblies.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>Assemblies</h3>
          <span class="mgdb-metric-badge">Searchable</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(assembly_count)</strong>
        </div>
        <p class="mgdb-metric-description">Assembly versions carrying gene models the lookup above can search.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>NAM founders</h3>
          <span class="mgdb-metric-badge">Pan-genome</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(nam_lines)</strong>
        </div>
        <p class="mgdb-metric-description">Nested association mapping founder inbreds with their own RNA-seq atlas.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>Developmental tissues</h3>
          <span class="mgdb-metric-badge">Atlases</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(distinct_tissues)</strong>
        </div>
        <p class="mgdb-metric-description">Anatomical tissues and stages in the Sekhon developmental atlas and qTeller.</p>
      </article>
    </div>

    <figure class="mgdb-figure expression-figure">
      <h3>Gene models by assembly</h3>
      <div class="mgdb-chart" id="expression-assembly-chart" role="img"
           aria-label="Horizontal bar chart of the number of distinct gene models indexed for each maize assembly"
           data-labels="$(chart_labels)" data-values="$(chart_values)">
        <div class="mgdb-chart-fallback">Loading the assembly breakdown&hellip;</div>
      </div>
      <figcaption>Twelve of the $(assembly_count) assemblies&#58; the B73 reference genomes first, then the rest by gene model count. Select a bar to search that assembly.</figcaption>
    </figure>
  </section>

  <!-- ── Related resources ────────────────────────────────────────────────── -->
  <section id="expression-related" class="mgdb-hub-related" aria-labelledby="expression-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="expression-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>Reference gene models, functional descriptions, and the expression tab on every gene record</span>
        </a>
        <a href="/pan_gene_center/pan_gene">
          <strong>Pan-Gene Data Hub</strong>
          <span>Syntenic pan-gene clusters across the NAM founder lines the atlases above are built from</span>
        </a>
        <a href="/genome">
          <strong>Genome Data Hub</strong>
          <span>The assemblies these gene models are called against, with browsers and sequence files</span>
        </a>
        <a href="/data_center/phenotype">
          <strong>Phenotype Data Hub</strong>
          <span>Curated mutant phenotypes and trait ontology terms for the loci in these results</span>
        </a>
        <a href="https://qteller.maizegdb.org/" target="_blank" rel="noopener">
          <strong>qTeller</strong>
          <span>Normalized RNA-seq comparison across tissues, inbred lines, and stress treatments</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
