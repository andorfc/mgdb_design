      <!-- 1: JBrowse 2 -->
      <article class="hilo-hosted-card">
        <h3>Genome Browsers \(JBrowse 2\)</h3>
        <p>Interactive chromosome-scale browsers for all 7 HiLo assemblies with gene models, repeat elements, and comparative tracks.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/genomebrowser">Open Genome Browsers &#8599;</a>
      </article>

      <!-- 2: Gene Center -->
      <article class="hilo-hosted-card">
        <h3>Gene Center &amp; Models</h3>
        <p>High-confidence structural and functional gene annotations across all 7 lines indexed in the Gene Center with GO terms.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/gene_center/gene">Explore Gene Center &#8599;</a>
      </article>

      <!-- 3: BLAST -->
      <article class="hilo-hosted-card">
        <h3>Sequence BLAST Tool</h3>
        <p>Align nucleotide, CDS, transcript, and translated protein queries directly against HiLo assemblies and gene models.</p>
        <a class="mgdb-button mgdb-button-secondary" href="$(blast_url)">Run BLAST Search &#8599;</a>
      </article>

      <!-- 4: Bulk Downloads -->
      <article class="hilo-hosted-card">
        <h3>Bulk Downloads &amp; Globus</h3>
        <p>Download complete assembly FASTA files, GFF3 annotations, canonical CDS/PEP sequences, and pre-indexed tracks.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/download#downloads-hilo">Browse Downloads &#8599;</a>
      </article>
    </div>
  </div>

