        <path d="M8 52L24 22L36 38L46 16L58 52H8Z" fill="#ecfdf5" stroke="#047857" stroke-width="2.5" stroke-linejoin="round"/>
        <path d="M24 22L31 34L26 36L24 22Z" fill="#a7f3d0"/>
        <path d="M46 16L51 29L47 31L46 16Z" fill="#a7f3d0"/>
        <!-- Maize ear accent on side -->
