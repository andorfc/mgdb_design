$$SYNTAX-LEVEL 2
*(mgdb-person
  <main class="mgdb-page mgdb-hub-page mgdb-person-page" id="person-top">

    <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">People &amp; Organizations</span>
    </nav>

    <section class="mgdb-hero" aria-labelledby="person-title">
      <div class="mgdb-hero-emblem">
        <svg viewBox="0 0 96 96" role="img" aria-label="Community directory icon">
          <circle cx="36" cy="34" r="13" fill="none" stroke="#235c37" stroke-width="6" />
          <path d="M16 78c0-13 9-22 20-22s20 9 20 22" fill="none" stroke="#235c37" stroke-width="6" stroke-linecap="round" />
          <circle cx="66" cy="40" r="9" fill="none" stroke="#d99a0b" stroke-width="6" />
          <path d="M60 78c0-11 6-18 14-18 5 0 9 2 12 6" fill="none" stroke="#d99a0b" stroke-width="6" stroke-linecap="round" />
        </svg>
        <strong>People<br />Data Hub</strong>
      </div>
      <div class="mgdb-hero-body">
        <h1 id="person-title">Find a person or organization</h1>
        <p class="mgdb-hero-description">Search the MaizeGDB community directory of 56,950 maize researchers and 650 organizations by name, known alias, or institution. Every author curated into a reference is linked to a record here.</p>
      </div>
    </section>

    <nav class="mgdb-section-tabs" aria-label="Sections on this page">
      <a href="#person-search" class="is-current" aria-current="true">Search</a>
      <a href="#person-notable">Notable geneticists</a>
      <a href="#person-profile">Update a profile</a>
      <a href="#person-references">References</a>
      <a href="#person-metrics">Metrics</a>
      <a href="#person-resources">Related resources</a>
    </nav>

    <section id="person-search" class="person-search-section" aria-labelledby="person-search-title">
      <div class="mgdb-section-heading">
        <div><h2 id="person-search-title">Search</h2></div>
      </div>

      <form id="person-search-form" class="person-search-form" action="/person" method="get" role="search">
        <div class="mgdb-hub-field person-field-query">
          <label for="bacterm">Name, alias, or institution</label>
          <div class="person-query-control">
            <svg class="person-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input autocomplete="off" spellcheck="false" type="search" name="term" id="bacterm"
                   value="$(queryterm)" placeholder="Researcher name, alias, or institution"
                   aria-describedby="person-search-status"
                   aria-autocomplete="list" aria-controls="person-suggestions" aria-expanded="false">
            <button type="button" id="person-search-clear" class="person-search-clear" aria-label="Clear search input" hidden>&times;</button>
            <div id="person-suggestions" class="person-suggestions" role="listbox" hidden></div>
          </div>
        </div>

        <div class="mgdb-hub-field mgdb-hub-field-action">
          <button type="submit" class="mgdb-button mgdb-button-primary">Search people</button>
        </div>

        <p class="person-hint" id="person-search-hint">Two-letter surnames work&#58; <code>Li</code>, <code>Wu</code>, <code>Yu</code>. Searching matches names, aliases, and institutions.</p>

        <div class="person-example-row" aria-label="Example searches">
          <span>Examples&#58;</span>
          <button type="button" class="person-chip" data-person-example="Barbara McClintock">Barbara McClintock</button>
          <button type="button" class="person-chip" data-person-example="Ed Buckler">Ed Buckler</button>
          <button type="button" class="person-chip" data-person-example="Virginia Walbot">Virginia Walbot</button>
          <button type="button" class="person-chip" data-person-example="Sarah Hake">Sarah Hake</button>
          <button type="button" class="person-chip" data-person-example="USDA-ARS">USDA-ARS</button>
          <button type="button" class="person-chip" data-person-example="Iowa State University">Iowa State</button>
          <button type="button" class="person-chip" data-person-example="CIMMYT">CIMMYT</button>
        </div>

        <details class="person-adv" id="person-adv">
          <summary>
            <strong>Browse by last-name initial</strong>
            <span>List everyone whose last name begins with a letter</span>
          </summary>
          <div class="person-az-grid" role="group" aria-label="Browse by last-name initial">
            <button type="button" class="person-az-btn" data-letter="A">A</button>
            <button type="button" class="person-az-btn" data-letter="B">B</button>
            <button type="button" class="person-az-btn" data-letter="C">C</button>
            <button type="button" class="person-az-btn" data-letter="D">D</button>
            <button type="button" class="person-az-btn" data-letter="E">E</button>
            <button type="button" class="person-az-btn" data-letter="F">F</button>
            <button type="button" class="person-az-btn" data-letter="G">G</button>
            <button type="button" class="person-az-btn" data-letter="H">H</button>
            <button type="button" class="person-az-btn" data-letter="I">I</button>
            <button type="button" class="person-az-btn" data-letter="J">J</button>
            <button type="button" class="person-az-btn" data-letter="K">K</button>
            <button type="button" class="person-az-btn" data-letter="L">L</button>
            <button type="button" class="person-az-btn" data-letter="M">M</button>
            <button type="button" class="person-az-btn" data-letter="N">N</button>
            <button type="button" class="person-az-btn" data-letter="O">O</button>
            <button type="button" class="person-az-btn" data-letter="P">P</button>
            <button type="button" class="person-az-btn" data-letter="Q">Q</button>
            <button type="button" class="person-az-btn" data-letter="R">R</button>
            <button type="button" class="person-az-btn" data-letter="S">S</button>
            <button type="button" class="person-az-btn" data-letter="T">T</button>
            <button type="button" class="person-az-btn" data-letter="U">U</button>
            <button type="button" class="person-az-btn" data-letter="V">V</button>
            <button type="button" class="person-az-btn" data-letter="W">W</button>
            <button type="button" class="person-az-btn" data-letter="X">X</button>
            <button type="button" class="person-az-btn" data-letter="Y">Y</button>
            <button type="button" class="person-az-btn" data-letter="Z">Z</button>
          </div>
        </details>
      </form>

      <div id="person-results-table-wrap" class="person-results-table-wrap">
        <div class="person-loading" aria-label="Loading results" hidden>
          <span class="person-spinner" aria-hidden="true"></span>
          <span>Searching MaizeGDB community records&hellip;</span>
        </div>
        <div id="person-results-container" aria-live="polite">
          <div class="person-empty-state">
            <h3>Search the community directory</h3>
            <p>Enter a researcher name, alias, or institution above, choose an example, or browse by last-name initial.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="person-notable" aria-labelledby="person-notable-title">
      <div class="mgdb-section-heading">
        <div><h2 id="person-notable-title">Notable geneticists</h2></div>
      </div>
      <div class="person-notable-grid">
        <article class="person-notable-card">
          <div class="person-notable-avatar" aria-hidden="true">BM</div>
          <div class="person-notable-info">
            <h3><a href="/person?id=2557">Barbara McClintock</a></h3>
            <p class="person-notable-role">Nobel Prize in Physiology or Medicine, 1983</p>
            <p>Discovered transposable elements &#40;<em>Ac/Ds</em>&#41; in maize and the breakage&ndash;fusion&ndash;bridge cycle.</p>
            <p class="person-notable-links"><a href="/person?id=2557">Record</a> &middot; <a href="/data_center/reference?author=McClintock">Publications</a></p>
          </div>
        </article>
        <article class="person-notable-card">
          <div class="person-notable-avatar" aria-hidden="true">GB</div>
          <div class="person-notable-info">
            <h3><a href="/person?id=2541">George Beadle</a></h3>
            <p class="person-notable-role">Nobel Prize in Physiology or Medicine, 1958</p>
            <p>Co-authored the one gene&ndash;one enzyme hypothesis and studied teosinte and maize domestication.</p>
            <p class="person-notable-links"><a href="/person?id=2541">Record</a> &middot; <a href="/data_center/reference?author=Beadle">Publications</a></p>
          </div>
        </article>
        <article class="person-notable-card">
          <div class="person-notable-avatar" aria-hidden="true">RE</div>
          <div class="person-notable-info">
            <h3><a href="/person?id=2561">Rollins Emerson</a></h3>
            <p class="person-notable-role">Cornell maize genetics group</p>
            <p>Mapped early linkage groups and kernel pigmentation genes, and trained a generation of maize geneticists.</p>
            <p class="person-notable-links"><a href="/person?id=2561">Record</a> &middot; <a href="/data_center/reference?author=Emerson">Publications</a></p>
          </div>
        </article>
        <article class="person-notable-card">
          <div class="person-notable-avatar" aria-hidden="true">MR</div>
          <div class="person-notable-info">
            <h3><a href="/person?id=2580">Marcus Rhoades</a></h3>
            <p class="person-notable-role">Founder of the Maize Genetics Cooperation News Letter</p>
            <p>Described preferential segregation and cytoplasmic male sterility, and started the MNL in 1929.</p>
            <p class="person-notable-links"><a href="/person?id=2580">Record</a> &middot; <a href="/data_center/reference?author=Rhoades">Publications</a></p>
          </div>
        </article>
      </div>
    </section>

    <section id="person-profile" aria-labelledby="person-profile-title">
      <div class="mgdb-section-heading">
        <div><h2 id="person-profile-title">Update a profile</h2></div>
      </div>
      <div class="person-faq-list">
        <details class="person-faq-item">
          <summary>How do I update an affiliation, address, or contact details?</summary>
          <div class="person-faq-body">
            <p>Send changes through the <a href="/contact">contact form</a> or email <a href="mailto:curators@maizegdb.org">curators@maizegdb.org</a>. Include the MaizeGDB Person ID or the full name and current affiliation.</p>
          </div>
        </details>
        <details class="person-faq-item">
          <summary>How are publications linked to a person record?</summary>
          <div class="person-faq-body">
            <p>Author names are mapped to person records when a reference is curated into MaizeGDB. To report a missing publication, submit the DOI or PubMed ID through <a href="/contribute_data">Contribute Data</a>.</p>
          </div>
        </details>
        <details class="person-faq-item">
          <summary>Can I register a new laboratory or organization?</summary>
          <div class="person-faq-body">
            <p>Yes. Institutions, seed repositories, and research groups can be added so that publications and stocks can be attributed to them. Contact the curation staff to register an organization record.</p>
          </div>
        </details>
      </div>
    </section>

    <section id="person-references" aria-labelledby="person-references-title">
      <div class="mgdb-section-heading">
        <div><h2 id="person-references-title">References</h2></div>
      </div>
      <div class="mgdb-ref-list">
        $(reference_cards)
      </div>
    </section>

    <section id="person-metrics" aria-labelledby="person-metrics-title">
      <div class="mgdb-section-heading">
        <div><h2 id="person-metrics-title">Metrics</h2></div>
      </div>
      <div class="mgdb-metric-grid">
        <article class="mgdb-metric mgdb-tone-green">
          <div class="mgdb-metric-top">
            <h3>People</h3>
            <span class="mgdb-metric-badge">Curated</span>
          </div>
          <div class="mgdb-metric-stat">
            <strong class="mgdb-metric-value">$(people)</strong>
          </div>
          <p class="mgdb-metric-description">Researchers, authors, and cooperators with a record in the directory.</p>
        </article>

        <article class="mgdb-metric mgdb-tone-amber">
          <div class="mgdb-metric-top">
            <h3>Organizations</h3>
            <span class="mgdb-metric-badge">Institutions</span>
          </div>
          <div class="mgdb-metric-stat">
            <strong class="mgdb-metric-value">$(orgs)</strong>
          </div>
          <p class="mgdb-metric-description">Universities, USDA-ARS stations, companies, publishers, and projects.</p>
        </article>

        <article class="mgdb-metric mgdb-tone-blue">
          <div class="mgdb-metric-top">
            <h3>Countries</h3>
            <span class="mgdb-metric-badge">Represented</span>
          </div>
          <div class="mgdb-metric-stat">
            <strong class="mgdb-metric-value">$(countries)</strong>
          </div>
          <p class="mgdb-metric-description">Distinct countries recorded across people in the directory.</p>
        </article>

        <article class="mgdb-metric mgdb-tone-burgundy">
          <div class="mgdb-metric-top">
            <h3>ORCID iDs</h3>
            <span class="mgdb-metric-badge">Linked</span>
          </div>
          <div class="mgdb-metric-stat">
            <strong class="mgdb-metric-value">$(orcid)</strong>
          </div>
          <p class="mgdb-metric-description">People whose record carries a linked ORCID identifier.</p>
        </article>
      </div>
    </section>

    <section id="person-resources" class="mgdb-hub-related" aria-labelledby="person-resources-title">
      <div class="mgdb-section-heading">
        <div><h2 id="person-resources-title">Related resources</h2></div>
      </div>
      <div class="mgdb-resource-panel">
        <div class="mgdb-resource-list">
          <a href="/data_center/reference">
            <strong>Literature Data Hub</strong>
            <span>Search maize references and abstracts linked to authors</span>
          </a>
          <a href="/data_center/stock">
            <strong>Stock Data Hub</strong>
            <span>Seed stocks and accessions from the Maize Genetics Cooperation Stock Center</span>
          </a>
          <a href="/hot_new_papers">
            <strong>Editorial Board picks</strong>
            <span>Recent papers selected and annotated by the MaizeGDB Editorial Board</span>
          </a>
          <a href="/contribute_data">
            <strong>Contribute data</strong>
            <span>Submit publications, datasets, and corrections to the curation team</span>
          </a>
          <a href="https\://www.maizegenetics.org" target="_blank" rel="noopener">
            <strong>Maize Genetics Cooperation</strong>
            <span>Community organization, awards, and the annual Maize Genetics Meeting</span>
          </a>
        </div>
      </div>
    </section>

  </main>
)
