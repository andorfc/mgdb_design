$$SYNTAX-LEVEL 2
*(mgdb-locus-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No locus found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="locus-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/locus">Gene and Locus Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="locus-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="locus-notfound-title">No locus matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB holds $(total_loci) curated loci across 26 types. None of them carries that name, synonym, or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="locus-notfound-search" aria-labelledby="locus-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="locus-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/locus" method="get" role="search">
      <label class="mgdb-visually-hidden" for="locus-notfound-query">Locus name, synonym, or MaizeGDB ID</label>
      <input class="mgdb-input" id="locus-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Locus name, synonym, or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search loci</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/locus?id=vgt1">vgt1</a>
      <a class="mgdb-rec-example" href="/data_center/locus?id=cent1">cent1</a>
      <a class="mgdb-rec-example" href="/data_center/locus?id=Ac">Ac</a>
      <a class="mgdb-rec-example" href="/data_center/locus?id=12350">12350</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs an exact locus name, one of its synonyms, or its MaizeGDB ID. Partial and wildcard matching lives in the hub search above. A classical gene symbol such as <em>adh1</em> resolves to the gene record page rather than to a locus record.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="locus-notfound-resources" aria-labelledby="locus-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="locus-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>Search classical loci by name, synonym, type, chromosome, or map position</span>
        </a>
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>B73 gene models across assembly versions, and the loci they represent</span>
        </a>
        <a href="/data_center/variation">
          <strong>Variations &amp; Alleles Data Hub</strong>
          <span>Curated variations and alleles, which often carry the name a locus does not</span>
        </a>
        <a href="/nomenclature">
          <strong>Maize nomenclature guidelines</strong>
          <span>How maize gene symbols and locus names are formed, which explains most near misses</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across loci, genes, markers, stocks, references, and every other data type</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
