$$SYNTAX-LEVEL 2
*(mgdb-stock-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No stock found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="stock-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/stock">Stock Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="stock-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="stock-notfound-title">No stock matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB holds $(total_stocks) genetic stocks. None of them carries that name, alternate description, accession, or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="stock-notfound-search" aria-labelledby="stock-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="stock-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/stock" method="get" role="search">
      <label class="mgdb-visually-hidden" for="stock-notfound-query">Stock name, accession, or MaizeGDB ID</label>
      <input class="mgdb-input" id="stock-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Stock name, accession, or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search stocks</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/stock?id=CML277">CML277</a>
      <a class="mgdb-rec-example" href="/data_center/stock?id=47846">47846</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs one stock&#58; its name, one of its alternate descriptions, an external accession such as a GRIN PI number, or its MaizeGDB ID. An allele symbol names a variation rather than a stock, and the stocks carrying it are listed below where MaizeGDB has them.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="stock-notfound-resources" aria-labelledby="stock-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="stock-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/stock">
          <strong>Stock Data Hub</strong>
          <span>Find germplasm by stock type, provider, parentage, or variation</span>
        </a>
        <a href="/data_center/variation">
          <strong>Variation Data Hub</strong>
          <span>Alleles and mutations, and the germplasm that carries them</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="https\://maizecoopsc.org/" target="_blank" rel="noopener">
          <strong>Maize Genetics COOP Stock Center</strong>
          <span>Availability and seed ordering for distributed mutant and inbred stocks</span>
        </a>
        <a href="https\://npgsweb.ars-grin.gov/gringlobal/search" target="_blank" rel="noopener">
          <strong>GRIN-Global</strong>
          <span>USDA-ARS germplasm accessions, passport data, and seed requests</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
