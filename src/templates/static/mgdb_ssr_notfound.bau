$$SYNTAX-LEVEL 2
*(mgdb-ssr-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No SSR found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="ssr-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/ssr">SSR Marker Archive</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="ssr-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="ssr-notfound-title">No SSR matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB archives $(total_ssrs) simple sequence repeat markers. None of them carries that name, synonym, or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="ssr-notfound-search" aria-labelledby="ssr-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="ssr-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/ssr" method="get" role="search">
      <label class="mgdb-visually-hidden" for="ssr-notfound-query">SSR name, synonym, or MaizeGDB ID</label>
      <input class="mgdb-input" id="ssr-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="SSR name, synonym, or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search SSRs</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/ssr?id=p-umc1246">p-umc1246</a>
      <a class="mgdb-rec-example" href="/data_center/ssr?id=umc1246">umc1246</a>
      <a class="mgdb-rec-example" href="/data_center/ssr?id=242172">242172</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs one SSR&#58; its name, one of its synonyms, or its MaizeGDB ID. Names are written with and without the <em>p-</em> prefix and both reach the record. An SSR is one kind of molecular marker, so a marker that is not an SSR has its record in the Molecular Marker Data Hub instead.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="ssr-notfound-resources" aria-labelledby="ssr-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="ssr-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/ssr">
          <strong>SSR Marker Archive</strong>
          <span>Search the archived simple sequence repeat collection by name, synonym, or motif</span>
        </a>
        <a href="/data_center/marker">
          <strong>Molecular Marker Data Hub</strong>
          <span>Every marker and probe MaizeGDB holds, of which SSRs are one kind</span>
        </a>
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>The genetic maps these markers are placed on</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="/downloads">
          <strong>Downloads</strong>
          <span>Mapped SSR datasets by chromosome, and the rest of the marker data</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
