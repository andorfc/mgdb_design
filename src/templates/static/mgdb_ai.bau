    <div class="ai-card-grid ai-card-grid-data">
      <article class="ai-resource-card ai-data-card" data-ai-resource data-ai-category="data" data-ai-search="Core-60 feature vector B73 NAM essential metadata 60 features Haley">
        <span class="ai-data-label">Feature vectors</span>
        <h3>Core-60</h3>
        <p>A compact set of approximately 60 genetic and genomic attributes for B73 and NAM gene annotations.</p>
        <div class="ai-tags"><span>B73 v5</span><span>NAM genes</span></div>
        <a href="https\://iastate.app.box.com/v/maizegdb-public/folder/362581854753" target="_blank" rel="noopener">Download dataset &nearr;</a>
