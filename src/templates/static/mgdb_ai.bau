$$SYNTAX-LEVEL 2
*(mgdb-ai
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/ai">
<meta property="og:title" content="MaizeGDB AI &amp; Machine Learning Data Hub">
<meta property="og:description" content="Search maize AI and machine learning resources at MaizeGDB: analysis tools, AI-ready datasets, open-source code, and the publications behind them.">

<main class="mgdb-page mgdb-hub-page mgdb-ai-page" id="ai-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">AI &amp; Machine Learning Data Hub</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="ai-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/quicklinks/AI.png" alt="" width="128" height="128" decoding="async" />
      <strong>AI &amp; Machine Learning<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; August 2026</p>
      <h1 id="ai-title">Maize artificial intelligence and machine learning resources</h1>
      <p class="mgdb-hero-description">$(metric_total) resources for machine learning on maize&#58; $(metric_tools) analysis tools, $(metric_data) AI-ready datasets, $(metric_code) code repositories, and $(metric_pubs) references.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#ai-search" class="is-current" aria-current="true">Search</a>
    <a href="#ai-tools">Tools</a>
    <a href="#ai-data">Data</a>
    <a href="#ai-code">Code</a>
    <a href="#ai-publications">References</a>
    <a href="#ai-metrics">Metrics</a>
    <a href="#ai-related">Related resources</a>
  </nav>

  <!-- ── Search ───────────────────────────────────────────────────────────── -->
  <section id="ai-search" aria-labelledby="ai-search-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ai-search-title">Search</h2></div>
    </div>

    <form id="ai-search-form" class="ai-search-form" role="search">
      <div class="mgdb-hub-field ai-field-query">
        <label for="ai-query">Search term</label>
        <div class="ai-query-control">
          <svg class="ai-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
          <input id="ai-query" name="q" type="search" placeholder="Tool, dataset, repository, method, or author" autocomplete="off" />
          <button id="ai-query-clear" type="button" hidden>Clear</button>
        </div>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action">
        <button class="mgdb-button mgdb-button-primary" type="submit">Search resources</button>
      </div>

      <div class="ai-example-row" aria-label="Example searches">
        <span>Examples&#58;</span>
        <button type="button" data-ai-example="protein structure">protein structure</button>
        <button type="button" data-ai-example="variant effect">variant effect</button>
        <button type="button" data-ai-example="embeddings">embeddings</button>
        <button type="button" data-ai-example="gene ontology">gene ontology</button>
        <button type="button" data-ai-example="feature vectors">feature vectors</button>
        <button type="button" data-ai-example="AlphaFold">AlphaFold</button>
        <button type="button" data-ai-example="PanEffect">PanEffect</button>
      </div>

      <details class="ai-adv" id="ai-adv">
        <summary>
          <strong>Advanced search criteria</strong>
          <span>Filter by resource type, data type, genome coverage, or internal and external access</span>
        </summary>
        <div class="ai-adv-body">
          <div class="mgdb-hub-field">
            <label for="ai-filter-category">Resource type</label>
            <select id="ai-filter-category" name="category">
              <option value="">All resource types</option>
              <option value="tool">Analysis tools</option>
              <option value="data">AI-ready data</option>
              <option value="code">Open-source code</option>
              <option value="publication">References</option>
            </select>
          </div>

          <div class="mgdb-hub-field">
            <label for="ai-filter-topic">Data type</label>
            <select id="ai-filter-topic" name="topic">
              <option value="">All data types</option>
              $(topic_options)
            </select>
          </div>

          <div class="mgdb-hub-field">
            <label for="ai-filter-genome">Genome coverage</label>
            <select id="ai-filter-genome" name="genome">
              <option value="">All genomes and assemblies</option>
              $(genome_options)
            </select>
          </div>

          <div class="mgdb-hub-field">
            <label for="ai-filter-access">Access</label>
            <select id="ai-filter-access" name="access">
              <option value="">Internal and external</option>
              <option value="internal">Internal only</option>
              <option value="external">External only</option>
            </select>
          </div>
        </div>

        <div class="ai-adv-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit">Apply advanced filters</button>
          <button class="mgdb-button mgdb-button-quiet" id="ai-adv-reset" type="button">Reset advanced filters</button>
        </div>
      </details>
    </form>
  </section>

  <!-- ── Search results: hidden until a search runs ───────────────────────── -->
  <section id="ai-results-section" class="ai-results-section" aria-labelledby="ai-results-title" hidden>
    <div class="ai-results-heading">
      <div>
        <h2 id="ai-results-title">Search results</h2>
        <p id="ai-results-status" role="status" aria-live="polite"></p>
      </div>
      <div class="ai-results-controls">
        <div class="mgdb-hub-field">
          <label for="ai-results-filter">Filter results</label>
          <input id="ai-results-filter" type="search" placeholder="Narrow this table" autocomplete="off" />
        </div>
        <div class="mgdb-hub-field">
          <label for="ai-page-size">Results per page</label>
          <select id="ai-page-size">
            <option value="10">Top 10</option>
            <option value="25" selected>Top 25</option>
            <option value="50">Top 50</option>
            <option value="all">All results</option>
          </select>
        </div>
      </div>
    </div>

    <div class="mgdb-table-scroll">
      <table class="mgdb-table ai-results-table" id="ai-results-table">
        <caption>
          Matching AI and machine learning resources
          <span class="mgdb-muted">Sort any column by activating its header. Access says whether the resource opens on this site or on another one.</span>
        </caption>
        <thead>
          <tr>
            <th scope="col" data-ai-sort="name" aria-sort="none"><button type="button">Resource</button></th>
            <th scope="col" data-ai-sort="category" aria-sort="none"><button type="button">Type</button></th>
            <th scope="col" data-ai-sort="topics" aria-sort="none"><button type="button">Data type</button></th>
            <th scope="col" data-ai-sort="access" aria-sort="none"><button type="button">Access</button></th>
            <th scope="col" class="ai-col-open">Open</th>
          </tr>
        </thead>
        <tbody id="ai-results-body"></tbody>
      </table>
    </div>

    <div class="mgdb-empty" id="ai-results-empty" hidden>
      <h3>No resources matched that search</h3>
      <p>Try a broader term such as <code>structure</code>, <code>variant</code>, or <code>function</code>, or reset the advanced filters.</p>
      <button class="mgdb-button mgdb-button-secondary" id="ai-empty-reset" type="button">Reset search</button>
    </div>

    <nav class="ai-pagination" id="ai-pagination" aria-label="Search result pages"></nav>
  </section>

  <!-- ── Analysis tools ───────────────────────────────────────────────────── -->
  <section id="ai-tools" aria-labelledby="ai-tools-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ai-tools-title">Analysis tools</h2></div>
    </div>
    <div class="mgdb-card-grid ai-card-grid">
      $(featured_tool)
      $(tool_cards)
    </div>
  </section>

  <!-- ── AI-ready data ────────────────────────────────────────────────────── -->
  <section id="ai-data" aria-labelledby="ai-data-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ai-data-title">AI-ready data</h2></div>
      <a class="ai-section-link" href="https://iastate.app.box.com/v/maizegdb-public/folder/362582785407" target="_blank" rel="noopener">Browse all downloads <span aria-hidden="true">&nearr;</span></a>
    </div>
    <div class="mgdb-card-grid ai-card-grid">
      $(data_cards)
    </div>
  </section>

  <!-- ── Open-source code ─────────────────────────────────────────────────── -->
  <section id="ai-code" aria-labelledby="ai-code-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ai-code-title">Open-source code</h2></div>
      <a class="ai-section-link" href="https://github.com/Maize-Genetics-and-Genomics-Database" target="_blank" rel="noopener">All MaizeGDB repositories <span aria-hidden="true">&nearr;</span></a>
    </div>
    <div class="mgdb-card-grid ai-card-grid">
      $(code_cards)
    </div>
  </section>

  <!-- ── References ───────────────────────────────────────────────────────── -->
  <section id="ai-publications" aria-labelledby="ai-publications-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ai-publications-title">References</h2></div>
    </div>
    <div class="mgdb-ref-list">
      $(publication_cards)
    </div>
  </section>

  <!-- ── Metrics ──────────────────────────────────────────────────────────── -->
  <section id="ai-metrics" aria-labelledby="ai-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ai-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Analysis tools</h3>
          <span class="mgdb-metric-badge">Applications</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_tools)</strong>
        </div>
        <p class="mgdb-metric-description">Interactive tools for variants, structures, function, and gene features.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>AI-ready datasets</h3>
          <span class="mgdb-metric-badge">Downloads</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_data)</strong>
        </div>
        <p class="mgdb-metric-description">Feature vectors, structures, embeddings, scores, and annotations.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>Code repositories</h3>
          <span class="mgdb-metric-badge">Open source</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_code)</strong>
        </div>
        <p class="mgdb-metric-description">Public workflows that produced the datasets listed above.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>References</h3>
          <span class="mgdb-metric-badge">Methods</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(metric_pubs)</strong>
        </div>
        <p class="mgdb-metric-description">Peer-reviewed papers and preprints describing these methods.</p>
      </article>
    </div>

    <figure class="mgdb-figure ai-figure">
      <h3>Resources by data type</h3>
      <div class="mgdb-chart" id="ai-topic-chart" role="img"
           aria-label="Stacked horizontal bar chart counting the analysis tools, datasets, code repositories, and references that cover each data type">
        <div class="mgdb-chart-fallback">Loading the data type breakdown&hellip;</div>
      </div>
      <figcaption>Each resource is counted once per data type it covers, so the bars total more than the $(metric_total) resources in the catalog. Select a bar to search that data type.</figcaption>
    </figure>

    <div class="mgdb-table-scroll ai-figure-table">
      <table class="mgdb-table" id="ai-topic-table">
        <caption>
          Resources by data type
          <span class="mgdb-muted">The values behind the chart above.</span>
        </caption>
        <thead>
          <tr>
            <th scope="col">Data type</th>
            <th scope="col" class="mgdb-numeric">Tools</th>
            <th scope="col" class="mgdb-numeric">Data</th>
            <th scope="col" class="mgdb-numeric">Code</th>
            <th scope="col" class="mgdb-numeric">References</th>
            <th scope="col" class="mgdb-numeric">Total</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <!-- ── Related resources ────────────────────────────────────────────────── -->
  <section id="ai-related" class="mgdb-hub-related" aria-labelledby="ai-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="ai-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/genome">
          <strong>Genome Data Hub</strong>
          <span>Hosted genome assemblies across maize and its wild relatives, with assembly statistics</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="/pan_gene_center/pan_gene">
          <strong>Pan-Gene Data Hub</strong>
          <span>Syntenic pan-genes, core and dispensable loci, and structural variation across the pan-genome</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="/data_center/variation">
          <strong>Variations &amp; Alleles Data Hub</strong>
          <span>Curated variations, gene mutations, and allele descriptors underlying the variant effect scores</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
        <a href="https://download.maizegdb.org/" target="_blank" rel="noopener">
          <strong>MaizeGDB downloads</strong>
          <span>Bulk sequence, annotation, expression, and function files, including the sets listed on this page</span>
          <span class="mgdb-resource-badge mgdb-resource-badge-external">External</span>
        </a>
        <a href="/cite">
          <strong>How to cite MaizeGDB</strong>
          <span>Citation formats, primary database manuscripts, and the publication bibliography</span>
          <span class="mgdb-resource-badge">Internal</span>
        </a>
      </div>
    </div>
  </section>

  <script type="application/json" id="ai-search-index">$(search_index)</script>
  <script type="application/json" id="ai-chart-data">$(chart_data)</script>
</main>
)
