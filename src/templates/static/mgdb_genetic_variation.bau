$$SYNTAX-LEVEL 2
*(mgdb-genetic-variation
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https\://maizegdb.org/genetic_variation">
<meta property="og:title" content="MaizeGDB Genetic Variation Data Hub">
<meta property="og:description" content="Maize SNP and indel resources at MaizeGDB: the SNPTools workspace, SNPVersity 2, TYPSimSelector, eleven variant builds on B73 v5, and public resequencing projects.">

<a class="mgdb-skip-link" href="#gv-main">Skip to main content</a>

<main class="mgdb-page mgdb-hub-page mgdb-genetic-variation-page" id="gv-main">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Genetic variation</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="gv-title">
    <div class="mgdb-hero-emblem">
      <img class="gv-hero-icon" src="/images/data_center/genetic_variation_transparent.png?v=20260822" width="76" height="76" alt="Maize genetic variation four-kernel emblem" />
      <strong>Genetic<br />Variation</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="gv-title">Explore maize SNPs, indels &amp; genetic diversity</h1>
      <p class="mgdb-hero-description">Discover maize sequence variants, navigate $(dataset-count) curated builds on B73 RefGen_v5, explore public resequencing projects, and launch specialized analysis tools.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#gv-datasets" class="is-current" aria-current="true">Search</a>
    <a href="#gv-tools">Tools</a>
    <a href="#gv-projects">Projects</a>
    <a href="#gv-downloads">Downloads</a>
    <a href="#gv-about">About</a>
    <a href="#gv-references">References</a>
    <a href="#gv-metrics">Metrics</a>
    <a href="#gv-related">Related resources</a>
  </nav>

<!-- ====================================================================
       2. Variant Datasets
       ==================================================================== -->
  <section id="gv-datasets" aria-labelledby="gv-datasets-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-datasets-title">Search</h2></div>
    </div>

    <div class="gv-search-intro">
      <div><h3>Which variant build do you need?</h3><p>This hub's own collection is the variant builds, so they are all listed and the filter narrows them. Every build is selectable in SNPVersity 2 and SNPTools. <strong>High Quality</strong> builds apply linkage-disequilibrium \(LD\) filtering on top of <strong>High Coverage</strong> datasets for reduced redundancy.</p></div>
    </div>

    <div class="gv-search-form-wrap">
      <form id="gv-dataset-search-form" class="gv-search-form" role="search" onsubmit="return false;">
        <div class="gv-query-row">
          <div class="gv-query-control">
            <label class="mgdb-visually-hidden" for="gv-dataset-query">Search variant datasets</label>
            <svg class="gv-search-icon" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
            <input class="mgdb-input" id="gv-dataset-query" type="search" autocomplete="off" placeholder="Try B73 v5, MaizeGDB 2026, imputation, NAM, Panzea, or ZeaGBS..." />
            <button class="gv-query-clear" id="gv-dataset-query-clear" type="button" aria-label="Clear query" hidden>
              <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="gv-examples" aria-label="Example searches">
          <span class="gv-example-label">EXAMPLES&#58;</span>
          <button type="button" class="gv-example-btn" data-gv-example="B73 v5">B73 v5</button>
          <button type="button" class="gv-example-btn" data-gv-example="MaizeGDB 2026">MaizeGDB 2026</button>
          <button type="button" class="gv-example-btn" data-gv-example="Imputation">Imputation</button>
          <button type="button" class="gv-example-btn" data-gv-example="Panzea">Panzea</button>
          <button type="button" class="gv-example-btn" data-gv-example="NAM">NAM</button>
        </div>

        <details class="gv-advanced gv-adv" id="gv-dataset-adv">
          <summary>
            <span class="gv-advanced-label">Advanced search</span>
            <span class="gv-advanced-count" id="gv-dataset-adv-count" hidden>0</span>
          </summary>
          <div class="gv-advanced-body">
            <div class="gv-advanced-grid">
              <div class="mgdb-hub-field">
                <label class="mgdb-label" for="gv-filter-ref">Reference genome</label>
                <select class="mgdb-select" id="gv-filter-ref" name="ref">
                  <option value="">All reference assemblies</option>
                  <option value="B73 v5">B73 RefGen_v5</option>
                  <option value="historical">Historical \(AGPv2, v3, v4\)</option>
                </select>
                <span class="mgdb-hint">Restrict builds to B73 v5 coordinates or historical GBS</span>
              </div>

              <div class="mgdb-hub-field">
                <label class="mgdb-label" for="gv-filter-het">Heterozygous sites</label>
                <select class="mgdb-select" id="gv-filter-het" name="het">
                  <option value="">All builds</option>
                  <option value="yes">Includes heterozygous sites</option>
                </select>
                <span class="mgdb-hint">Filter builds retaining heterozygous genotype calls</span>
              </div>

              <div class="mgdb-hub-field">
                <label class="mgdb-label" for="gv-filter-indels">Indel variants</label>
                <select class="mgdb-select" id="gv-filter-indels" name="indels">
                  <option value="">All builds</option>
                  <option value="yes">Includes small insertions/deletions</option>
                  <option value="no">SNPs only</option>
                </select>
                <span class="mgdb-hint">Include builds with both SNPs and indels</span>
              </div>

              <div class="mgdb-hub-field">
                <label class="mgdb-label" for="gv-filter-imputed">Imputation</label>
                <select class="mgdb-select" id="gv-filter-imputed" name="imputed">
                  <option value="">All builds</option>
                  <option value="yes">Imputed genotypes</option>
                  <option value="no">Raw calls only \(unimputed\)</option>
                </select>
                <span class="mgdb-hint">Filter by algorithmic genotype imputation</span>
              </div>
            </div>

            <div class="gv-advanced-actions">
              <button class="mgdb-button mgdb-button-primary" id="gv-dataset-adv-apply" type="button">Apply filters</button>
              <button class="gv-advanced-reset-btn" id="gv-dataset-adv-reset" type="button">Reset filters</button>
            </div>
          </div>
        </details>
      </form>
    </div>

    <div class="gv-results-toolbar" id="gv-results-toolbar">
      <div class="mgdb-hub-field gv-results-filter">
        <label for="gv-results-filter">Filter these results</label>
        <input id="gv-results-filter" type="search" placeholder="Narrow by build, filter, or notes" autocomplete="off" />
        <span class="mgdb-result-count" id="gv-filter-count" aria-live="polite"></span>
      </div>

      <div class="mgdb-hub-field">
        <label for="gv-page-size">Results shown</label>
        <select class="mgdb-select" id="gv-page-size">
          <option value="10">Top 10</option>
          <option value="25" selected>Top 25</option>
          <option value="50">Top 50</option>
          <option value="all">All builds</option>
        </select>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action gv-results-export">
        <a class="mgdb-button mgdb-button-quiet" id="gv-export-tsv" href="#" download="maizegdb_variant_builds.tsv">Export TSV</a>
      </div>

      <div class="mgdb-hub-field mgdb-hub-field-action gv-results-view">
        <div class="mgdb-view-toggle" role="group" aria-label="Result view">
          <button class="mgdb-view-btn" id="gv-view-cards" type="button" data-view="card" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor"/><rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor"/><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"/></svg>Cards
          </button>
          <button class="mgdb-view-btn is-active" id="gv-view-table" type="button" data-view="table" aria-pressed="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="7" width="14" height="2" rx="1" fill="currentColor"/><rect x="1" y="12" width="14" height="2" rx="1" fill="currentColor"/></svg>Table
          </button>
        </div>
      </div>
    </div>

    <div class="mgdb-table-scroll" id="gv-table-view">
      <table class="mgdb-table gv-dataset-table" data-sortable>
        <caption>
          Variant builds available through SNPVersity 2 and SNPTools
          <span class="mgdb-muted">Accession counts and variant-site counts are published values. Sort columns with header buttons.</span>
        </caption>
        <thead>
          <tr>
            <th scope="col" aria-sort="ascending"><button type="button" data-sort-key="name">Dataset</button></th>
            <th scope="col" aria-sort="none"><button type="button" data-sort-key="ref">Reference</button></th>
            <th scope="col" class="mgdb-numeric" aria-sort="none"><button type="button" data-sort-key="accessions">Accessions</button></th>
            <th scope="col" class="mgdb-numeric" aria-sort="none"><button type="button" data-sort-key="sites">Variant sites</button></th>
            <th scope="col">Key filters</th>
            <th scope="col" class="gv-flag-col" aria-sort="none"><button type="button" data-sort-key="het">Het. sites</button></th>
            <th scope="col" class="gv-flag-col" aria-sort="none"><button type="button" data-sort-key="indels">Indels</button></th>
            <th scope="col" class="gv-flag-col" aria-sort="none"><button type="button" data-sort-key="imputed">Imputation</button></th>
            <th scope="col">Paper</th>
            <th scope="col">Notes</th>
          </tr>
        </thead>
        <tbody id="gv-dataset-rows">
          $(dataset-rows)
        </tbody>
      </table>
    </div>

    <div class="gv-card-grid" id="gv-cards-view" hidden>
      $(dataset-cards)
    </div>

    <div class="mgdb-empty" id="gv-dataset-empty" hidden>
      <h3>No datasets match that filter</h3>
      <p>Clear the search box or reset advanced filters to see every build again.</p>
    </div>
  </section>

  <!-- ====================================================================
       1. Tools & Workspaces
       ==================================================================== -->
  <section id="gv-tools" aria-labelledby="gv-tools-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-tools-title">Tools</h2></div>
    </div>
    <p class="gv-section-lead">Analyze maize variants across shared builds, build targeted VCFs, and explore functional consequences.</p>

    <article class="gv-featured" aria-labelledby="gv-snptools-title">
      <div class="gv-featured-copy">
        <span class="mgdb-pill mgdb-pill-ok">Featured workspace</span>
        <h3 id="gv-snptools-title">SNPTools</h3>
        <p class="gv-featured-lead">One unified workspace for maize SNP discovery, allele exploration, and functional interpretation. Search variants, inspect evidence, compare accessions, and pass selections directly between downstream tools.</p>
        <ul class="gv-feature-list">
          <li><strong>Build a targeted view</strong><span>Select a B73 v5 genomic interval or gene model, then choose accessions from any supported dataset.</span></li>
          <li><strong>Inspect the evidence</strong><span>Explore alleles, predicted variant effects, and DNA/protein language-model scores in one interactive interface.</span></li>
          <li><strong>Connected analysis</strong><span>Download a focused VCF or transfer selections directly to impact, function, structure, and phylogenetic workflows.</span></li>
        </ul>
        <div class="gv-featured-actions">
          <a class="mgdb-button mgdb-button-primary" href="https\://snptools.maizegdb.org/" target="_blank" rel="noopener">Open SNPTools</a>
          <a class="mgdb-button mgdb-button-secondary" href="https\://snptools.maizegdb.org/#help" target="_blank" rel="noopener">Help &amp; FAQ</a>
          <a class="mgdb-button mgdb-button-quiet" href="/ai">AI Resources</a>
        </div>
      </div>
      <div class="gv-workflow" aria-label="SNPTools session workflow">
        <div class="gv-workflow-heading"><span>Connected workflow</span><strong>Start with a region. Continue with evidence.</strong></div>
        <ol>
          <li><span aria-hidden="true">01</span><div><strong>Choose</strong><small>Dataset, interval, gene, and accessions</small></div></li>
          <li><span aria-hidden="true">02</span><div><strong>Explore</strong><small>Variants, alleles, effects, and model scores</small></div></li>
          <li><span aria-hidden="true">03</span><div><strong>Compare</strong><small>Accessions, functional evidence, and relationships</small></div></li>
          <li><span aria-hidden="true">04</span><div><strong>Export</strong><small>Download a focused VCF or continue in another tool</small></div></li>
        </ol>
        <div class="gv-suite-list" aria-label="Applications in the SNPTools suite">
          <span>SNPVersity</span><span>SNPImpact</span><span>SNPFunction</span><span>SNPFold</span><span>SNPCompare</span><span>SNPTrait</span><span>SNPTree</span><span>PanEffect</span>
        </div>
      </div>
    </article>

    <div class="mgdb-card-grid gv-tool-grid">
      <article class="mgdb-card gv-tool-card">
        <span class="mgdb-pill mgdb-pill-info">VCF builder</span>
        <h3>SNPVersity 2</h3>
        <p>Create a custom VCF for any region of B73 v5 across thousands of diverse maize accessions, then view the result as a genotype table, a phylogenetic tree, or an identity-by-state matrix.</p>
        <dl class="gv-tool-facts">
          <div><dt>Release</dt><dd>$(snpv-release), $(snpv-release-date)</dd></div>
          <div><dt>Datasets</dt><dd>$(b73-dataset-count) builds on B73 v5</dd></div>
        </dl>
        <a class="gv-card-cta" href="https\://wgs.maizegdb.org/" target="_blank" rel="noopener">Open SNPVersity 2</a>
      </article>

      <article class="mgdb-card gv-tool-card">
        <span class="mgdb-pill mgdb-pill-warn">Germplasm similarity</span>
        <h3>TYPSimSelector</h3>
        <p>Sort lines from the Ames Diversity Panel &mdash; representing wide genetic diversity in maize &mdash; by identity-by-state similarity against any chosen reference accession.</p>
        <dl class="gv-tool-facts">
          <div><dt>Scores</dt><dd>Identity by state \(PLINK\)</dd></div>
          <div><dt>Data</dt><dd>Genotyping-by-sequencing SNPs</dd></div>
        </dl>
        <a class="gv-card-cta" href="/TYPSimSelector">Open TYPSimSelector <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="mgdb-card gv-tool-card">
        <span class="mgdb-pill mgdb-pill-info">Variant effects</span>
        <h3>PanEffect</h3>
        <p>Visualize predicted effects for every possible missense substitution across B73 proteins, and examine natural variation across the maize pan-genome against that landscape.</p>
        <dl class="gv-tool-facts">
          <div><dt>Scope</dt><dd>B73 v5 proteome</dd></div>
          <div><dt>Integrated</dt><dd>Available inside SNPTools</dd></div>
        </dl>
        <a class="gv-card-cta" href="/effect/maize_v2/">Open PanEffect <span aria-hidden="true">&rarr;</span></a>
      </article>
    </div>
  </section>

  

  <!-- ====================================================================
       3. Public Resequencing Projects
       ==================================================================== -->
  <section id="gv-projects" aria-labelledby="gv-projects-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-projects-title">Projects</h2></div>
    </div>
    <p class="gv-section-lead">Whole-genome resequencing projects for maize and wild relatives. Accessions link to archive records at NCBI, ENA, the NGDC, and CNGB.</p>

    <div class="gv-table-controls gv-project-controls">
      <div class="gv-project-query-wrap">
        <label class="mgdb-visually-hidden" for="gv-project-query">Filter projects</label>
        <div class="gv-query-control gv-project-query-control">
          <svg class="gv-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
          <input class="mgdb-input" id="gv-project-query" type="search" autocomplete="off" placeholder="PRJNA641489, NAM, landrace, European..." />
          <button class="gv-query-clear" id="gv-project-query-clear" type="button" aria-label="Clear project query" hidden>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="mgdb-filters" role="group" aria-label="Filter projects by archive">
        <button class="mgdb-chip gv-example-btn" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="mgdb-chip gv-example-btn" type="button" data-filter="ncbi" aria-pressed="false">NCBI / ENA</button>
        <button class="mgdb-chip gv-example-btn" type="button" data-filter="other" aria-pressed="false">NGDC / CNGB</button>
        <button class="mgdb-button mgdb-button-quiet gv-reset" type="button" id="gv-project-reset" hidden>Reset</button>
      </div>
      <p class="mgdb-result-count" id="gv-project-count" aria-live="polite"></p>
    </div>

    <div class="mgdb-table-scroll">
      <table class="mgdb-table gv-project-table" data-sortable>
        <caption>
          Public projects behind the maize variant collections
          <span class="mgdb-muted">Year is the year MaizeGDB records for the project.</span>
        </caption>
        <thead>
          <tr>
            <th scope="col">Project accession</th>
            <th scope="col" data-sort="text"><button type="button">Project name</button></th>
            <th scope="col" class="mgdb-numeric" data-sort="number"><button type="button">Year</button></th>
            <th scope="col">PubMed</th>
            <th scope="col">DOI</th>
          </tr>
        </thead>
        <tbody id="gv-project-rows">
          $(project-rows)
        </tbody>
      </table>
    </div>

    <div class="mgdb-empty" id="gv-project-empty" hidden>
      <h3>No projects match that filter</h3>
      <p>Clear the search box or choose <strong>All</strong> to see every project again.</p>
    </div>

    <p class="mgdb-small mgdb-muted gv-archive-key">Accession prefixes&#58; <code>PRJNA</code> and <code>PRJEB</code> resolve at NCBI BioProject / ENA&#59; <code>PRJCA</code> at the National Genomics Data Hub&#59; <code>CNP</code> at the China National GeneBank.</p>
  </section>

  <!-- ====================================================================
       4. Downloads & Public Globus Endpoint
       ==================================================================== -->
  <section id="gv-downloads" aria-labelledby="gv-downloads-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-downloads-title">Downloads</h2></div>
    </div>
    <p class="gv-section-lead">Filtered variant builds download directly. Large whole-genome datasets are available via Box and the upcoming Public Globus collection.</p>

    <div class="gv-downloads-layout">
      <div class="gv-globus-card">
        <span class="mgdb-pill mgdb-pill-ok">High-Speed Transfer</span>
        <h3>Public Globus Endpoint</h3>
        <p>Maize variant builds are transitioning to a public Globus collection. Open to anyone with a free Globus account &mdash; no MaizeGDB login required, no individual access forms, and automatic resumed transfers for multi-hundred-gigabyte VCFs.</p>
        <div class="gv-globus-features">
          <div><strong>Fast</strong><span>High-throughput grid transfers</span></div>
          <div><strong>Reliable</strong><span>Resumable interrupted downloads</span></div>
          <div><strong>Direct</strong><span>Full VCF and score matrices</span></div>
        </div>
      </div>

      <div class="mgdb-resource-panel gv-direct-downloads">
        <div class="mgdb-resource-list">
          <a href="https\://wgs.maizegdb.org/#download" target="_blank" rel="noopener">
            <strong>SNPVersity 2 Downloads</strong>
            <span>Filtered builds on Box with MD5 checksums.</span>
          </a>
          <a href="https\://iastate.app.box.com/v/maizegdb-public/folder/323422312050" target="_blank" rel="noopener">
            <strong>Schnable 2023 Imputation</strong>
            <span>46M high-quality SNPs across 1,515 accessions.</span>
          </a>
          <a href="https\://iastate.box.com/s/hle6ukv1i1ybu4dqjcqhdzxusvj7bj1a" target="_blank" rel="noopener">
            <strong>PlantCaduceus DNA Scores</strong>
            <span>Genomic sequence language-model fitness scores.</span>
          </a>
          <a href="https\://iastate.box.com/s/qyrg2q005xaoek4yz3wxot6dtusye10b" target="_blank" rel="noopener">
            <strong>ESM Protein Scores</strong>
            <span>Alternate amino acid log-likelihood ratios \(ESM family\).</span>
          </a>
          <a href="https\://www.panzea.org/genotypes" target="_blank" rel="noopener">
            <strong>Panzea Genotypes &amp; GBS</strong>
            <span>HapMap1-3 and GBS v2.7 in AGPv2-v4 coordinates.</span>
          </a>
          <a href="https\://download.maizegdb.org/SNPs_and_Maps/Traits">
            <strong>IBM &amp; NAM Trait Values</strong>
            <span>Raw text trait measurements for mapping populations.</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mgdb-note mgdb-note-info gv-note">
      <p><strong>Transfer advisory&#58;</strong> Verify local disk storage before downloading large multi-gigabyte VCFs, use a wired connection with download managers that support resume, and always verify published checksums upon completion.</p>
    </div>
  </section>

  <!-- ====================================================================
       5. Types of Variation Data
       ==================================================================== -->
  <section id="gv-about" aria-labelledby="gv-about-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-about-title">About</h2></div>
    </div>

    <div class="gv-types-grid">
      <article class="gv-type-card">
        <h3>Sequence variation</h3>
        <ul class="mgdb-list">
          <li>Single nucleotide polymorphisms \(SNPs\) &amp; indels</li>
          <li>Copy number variations \(CNVs\)</li>
          <li>Presence/absence variations \(PAVs\)</li>
          <li>Complex alleles &amp; alternative loci</li>
          <li>Unmapped sequence contigs</li>
          <li>Inversion breakpoints</li>
        </ul>
        <p class="gv-type-where">In <a href="https\://snptools.maizegdb.org/" target="_blank" rel="noopener">SNPTools</a>, <a href="https\://wgs.maizegdb.org/" target="_blank" rel="noopener">SNPVersity 2</a>, and <a href="/data_center/variation">Alleles &amp; Polymorphisms</a>.</p>
      </article>

      <article class="gv-type-card">
        <h3>Phenotype and germplasm</h3>
        <ul class="mgdb-list">
          <li>Curated mutant phenotypes &amp; descriptions</li>
          <li>Germplasm accessions with GRIN passport data</li>
          <li>IBM &amp; NAM population trait measurements</li>
          <li>Genetic linkage maps &amp; marker positions</li>
        </ul>
        <p class="gv-type-where">In the <a href="/data_center/phenotype">Phenotype</a>, <a href="/data_center/stock">Stock</a>, and <a href="/data_center/map">Map</a> data hubs.</p>
      </article>

      <article class="gv-type-card">
        <h3>Sequence and expression</h3>
        <ul class="mgdb-list">
          <li>Transcript assembly &amp; exome alignments</li>
          <li>GenBank exome and full-length cDNA sequences</li>
          <li>Tissue expression across developmental stages</li>
        </ul>
        <p class="gv-type-where">Through <a href="/gene_center/gene">Gene</a> records and the <a href="/expression">Expression Atlas</a>.</p>
      </article>
    </div>
  </section>

  <!-- ====================================================================
       6. References
       ==================================================================== -->
  <section id="gv-references" aria-labelledby="gv-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <!-- ====================================================================
       6. Corpus Summary / Statistics \(second to last item\)
       ==================================================================== -->
  <section id="gv-metrics" aria-labelledby="gv-metrics-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-metrics-title">Metrics</h2></div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <span class="mgdb-metric-icon" aria-hidden="true">SNP</span>
        <div><strong class="mgdb-metric-value">$(max-variants)</strong><h3>Variant sites</h3><p>In the largest build, MaizeGDB 2026 \(High Coverage\). The LD-filtered build keeps $(hq-variants).</p></div>
      </article>
      <article class="mgdb-metric mgdb-tone-amber">
        <span class="mgdb-metric-icon" aria-hidden="true">Acc</span>
        <div><strong class="mgdb-metric-value">$(max-accessions)</strong><h3>Accessions genotyped</h3><p>Diverse maize lines in the 2026 collection, up from $(prev-accessions) in 2024.</p></div>
      </article>
      <article class="mgdb-metric mgdb-tone-blue">
        <span class="mgdb-metric-icon" aria-hidden="true">Bld</span>
        <div><strong class="mgdb-metric-value">$(dataset-count)</strong><h3>Variant builds</h3><p>$(b73-dataset-count) called against B73 v5, plus historical GBS in AGPv2-v4 coordinates.</p></div>
      </article>
      <article class="mgdb-metric mgdb-tone-burgundy">
        <span class="mgdb-metric-icon" aria-hidden="true">Prj</span>
        <div><strong class="mgdb-metric-value">$(project-count)</strong><h3>Public projects</h3><p>Resequencing projects at NCBI, ENA, NGDC and CNGB whose reads underpin these calls.</p></div>
      </article>
    </div>
  </section>

  <!-- ====================================================================
       7. Connected Resources & Contributor Submission \(final item, light green\)
       ==================================================================== -->
  <section id="gv-related" class="mgdb-hub-related" aria-labelledby="gv-related-title">
    <div class="mgdb-section-heading">
      <div><h2 id="gv-related-title">Related resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/variation">
          <strong>Variation Data Hub</strong>
          <span>Curated variation records, alleles, and linked genetic loci</span>
        </a>
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>Gene annotations, functional descriptions, and expression</span>
        </a>
        <a href="/uniformmu">
          <strong>Insertion Data Hub</strong>
          <span>Sequence-indexed transposon insertions and mutant stocks</span>
        </a>
        <a href="/data_center/protein_structure">
          <strong>Protein structures</strong>
          <span>Predicted 3D structures to assess missense variant impacts</span>
        </a>
        <a href="/genome">
          <strong>Genome Data Hub</strong>
          <span>B73 v5, NAM founder lines, and pan-genome assemblies</span>
        </a>
      </div>
    </div>

    <div class="gv-contribute-banner">
      <div>
        <h3>Submitting variation datasets</h3>
        <p>MaizeGDB welcomes SNP, indel, and trait datasets from the maize community. If you have new resequencing data to deposit or a published project to index, reach out to our curation team.</p>
      </div>
      <div class="gv-contribute-actions">
        <a class="mgdb-button mgdb-button-primary" href="/contact">Contact Curation Team</a>
        <a class="mgdb-button mgdb-button-secondary" href="/nomenclature">Naming Conventions</a>
      </div>
    </div>
  </section>

</main>
)
