$$SYNTAX-LEVEL 2
*(mgdb-gene-product-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No gene product found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="gp-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/gene_product">Gene Product Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="gp-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="gp-notfound-title">No gene product matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB has $(total_products) curated gene products. None of them carries that name, synonym, or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="gp-notfound-search" aria-labelledby="gp-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="gp-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/gene_product" method="get" role="search">
      <label class="mgdb-visually-hidden" for="gp-notfound-query">Gene product name, EC number, synonym, or encoding locus</label>
      <input class="mgdb-input" id="gp-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Gene product name, EC number, synonym, or encoding locus" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search gene products</button>
    </form>
    <p class="mgdb-rec-examples">
      <span>Try an example&#58;</span>
      <a class="mgdb-rec-example" href="/data_center/gene_product?id=alcohol%20dehydrogenase">alcohol dehydrogenase</a>
      <a class="mgdb-rec-example" href="/data_center/gene_product?id=ferritin">ferritin</a>
      <a class="mgdb-rec-example" href="/data_center/gene_product?id=kinesin">kinesin</a>
      <a class="mgdb-rec-example" href="/data_center/gene_product?id=58066">58066</a>
    </p>
    <p class="mgdb-rec-hint">A record page needs a gene product name, one of its synonyms, or its MaizeGDB ID. Gene symbols such as <em>adh1</em> name a locus, not a product&#58; the locus record lists the products it encodes.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="gp-notfound-resources" aria-labelledby="gp-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="gp-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/gene_product">
          <strong>Gene Product Data Hub</strong>
          <span>Search all curated gene products by name, EC number, class, localization, or pathway</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>Classical loci and the gene models that represent them across assemblies</span>
        </a>
        <a href="/metabolic_pathways">
          <strong>Metabolic Pathways</strong>
          <span>Curated maize pathways and the reactions and enzymes they comprise</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across genes, loci, stocks, references, and every other data type</span>
        </a>
        <a href="https\://www.uniprot.org/" target="_blank" rel="noopener">
          <strong>UniProt</strong>
          <span>Protein sequence and functional annotation beyond the MaizeGDB collection</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
