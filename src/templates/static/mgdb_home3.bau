$$SYNTAX-LEVEL 2
*(mgdb-home
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/">
<meta property="og:title" content="MaizeGDB — Maize Genetics and Genomics Database">
<meta property="og:description" content="The community database for maize genetics and genomics: genome assemblies, gene models, seed stocks, and curated literature, with the tools to search them.">

<main class="mgdb-page mgdb-home-page mgdb-home-v3">

  <!-- The default homepage wears .mgdb-hero-record, the same component the gene,
       stock, map, and reference record pages use: an eyebrow, a title, and a
       definition list of facts. That reads as database metadata, which is right
       on a record and cold on a front door. This is a welcome instead -- a warm
       ground, a sentence saying what the place is, and the release facts
       demoted to one quiet line underneath. -->
  <!-- The default homepage wears .mgdb-hero-record, the same component the gene,
       stock, map, and reference record pages use: an eyebrow, a title, and a
       definition list of facts. That reads as database metadata, which is right
       on a record and cold on a front door. This is a welcome instead, and it is
       deliberately short -- the quick links are what people came for, so the
       header earns its height and then gets out of the way. -->
  <header class="mgdb-home3-hero">
    <div class="mgdb-home3-hero-inner">
      <p class="mgdb-home3-kicker">Maize genetics and genomics database</p>
      <h1>Welcome to MaizeGDB</h1>
      <p class="mgdb-home3-lede">MaizeGDB is a community-oriented, long-term, federally funded
        informatics service to researchers focused on the crop plant and model organism
        <i>Zea mays</i>.</p>
      <p class="mgdb-home3-links">
        <a href="$(server-url)/contribute_data">Contribute your data</a>
        <a href="$(server-url)/cite">Cite MaizeGDB</a>
        <a href="$(server-url)/contact">Contact us</a>
      </p>
      <p class="mgdb-home3-stamp">
        <span>Release <strong>$(release_date)</strong></span>
        <span>Next update <strong>$(next_update)</strong></span>
        <span>Reference <strong>B73 RefGen_v5</strong></span>
      </p>
    </div>
    <!-- The kernels from the MaizeGDB mark. Decorative, so it carries an empty
         alt and aria-hidden -- the wordmark in the chrome already names the site. -->
    <img class="mgdb-home3-hero-art" src="/images/kernels.png" alt="" aria-hidden="true"
         width="368" height="213" decoding="async" />
  </header>

  <div class="mgdb-home-layout">

    <section aria-labelledby="home-index-title">
      <div class="mgdb-home-index-heading">
        <div>
          <h2 id="home-index-title">Quick links</h2>
        </div>
        <div class="mgdb-home-index-controls">
          <div class="mgdb-view-toggle" role="group" aria-label="Choose how resources are shown">
            <button type="button" class="mgdb-view-button is-active" data-home-view="grid" aria-pressed="true">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
              Quick links
            </button>
            <button type="button" class="mgdb-view-button" data-home-view="list" aria-pressed="false">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><rect x="1" y="2" width="3" height="3" rx="0.5"/><rect x="6" y="2.75" width="9" height="1.5" rx="0.75"/><rect x="1" y="7" width="3" height="3" rx="0.5"/><rect x="6" y="7.75" width="9" height="1.5" rx="0.75"/><rect x="1" y="12" width="3" height="3" rx="0.5"/><rect x="6" y="12.75" width="9" height="1.5" rx="0.75"/></svg>
              List
            </button>
          </div>
        </div>
      </div>
      <ul class="mgdb-quicklinks" data-home-panel="grid">
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/genomebrowser">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/genomebrowser.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Genome Browsers</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(blast_url)">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/blast.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">BLAST</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/gene_center">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/gene_center.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Gene Center</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/pan_gene_center">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/pan_genes.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Pan-genes</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/genome">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/genome.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Genomes</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/NAM_project">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/NAM.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">NAM Genomes</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/PanAnd_project">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/pannad.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">PanAnd Genomes</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/genetic_variation">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/variation.png$(ql_version)" alt="" width="128" height="128" loading="eager" fetchpriority="high" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Genetic Variation</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/data_center/protein_structure">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/protein.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Protein Structures</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/data_center/phenotype">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/phenotype.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Mutants & Phenotypes</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/new_genes">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/new_genes.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">New Genes</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/ai">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/AI.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">AI & Machine Learning</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/metabolic_pathways">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/pathway.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Metabolic Pathways</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="https://qteller.maizegdb.org" target="_blank" rel="noopener">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/qteller.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">qTeller <span class="mgdb-quicklink-ext" aria-hidden="true">&nearr;</span></strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="https://maizemine.rnet.missouri.edu/maizemine/" target="_blank" rel="noopener">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/maize_mine.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">MaizeMine <span class="mgdb-quicklink-ext" aria-hidden="true">&nearr;</span></strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/nomenclature">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/nomenclature.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Nomenclature</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/download">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/download.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Downloads</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/hot_new_papers">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/editorial_board.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">Editorial Board</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="$(server-url)/mgec">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/mgec.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">MGEC</strong>
            </span>
          </a>
        </li>
        <li>
          <a class="mgdb-quicklink" href="https://www.agbiodata.org" target="_blank" rel="noopener">
            <span class="mgdb-quicklink-art">
              <img src="/images/quicklinks/agbiodata.png$(ql_version)" alt="" width="128" height="128" loading="lazy" decoding="async" />
            </span>
            <span class="mgdb-quicklink-text">
              <strong class="mgdb-quicklink-label">AgBioData <span class="mgdb-quicklink-ext" aria-hidden="true">&nearr;</span></strong>
            </span>
          </a>
        </li>
      </ul>

      <div class="mgdb-index" data-home-panel="list" hidden>

        <h3 class="mgdb-index-band" id="home-band-tools">Tools</h3>
        <div role="list" aria-labelledby="home-band-tools">
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/genomebrowser">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-genome-browsers"></use></svg></span>
            <strong>Genome Browsers</strong>
            <span class="mgdb-index-desc">JBrowse tracks for every assembly</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(blast_url)">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-sequences"></use></svg></span>
            <strong>BLAST</strong>
            <span class="mgdb-index-desc">Align a sequence to maize databases</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://snptools.maizegdb.org" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-variations-and-alleles"></use></svg></span>
            <strong>SNPTools</strong>
            <span class="mgdb-index-desc">Variant browsing and AI score tracks</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://pangenome-viewer.maizegdb.org" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-pan-genome-graphs"></use></svg></span>
            <strong>Pan-genome viewer</strong>
            <span class="mgdb-index-desc">Compare structure across genomes</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://qteller.maizegdb.org" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-gene-expression-profile"></use></svg></span>
            <strong>qTeller</strong>
            <span class="mgdb-index-desc">Compare expression across experiments</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://maizemine.rnet.missouri.edu/maizemine/" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-maizemine"></use></svg></span>
            <strong>MaizeMine</strong>
            <span class="mgdb-index-desc">Build and export custom queries</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://feta.maizegdb.org" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-gene-enrichment-feta"></use></svg></span>
            <strong>Gene Enrichment</strong>
            <span class="mgdb-index-desc">GO and pathway enrichment testing</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://phylostrata.maizegdb.org" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="gene_product" aria-hidden="true"><svg focusable="false"><use href="#mzg-gene-evolution"></use></svg></span>
            <strong>Phylostrata</strong>
            <span class="mgdb-index-desc">Evolutionary age of gene families</span>
          </a>
        </div>

        <h3 class="mgdb-index-band" id="home-band-data">Data</h3>
        <div role="list" aria-labelledby="home-band-data">
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/NAM_project">
            <span class="mgdb-search-icon" data-cat="genome" aria-hidden="true"><svg focusable="false"><use href="#mzg-nam-genomes"></use></svg></span>
            <strong>NAM Genomes</strong>
            <span class="mgdb-index-desc">The 26 founder-line assemblies</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/PanAnd_project">
            <span class="mgdb-search-icon" data-cat="genome" aria-hidden="true"><svg focusable="false"><use href="#mzg-panand-genomes"></use></svg></span>
            <strong>PanAnd Genomes</strong>
            <span class="mgdb-index-desc">Andropogoneae comparative set</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/pan_gene_center/pan_gene">
            <span class="mgdb-search-icon" data-cat="genome" aria-hidden="true"><svg focusable="false"><use href="#mzg-pan-genes"></use></svg></span>
            <strong>Pan-genes</strong>
            <span class="mgdb-index-desc">Orthology across the pan-genome</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/gene_center/gene">
            <span class="mgdb-search-icon" data-cat="genome" aria-hidden="true"><svg focusable="false"><use href="#mzg-genes"></use></svg></span>
            <strong>Gene Center</strong>
            <span class="mgdb-index-desc">One report page per gene model</span>
          </a>
        </div>

        <h3 class="mgdb-index-band" id="home-band-resources">Resources</h3>
        <div role="list" aria-labelledby="home-band-resources">
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/ai">
            <span class="mgdb-search-icon" data-cat="stock" aria-hidden="true"><svg focusable="false"><use href="#mzg-artificial-intelligence"></use></svg></span>
            <strong>Artificial Intelligence</strong>
            <span class="mgdb-index-desc">Model-derived predictions and scores</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/download">
            <span class="mgdb-search-icon" data-cat="stock" aria-hidden="true"><svg focusable="false"><use href="#mzg-datasets-and-downloads"></use></svg></span>
            <strong>Downloads</strong>
            <span class="mgdb-index-desc">Bulk sequence and annotation files</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/data_center/protein_structure">
            <span class="mgdb-search-icon" data-cat="stock" aria-hidden="true"><svg focusable="false"><use href="#mzg-protein-structures"></use></svg></span>
            <strong>Protein Structures</strong>
            <span class="mgdb-index-desc">Predicted folds and domain annotation</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/new_genes">
            <span class="mgdb-search-icon" data-cat="stock" aria-hidden="true"><svg focusable="false"><use href="#mzg-new-genes"></use></svg></span>
            <strong>Newly Characterized Genes</strong>
            <span class="mgdb-index-desc">Recently described maize genes</span>
          </a>
        </div>

        <h3 class="mgdb-index-band" id="home-band-community">Community</h3>
        <div role="list" aria-labelledby="home-band-community">
          <a class="mgdb-index-row" role="listitem" href="https://www.mgcmeeting.com" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="reference" aria-hidden="true"><svg focusable="false"><use href="#mzg-maize-genetics-meeting"></use></svg></span>
            <strong>Maize Meeting</strong>
            <span class="mgdb-index-desc">Annual conference and archive</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://www.maizegenetics.org" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="reference" aria-hidden="true"><svg focusable="false"><use href="#mzg-maize-genetics-cooperation"></use></svg></span>
            <strong>Maize Genetics Cooperation</strong>
            <span class="mgdb-index-desc">Stock center and newsletter</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="$(server-url)/hot_new_papers">
            <span class="mgdb-search-icon" data-cat="reference" aria-hidden="true"><svg focusable="false"><use href="#mzg-editorial-board-papers"></use></svg></span>
            <strong>Editorial Board papers</strong>
            <span class="mgdb-index-desc">Curated picks from the literature</span>
          </a>
          <a class="mgdb-index-row" role="listitem" href="https://www.agbiodata.org" target="_blank" rel="noopener">
            <span class="mgdb-search-icon" data-cat="reference" aria-hidden="true"><svg focusable="false"><use href="#mzg-agbiodata"></use></svg></span>
            <strong>AgBioData</strong>
            <span class="mgdb-index-desc">Cross-database FAIR data consortium</span>
          </a>
        </div>

      </div>
    </section>

    <aside class="mgdb-home-rail" aria-label="News and shortcuts">

      <!-- The Reference Assembly block from the production homepage, rebuilt.
           There it was three images with their captions baked in -- 75px PNGs
           reading "B73 ASSEMBLY", "B73 ANNOTATION", "ALL GENOMES" -- which is
           illegible on a phone and invisible to a screen reader. The puzzle art
           is the recognizable part, so it leads as the section emblem and the
           three destinations become real text. Same three links as production. -->
      <div class="mgdb-aside-card mgdb-refassembly">
        <h2>Reference assembly</h2>
        <div class="mgdb-refassembly-head">
          <img src="/images/home/assembly_puzzle.png" alt="" aria-hidden="true"
               width="160" height="160" loading="lazy" decoding="async" />
          <div>
            <strong>B73 RefGen_v5</strong>
            <span>The current MaizeGDB reference</span>
          </div>
        </div>
        <ul class="mgdb-refassembly-links">
          <li><a href="$(server-url)/assembly">B73 assembly<span>How the reference was chosen</span></a></li>
          <li><a href="$(server-url)/gene_center/gene">B73 annotation<span>Gene models on the reference</span></a></li>
          <li><a href="$(server-url)/genome">All genomes<span>Every assembly hosted here</span></a></li>
        </ul>
      </div>

      <div class="mgdb-aside-card">
        <h2>MaizeGDB news</h2>
        <ul class="mgdb-home-news">
          $(news_items)
        </ul>
        <p class="mgdb-home-news-more"><a href="$(server-url)/whatsnew">More news &middot; Archive</a></p>
      </div>

      <div class="mgdb-panel mgdb-home-crops-panel">
        <div class="mgdb-home-crops-header">
          <h2 class="mgdb-home-rail-title">USDA crop databases</h2>
          <a class="mgdb-home-usda-link" href="https://www.usda.gov/" target="_blank" rel="noopener" title="United States Department of Agriculture">
            <img src="/images/USDA.png" alt="United States Department of Agriculture" height="38" />
          </a>
        </div>
        <div class="mgdb-home-crops-links">
          <a class="mgdb-crop-chip" href="https://wheat.pw.usda.gov/GG3/" target="_blank" rel="noopener">GrainGenes <span aria-hidden="true">&#8599;</span></a>
          <a class="mgdb-crop-chip" href="https://sorghumbase.org/" target="_blank" rel="noopener">SorghumBase <span aria-hidden="true">&#8599;</span></a>
          <a class="mgdb-crop-chip" href="https://soybase.org/" target="_blank" rel="noopener">SoyBase <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>

    </aside>
  </div>

  <!-- The metric cards carry h3 headings, from the shared .mgdb-metric
       component. Elsewhere they sit under a section h2; the design gives this
       strip no visible heading, so one is supplied for the outline only —
       without it the document skips from h1 straight to h3. -->
  <h2 class="mgdb-visually-hidden">MaizeGDB at a glance</h2>
  <div class="mgdb-metric-grid mgdb-home-metrics">
    <article class="mgdb-metric mgdb-tone-green">
      <span class="mgdb-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" focusable="false"><use href="#mzg-genomes"></use></svg></span>
      <div>
        <strong class="mgdb-metric-value">$(metric_assemblies)</strong>
        <h3>Genome assemblies</h3>
        <p>Completed <i>Zea mays</i> assemblies hosted here</p>
      </div>
    </article>
    <article class="mgdb-metric mgdb-tone-amber">
      <span class="mgdb-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" focusable="false"><use href="#mzg-genes"></use></svg></span>
      <div>
        <strong class="mgdb-metric-value">$(metric_genes)</strong>
        <h3>B73 gene models</h3>
        <p>Zm00001eb annotation set</p>
      </div>
    </article>
    <article class="mgdb-metric">
      <span class="mgdb-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" focusable="false"><use href="#mzg-stocks-and-germplasm"></use></svg></span>
      <div>
        <strong class="mgdb-metric-value">$(metric_stocks)</strong>
        <h3>Seed stocks</h3>
        <p>Orderable from the COOP</p>
      </div>
    </article>
    <article class="mgdb-metric mgdb-tone-burgundy">
      <span class="mgdb-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="21" height="21" focusable="false"><use href="#mzg-references"></use></svg></span>
      <div>
        <strong class="mgdb-metric-value">$(metric_references)</strong>
        <h3>References</h3>
        <p>Curated maize literature</p>
      </div>
    </article>
  </div>
</main>
)
