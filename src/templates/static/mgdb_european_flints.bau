  <!-- SECTION 5: SCALE & GENOMIC METRICS DASHBOARD -->
  <section id="flints-metrics" class="mgdb-panel" aria-labelledby="flints-metrics-title">
    <div class="flints-panel-header-wrap">
      <div>
        <h2 id="flints-metrics-title" class="mgdb-panel-title">European Flint Dataset Scale &amp; Metrics</h2>
        <p class="mgdb-panel-lead">Summary metrics across the European flint de novo assemblies, genome coverage, and annotations.</p>
      </div>
