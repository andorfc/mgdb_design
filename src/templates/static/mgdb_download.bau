<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/download">
<meta property="og:title" content="Bulk Downloads &amp; Globus Data Portal | MaizeGDB">
<meta property="og:description" content="Download maize reference genomes, NAM founders, Pan-Andropogoneae wild relatives, AI/ML models, variant matrices, and functional data tracks via Globus high-speed endpoints and HTTP bulk servers.">

<main class="mgdb-page mgdb-download-page" id="download-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center">Data centers</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Bulk Downloads &amp; Globus</span>
  </nav>

  <!-- HERO SECTION -->
  <section class="mgdb-hero" aria-labelledby="download-title">
    <div class="mgdb-hero-emblem">
      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Cloud outline & base server layers -->
        <path d="M48 38C52.4183 38 56 34.4183 56 30C56 25.8254 52.8021 22.3978 48.7188 22.0368C47.8016 15.1741 41.9366 10 34.8 10C28.6186 10 23.3601 13.9161 21.464 19.467C20.3541 19.1607 19.1934 19 18 19C12.4772 19 8 23.4772 8 29C8 34.2045 11.9796 38.4807 17.0652 38.9507" stroke="#1b5e20" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Download Arrow -->
        <path d="M32 24V46M32 46L23 37M32 46L41 37" stroke="#2e7d32" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Storage Base Trays -->
        <path d="M12 50H52M16 56H48" stroke="#f59e0b" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <strong>Bulk<br />Downloads</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; $(data_date)</p>
      <h1 id="download-title">MaizeGDB Bulk Downloads &amp; Globus Data Portal</h1>
      <p class="mgdb-hero-description">High-performance data distribution environments for maize reference assemblies, pan-genomes, functional track packages, large variant matrices, AI models, and curated community dataset archives.</p>
    </div>
  </section>

  <!-- STICKY SECTION TABS -->
  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#downloads-globus" class="is-current">Globus High-Speed Endpoint</a>
    <a href="#downloads-server">HTTP Bulk Server</a>
