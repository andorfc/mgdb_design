  <!-- SECTION 7: THEMATIC FUNCTIONAL DATASETS & AI MODELS -->
  <section id="downloads-thematic" class="mgdb-panel" aria-labelledby="downloads-thematic-heading">
    <h2 id="downloads-thematic-heading" class="mgdb-panel-title">Thematic Functional Datasets, AI Models &amp; Archives</h2>
    <p class="mgdb-panel-lead">Curated collections spanning machine learning weights, variant catalogs, transcriptomics matrices, mutagenesis libraries, and phenotypic images.</p>

    <div class="thematic-grid">
      <!-- 1: AI / Machine Learning -->
      <article class="thematic-card">
        <div class="thematic-badge thematic-badge-green">AI &amp; Models</div>
        <h3 class="thematic-title">Artificial Intelligence &amp; ML Models</h3>
        <p class="thematic-desc">Trained deep learning model weights, embeddings, benchmark training/validation splits, and pipeline inference outputs.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://iastate.app.box.com/v/maizegdb-public/folder/323424248589" target="_blank" rel="noopener">Box Repository &#8599;</a>
          <a class="thematic-link" href="#downloads-globus">Globus Endpoint &uarr;</a>
        </div>
      </article>

      <!-- 2: SNPs & Maps -->
      <article class="thematic-card">
        <div class="thematic-badge thematic-badge-gold">Genotyping</div>
        <h3 class="thematic-title">SNPs, Genetic Maps &amp; Genotypes</h3>
        <p class="thematic-desc">HapMap VCFs, high-density SNP genotyping arrays, recombination genetic maps, and marker coordinate mapping files.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/SNPs_and_Maps/" target="_blank" rel="noopener">Browse SNP Downloads &#8599;</a>
        </div>
      </article>

      <!-- 3: Expression -->
      <article class="thematic-card">
        <div class="thematic-badge thematic-badge-blue">Transcriptomics</div>
        <h3 class="thematic-title">Gene Function &amp; Expression</h3>
        <p class="thematic-desc">Multi-tissue developmental RNA-seq expression TPM matrices, qTeller raw counts, and functional GO/pathway annotations.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/GeneFunction_and_Expression/" target="_blank" rel="noopener">Browse Expression Files &#8599;</a>
        </div>
      </article>

      <!-- 4: Insertions -->
      <article class="thematic-card">
        <div class="thematic-badge thematic-badge-purple">Mutagenesis</div>
        <h3 class="thematic-title">Transposon Insertions &amp; Mutants</h3>
        <p class="thematic-desc">Sequence-indexed <em>UniformMu</em> flanking sequence tags, Ac/Ds insertion coordinates, and rescue clone data.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/Insertions/" target="_blank" rel="noopener">Browse Insertion Data &#8599;</a>
        </div>
      </article>

      <!-- 5: Domestication -->
      <article class="thematic-card">
        <div class="thematic-badge">Evolution</div>
        <h3 class="thematic-title">Maize Domestication Traits</h3>
        <p class="thematic-desc">Morphological trait measurements, archaeological cob metrics, and selection sweep datasets comparing maize and teosinte.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/Maize_Domestication_Traits/" target="_blank" rel="noopener">Browse Domestication Data &#8599;</a>
        </div>
      </article>

      <!-- 6: Metabolic -->
      <article class="thematic-card">
        <div class="thematic-badge">Biochemistry</div>
        <h3 class="thematic-title">Metabolic Pathways \(CornCyc\)</h3>
        <p class="thematic-desc">Pathway/Genome Databases \(PGDBs\), enzymatic reactions, metabolite cross-references, and BioCyc flat files.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/MetabolicResources/" target="_blank" rel="noopener">Browse CornCyc Resources &#8599;</a>
        </div>
      </article>

      <!-- 7: Neuffer Images -->
      <article class="thematic-card">
        <div class="thematic-badge">Phenomics</div>
        <h3 class="thematic-title">Neuffer Mutant Image Collection</h3>
        <p class="thematic-desc">High-resolution photographic slide collection documenting classic morphological maize mutants across ear, tassel, and leaf phenotypes.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/Neuffer_Mutant_Images/" target="_blank" rel="noopener">Browse Image Archives &#8599;</a>
        </div>
      </article>

      <!-- 8: Templates -->
      <article class="thematic-card">
        <div class="thematic-badge">Curation</div>
        <h3 class="thematic-title">Community Data Submission Templates</h3>
        <p class="thematic-desc">Standardized Excel and TSV templates for submitting QTL, loci, stocks, phenotypic measurements, and mapping data to MaizeGDB.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/data_templates/" target="_blank" rel="noopener">Browse Submission Templates &#8599;</a>
        </div>
      </article>

      <!-- 9: Archives -->
      <article class="thematic-card">
        <div class="thematic-badge">Historical</div>
        <h3 class="thematic-title">Historical Database Archives</h3>
        <p class="thematic-desc">Past releases of MaizeDB, BAC clone fingerprinting tables, SSR marker maps, and legacy curation snapshots.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/Archive/" target="_blank" rel="noopener">Browse Historical Archives &#8599;</a>
        </div>
      </article>

      <!-- 10: Supplementary -->
      <article class="thematic-card">
        <div class="thematic-badge">Publications</div>
        <h3 class="thematic-title">Supplementary Publication Files</h3>
        <p class="thematic-desc">Author-contributed data tables, supplementary protocols, scripts, and figure datasets linked from community literature.</p>
        <div class="thematic-links">
          <a class="thematic-link" href="https://download.maizegdb.org/supplementary_files/" target="_blank" rel="noopener">Browse Supplementary Files &#8599;</a>
        </div>
      </article>
    </div>
  </section>

