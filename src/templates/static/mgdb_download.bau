$$SYNTAX-LEVEL 2
*(mgdb-download
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/download">
<meta property="og:title" content="Bulk Downloads &amp; Globus Data Portal | MaizeGDB">
<meta property="og:description" content="Download maize reference genomes, NAM founders, Pan-Andropogoneae wild relatives, AI/ML models, variant matrices, and functional data tracks via Globus high-speed endpoints and HTTP bulk servers.">

<main class="mgdb-page mgdb-download-page" id="download-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Bulk Downloads &amp; Globus</span>
  </nav>

  <!-- HERO SECTION -->
  <section class="mgdb-hero" aria-labelledby="download-title">
    <div class="mgdb-hero-emblem">
      <img src="/images/quicklinks/download.png" alt="" width="64" height="64">
      <strong>Bulk<br />Downloads</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; $(data_date)</p>
      <h1 id="download-title">MaizeGDB Bulk Downloads &amp; Globus Data Portal</h1>
      <p class="mgdb-hero-description">High-performance data distribution environments for maize reference assemblies, pan-genomes, functional track packages, large variant matrices, AI models, and curated community dataset archives.</p>
    </div>
  </section>

  <!-- STICKY SECTION TABS -->
  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#downloads-sources" class="is-current">Download source</a>
    <a href="#downloads-quick">B73 v5 quick downloads</a>
    <a href="#downloads-finder">Genome file finder</a>
    <a href="#downloads-b73">B73 Reference Genomes</a>
    <a href="#downloads-nam">NAM Founder Genomes</a>
    <a href="#downloads-panand">Pan-Andropogoneae &amp; Relatives</a>
    <a href="#downloads-inbreds">Diverse Inbreds</a>
    <a href="#downloads-thematic">Functional &amp; AI Datasets</a>
    <a href="#downloads-overview">Statistics</a>
    <a href="#downloads-related">Connected Resources</a>
  </nav>

  <!-- SECTION 1: CHOOSE A DOWNLOAD SOURCE -->
  <section id="downloads-sources" class="mgdb-panel" aria-labelledby="downloads-sources-heading">
    <h2 id="downloads-sources-heading" class="mgdb-panel-title">Choose a download source</h2>

    <div class="source-grid">

      <!-- Source 1: FTP -->
      <article class="source-card">
        <h3 class="source-card-title"><a class="source-card-main" href="https://ftp.maizegdb.org/" target="_blank" rel="noopener">
          <img class="source-card-icon" src="/images/maize_download.png" alt="">
          <span class="source-card-id">
            <span class="source-card-name">MaizeGDB FTP</span>
            <code class="source-card-host">ftp.maizegdb.org</code>
          </span>
        </a></h3>
        <p class="source-card-desc">The complete MaizeGDB file tree, served over HTTPS. Genome assemblies and annotations sit under <code>/downloads/</code>, which is also reachable as <code>download.maizegdb.org</code>. The rest of the tree holds bulk data sets, MGSC and MIPS repeat files, BLAST databases, and the Maize Genetics Cooperation Newsletter archive.</p>
        <dl class="source-card-facts">
          <div><dt>Best for</dt><dd>Single files, scripted <code>wget</code> and <code>curl</code> retrieval</dd></div>
          <div><dt>Account</dt><dd>None &#8212; open access</dd></div>
        </dl>
        <div class="source-card-actions">
          <a href="https://download.maizegdb.org/" target="_blank" rel="noopener">Go straight to the genome downloads &#8599;</a>
        </div>
      </article>

      <!-- Source 2: Box -->
      <article class="source-card">
        <h3 class="source-card-title"><a class="source-card-main" href="https://iastate.app.box.com/v/maizegdb-public" target="_blank" rel="noopener">
          <img class="source-card-icon" src="/images/box_download.png" alt="">
          <span class="source-card-id">
            <span class="source-card-name">MaizeGDB Box</span>
            <code class="source-card-host">iastate.app.box.com</code>
          </span>
        </a></h3>
        <p class="source-card-desc">Iowa State University cloud storage for data that does not belong in the file tree&#58; machine learning model weights, deep learning training sets, and bundled JBrowse track archives for the NAM projects.</p>
        <dl class="source-card-facts">
          <div><dt>Best for</dt><dd>Project collections and model files</dd></div>
          <div><dt>Account</dt><dd>None to download</dd></div>
        </dl>
        <div class="source-card-actions">
          <a href="#downloads-thematic">See what is stored on Box &#8595;</a>
        </div>
      </article>

      <!-- Source 3: Globus -->
      <article class="source-card source-card-globus">
        <span class="source-card-flag">New</span>
        <h3 class="source-card-title"><a class="source-card-main" href="https://app.globus.org/file-manager?origin_id=g-3126c1.67741c.a567.data.globus.org" target="_blank" rel="noopener">
          <img class="source-card-icon" src="/images/globus_download.png" alt="">
          <span class="source-card-id">
            <span class="source-card-name">MaizeGDB Globus Endpoint</span>
            <code class="source-card-host">app.globus.org</code>
          </span>
        </a></h3>
        <p class="source-card-desc">Globus moves large data sets in the background. A transfer resumes by itself after a dropped connection, verifies every file by checksum, and emails you when it finishes, so a multi-terabyte copy does not depend on a browser window staying open. It runs on USDA SCINet infrastructure and can transfer straight to a campus cluster, a laptop, or cloud storage.</p>
        <dl class="source-card-facts">
          <div><dt>Best for</dt><dd>Whole-genome sets, variant matrices, and other multi-gigabyte transfers</dd></div>
          <div><dt>Account</dt><dd>Free Globus login &#8212; institutional or Globus ID</dd></div>
          <div class="source-card-fact-wide">
            <dt>Collection</dt>
            <dd>MaizeGDB Public Collection \(SCINet - JUNO\)</dd>
          </div>
          <div class="source-card-fact-wide">
            <dt>Endpoint</dt>
            <dd>
              <code id="globus-domain-str">g-3126c1.67741c.a567.data.globus.org</code>
              <button type="button" class="copy-btn-inline" onclick="copyText\('globus-domain-str', this\)" title="Copy the endpoint domain">Copy</button>
            </dd>
          </div>
        </dl>
        <div class="source-card-actions">
          <a href="/docs/maizegdb-globus-guide.pdf" target="_blank" rel="noopener">Transfer guide \(PDF\) &#8595;</a>
        </div>
      </article>

    </div>
  </section>

  <!-- QUICK DOWNLOADS: the B73 v5 reference, far and away the most requested -->
  <section id="downloads-quick" class="mgdb-panel quick-panel" aria-labelledby="downloads-quick-heading">
    <div class="quick-head">
      <h2 id="downloads-quick-heading" class="mgdb-panel-title">B73 v5 quick downloads</h2>
      <div class="quick-head-actions">
        <a href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/" target="_blank" rel="noopener">All 52 B73 v5 files &#8599;</a>
        <button type="button" class="copy-btn-inline" onclick="copyText\('b73-wget-block', this\)">Copy all four wget commands</button>
      </div>
    </div>

    <div class="quick-grid">
        <a class="quick-tile" href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0.fa.gz" download>
          <span class="quick-tile-kind">FASTA</span>
          <span class="quick-tile-label">Genome assembly</span>
          <code class="quick-tile-file">Zm-B73-REFERENCE-NAM-5.0.fa.gz</code>
          <span class="quick-tile-size">616M</span>
        </a>
        <a class="quick-tile" href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3.gz" download>
          <span class="quick-tile-kind">GFF3</span>
          <span class="quick-tile-label">Gene annotation</span>
          <code class="quick-tile-file">Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3.gz</code>
          <span class="quick-tile-size">12M</span>
        </a>
        <a class="quick-tile" href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.protein.fa.gz" download>
          <span class="quick-tile-kind">FASTA</span>
          <span class="quick-tile-label">Protein sequences</span>
          <code class="quick-tile-file">Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.protein.fa.gz</code>
          <span class="quick-tile-size">10M</span>
        </a>
        <a class="quick-tile" href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.canonical.cds.fa.gz" download>
          <span class="quick-tile-kind">FASTA</span>
          <span class="quick-tile-label">Coding sequences</span>
          <code class="quick-tile-file">Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.canonical.cds.fa.gz</code>
          <span class="quick-tile-size">13M</span>
        </a>
    </div>

    <pre id="b73-wget-block" hidden>wget -c "https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0.fa.gz"
wget -c "https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3.gz"
wget -c "https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.protein.fa.gz"
wget -c "https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.canonical.cds.fa.gz"</pre>
  </section>

  <!-- SECTION 2: GUIDED GENOME FILE FINDER -->
  <section id="downloads-finder" class="mgdb-panel" data-manifest-url="/data/download_catalog.json" aria-labelledby="downloads-finder-heading">
    <div class="finder-head">
      <h2 id="downloads-finder-heading" class="mgdb-panel-title">Guided genome file finder</h2>
      <div class="finder-stats" aria-label="Catalog contents">
        <span><strong id="download-manifest-assemblies">&#8212;</strong> assemblies</span>
        <span><strong id="download-manifest-files">&#8212;</strong> files indexed</span>
        <span><strong id="download-manifest-updated">&#8212;</strong> catalog date</span>
      </div>
    </div>

    <ol class="finder-workflow">
      <li><b>1</b><strong>Find an assembly</strong><small>Search by inbred, accession, species, or project</small></li>
      <li><b>2</b><strong>Choose a file type</strong><small>Recommended biological files come first</small></li>
      <li><b>3</b><strong>Download or copy a command</strong><small>Browser download, wget, curl, or the direct URL</small></li>
    </ol>

    <div id="download-explorer-loading" class="finder-message" role="status">Loading the file catalog&#8230;</div>
    <div id="download-explorer-error" class="finder-message finder-message-error" role="alert" hidden>
      <strong>The file catalog is unavailable.</strong>
      <span>Every file is still reachable in the <a href="https://download.maizegdb.org/">genome download directory</a>.</span>
    </div>

    <div id="download-explorer-app" class="finder-app" hidden>

      <div class="finder-picker">
        <div class="finder-step-head">
          <span class="finder-step">Step 1</span>
          <h3 id="download-assembly-title">Find an assembly</h3>
        </div>
        <label class="finder-label" for="download-assembly-search">Genome, accession, species, or project</label>
        <div class="finder-search-wrap">
          <input id="download-assembly-search" type="search" placeholder="Try B73, PH207, Mo17, NAM, or Tripsacum" autocomplete="off">
          <button id="download-assembly-clear" type="button" hidden aria-label="Clear the assembly search">&times;</button>
        </div>
        <p id="download-assembly-status" class="finder-picker-status" aria-live="polite"></p>
        <div id="download-assembly-results" class="finder-assembly-results" role="listbox" aria-label="Matching genome assemblies"></div>
      </div>

      <div class="finder-browser">
        <div class="finder-selected">
          <div class="finder-step-head">
            <span class="finder-step">Step 2</span>
            <h3 id="download-selected-name">Select an assembly</h3>
          </div>
          <p id="download-selected-meta" class="finder-selected-meta"></p>
          <div class="finder-selected-actions">
            <button id="download-copy-core" type="button" class="mgdb-button mgdb-button-secondary">Copy core wget commands</button>
            <a id="download-open-directory" class="mgdb-button mgdb-button-secondary" href="https://download.maizegdb.org/" target="_blank" rel="noopener">Open directory &#8599;</a>
          </div>
        </div>

        <div class="finder-controls">
          <div id="download-role-filters" class="finder-role-filters" aria-label="Filter by file type"></div>
          <label class="finder-recommended"><input id="download-recommended-only" type="checkbox" checked> Recommended files only</label>
        </div>

        <p id="download-file-summary" class="finder-file-summary" aria-live="polite"></p>
        <div id="download-file-results" class="finder-file-results"></div>

        <div id="download-command-guide" class="finder-command" hidden>
          <div class="finder-command-head">
            <div class="finder-step-head">
              <span class="finder-step">Step 3</span>
              <h3 id="download-command-title">Download from the command line</h3>
            </div>
            <button id="download-command-close" type="button" class="finder-command-close" aria-label="Close the command guide">&times;</button>
          </div>
          <p id="download-command-file" class="finder-command-file"></p>
          <div class="finder-command-row"><span>wget</span><code id="download-command-wget"></code><button type="button" data-copy-command="wget">Copy</button></div>
          <div class="finder-command-row"><span>curl</span><code id="download-command-curl"></code><button type="button" data-copy-command="curl">Copy</button></div>
          <div class="finder-command-row"><span>URL</span><code id="download-command-url"></code><button type="button" data-copy-command="url">Copy</button></div>
          <p class="finder-command-note"><code>wget -c</code> resumes an interrupted transfer. With curl, <code>-L</code> follows redirects and <code>-O</code> keeps the server filename.</p>
        </div>
      </div>
    </div>

    <p class="finder-footer">The catalog is generated from the genome download directory, so every file keeps its stable URL. Files outside the assembly directories are listed in the sections below.</p>
  </section>

  <!-- SECTION 3: B73 REFERENCE GENOMES -->
  <section id="downloads-b73" class="mgdb-panel" aria-labelledby="downloads-b73-heading">
    <h2 id="downloads-b73-heading" class="mgdb-panel-title">B73 Representative Reference Genome Releases</h2>
    <p class="mgdb-panel-lead">Complete sequence assemblies, GFF3 gene model annotations, canonical CDS/PEP FASTA, and MAKER-P support packages for all 5 B73 reference versions.</p>

    <div class="mgdb-table-scroll">
      <table class="mgdb-table">
        <thead>
          <tr>
            <th scope="col">Version / Name</th>
            <th scope="col">Release Year</th>
            <th scope="col">Annotation Format</th>
            <th scope="col">Key Features</th>
            <th scope="col">Direct Download Links</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>B73 RefGen_v5</strong><br><small>Zm-B73-REFERENCE-NAM-5.0</small></td>
            <td>2020</td>
            <td>Zm00001eb</td>
            <td>PacBio Sequel II HiFi / BioNano de novo assembly; current reference standard</td>
            <td>
              <div class="download-link-group">
                <a class="table-dl-btn" href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/" target="_blank" rel="noopener">Browse v5 Files &#8599;</a>
                <a class="table-dl-btn table-dl-secondary" href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0.fa.gz">Assembly FASTA</a>
                <a class="table-dl-btn table-dl-secondary" href="https://download.maizegdb.org/Zm-B73-REFERENCE-NAM-5.0/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3.gz">GFF3 Annotation</a>
              </div>
            </td>
          </tr>
          <tr>
            <td><strong>B73 RefGen_v4</strong><br><small>Zm-B73-REFERENCE-GRAMENE-4.0</small></td>
            <td>2016</td>
            <td>Zm00001d</td>
            <td>PacBio single-molecule real-time sequencing assembly; Gramene annotation</td>
            <td>
              <div class="download-link-group">
                <a class="table-dl-btn" href="https://download.maizegdb.org/Zm-B73-REFERENCE-GRAMENE-4.0/" target="_blank" rel="noopener">Browse v4 Files &#8599;</a>
                <a class="table-dl-btn table-dl-secondary" href="https://download.maizegdb.org/Zm-B73-REFERENCE-GRAMENE-4.0/Zm-B73-REFERENCE-GRAMENE-4.0.fa.gz">Assembly FASTA</a>
                <a class="table-dl-btn table-dl-secondary" href="https://download.maizegdb.org/Zm-B73-REFERENCE-GRAMENE-4.0/Zm-B73-REFERENCE-GRAMENE-4.0_Zm00001d.2.gff3.gz">GFF3 Annotation</a>
              </div>
            </td>
          </tr>
          <tr>
            <td><strong>B73 RefGen_v3</strong><br><small>RefGen_v3</small></td>
            <td>2013</td>
            <td>GRMZM \(5b/6a\)</td>
            <td>Upgraded BAC tiling path with improved pseudomolecule scaffolding</td>
            <td>
              <div class="download-link-group">
                <a class="table-dl-btn" href="https://download.maizegdb.org/B73_RefGen_v3/" target="_blank" rel="noopener">Browse v3 Files &#8599;</a>
                <a class="table-dl-btn table-dl-secondary" href="https://download.maizegdb.org/B73_RefGen_v3/Zea_mays.AGPv3.22.dna.toplevel.fa.gz">Assembly FASTA</a>
              </div>
            </td>
          </tr>
          <tr>
            <td><strong>B73 RefGen_v2</strong><br><small>RefGen_v2</small></td>
            <td>2010</td>
            <td>GRMZM \(5a\)</td>
            <td>Intermediate BAC-based chromosome builds</td>
            <td>
              <div class="download-link-group">
                <a class="table-dl-btn" href="https://download.maizegdb.org/B73_RefGen_v2/" target="_blank" rel="noopener">Browse v2 Files &#8599;</a>
              </div>
            </td>
          </tr>
          <tr>
            <td><strong>B73 RefGen_v1</strong><br><small>RefGen_v1 \(Schnable et al., 2009\)</small></td>
            <td>2009</td>
            <td>GRMZM \(4a\)</td>
            <td>First BAC-by-BAC Sanger sequence release for Zea mays</td>
            <td>
              <div class="download-link-group">
                <a class="table-dl-btn" href="https://download.maizegdb.org/B73_RefGen_v1/" target="_blank" rel="noopener">Browse v1 Files &#8599;</a>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- SECTION 4: NAM FOUNDER INBRED GENOMES -->
  <section id="downloads-nam" class="mgdb-panel" aria-labelledby="downloads-nam-heading">
    <div class="section-badge-row">
      <span class="nam-count-badge">26 Chromosome-Scale Assemblies</span>
      <span class="nam-citation-badge">Hufford et al., 2021 <em>Science</em></span>
    </div>
    <h2 id="downloads-nam-heading" class="mgdb-panel-title">NAM Founder Inbred Line Genomes</h2>
    <p class="mgdb-panel-lead">High-quality de novo assemblies and comprehensive annotations for all 26 diverse founder inbreds of the Nested Association Mapping \(NAM\) population.</p>

