$$SYNTAX-LEVEL 2
*(mgdb-gel-notfound
<meta name="robots" content="noindex">
<meta property="og:title" content="No gel pattern found &mdash; MaizeGDB">
<meta property="og:description" content="$(notfound_summary)">

<main class="mgdb-page mgdb-hub-page mgdb-record-page mgdb-record-notfound-page" id="gel-notfound-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><a href="/data_center/marker">Marker Data Hub</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Not found</span>
  </nav>

  <section class="mgdb-hero mgdb-hub-record-hero mgdb-rec-notfound-hero" aria-labelledby="gel-notfound-title">
    <div class="mgdb-hero-body">
      <h1 id="gel-notfound-title">No gel pattern matches &ldquo;$(requested_display)&rdquo;</h1>
      <p class="mgdb-rec-lead">MaizeGDB holds $(total_patterns) curated gel patterns. None of them carries that name or MaizeGDB ID.</p>
    </div>
  </section>

  <section id="gel-notfound-search" aria-labelledby="gel-notfound-search-title">
    <div class="mgdb-section-heading"><div><h2 id="gel-notfound-search-title">Search</h2></div></div>
    <form class="mgdb-rec-search" action="/data_center/marker" method="get" role="search">
      <label class="mgdb-visually-hidden" for="gel-notfound-query">Gel pattern name or MaizeGDB ID</label>
      <input class="mgdb-input" id="gel-notfound-query" name="term" type="search" autocomplete="off" value="$(requested_value)" placeholder="Gel pattern name or MaizeGDB ID" />
      <button class="mgdb-button mgdb-button-primary" type="submit">Search markers</button>
    </form>
    <p class="mgdb-rec-hint">A gel pattern is named for the probe and enzyme that produced it, and the stock it was run on. Gel patterns are reached from the marker and locus records that use them rather than searched directly.</p>
  </section>

  $(suggestion_sections)

  <section class="mgdb-hub-related" id="gel-notfound-resources" aria-labelledby="gel-notfound-resources-title">
    <div class="mgdb-section-heading"><div><h2 id="gel-notfound-resources-title">Related resources</h2></div></div>
    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>The probes gel patterns are run with</span>
        </a>
        <a href="/data_center/locus">
          <strong>Gene and Locus Data Hub</strong>
          <span>Loci list their gel patterns in the Genetic information section</span>
        </a>
        <a href="/data_center/variation">
          <strong>Variations &amp; Alleles Data Hub</strong>
          <span>The DNA polymorphisms called from gel bands</span>
        </a>
        <a href="/data_center/stock">
          <strong>Stock Data Hub</strong>
          <span>The lines whose DNA is run on these gels</span>
        </a>
        <a href="/searchall">
          <strong>Search all MaizeGDB data</strong>
          <span>One search across every data type</span>
        </a>
      </div>
    </div>
  </section>
</main>
)
