$$SYNTAX-LEVEL 2
*(mgdb-data-center-hub
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/">
<meta property="og:title" content="MaizeGDB Data Hubs | Unified Directory &amp; Dashboard">
<meta property="og:description" content="Explore MaizeGDB data hubs for genomes, genes, variation, expression, phenotypes, germplasm, protein structures, and curated literature.">

<main class="mgdb-page mgdb-data-center-hub" id="hub-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Data hubs</span>
  </nav>

  <section class="data-hub-hero" aria-labelledby="data-hub-title">
    <div class="data-hub-logo-panel">
      <svg viewBox="0 0 96 96" class="data-hub-hero-svg" role="img" aria-label="Connected MaizeGDB data network">
        <circle cx="48" cy="48" r="40" fill="none" stroke="#31613d" stroke-width="3" stroke-dasharray="4 4" />
        <line x1="48" y1="20" x2="24" y2="60" stroke="#d99a0b" stroke-width="3" />
        <line x1="48" y1="20" x2="72" y2="60" stroke="#d99a0b" stroke-width="3" />
        <line x1="24" y1="60" x2="72" y2="60" stroke="#d99a0b" stroke-width="3" />
        <line x1="48" y1="20" x2="48" y2="76" stroke="#4a825c" stroke-width="2" />
        <circle cx="48" cy="20" r="10" fill="#235c37" />
        <circle cx="24" cy="60" r="9" fill="#1b4d75" />
        <circle cx="72" cy="60" r="9" fill="#9e6c0c" />
        <circle cx="48" cy="76" r="7" fill="#437d57" />
        <circle cx="48" cy="46" r="11" fill="#fff" stroke="#235c37" stroke-width="3" />
        <path d="M44 46 L48 42 L52 46 L48 50 Z" fill="#d99a0b" />
      </svg>
      <strong>MaizeGDB<br />Data Hubs</strong>
      <span>Unified Discovery Hub</span>
    </div>
    <div class="data-hub-hero-main">
      <div class="data-hub-hero-copy">
        <span class="mgdb-eyebrow">Explore MaizeGDB</span>
        <h1 id="data-hub-title">One place to start with maize data</h1>
        <p class="data-hub-hero-tagline">Discover the right entry point for genomes, genes, variation, expression, phenotype, germplasm, structures, and curated literature&mdash;then search, analyze, or download the underlying records.</p>
        <div class="data-hub-hero-actions">
          <a class="mgdb-button mgdb-button-primary" href="#hub-directory">Browse all data hubs &darr;</a>
          <a class="mgdb-button mgdb-button-secondary" href="https://download.maizegdb.org">Download common datasets &rarr;</a>
        </div>
      </div>
      <div class="data-hub-hero-route" aria-label="A typical path through MaizeGDB data">
        <span>How the collections connect</span>
        <ol>
          <li><strong>Find</strong><small>an identifier, trait, stock, or paper</small></li>
          <li><strong>Connect</strong><small>curated biological relationships</small></li>
          <li><strong>Analyze</strong><small>browsers, plots, and specialized tools</small></li>
          <li><strong>Reuse</strong><small>downloads, exports, and APIs</small></li>
        </ol>
      </div>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#hub-overview">Overview &amp; Metrics</a>
    <a href="#hub-dashboard">Scale Dashboard</a>
    <a href="#hub-tasks">Guided Paths</a>
    <a href="#hub-directory">All Data Hubs</a>
    <a href="#hub-support">Downloads &amp; Support</a>
  </nav>

  <section id="hub-overview" class="data-hub-snapshot" aria-labelledby="data-hub-snapshot-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Collection snapshot &middot; Live Database Metrics</span>
        <h2 id="data-hub-snapshot-title">The scale of connected maize data</h2>
      </div>
      <p>Headline values summarize core PostgreSQL database records and major computed collections across MaizeGDB.</p>
    </div>
    <div class="data-hub-metric-grid">
      @(summary-card
        <article class="data-hub-metric data-hub-tone-$(tone)" data-hub-metric data-chart-value="$(chart_value)" data-chart-label="$(chart_label)">
          <span class="data-hub-metric-icon" aria-hidden="true">$(icon)</span>
          <div>
            <strong>$(value)</strong>
            <h3>$(label)</h3>
            <p>$(detail)</p>
          </div>
        </article>
      )
    </div>
  </section>

  <section id="hub-dashboard" class="data-hub-dashboard" aria-labelledby="data-hub-dashboard-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Visual overview &middot; Interactive Charts</span>
        <h2 id="data-hub-dashboard-title">A connected collection, not a single table</h2>
      </div>
      <p>Use these interactive figures to compare orders of magnitude and see how active data hubs span complementary research domains.</p>
    </div>
    <div class="data-hub-chart-grid">
      <article class="data-hub-chart-card">
        <div>
          <span class="mgdb-eyebrow">Collection scale</span>
          <h3>Records &amp; computed objects</h3>
          <p>Logarithmic scale makes both focused curated collections and high-volume genomic resources easily comparable.</p>
        </div>
        <div id="data-hub-scale-chart" class="data-hub-chart" role="img" aria-label="Log scale bar chart of selected MaizeGDB collection sizes">
          <span class="data-hub-chart-fallback">Loading collection summary&hellip;</span>
        </div>
      </article>
      <article class="data-hub-chart-card">
        <div>
          <span class="mgdb-eyebrow">Domain coverage</span>
          <h3>Active data hubs by research area</h3>
          <p>Centers overlap in practice; this view groups each by its primary discovery role.</p>
        </div>
        <div id="data-hub-domain-chart" class="data-hub-chart" role="img" aria-label="Donut chart of active data hubs grouped by research area">
          <span class="data-hub-chart-fallback">Loading domain summary&hellip;</span>
        </div>
      </article>
    </div>
  </section>

  <section id="hub-tasks" class="data-hub-tasks" aria-labelledby="data-hub-tasks-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Start with your question</span>
        <h2 id="data-hub-tasks-title">Common paths through the data</h2>
      </div>
      <p>You do not need to know the database schema. Begin with the biological object or research question you already have.</p>
    </div>
    <div class="data-hub-task-grid">
      <a href="/gene_center/gene">
        <span class="task-num" aria-hidden="true">01</span>
        <div>
          <strong>I have a gene or gene-model ID</strong>
          <small>Resolve annotation versions and follow function, expression, variation, and evidence.</small>
        </div>
        <b aria-hidden="true">&rarr;</b>
      </a>
      <a href="/genetic_variation">
        <span class="task-num" aria-hidden="true">02</span>
        <div>
          <strong>I want to explore genomic variation</strong>
          <small>Move from assemblies and SNP collections to accessions, diversity panels, and effects.</small>
        </div>
        <b aria-hidden="true">&rarr;</b>
      </a>
      <a href="/data_center/phenotype">
        <span class="task-num" aria-hidden="true">03</span>
        <div>
          <strong>I have a phenotype or mutant trait</strong>
          <small>Connect visible effects to loci, alleles, stocks, images, and publications.</small>
        </div>
        <b aria-hidden="true">&rarr;</b>
      </a>
      <a href="/data_center/reference">
        <span class="task-num" aria-hidden="true">04</span>
        <div>
          <strong>I need papers &amp; supporting evidence</strong>
          <small>Search curated references, view publication trends, and export DOIs or PubMed IDs.</small>
        </div>
        <b aria-hidden="true">&rarr;</b>
      </a>
      <a href="https://download.maizegdb.org">
        <span class="task-num" aria-hidden="true">05</span>
        <div>
          <strong>I need files for offline analysis</strong>
          <small>Browse commonly downloaded genomes, annotations, variants, and functional datasets.</small>
        </div>
        <b aria-hidden="true">&rarr;</b>
      </a>
    </div>
  </section>

  <section id="hub-directory" class="data-hub-directory" aria-labelledby="data-hub-directory-title">
    <div class="mgdb-section-heading">
      <div>
        <span class="mgdb-eyebrow">Interactive Directory</span>
        <h2 id="data-hub-directory-title">Browse every active data hub</h2>
      </div>
      <p>Search descriptions or filter by the primary type of biological information.</p>
    </div>
    <div class="data-hub-finder">
      <div class="data-hub-search">
        <svg class="data-hub-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><line x1="11" y1="11" x2="15" y2="15"/></svg>
        <label class="data-hub-visually-hidden" for="data-hub-query">Search data hubs</label>
        <input id="data-hub-query" type="search" placeholder="Try expression, stocks, protein structure, QTL, marker, image&hellip;" autocomplete="off" />
        <button id="data-hub-query-clear" type="button" hidden>Clear</button>
      </div>
      <div class="data-hub-filters" role="tablist" aria-label="Filter data hubs">
        <button type="button" class="data-hub-filter-btn is-active" data-hub-filter="all" role="tab" aria-selected="true">All centers</button>
        <button type="button" class="data-hub-filter-btn" data-hub-filter="genomes-variation" role="tab" aria-selected="false">Genomes &amp; variation</button>
        <button type="button" class="data-hub-filter-btn" data-hub-filter="genes-function" role="tab" aria-selected="false">Genes &amp; function</button>
        <button type="button" class="data-hub-filter-btn" data-hub-filter="phenotype-germplasm" role="tab" aria-selected="false">Phenotype &amp; germplasm</button>
        <button type="button" class="data-hub-filter-btn" data-hub-filter="literature-media" role="tab" aria-selected="false">Literature &amp; media</button>
        <span id="data-hub-result-count" aria-live="polite">18 centers shown</span>
      </div>
    </div>
    <div class="data-hub-center-grid">
      @(center-card
        <article class="data-hub-center-card" data-hub-center data-category="$(category)" data-search="$(search) $(name) $(description) $(best_for)">
          <div class="data-hub-center-top">
            <span class="data-hub-center-icon" aria-hidden="true">$(icon)</span>
            <span class="data-hub-center-category">$(category_label)</span>
          </div>
          <h3>$(name)</h3>
          <p>$(description)</p>
          <div class="data-hub-best">
            <span>Best for</span>
            <strong>$(best_for)</strong>
          </div>
          <a class="data-hub-card-link" href="$(url)">Open data hub <span aria-hidden="true">&rarr;</span></a>
        </article>
      )
    </div>
    <div id="data-hub-empty" class="data-hub-empty" hidden>
      <strong>No data hubs matched that search.</strong>
      <span>Try a broader keyword or reset the directory filter.</span>
      <button id="data-hub-reset" type="button">Reset directory</button>
    </div>
  </section>

  <section id="hub-support" class="data-hub-support" aria-labelledby="data-hub-support-title">
    <div>
      <span class="mgdb-eyebrow" style="color: #b1dfbb;">Take the next step</span>
      <h2 id="data-hub-support-title">Download, contribute, or ask for help</h2>
      <p>MaizeGDB connects community data with long-term curation. Tell us when a dataset should be added or a relationship needs correction.</p>
    </div>
    <div class="data-hub-support-links">
      <a href="https://download.maizegdb.org">
        <strong>Bulk Downloads</strong>
        <span>Commonly requested files and genomic datasets</span>
        <b aria-hidden="true">&rarr;</b>
      </a>
      <a href="/contribute_data">
        <strong>Contribute Data</strong>
        <span>Submission guidance and supported data types</span>
        <b aria-hidden="true">&rarr;</b>
      </a>
      <a href="/contact">
        <strong>Contact MaizeGDB</strong>
        <span>Reach the curation team for questions or corrections</span>
        <b aria-hidden="true">&rarr;</b>
      </a>
      <a href="/archive">
        <strong>Archived Data Hubs</strong>
        <span>Legacy resources retained for historical research</span>
        <b aria-hidden="true">&rarr;</b>
      </a>
    </div>
  </section>
</main>
)
