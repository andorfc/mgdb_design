$$SYNTAX-LEVEL 2
*(mgdb-bin-record
<main class="mgdb-page mgdb-bin-page" id="bin-top">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/bin_viewer">Bin Viewer</a><span aria-hidden="true">&rsaquo;</span>$(breadcrumb_tail)
  </nav>

  <section class="mgdb-hero" aria-labelledby="bin-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="Maize chromosome idiogram icon">
        <rect x="16" y="12" width="16" height="72" rx="7" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <rect x="40" y="24" width="16" height="56" rx="7" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <rect x="64" y="18" width="16" height="64" rx="7" fill="#e8f4ec" stroke="#235c37" stroke-width="3" />
        <rect x="17" y="30" width="14" height="9" fill="#d99a0b" />
        <rect x="17" y="52" width="14" height="7" fill="#7fae8c" />
        <rect x="41" y="38" width="14" height="10" fill="#d99a0b" />
        <rect x="41" y="60" width="14" height="6" fill="#7fae8c" />
        <rect x="65" y="34" width="14" height="7" fill="#7fae8c" />
        <rect x="65" y="55" width="14" height="10" fill="#d99a0b" />
      </svg>
      <strong>Bin<br />Viewer</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; $(built_date)</p>
      <h1 id="bin-title">$(page_title)</h1>
      <p class="mgdb-hero-description">$(page_description)</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">$(section_tabs)</nav>

  <section id="bin-map" aria-labelledby="bin-map-title">
    <div class="mgdb-section-heading">
      <div><h2 id="bin-map-title">Chromosome map</h2></div>
      <p>$(map_intro)</p>
    </div>

    <div class="bin-map-panel bin-map-record">
      <div class="bin-map-figure">
        $(idiogram)
      </div>
      <div class="bin-record-side">
        $(record_links)
      </div>
    </div>
  </section>

  $(sections)

  <section id="bin-resources" aria-labelledby="bin-resources-title">
    <div class="mgdb-section-heading">
      <div><h2 id="bin-resources-title">Other resources</h2></div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list bin-resource-list">
        <a href="/data_center/locus">
          <strong>Locus Data Hub</strong>
          <span>Classic genetic loci, alleles, and phenotypes</span>
        </a>
        <a href="/data_center/marker">
          <strong>Markers and Probes</strong>
          <span>Molecular markers, probes, SSRs, and RFLPs</span>
        </a>
        <a href="/data_center/map">
          <strong>Maps</strong>
          <span>Genetic, physical, and cytological maps</span>
        </a>
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>Genes and gene models by name or position</span>
        </a>
        <a href="/genome/genomebrowser">
          <strong>Genome Browser</strong>
          <span>JBrowse tracks across every assembly</span>
        </a>
        <a href="/data_center/cytogenetic">
          <strong>Cytogenetics</strong>
          <span>Cytogenetic stocks and chromosome aberrations</span>
        </a>
        <a href="/genome/whole_genome">
          <strong>Whole-Genome Views</strong>
          <span>Comparative synteny and karyotype views</span>
        </a>
        <a href="/data_center/qtl">
          <strong>QTL Data Hub</strong>
          <span>Quantitative trait loci and their intervals</span>
        </a>
        <a href="/data_center/bac">
          <strong>BAC Data Hub</strong>
          <span>Bacterial artificial chromosome clones</span>
        </a>
        <a href="/nomenclature">
          <strong>Nomenclature</strong>
          <span>Maize naming rules for loci and assemblies</span>
        </a>
      </div>
    </div>
  </section>

</main>
)
