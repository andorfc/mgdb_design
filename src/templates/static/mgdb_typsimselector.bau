$$SYNTAX-LEVEL 2
*(mgdb-typsimselector
<a class="mgdb-skip-link" href="#typ-main">Skip to main content</a>

<main class="mgdb-page mgdb-typsimselector-page" id="typ-main"
      data-lines-curation="$(lines-curation-url)"
      data-lines-breeding="$(lines-breeding-url)"
      data-api="$(api-url)">

  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Tools</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">TYPSimSelector</span>
  </nav>

  <!-- HERO SECTION -->
  <section class="mgdb-hero" aria-labelledby="typ-title">
    <div class="mgdb-hero-emblem">
      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Connecting network lines -->
        <line x1="32" y1="32" x2="16" y2="16" stroke="#ca8a04" stroke-width="2" stroke-dasharray="3 2" />
        <line x1="32" y1="32" x2="48" y2="16" stroke="#ca8a04" stroke-width="2" stroke-dasharray="3 2" />
        <line x1="32" y1="32" x2="14" y2="44" stroke="#ca8a04" stroke-width="2" stroke-dasharray="3 2" />
        <line x1="32" y1="32" x2="50" y2="44" stroke="#ca8a04" stroke-width="2" stroke-dasharray="3 2" />
        <line x1="32" y1="32" x2="32" y2="54" stroke="#ca8a04" stroke-width="2" stroke-dasharray="3 2" />
        <!-- Surrounding accession nodes -->
        <circle cx="16" cy="16" r="6" fill="#15803d" />
        <circle cx="48" cy="16" r="5" fill="#166534" />
        <circle cx="14" cy="44" r="5" fill="#854d0e" />
        <circle cx="50" cy="44" r="6" fill="#15803d" />
        <circle cx="32" cy="54" r="4.5" fill="#854d0e" />
        <!-- Central Reference Node -->
        <circle cx="32" cy="32" r="10" fill="#501719" stroke="#ffffff" stroke-width="2" />
        <circle cx="32" cy="32" r="4" fill="#facc15" />
      </svg>
      <strong>TYPSim<br />Selector</strong>
    </div>
    <div class="mgdb-hero-body">
      <p class="mgdb-hero-stamp"><span aria-hidden="true">&#9679;</span> Updated&#58; $(data_date)</p>
      <h1 id="typ-title">TYPSimSelector</h1>
      <p class="mgdb-hero-description">Rank and compare USDA Ames maize inbred lines against any reference accession using genome-wide identity-by-state \(IBS\) genetic similarity scores computed from the Ames Diversity Panel.</p>

      <div class="typ-hero-actions-row">
        <a class="typ-hero-link" href="/data_center/stock">
          <span class="typ-link-dot" aria-hidden="true"></span> Search MaizeGDB Stocks &#8599;
        </a>
        <a class="typ-hero-link" href="https://npgsweb.ars-grin.gov/gringlobal/search.aspx" target="_blank" rel="noopener">
          <span class="typ-link-dot" aria-hidden="true"></span> Search GRIN-Global &#8599;
        </a>
        <a class="typ-hero-link" href="#typ-data">
          <span class="typ-link-dot typ-dot-gold" aria-hidden="true"></span> Ames HapMap Genotypes &#8595;
        </a>
      </div>
    </div>
  </section>

  <!-- STICKY SECTION TABS -->
  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#typ-compare" class="is-current">Comparison Console</a>
    <a href="#typ-about">About the Tool</a>
    <a href="#typ-method">Methodology &amp; Guidelines</a>
    <a href="#typ-data">Underlying Data</a>
    <a href="#typ-overview">Statistics</a>
    <a href="#typ-cite">Attribution &amp; Citation</a>
    <a href="#typ-related">Connected Resources</a>
  </nav>

  <!-- SECTION 1: INTERACTIVE COMPARISON CONSOLE & RESULTS -->
  <section id="typ-compare" class="mgdb-panel" aria-labelledby="typ-compare-title">
    <h2 id="typ-compare-title" class="mgdb-panel-title">Interactive Comparison Console</h2>
    <p class="mgdb-panel-lead">Select a dataset and reference line to rank the collection by genetic similarity. Results, interactive distribution charts, and exports appear below.</p>

    <form id="typ-form" class="typ-console" novalidate>
      <fieldset class="typ-step" id="typ-step-dataset">
        <legend><span class="typ-step-number" aria-hidden="true">1</span> Dataset</legend>
        <p class="mgdb-hint" id="typ-dataset-hint">The two datasets were genotyped and scored separately. Scores from one are not comparable with scores from the other.</p>
        <div class="typ-dataset-choices" role="radiogroup" aria-describedby="typ-dataset-hint" aria-labelledby="typ-dataset-label">
          <span class="mgdb-visually-hidden" id="typ-dataset-label">Dataset</span>
          <label class="typ-dataset-card">
            <input type="radio" name="dataset" value="curation" />
            <span class="typ-dataset-body">
              <strong>Curation dataset</strong>
              <span class="typ-dataset-count">$(curation-accessions) accessions</span>
              <span class="typ-dataset-note">Keyed to NCRPIS inventory, so every row carries its accession number and links out to GRIN. Includes replicate genotyping runs of the same accession.</span>
            </span>
          </label>
          <label class="typ-dataset-card">
            <input type="radio" name="dataset" value="breeding" />
            <span class="typ-dataset-body">
              <strong>Breeding dataset</strong>
              <span class="typ-dataset-count">$(breeding-lines) lines</span>
              <span class="typ-dataset-note">The merged Ames genotype set, keyed by line name. One score per pair of lines, with no accession numbers attached.</span>
            </span>
          </label>
        </div>
      </fieldset>

      <fieldset class="typ-step" id="typ-step-line" disabled>
        <legend><span class="typ-step-number" aria-hidden="true">2</span> Reference line</legend>
        <p class="mgdb-hint" id="typ-line-hint">Start typing a line name or an accession number. Everything else will be ranked against whatever you pick here.</p>

        <div class="mgdb-field typ-combobox" data-combobox="line">
          <label class="mgdb-label" for="typ-line-input">Line or accession</label>
          <input class="mgdb-input typ-combobox-input" id="typ-line-input" type="text"
                 role="combobox" aria-expanded="false" aria-autocomplete="list"
                 aria-controls="typ-line-listbox" aria-describedby="typ-line-hint"
                 autocomplete="off" spellcheck="false" placeholder="Choose a dataset first" disabled />
          <ul class="typ-combobox-list" id="typ-line-listbox" role="listbox" aria-label="Matching lines" hidden></ul>
          <p class="typ-combobox-status mgdb-small mgdb-muted" id="typ-line-status" aria-live="polite"></p>
        </div>

        <div class="mgdb-field typ-run-field" id="typ-run-field" hidden>
          <label class="mgdb-label" for="typ-run">Genotyping run</label>
          <select class="mgdb-select" id="typ-run"></select>
          <p class="mgdb-hint">This accession was genotyped more than once. Each run was scored against the panel separately and is ranked on its own.</p>
        </div>
      </fieldset>

      <fieldset class="typ-step" id="typ-step-scope" disabled>
        <legend><span class="typ-step-number" aria-hidden="true">3</span> Comparison and order</legend>

        <div class="typ-scope-grid">
          <div class="mgdb-field">
            <label class="mgdb-label" for="typ-scope">Compare against</label>
            <select class="mgdb-select" id="typ-scope">
              <option value="all" selected>The whole dataset</option>
              <option value="one">One other line</option>
            </select>
          </div>

          <div class="mgdb-field">
            <label class="mgdb-label" for="typ-sort">Order</label>
            <select class="mgdb-select" id="typ-sort">
              <option value="desc" selected>Most similar first</option>
              <option value="asc">Least similar first</option>
            </select>
          </div>
        </div>

        <div class="mgdb-field typ-combobox" data-combobox="compare" id="typ-compare-field" hidden>
          <label class="mgdb-label" for="typ-compare-input">Second line</label>
          <input class="mgdb-input typ-combobox-input" id="typ-compare-input" type="text"
                 role="combobox" aria-expanded="false" aria-autocomplete="list"
                 aria-controls="typ-compare-listbox" autocomplete="off" spellcheck="false" />
          <ul class="typ-combobox-list" id="typ-compare-listbox" role="listbox" aria-label="Matching lines" hidden></ul>
          <p class="typ-combobox-status mgdb-small mgdb-muted" id="typ-compare-status" aria-live="polite"></p>
        </div>

        <div class="mgdb-form-actions typ-actions">
          <button class="mgdb-button mgdb-button-primary" id="typ-submit" type="submit">Rank the dataset</button>
          <button class="mgdb-button mgdb-button-quiet" id="typ-reset" type="reset">Start over</button>
        </div>
      </fieldset>
    </form>

    <p id="typ-status" class="mgdb-visually-hidden" aria-live="polite"></p>
    <div id="typ-results" class="typ-results"></div>
  </section>

  <!-- SECTION 2: ABOUT TYPSIMSELECTOR -->
  <section id="typ-about" class="mgdb-panel" aria-labelledby="typ-about-title">
    <h2 id="typ-about-title" class="mgdb-panel-title">About TYPSimSelector</h2>
    <p class="mgdb-panel-lead">Origins, background, and practical applications of genomic identity-by-state similarity in maize germplasm management.</p>

    <div class="typ-about-content">
      <p>TYPSimSelector sorts identity-by-state \(IBS\) values derived from genotyping-by-sequencing \(GBS\) SNP datasets for accessions in the <strong>Ames Diversity Panel</strong> &mdash; a USDA-maintained collection of maize inbred lines held at the North Central Regional Plant Introduction Station \(NCRPIS\) in Ames, Iowa, representing a broad spectrum of the species' genetic variation \(<a href="/data_center/reference?id=9023933">Romay et al., 2013</a>\).</p>
      
      <p>The tool was conceived and first implemented by <strong>Mark Millard</strong> at NCRPIS to make genomic similarity directly actionable for germplasm curators. Recognising its utility for the wider maize genetics community, a collaboration to deploy it through MaizeGDB was established in 2013. The tool was developed by <strong>Emily Mauch</strong> with guidance from <strong>Carson Andorf</strong>, <strong>Mark Millard</strong>, <strong>Cinta Romay</strong>, <strong>Ed Buckler</strong>, <strong>Candy Gardner</strong>, and <strong>Carolyn Lawrence</strong>.</p>
      
      <p>The Ames Diversity Panel comprises approximately 2,800 maize accessions genotyped across more than <strong>680,000 SNP markers</strong>. Pairwise similarity metrics are essential for detecting near-duplicates, confirming seed purity, identifying contrasting parents for cross-breeding, and verifying sample identity prior to experimental trials.</p>
    </div>
  </section>

  <!-- SECTION 3: METHODOLOGY & INTERPRETATION GUIDELINES -->
  <section id="typ-method" class="mgdb-panel" aria-labelledby="typ-method-title">
    <h2 id="typ-method-title" class="mgdb-panel-title">Methodology &amp; Interpretation Guidelines</h2>
    <p class="mgdb-panel-lead">Guidelines for interpreting identity-by-state scores, understanding replicate spread, and avoiding ascertainment bias pitfalls.</p>

    <div class="mgdb-card-grid typ-method-grid">
      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-info">Calculation</span>
        <h3>Identity by State via PLINK</h3>
        <p>Scores were calculated as described by <a href="/data_center/reference?id=9023933">Romay et al., 2013</a>. Pairwise IBS metrics across all accessions were computed using PLINK v1.07 \(<a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1950838/" target="_blank" rel="noopener">Purcell et al., 2007</a>\).</p>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-warn">Caveat</span>
        <h3>Ascertainment Bias in Low Scores</h3>
        <p>Very low similarity scores are subject to ascertainment bias in the GBS marker set. The lines ranked at the extreme bottom should not be interpreted as an authoritative phylogenetically distant outlier.</p>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill mgdb-pill-ok">Score Interpretation</span>
        <h3>1.0 is Identical, 0.85 is Baseline</h3>
        <p>Replicate samples of the same accession typically score above 0.98. The baseline background similarity across the entire panel centers between 0.83 and 0.87; the informative signal lies in the upper tail.</p>
      </article>

      <article class="mgdb-card">
        <span class="mgdb-pill">Replicate Runs</span>
        <h3>Independent Genotyping Replicates</h3>
        <p>347 accessions in the curation dataset were genotyped multiple times \(one accession up to 28 times\). Each run was scored independently against the entire panel to capture experimental variance.</p>
      </article>
    </div>
  </section>

  <!-- SECTION 4: UNDERLYING GENOTYPIC DATA & DOWNLOADS -->
  <section id="typ-data" class="mgdb-panel" aria-labelledby="typ-data-title">
    <h2 id="typ-data-title" class="mgdb-panel-title">Underlying Genotypic Data &amp; HapMap Downloads</h2>
    <p class="mgdb-panel-lead">Complete open-access downloads for the raw Ames Diversity Panel HapMap genotyping matrices and sample identification keys.</p>

    <div class="typ-downloads-grid">
      <article class="typ-dl-card">
        <div class="typ-dl-badge">Genotypes Matrix</div>
        <h3>Ames Diversity Panel HapMap Genotypes</h3>
        <p>Raw GBS SNP genotype matrix for all Ames accessions in standard HapMap format. Compressed ZIP archive \(expands to approximately 6 GB\).</p>
        <a class="mgdb-button mgdb-button-primary" href="https://download.maizegdb.org/Archive/TYPSimSelector/All_Ames_all_20120110.hmp.zip" target="_blank" rel="noopener">Download HapMap ZIP \(6 GB\) &#8599;</a>
      </article>

      <article class="typ-dl-card">
        <div class="typ-dl-badge typ-dl-badge-blue">Sample Metadata</div>
        <h3>Ames Diversity Panel Sample Key</h3>
        <p>Comprehensive sample mapping spreadsheet matching taxa identifiers, NCRPIS accession numbers, seed lot codes, and GRIN identifiers.</p>
        <a class="mgdb-button mgdb-button-secondary" href="https://download.maizegdb.org/Archive/TYPSimSelector/Ames_key_120110.xlsx" target="_blank" rel="noopener">Download Sample Key \(XLSX\) &#8599;</a>
      </article>
    </div>
  </section>

  <!-- SECTION 5: DATASET STATISTICS & MATRIX SCALE \(DASHBOARD MOVED TO BOTTOM\) -->
  <section id="typ-overview" class="mgdb-panel" aria-labelledby="typ-scale-title">
    <h2 id="typ-scale-title" class="mgdb-panel-title">Dataset Statistics &amp; Matrix Scale</h2>
    <p class="mgdb-panel-lead">Pre-computed pairwise similarity matrix scale across the Ames Diversity Panel.</p>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Curated Accessions</h3>
          <span class="mgdb-metric-badge">Curation</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(curation-accessions)</strong>
        </div>
        <p class="mgdb-metric-description">NCRPIS accessions in the curation dataset across $(curation-entries) genotyping runs.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Breeding Lines</h3>
          <span class="mgdb-metric-badge">Breeding</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(breeding-lines)</strong>
        </div>
        <p class="mgdb-metric-description">Named inbred lines in the merged Ames diversity breeding dataset.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>Pairwise Scores</h3>
          <span class="mgdb-metric-badge">Matrix</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total-pairs)</strong>
        </div>
        <p class="mgdb-metric-description">$(curation-pairs) curation pairs and $(breeding-pairs) breeding comparisons on file.</p>
      </article>

      <article class="mgdb-metric">
        <div class="mgdb-metric-top">
          <h3>SNP Markers</h3>
          <span class="mgdb-metric-badge">GBS</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">680,000+</strong>
        </div>
        <p class="mgdb-metric-description">Genotyping-by-sequencing markers used to compute pairwise identity by state.</p>
      </article>
    </div>
  </section>

  <!-- SECTION 6: ATTRIBUTION & CITATIONS -->
  <section id="typ-cite" class="mgdb-panel" aria-labelledby="typ-cite-title">
    <h2 id="typ-cite-title" class="mgdb-panel-title">Attribution &amp; Citing TYPSimSelector</h2>
    <p class="mgdb-panel-lead">If TYPSimSelector contributed to your research or breeding selections, please cite both MaizeGDB and the Ames panel publication&#58;</p>

    <div class="mgdb-table-scroll">
      <table class="mgdb-table typ-cite-table">
        <caption>Works to cite when using TYPSimSelector</caption>
        <thead>
          <tr><th scope="col">Cite</th><th scope="col">Reference</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">MaizeGDB</th>
            <td>Andorf CM, Cannon EK, Portwood JL, Gardiner JM, Harper LC, Schaeffer ML, Braun BL, Campbell DA, Vinnakota AG, Sribalusu VV, Huerta M, Cho KT, Wimalanathan K, Richter JD, Mauch ED, Rao BS, Birkett SM, Sen TZ, Lawrence-Dill CJ. MaizeGDB update&#58; new tools, data and interface for the maize model organism database. <em>Nucleic Acids Research</em> 2016 Jan 4;44\(D1\)&#58;D1195&ndash;D1201. <a href="https://doi.org/10.1093/nar/gkv1007" target="_blank" rel="noopener">doi&#58;10.1093/nar/gkv1007</a></td>
          </tr>
          <tr>
            <th scope="row">Romay et al., 2013</th>
            <td>Romay MC, Millard MJ, Glaubitz JC, Peiffer JA, Swarts KL, Casstevens TM, Elshire RJ, Acharya CB, Mitchell SE, Flint-Garcia SA, McMullen MD, Holland JB, Buckler ES, Gardner CA. Comprehensive genotyping of the USA national maize inbred seed bank. <em>Genome Biology</em> 2013;14&#58;R55. <a href="https://doi.org/10.1186/gb-2013-14-6-r55" target="_blank" rel="noopener">doi&#58;10.1186/gb-2013-14-6-r55</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- SECTION 7: CONNECTED GENOMICS RESOURCES -->
  <section id="typ-related" class="mgdb-panel typ-bottom-section" aria-labelledby="typ-related-title">
    <h2 id="typ-related-title" class="mgdb-panel-title">Connected Genomics Resources</h2>
    <p class="mgdb-panel-lead">Explore related stock repositories, genetic variation tools, and reference genome resources.</p>

    <div class="typ-related-grid">
      <a class="typ-related-card" href="/data_center/stock">
        <div class="typ-related-title">Stocks Data Hub</div>
        <p class="typ-related-desc">Search and request maize germplasm stocks, mutant alleles, and NCRPIS seed accessions.</p>
      </a>

      <a class="typ-related-card" href="/genetic_variation">
        <div class="typ-related-title">Genetic Variation Center</div>
        <p class="typ-related-desc">Query SNPs, structural variations, and resequencing catalogs across diverse inbred lines.</p>
      </a>

      <a class="typ-related-card" href="/assembly">
        <div class="typ-related-title">B73 Reference Assemblies</div>
        <p class="typ-related-desc">Explore version histories \(v1&ndash;v5\), chromosome accessions, and FASTA/GFF bulk downloads.</p>
      </a>

      <a class="typ-related-card" href="/download">
        <div class="typ-related-title">Bulk Downloads &amp; Globus</div>
        <p class="typ-related-desc">Access high-speed Globus endpoints and bulk HTTP download directories.</p>
      </a>

      <a class="typ-related-card" href="https://npgsweb.ars-grin.gov/gringlobal/search.aspx" target="_blank" rel="noopener">
        <div class="typ-related-title">GRIN-Global Germplasm &#8599;</div>
        <p class="typ-related-desc">National Plant Germplasm System repository holding NCRPIS Ames maize collections.</p>
      </a>

      <a class="typ-related-card" href="/data_center">
        <div class="typ-related-title">All Data Hubs</div>
        <p class="typ-related-desc">Discover the full catalog of MaizeGDB data hubs, tools, and interactive catalogs.</p>
      </a>
    </div>
  </section>
</main>
)
