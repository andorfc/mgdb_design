$$SYNTAX-LEVEL 2
*(mgdb-locus
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@MaizeGDB">
<meta property="og:url" content="https://maizegdb.org/data_center/locus">
<meta property="og:title" content="MaizeGDB Locus Data Hub | Classic Genetic Loci, Mutants &amp; Characterized Genes">
<meta property="og:description" content="Explore classic maize genetic loci, characterized genes, mutant alleles, and cytological bin coordinates mapped to reference gene models.">

<main class="mgdb-page mgdb-hub-page mgdb-locus-page" id="locus-top">
  <nav class="mgdb-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">&rsaquo;</span><a href="/sitemap">Data hubs</a><span aria-hidden="true">&rsaquo;</span><span aria-current="page">Loci</span>
  </nav>

  <section class="mgdb-hero" aria-labelledby="locus-title">
    <div class="mgdb-hero-emblem">
      <svg viewBox="0 0 96 96" role="img" aria-label="Locus and chromosome map position icon">
        <rect x="28" y="16" width="40" height="64" rx="20" fill="#e8f4ec" stroke="#235c37" stroke-width="4" />
        <line x1="28" y1="36" x2="68" y2="36" stroke="#235c37" stroke-width="3" stroke-dasharray="2 3" />
        <line x1="28" y1="56" x2="68" y2="56" stroke="#235c37" stroke-width="3" stroke-dasharray="2 3" />
        <rect x="24" y="42" width="48" height="12" rx="4" fill="#d99a0b" stroke="#7a4a10" stroke-width="2" />
        <circle cx="48" cy="48" r="3" fill="#ffffff" />
        <path d="M12 48 L22 48 M74 48 L84 48" stroke="#d99a0b" stroke-width="3" stroke-linecap="round" />
      </svg>
      <strong>Locus<br />Data Hub</strong>
    </div>
    <div class="mgdb-hero-body">
      <h1 id="locus-title">Explore classic maize genetic loci &amp; mutant genes</h1>
      <p class="mgdb-hero-description">Search $(total_loci) curated genetic loci, covering $(gene_loci) characterized genes, $(total_alleles) mutant alleles, and $(distinct_phenotypes) phenotypic classes, mapped across chromosomes and linked to reference gene models.</p>
    </div>
  </section>

  <nav class="mgdb-section-tabs" aria-label="Sections on this page">
    <a href="#locus-search-panel" class="is-current" aria-current="true">Search</a>
    <a href="#locus-top-genes">Classic genes</a>
    <a href="#locus-types">Locus types</a>
    <a href="#locus-downloads">Downloads</a>
    <a href="#locus-references">References</a>
    <a href="#locus-metrics">Metrics</a>
    <a href="#locus-related">Related resources</a>
  </nav>

  <!-- Notice: Gene Models vs Classic Loci -->
  <div class="locus-notice-banner" role="note">
    <span class="locus-notice-icon" aria-hidden="true">&#9432;</span>
    <span class="locus-notice-body"><strong>Looking for the functional annotations of gene models?</strong> Search the <a href="/gene_center/gene">Gene Center &rarr;</a></span>
  </div>

  <section id="locus-search-panel" class="locus-search-panel" aria-labelledby="locus-search-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="locus-search-title">Search</h2>
      </div>
    </div>

    <form id="locus-search-form" class="locus-search-form" role="search">
      <div class="mgdb-hub-field locus-field-query">
        <label class="mgdb-label" for="locus-search-term">Search locus symbol, gene name, or synonym</label>
        <div class="locus-search-input-wrap">
          <input class="mgdb-input" id="locus-search-term" name="term" type="search" placeholder="e.g., adh1, tb1, kn1, bronze, glossy, opaque, bz1, Zm00001eb054440" autocomplete="off" />
        </div>
        <p class="mgdb-hint">
          <span>Try an example&#58;</span>
          <button type="button" class="locus-example-btn" data-term="adh1">adh1</button>
          <button type="button" class="locus-example-btn" data-term="tb1">tb1</button>
          <button type="button" class="locus-example-btn" data-term="kn1">kn1</button>
          <button type="button" class="locus-example-btn" data-term="opaque">opaque</button>
          <button type="button" class="locus-example-btn" data-term="glossy">glossy</button>
          <button type="button" class="locus-example-btn" data-term="sh2">sh2</button>
        </p>
      </div>


      <div class="mgdb-hub-field mgdb-hub-field-action">
        <button class="mgdb-button mgdb-button-primary" type="submit">Search loci</button>
      </div>

      <details class="locus-adv" id="locus-adv">
        <summary>
          <strong>Advanced search criteria</strong>
          <span>Restrict by locus type, chromosome, or curated phenotype</span>
        </summary>
        <div class="locus-adv-body">
        <div class="mgdb-hub-field">
          <label class="mgdb-label" for="locus-filter-type">Locus type</label>
          <select class="mgdb-select" id="locus-filter-type" name="type">
            $(type_options)
          </select>
        </div>

        <div class="mgdb-hub-field">
          <label class="mgdb-label" for="locus-filter-chr">Chromosome</label>
          <select class="mgdb-select" id="locus-filter-chr" name="chromosome">
            $(chr_options)
          </select>
        </div>

        <div class="mgdb-hub-field">
          <label class="mgdb-label" for="locus-filter-pheno">Curated phenotype</label>
          <select class="mgdb-select" id="locus-filter-pheno" name="phenotype">
            $(pheno_options)
          </select>
        </div>        </div>

        <div class="locus-adv-actions">
          <button class="mgdb-button mgdb-button-primary" type="submit">Apply advanced filters</button>
          <button class="mgdb-button mgdb-button-quiet" id="locus-adv-reset" type="button">Reset advanced filters</button>
        </div>
      </details>
    </form>
  </section>

  <section id="locus-results-section" class="locus-results-section" aria-labelledby="locus-results-title" hidden>
    <div class="locus-results-heading">
      <div>
        <h2 id="locus-results-title">Results</h2>
        <p id="locus-results-status" aria-live="polite">Enter a locus symbol or choose a filter above to view matching records.</p>
      </div>
      <div class="locus-results-controls">
        <div class="mgdb-hub-field">
          <label for="locus-results-filter">Filter results</label>
          <input id="locus-results-filter" type="search" placeholder="Narrow this page" autocomplete="off" />
        </div>
        <div class="mgdb-hub-field">
          <label for="locus-page-size">Results per page</label>
          <select id="locus-page-size">
            <option value="10">Top 10</option>
            <option value="25" selected>Top 25</option>
            <option value="50">Top 50</option>
            <option value="all">All results</option>
          </select>
        </div>
        <div class="locus-export-buttons">
          <a class="mgdb-button mgdb-button-quiet" id="locus-export-tsv" href="#" download>Export TSV</a>
        </div>
      </div>
    </div>

    <div id="locus-notes"></div>
    <div id="locus-results"></div>

    <div id="locus-empty" class="mgdb-empty" hidden>
      <h3>No loci matched</h3>
      <p>Try a shorter symbol, a different spelling, or reset the type and chromosome filters.</p>
    </div>

    <nav id="locus-pagination" class="locus-pagination" aria-label="Search result pages"></nav>
  </section>

  <section id="locus-top-genes" aria-labelledby="locus-top-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="locus-top-title">Classic genes</h2>
      </div>
    </div>

    <div class="mgdb-card-grid locus-top-grid">
      <article class="mgdb-card">
        <div class="locus-card-top">
          <span class="mgdb-pill mgdb-pill-ok">Chr 1 &middot; Bin 1.09</span>
        </div>
        <h3><a href="/data_center/locus?id=12671"><em>tb1</em> &mdash; teosinte branched1</a></h3>
        <p>TCP family transcription factor regulating apical dominance and plant architecture during maize domestication.</p>
        <span class="mgdb-muted locus-card-footer">Model&#58; Zm00001eb054440 &middot; 45 alleles</span>
      </article>

      <article class="mgdb-card">
        <div class="locus-card-top">
          <span class="mgdb-pill mgdb-pill-ok">Chr 1 &middot; Bin 1.08</span>
        </div>
        <h3><a href="/data_center/locus?id=12352"><em>kn1</em> &mdash; knotted1</a></h3>
        <p>Homeobox transcription factor required for shoot apical meristem maintenance and leaf development.</p>
        <span class="mgdb-muted locus-card-footer">Model&#58; Zm00001eb058310 &middot; 38 alleles</span>
      </article>

      <article class="mgdb-card">
        <div class="locus-card-top">
          <span class="mgdb-pill mgdb-pill-ok">Chr 1 &middot; Bin 1.03</span>
        </div>
        <h3><a href="/data_center/locus?id=12021"><em>adh1</em> &mdash; alcohol dehydrogenase1</a></h3>
        <p>Classic anaerobic response enzyme catalyzing reduction of acetaldehyde to ethanol under flooding stress.</p>
        <span class="mgdb-muted locus-card-footer">Model&#58; Zm00001eb026700 &middot; 84 alleles</span>
      </article>

      <article class="mgdb-card">
        <div class="locus-card-top">
          <span class="mgdb-pill mgdb-pill-ok">Chr 9 &middot; Bin 9.02</span>
        </div>
        <h3><a href="/data_center/locus?id=12086"><em>bz1</em> &mdash; bronze1</a></h3>
        <p>UDP-glucose flavonol glucosyltransferase involved in anthocyanin biosynthesis; historic transposon tagging locus.</p>
        <span class="mgdb-muted locus-card-footer">Model&#58; Zm00001eb375080 &middot; 62 alleles</span>
      </article>

      <article class="mgdb-card">
        <div class="locus-card-top">
          <span class="mgdb-pill mgdb-pill-ok">Chr 7 &middot; Bin 7.01</span>
        </div>
        <h3><a href="/data_center/locus?id=12461"><em>o2</em> &mdash; opaque2</a></h3>
        <p>bZIP transcription factor regulating 22-kDa alpha-zein storage protein synthesis and kernel nutritional quality.</p>
        <span class="mgdb-muted locus-card-footer">Model&#58; Zm00001eb304040 &middot; 71 alleles</span>
      </article>

      <article class="mgdb-card">
        <div class="locus-card-top">
          <span class="mgdb-pill mgdb-pill-ok">Chr 9 &middot; Bin 9.03</span>
        </div>
        <h3><a href="/data_center/locus?id=12763"><em>wx1</em> &mdash; waxy1</a></h3>
        <p>Granule-bound starch synthase responsible for amylose synthesis in the endosperm and pollen grains.</p>
        <span class="mgdb-muted locus-card-footer">Model&#58; Zm00001eb378290 &middot; 95 alleles</span>
      </article>

      <article class="mgdb-card">
        <div class="locus-card-top">
          <span class="mgdb-pill mgdb-pill-ok">Chr 4 &middot; Bin 4.05</span>
        </div>
        <h3><a href="/data_center/locus?id=12664"><em>su1</em> &mdash; sugary1</a></h3>
        <p>Starch debranching enzyme \(isoamylase1\) whose loss leaves the sugary endosperm that sweet corn is grown for.</p>
        <span class="mgdb-muted locus-card-footer">Model&#58; Zm00001eb174590 &middot; 78 alleles</span>
      </article>

      <!-- These seven are examples, not a ranking. The card below says where the
           whole list lives, so the section cannot be mistaken for the corpus. -->
      <article class="mgdb-card locus-card-more">
        <div class="locus-card-top">
          <span class="mgdb-pill">Naming</span>
        </div>
        <h3><a href="/data_center/gene-symbols">Gene symbol prefixes</a></h3>
        <p>The seven above are a sample. All 1,181 symbol prefixes used when naming maize genes, such as <em>adh</em> behind <em>adh1</em>, are listed and searchable on one page.</p>
        <span class="locus-card-footer"><a class="mgdb-button mgdb-button-secondary" href="/data_center/gene-symbols">Browse gene symbols <span aria-hidden="true">&rarr;</span></a></span>
      </article>
    </div>
  </section>

  <section id="locus-types" aria-labelledby="locus-types-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="locus-types-title">Locus types</h2>
      </div>
    </div>

    <p class="mgdb-note">Every result carries a type tag. A locus here is any mapped
      position, so the tag says what kind of thing was mapped &#58; a characterized
      gene, a probed site, a transgene, a segment of chromosome. The wording below is
      MaizeGDB's own definition of each type, the same text the term record shows.</p>

    <dl class="locus-type-list">
      $(type_glossary)
    </dl>
  </section>

  <section id="locus-downloads" aria-labelledby="locus-downloads-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="locus-downloads-title">Downloads</h2>
      </div>
    </div>

    <div class="locus-download-grid" aria-label="Locus downloads">
      <article class="locus-download-card">
        <div class="locus-download-header">
          <span class="mgdb-pill mgdb-pill-ok">Gene Center</span>
          <h3>Reference Gene Models</h3>
        </div>
        <p>Explore B73 RefGen_v5, v4, and NAM pan-genome gene models with transcript isoforms, functional GO terms, and expression atlases.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/gene_center/gene">Visit Gene Center <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="locus-download-card">
        <div class="locus-download-header">
          <span class="mgdb-pill mgdb-pill-info">Bulk Data</span>
          <h3>Locus to Gene Model Mapping</h3>
        </div>
        <p>Every curated locus with the gene models it has been associated with, in one sortable table.</p>
        <a class="mgdb-button mgdb-button-secondary" href="/associated_genes?type=all&amp;style=table">View the mapping table <span aria-hidden="true">&rarr;</span></a>
      </article>

      <article class="locus-download-card">
        <div class="locus-download-header">
          <span class="mgdb-pill mgdb-pill-warn">Phenotypes</span>
          <h3>Mutant Stock Catalog</h3>
        </div>
        <p>Browse seed stocks carrying characterized mutant alleles from the Maize Genetics Cooperation Stock Center \(MGCSC\).</p>
        <a class="mgdb-button mgdb-button-secondary" href="/data_center/stock">Explore Seed Stocks <span aria-hidden="true">&rarr;</span></a>
      </article>
    </div>
  </section>

  <section id="locus-references" aria-labelledby="locus-references-title">
    <div class="mgdb-section-heading">
      <div><h2 id="locus-references-title">References</h2></div>
    </div>

    <div class="mgdb-ref-list">
      $(reference_cards)
    </div>
  </section>

  <section id="locus-metrics" aria-labelledby="locus-metrics-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="locus-metrics-title">Metrics</h2>
      </div>
    </div>

    <div class="mgdb-metric-grid">
      <article class="mgdb-metric mgdb-tone-green">
        <div class="mgdb-metric-top">
          <h3>Curated Loci</h3>
          <span class="mgdb-metric-badge">All Types</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total_loci)</strong>
        </div>
        <p class="mgdb-metric-description">Total genetic loci, mapped probed sites, points, and genes cataloged in MaizeGDB.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-amber">
        <div class="mgdb-metric-top">
          <h3>Characterized Genes</h3>
          <span class="mgdb-metric-badge">Gene Loci</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(gene_loci)</strong>
        </div>
        <p class="mgdb-metric-description">Curated classic genes with named gene symbols and experimental characterization.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-blue">
        <div class="mgdb-metric-top">
          <h3>Curated Alleles</h3>
          <span class="mgdb-metric-badge">Alleles</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(total_alleles)</strong>
        </div>
        <p class="mgdb-metric-description">Named mutant alleles, sequence variations, and transposon insertion events.</p>
      </article>

      <article class="mgdb-metric mgdb-tone-burgundy">
        <div class="mgdb-metric-top">
          <h3>Phenotype Classes</h3>
          <span class="mgdb-metric-badge">Phenotypes</span>
        </div>
        <div class="mgdb-metric-stat">
          <strong class="mgdb-metric-value">$(distinct_phenotypes)</strong>
        </div>
        <p class="mgdb-metric-description">Distinct curated phenotypic trait classes associated with maize mutant loci.</p>
      </article>
    </div>

    <figure class="mgdb-figure locus-figure">
      <h3>Loci by type</h3>
      <div class="mgdb-chart" id="locus-type-chart" role="img"
           aria-label="Horizontal bar chart of how many curated loci belong to each of the ten largest locus types, with the remaining types grouped together">
        <div class="mgdb-chart-fallback">Loading the locus type breakdown&hellip;</div>
      </div>
      <figcaption>Every curated locus counts once, so the bars total the whole corpus. Mapping points are 88&#37; of it, which is why the rest read as slivers &#8212; the count beside each bar is the one to read. Select a bar to search that type.</figcaption>
    </figure>

    <div class="mgdb-table-scroll locus-figure-table">
      <table class="mgdb-table" id="locus-type-table">
        <caption>
          Loci by type
          <span class="mgdb-muted">The values behind the chart above.</span>
        </caption>
        <thead>
          <tr>
            <th scope="col">Locus type</th>
            <th scope="col" class="mgdb-numeric">Loci</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section id="locus-related" class="mgdb-hub-related" aria-labelledby="locus-related-title">
    <div class="mgdb-section-heading">
      <div>
        <h2 id="locus-related-title">Related resources</h2>
      </div>
    </div>

    <div class="mgdb-resource-panel">
      <div class="mgdb-resource-list">
        <a href="/gene_center/gene">
          <strong>Gene Data Hub</strong>
          <span>B73 and NAM reference gene models, symbols, and the evidence behind them</span>
        </a>
        <a href="/data_center/qtl">
          <strong>QTL Data Hub</strong>
          <span>Quantitative trait analyses, and the QTL loci they place on these maps</span>
        </a>
        <a href="/data_center/variation">
          <strong>Variation Data Hub</strong>
          <span>The alleles and polymorphisms recorded against these loci</span>
        </a>
        <a href="/data_center/phenotype">
          <strong>Phenotype Data Hub</strong>
          <span>The mutant phenotypes these loci were characterized by</span>
        </a>
        <a href="/data_center/map">
          <strong>Map Data Hub</strong>
          <span>The genetic, cytogenetic, and physical maps these loci are placed on</span>
        </a>
      </div>
    </div>
  </section>

  <script type="application/json" id="locus-chart-data">$(chart_data)</script>
</main>
)
