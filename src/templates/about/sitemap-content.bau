*(doc-content
<div id="sitemap_content" aria-label="MaizeGDB directory">

  <section id="sm-start" class="sitemap-section" data-section-kind="community">
    <h2 class="sitemap-section-heading">
      <button type="button" class="sitemap-section-toggle" aria-controls="sm-start-panel" aria-expanded="true">
        <span class="sitemap-section-name">Start here</span>
        <span class="sitemap-section-count" data-total="6">6</span>
      </button>
    </h2>
    <div id="sm-start-panel" class="sitemap-panel open">
      <ul class="sitemap-grid">
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/search_engine/searchall">Search everything</a>
          <p class="sitemap-item-desc">One search across genes, stocks, phenotypes, references, and more.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center">Data hubs</a>
          <p class="sitemap-item-desc">Every curated collection in one directory.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/genome">Genome Center</a>
          <p class="sitemap-item-desc">Assemblies hosted at MaizeGDB, with browsers and downloads.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/gene_center/gene">Gene Center</a>
          <p class="sitemap-item-desc">Look up a gene model, symbol, or locus.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/BLAST">BLAST</a>
          <p class="sitemap-item-desc">Sequence search against every genome dataset hosted here.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://download.maizegdb.org" target="_blank" rel="noopener">Downloads <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Bulk files: assemblies, annotations, insertions, expression.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="sm-tools" class="sitemap-section" data-section-kind="tools">
    <h2 class="sitemap-section-heading">
      <button type="button" class="sitemap-section-toggle" aria-controls="sm-tools-panel" aria-expanded="true">
        <span class="sitemap-section-name">All research tools</span>
        <span class="sitemap-section-count" data-total="26">26</span>
      </button>
    </h2>
    <div id="sm-tools-panel" class="sitemap-panel open">
      <ul class="sitemap-grid">
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/BLAST">BLAST</a>
          <p class="sitemap-item-desc">Sequence search against the full set of genome datasets hosted at MaizeGDB.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/bin_viewer">Bin Viewer</a>
          <p class="sitemap-item-desc">Explore data in regions defined by genetic bin boundaries.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/fatcat">FATCAT comparison tool</a>
          <p class="sitemap-item-desc">Structural alignments between a maize protein and its top structural hits.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://feta.maizegdb.org" target="_blank" rel="noopener">FETA <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">A suite of tools for exploring gene functional enrichment in Zea mays and relatives.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/foldseek">Foldseek search</a>
          <p class="sitemap-item-desc">Search a maize protein structure by shape, and find relatives that sequence search misses.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://fusarium.maizegdb.org" target="_blank" rel="noopener">Fusarium Protein Toolkit <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Tools and datasets for the functions and structures of the Fusarium proteome.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/gbrowse">GBrowse genome browsers</a>
          <p class="sitemap-item-desc">Older browser hosting B73 v1-v4, NRGene W22, and other historic assemblies.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://gcv.maizegdb.org" target="_blank" rel="noopener">Genome Context Viewer <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Explore gene families in genomic context across multiple assemblies.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://genomeqc.maizegdb.org/" target="_blank" rel="noopener">GenomeQC <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Assess genome assembly and gene model annotation quality.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://jbrowse.maizegdb.org" target="_blank" rel="noopener">JBrowse genome browsers <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">The GBrowse replacement, hosting B73 v5 and most assemblies here.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/genome/jbrowse2_tutorial">JBrowse 2 tutorial</a>
          <p class="sitemap-item-desc">How to drive the JBrowse 2 interface.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://mfs.maizegdb.org/" target="_blank" rel="noopener">Maize Feature Store <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Central repository of raw and transformed data, suited to machine learning.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/metabolic_pathways">Metabolic Pathways</a>
          <p class="sitemap-item-desc">Maize pathway assignments, and the maintained databases that curate them. Replaces the retired CornCyc instances.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/effect/maize_v2/">PanEffect</a>
          <p class="sitemap-item-desc">Explore variant effects across the maize pan-genome.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://pangenome-viewer.maizegdb.org/" target="_blank" rel="noopener">Pangenome graph <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Structural and sequence variation across Zea genomes.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/projects/pathway_explorer">Pan-genome pathway explorer</a>
          <p class="sitemap-item-desc">E2P2 metabolic pathway annotation across the 26 NAM founder genomes, with gap analysis and gene-list enrichment.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/past">Pathway Association Study Tool \(PAST\)</a>
          <p class="sitemap-item-desc">Assigns SNPs to genes and genes to metabolic pathways.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/breeders_toolbox">PedigreeNet</a>
          <p class="sitemap-item-desc">Pedigree relationships between maize varieties, drawn as a network.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://phylostrata.maizegdb.org" target="_blank" rel="noopener">Phylostrata <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Phylostratigraphy: evolutionary conservation level of a protein.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/protein_structure">Protein structures</a>
          <p class="sitemap-item-desc">Predicted structures for gene model proteins, with Foldseek and FATCAT.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://qteller.maizegdb.org" target="_blank" rel="noopener">qTeller <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Comparative RNA-seq expression across multiple data sources.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://reelgene.maizegdb.org/" target="_blank" rel="noopener">reelGene <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Look up a gene model for its reelGene functionality score, conservation level, and pan-gene class.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://snptools.maizegdb.org" target="_blank" rel="noopener">SNPTools <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Variant browsing and per-gene structure views.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://wgs.maizegdb.org/" target="_blank" rel="noopener">SNPversity 2.0 <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Build a VCF for a region of B73 across a subset of diverse accessions.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/traits_ibm_nam">Trait values for IBM and NAM</a>
          <p class="sitemap-item-desc">Measured trait values, searchable by stock, trait, reference, or environment.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/TYPSimSelector">TYPSimSelector</a>
          <p class="sitemap-item-desc">Rank USDA Ames inbred lines by genetic similarity to a reference accession.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="sm-ai" class="sitemap-section" data-section-kind="tools">
    <h2 class="sitemap-section-heading">
      <button type="button" class="sitemap-section-toggle" aria-controls="sm-ai-panel" aria-expanded="true">
        <span class="sitemap-section-name">AI and machine learning</span>
        <span class="sitemap-section-count" data-total="6">6</span>
      </button>
    </h2>
    <div id="sm-ai-panel" class="sitemap-panel open">
      <ul class="sitemap-grid">
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/ai">AI and Machine Learning at MaizeGDB</a>
          <p class="sitemap-item-desc">Overview of the AI-derived datasets and tools hosted here.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/effect/maize_v2/">PanEffect variant effects</a>
          <p class="sitemap-item-desc">Language-model variant effect predictions across the pan-genome.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/protein_structure">Protein structure data hub</a>
          <p class="sitemap-item-desc">AlphaFold and ESMFold predicted structures with search and comparison.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/projects/interpro_domain_atlas">InterPro domain atlas</a>
          <p class="sitemap-item-desc">Domain composition across the proteome.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://mfs.maizegdb.org/" target="_blank" rel="noopener">Maize Feature Store <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">ML-ready feature tables assembled from many sources.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/FAIRpractices">FAIR data and AI readiness</a>
          <p class="sitemap-item-desc">How MaizeGDB approaches FAIR and machine-readable data.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="sm-genomes" class="sitemap-section" data-section-kind="curated">
    <h2 class="sitemap-section-heading">
      <button type="button" class="sitemap-section-toggle" aria-controls="sm-genomes-panel" aria-expanded="true">
        <span class="sitemap-section-name">Genomic data</span>
        <span class="sitemap-section-count" data-total="17">17</span>
      </button>
    </h2>
    <div id="sm-genomes-panel" class="sitemap-panel open">
      <ul class="sitemap-grid">
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/genome">Genome Center</a>
          <p class="sitemap-item-desc">Search and filter every assembly hosted here by cultivar, species, accession, or status.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/genomebrowser">Genome browsers</a>
          <p class="sitemap-item-desc">Which browser serves which assembly, plus prepared synteny and structural-variant sessions.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://jbrowse.maizegdb.org" target="_blank" rel="noopener">JBrowse 2 <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">Current browser: B73 v5 and most assemblies here, with multi-assembly synteny views.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/gbrowse">GBrowse</a>
          <p class="sitemap-item-desc">Older browser, still serving B73 v1-v4 and other retired assemblies.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/assembly">B73 assembly center</a>
          <p class="sitemap-item-desc">The B73 reference across v1 to v5: sequencing technology, gene model sets, chromosome accessions, and downloads.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/historic">B73 assembly history</a>
          <p class="sitemap-item-desc">What changed between B73 releases, including gene model migrations and coordinate transitions from RefGen_v1 to NAM-5.0.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/sequencing_project">B73 sequencing project</a>
          <p class="sitemap-item-desc">Historic record of the BAC-by-BAC project that produced the first B73 reference.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/assembly_manifesto">Reference assembly information</a>
          <p class="sitemap-item-desc">How MaizeGDB chooses the representative maize assembly, and what a group planning a new assembly should know.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/genome/whole_genome">Whole genome views</a>
          <p class="sitemap-item-desc">Chromosome ideograms, gene density, and repeat distributions for B73 v5 and the 25 NAM founders.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/NAM_project">NAM founder genomes</a>
          <p class="sitemap-item-desc">De novo assemblies, annotations, GRIN accessions, and stock records for the 26 NAM founder inbreds.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/PanAnd_project">Pan-Andropogoneae genomes</a>
          <p class="sitemap-item-desc">Chromosome-scale assemblies across 36 wild Zea, Tripsacum, and Andropogoneae grasses.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/european_flints">European flint genomes</a>
          <p class="sitemap-item-desc">Assemblies and structural variation for four European flint inbreds: DK105, EP1, F7, and PE0075.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/CAAS_FIL_project">CAAS founder inbred genomes</a>
          <p class="sitemap-item-desc">Assemblies for the 12 Chinese and international founder lines behind modern hybrid breeding.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/HiLo_project">HiLo elevation genomes</a>
          <p class="sitemap-item-desc">Assemblies and gene models for Mexican landraces and CIMMYT inbreds sampled from 50 to 2,520 metres.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/amaizing_project">AMAIZING genomes</a>
          <p class="sitemap-item-desc">Assemblies, watered and drought transcriptomes, and panEDTA annotation for seven European breeding lines.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/14InbredsFISH">FISH karyotypes</a>
          <p class="sitemap-item-desc">Multicolor chromosome painting across 14 inbred lines, and high-resolution B73 versus Mo17 somatic karyotypes.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/projects/cytogenetic_map">Cytogenetic Map of Maize project</a>
          <p class="sitemap-item-desc">Probe nomenclature and FISH methods for placing genetically mapped markers on pachytene chromosomes.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="sm-data_center" class="sitemap-section" data-section-kind="curated">
    <h2 class="sitemap-section-heading">
      <button type="button" class="sitemap-section-toggle" aria-controls="sm-data_center-panel" aria-expanded="true">
        <span class="sitemap-section-name">Data hubs</span>
        <span class="sitemap-section-count" data-total="21">21</span>
      </button>
    </h2>
    <div id="sm-data_center-panel" class="sitemap-panel open">
      <ul class="sitemap-grid">
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center">All data hubs</a>
          <p class="sitemap-item-desc">Every data hub in one directory.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/marker">Markers and probes</a>
          <p class="sitemap-item-desc">Molecular markers, probes, SSRs, RFLPs, and sequence features.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/stock">Stocks</a>
          <p class="sitemap-item-desc">Stocks tracked by MaizeGDB.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/stock_catalog">Stock catalog</a>
          <p class="sitemap-item-desc">Catalog of new additions at the Maize Genetics Cooperation Stock Center.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/reference">References</a>
          <p class="sitemap-item-desc">The curated maize literature, searchable by topic, author, gene, or locus.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/variation">Alleles and polymorphisms</a>
          <p class="sitemap-item-desc">Alleles, polymorphisms, and the mutant collections behind them.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/map">Maps</a>
          <p class="sitemap-item-desc">Genetic, cytogenetic, physical, and bin maps across chromosomes 1-10.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/lg">Linkage groups</a>
          <p class="sitemap-item-desc">What a locus is placed on: the chromosomes, and the plasmids, phage, BACs, and organellar genomes used in maize genetics.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/phenotype">Phenotypes</a>
          <p class="sitemap-item-desc">Phenotype records and the mutant archives they come from.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/image">Images</a>
          <p class="sitemap-item-desc">Curated photographs of phenotypes, materials, and gel patterns.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/protein_structure">Protein structures</a>
          <p class="sitemap-item-desc">Predicted structures for gene model proteins.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/insertion">Insertions</a>
          <p class="sitemap-item-desc">Mu, Ac/Ds, and other sequence-indexed transposon insertion collections.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/pan_gene_center/pan_gene">Pan-genes</a>
          <p class="sitemap-item-desc">Pan-gene assignments across the NAM assemblies.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/genome">Genome Center</a>
          <p class="sitemap-item-desc">Assemblies hosted at MaizeGDB.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/gene_center/gene">Gene Center</a>
          <p class="sitemap-item-desc">Gene records with models, symbols, and supporting evidence.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/locus">Loci</a>
          <p class="sitemap-item-desc">Classic genetic loci, cloned genes, and their alleles.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/qtl">QTL</a>
          <p class="sitemap-item-desc">Quantitative trait analyses and the crosses behind them.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/expression">Expression</a>
          <p class="sitemap-item-desc">Expression datasets.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/gene_product">Gene products</a>
          <p class="sitemap-item-desc">Products assigned to gene models.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/metabolic_pathway">Metabolic pathways</a>
          <p class="sitemap-item-desc">Pathway records.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/data_center/cytogenetic">Cytogenetics</a>
          <p class="sitemap-item-desc">Cytogenetic stocks and maps.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="sm-community" class="sitemap-section" data-section-kind="community">
    <h2 class="sitemap-section-heading">
      <button type="button" class="sitemap-section-toggle" aria-controls="sm-community-panel" aria-expanded="true">
        <span class="sitemap-section-name">Community and people</span>
        <span class="sitemap-section-count" data-total="11">11</span>
      </button>
    </h2>
    <div id="sm-community-panel" class="sitemap-panel open">
      <ul class="sitemap-grid">
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/projects">Research projects</a>
          <p class="sitemap-item-desc">Every maize research project with data, results, or documentation here.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/person">Find researchers</a>
          <p class="sitemap-item-desc">Search the MaizeGDB people directory.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="/maize_meeting">Maize Genetics Conference</a>
          <p class="sitemap-item-desc">Past, present, and future annual meetings.</p>
        </li>
        <li class="sitemap-item">
          <a class="sitemap-item-link" href="https://www.maizegenetics.org" target="_blank" rel="noopener">Maize Genetics Cooperation <span class="sitemap-item-ext" aria-hidden="true">&nearr;</span></a>
          <p class="sitemap-item-desc">The organization coordinating maize research cooperation.</p>
