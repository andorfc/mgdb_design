Options -Indexes

# The shards are read by PHP on behalf of /api/v1/data/domains. Every JSON file
# is denied except the public index of each release.
<FilesMatch "\.json$">
  Require all denied
</FilesMatch>

<Files "index.json">
  Require all granted
  Header set Cache-Control "public, max-age=3600"
</Files>
