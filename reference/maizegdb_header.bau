$$SYNTAX-LEVEL 2
*(maizegdb_header {include-js: /js/google_analytics.js}
  @(lambda {display: off}
      $(image-dir {default: /images})
      $(icon-dir {default: /icon})
  )

<!-- $(gbrowse_url) -->

  <ul id="menu_bar" class="menu menu_green">
    <li id="nodrop">
        <a href="/">$(home_name)</a>
    </li>
    
    <li>
      *(about-item {load: templates/home/megamenu/about.bau}
        ;; manually pass scoped variables for now
        &(lambda
          $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
          $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
          
          $loaded = $this->reflect(\)->_parent(\);
          if ($loaded->has('image-dir'\)\)
            $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
          if ($loaded->has('icon-dir'\)\)
            $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
        )
      )
    </li>
    <li>
      *(community-item {load: templates/home/megamenu/community.bau}
        &(lambda
          $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
          $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
          
          $loaded = $this->reflect(\)->_parent(\);
          if ($loaded->has('image-dir'\)\)
            $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
          if ($loaded->has('icon-dir'\)\)
            $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
        )
      )
    </li>

    <li>
      *(genomes-item {load: templates/home/megamenu/genomes.bau}
        &(lambda
          $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
          $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
          
          $loaded = $this->reflect(\)->_parent(\);
          if ($loaded->has('image-dir'\)\)
            $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
          if ($loaded->has('icon-dir'\)\)
            $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
        )
      )
    </li>
      
    <li>
      *(tools-item {load: templates/home/megamenu/tools.bau}
        &(lambda
          $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
          $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
          
          $loaded = $this->reflect(\)->_parent(\);
          if ($loaded->has('image-dir'\)\)
            $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
          if ($loaded->has('icon-dir'\)\)
            $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
        )
      )
    </li>
      
    <li>
      *(data-centers-item {load: templates/home/megamenu/data-centers.bau}
        &(lambda
          $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
          $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
          
          $loaded = $this->reflect(\)->_parent(\);
          if ($loaded->has('image-dir'\)\)
            $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
          if ($loaded->has('icon-dir'\)\)
            $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
        )
      )
    </li>
    
   <li>
    *(sitemap-item {load: templates/home/megamenu/sitemap.bau}
      &(lambda
        $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
        $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
        
        $loaded = $this->reflect(\)->_parent(\);
        if ($loaded->has('image-dir'\)\)
          $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
        if ($loaded->has('icon-dir'\)\)
          $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
      )
    )
    </li>
     
    <li class="right">
      *(feedback-item {load: templates/home/megamenu/feedback.bau}
        &(lambda
          $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
          $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
          
          $loaded = $this->reflect(\)->_parent(\);
          if ($loaded->has('image-dir'\)\)
            $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
          if ($loaded->has('icon-dir'\)\)
            $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
        )
      )
    </li>
    
    <li class="right">
      *(search-item {load: templates/home/megamenu/search.bau}
        &(lambda
          $image_dir = $this->reflect(\)->upstream('maizegdb_header'\)->get('image-dir'\);
          $icon_dir  = $this->reflect(\)->upstream('maizegdb_header'\)->get('icon-dir'\);
          
          $loaded = $this->reflect(\)->_parent(\);
          if ($loaded->has('image-dir'\)\)
            $loaded->get('image-dir'\)->replace($image_dir->value(\)\); 
          if ($loaded->has('icon-dir'\)\)
            $loaded->get('icon-dir'\)->replace($icon_dir->value(\)\);
        )
      )
    </li>
  </ul>
)
