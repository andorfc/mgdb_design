.DS_Store
*.swp
node_modules/
tmp/
# Never commit server configuration — it contains database credentials.
**/mgdb.conf
**/db.conf

# Per-deploy snapshots. These are machine-local rollback artifacts and one is
# written on every deploy, so versioning them just accumulates duplicates.
# The pristine pre-redesign originals are tracked in reference/ instead.
backups/

# Local deployment target (host and server paths).
deploy/config.local.sh

# Python bytecode from tools/
__pycache__/
*.pyc

# AlphaFill research outputs. This is a staging folder for the proteome run's
# own artifacts, not source: a 54 MB single-file demo viewer with 179 structures
# inlined, and the 16 MB gene x ligand table. Both are inputs to
# tools/alphafill_index.py, which is versioned; the products are deployed as
# tarballs and never committed. See README, "AlphaFill ligand transplants",
# and ADMIN_DEPENDENCIES AD-028 for where the authoritative copies live.
# The design spec that came with them is kept at docs/alphafill/.
protein_data/
